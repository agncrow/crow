--- first-class functions test ---

--- 1. basic: function as value ---
fn double[x]
    return x * 2

fn square[x]
    return x * x

op = double
log['double via op: {op[5]}']

op = square
log['square via op: {op[5]}']

--- 2. pass function as argument ---
fn apply[f, x]
    return f[x]

log['apply double 3: {apply[double, 3]}']
log['apply square 4: {apply[square, 4]}']

--- 3. store functions in an array ---
ops = [double, square]
log['ops[0] on 3: {ops[0][3]}']
log['ops[1] on 3: {ops[1][3]}']

--- 4. iterate over functions ---
results = for f in [double, square]
    f[10]
log['map fns over 10: {results}']

--- 5. function returning a function ---
fn pick_op[name]
    if name eq 'double'
        return double
    return square

chosen = pick_op['double']
log['picked double, apply to 7: {chosen[7]}']

chosen2 = pick_op['square']
log['picked square, apply to 7: {chosen2[7]}']

--- 6. store functions in a map ---
fn add[a, b]
    return a + b

fn mul[a, b]
    return a * b

ops_map = [add = add, mul = mul]
r1 = ops_map.add
log['map add: {r1[3, 4]}']
r2 = ops_map.mul
log['map mul: {r2[3, 4]}']

--- 7. reduce pattern ---
fn reduce[f, arr, start]
    result = start
    i = 0
    while i lt arr.len
        result = f[result, arr[i]]
        i = i + 1
    return result

product = reduce[mul, [1, 2, 3, 4, 5], 1]
log['reduce mul: {product}']

sum = reduce[add, [1, 2, 3, 4, 5], 0]
log['reduce add: {sum}']

log['all first-class function tests complete']

