--- The fifth reference app: a page over a log (`use magpie`). Orders land
--- as batches — the form writes one — and the page reads the table the
--- log holds, a search over the notes and the log's figures, each a
--- derivation that follows the writes. From its folder, `crow run main.co`
--- serves it on port 3600; `crow test --served magpie` from the repository
--- root drives it in both modes.
use web, ui, frame, magpie

written = 0
new_item = ''
new_note = ''
search_words = ''

fn setup[]
    if not exists['orders']
        first = batch['orders', frame.new[id = [1, 2], item = ['apples', 'pears'], note = ['a crate of apples for the shop', 'pears for the kitchen']], by = ['id']]

--- the derivations read `written`, so each write re-derives them
derive orders
    seen = written
    return latest['orders']

derive figures
    seen = written
    return metrics['orders']

derive hits
    seen = written
    return search['orders', 'note', split[search_words, ' '], 5]

fn add[]
    if new_item eq ''
        notice['name the item']
        return
    h = head['orders']
    if not h.ok
        notice[h.reason]
        return
    wrote = batch['orders', frame.new[id = [h + 2], item = [new_item], note = [new_note]], by = ['id']]
    if not wrote.ok
        notice[wrote.reason]
        return
    written = written + 1
    new_item = ''
    new_note = ''

view render[]
    f = figures
    return stack[
        h1['Orders'],
        p['`f.rows[0]` rows in `f.files[0]` files, head at `f.head[0]`', color = 'muted'],
        table[orders, hide = ['_pos']],
        row[field['Item', new_item, type = 'text'], field['Note', new_note, type = 'text'], button['Add', click = add], gap = 'm', align = 'end'],
        field['Search the notes', search_words, type = 'text'],
        p['`len[hits]` hits'],
        table[hits, hide = ['_pos', 'score']],
        gap = 's', pad = 'l'
    ]

--- a write lands as a batch, and the page's derivations follow it
test an_order_added_shows_on_the_page[]
    gone = rm['orders']
    setup[]
    a = app[render]
    assert['2 rows in 1 files, head at 1' in html[a]]
    change[a, 'new_item', 'plums']
    change[a, 'new_note', 'plums for the kitchen table']
    click[a, add]
    assert['plums' in html[a]]
    assert['3 rows in 2 files, head at 2' in html[a]]
    change[a, 'search_words', 'kitchen']
    assert['2 hits' in html[a]]
    change[a, 'search_words', 'zebra']
    assert['0 hits' in html[a]]
    gone = rm['orders']

setup[]

serve[3600]
page['/', render]
