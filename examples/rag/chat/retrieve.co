--- Hybrid retrieval: the vector neighbours and the BM25 ranks fused by
--- reciprocal rank — each chunk's score the sum, over the rankings it
--- appears in, of 1 / (60 + its rank), as the paper states it — the top
--- chunks with their fused scores.
use web, math, llm
use vectors.flat
use retrieval.words, retrieval.bm25
use chat.corpus

struct Found [chunk, score]
struct Ranked [positions, scores]

--- two rankings of positions fused: the k best, the best first, an
--- earlier one first between equals
fn fused[near, lexical_top, k]
    scores = map[]
    order = []
    for r in range[len[near]]
        p = near[r]
        if p not in scores
            order = push[order, p]
            scores = set[scores, p, 0.0]
        scores = set[scores, p, scores[p] + 1.0 / (60.0 + float[r + 1])]
    for r in range[len[lexical_top]]
        p = lexical_top[r]
        if p not in scores
            order = push[order, p]
            scores = set[scores, p, 0.0]
        scores = set[scores, p, scores[p] + 1.0 / (60.0 + float[r + 1])]
    fused_scores = for p in order
        scores[p]
    ranked = argsort[0.0 - tensor[fused_scores]]
    positions = []
    best = []
    for i in slice[ranked, 0, min[k, len[ranked]]]
        positions = push[positions, order[i]]
        best = push[best, fused_scores[i]]
    return Ranked[positions, best]

--- the k chunks a question finds: its embedding's nearest and BM25's best,
--- fused; the embedder's refusal is the answer's
fn hybrid[chunks, embedded, lexical, question, k]
    qv = embed[corpus.embedder[], [question]]
    if not qv.ok
        return error[qv.reason, 'llm']
    near = flat.nearest[embedded, flatten[qv], k * 2]
    lexical_top = bm25.top[bm25.scores[lexical, words.tokens[question]], k * 2]
    ranked = fused[near.positions, lexical_top, k]
    out = for i in range[len[ranked.positions]]
        Found[chunks[ranked.positions[i]], ranked.scores[i]]
    return out

--- a position both rankings hold scores twice, the best come first, and
--- at most k come
test the_rankings_are_fused_by_reciprocal_rank[]
    near = push[push[push[[], 3], 1], 2]
    lexical_top = push[push[[], 1], 4]
    r = fused[near, lexical_top, 3]
    r.positions eq push[push[push[[], 1], 3], 4]
    abs[r.scores[0] - (1.0 / 62.0 + 1.0 / 61.0)] lt 0.000000000000001
    abs[r.scores[1] - 1.0 / 61.0] lt 0.000000000000001
    len[fused[near, lexical_top, 10].positions] eq 4
