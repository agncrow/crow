--- P4 Web Modules Test
--- NOTE: interpreter-only smoke test of Phase 4 web builtins using stub
--- app values ([]) and the removed live[] API. Not a compilable program;
--- excluded from the build sweep. The current web API is page[]/serve[]/route[]
--- (see docs/language-spec.md, examples/web_test.crow).

--- CORS
app = []
app = cors[app]
log['cors permissive:', app]

--- Sessions
store = sessions[]
log['sessions:', store]

--- Templates
t = templates['./templates/**/*']
log['templates:', t]

--- Render
data = map[name = 'crow']
result = render[t, 'index', data]
log['render:', result]

--- Cache
c = cache[100]
log['cache:', c]

c2 = cache[100, 60]
log['cache with ttl:', c2]

--- Rate limiter
limiter = limit[100, 60]
log['limiter:', limiter]

--- Uploads
req = []
files = uploads[req]
log['uploads:', files]

--- SSE
fn sse_handler[req]
  return 'data'

app2 = []
app2 = sse[app2, '/events', sse_handler]
log['sse app:', app2]

--- WebSocket
fn ws_handler[req]
  return 'ok'

app3 = []
app3 = ws[app3, '/ws', ws_handler]
log['ws app:', app3]

--- WebSocket client
sock = connect['ws://localhost:3000']
log['connect:', sock]

sent = send[sock, 'hello']
log['send:', sent]

msg = recv[sock]
log['recv:', msg]

closed = close[sock]
log['close:', closed]

--- LiveView
fn live_handler[req]
  return 'ok'

app4 = []
app4 = live[app4, '/live', live_handler]
log['live app:', app4]

--- Static files
app5 = []
app5 = static_dir[app5, '/assets', './public']
log['static_dir app:', app5]

--- SMTP
mailer = smtp['smtp.example.com', 587, 'user', 'pass']
log['smtp:', mailer]

log['P4 Web Test Complete']
