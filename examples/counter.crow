--- Counter: live UI example ---
--- Demonstrates reactive variables and function-reference events ---

use web, ui

count = 0

fn inc[]
    count = count + 1

fn dec[]
    count = count - 1

fn render[]
    return div[
        h1['Count: {count}'],
        button['+', click = inc],
        button['-', click = dec]
    ]

serve[3000]
page['/', render]

