--- The board's database: who may sign in, the boards, their cards, what was
--- said and attached, and a record of what everyone did. The tables are made
--- here; the first people are seeded with stored password hashes.
use db

book = db.connect['sqlite://taskboard.db']

fn setup[c]
    exec[c, 'CREATE TABLE IF NOT EXISTS people (name TEXT PRIMARY KEY, role TEXT NOT NULL, hash TEXT NOT NULL)']
    exec[c, 'CREATE TABLE IF NOT EXISTS boards (id INTEGER PRIMARY KEY, name TEXT NOT NULL)']
    exec[c, 'CREATE TABLE IF NOT EXISTS cards (id INTEGER PRIMARY KEY, board INTEGER NOT NULL, title TEXT NOT NULL, status TEXT NOT NULL, owner TEXT NOT NULL, stars INTEGER NOT NULL DEFAULT 0)']
    exec[c, 'CREATE TABLE IF NOT EXISTS comments (id INTEGER PRIMARY KEY, card INTEGER NOT NULL, author TEXT NOT NULL, body TEXT NOT NULL)']
    exec[c, 'CREATE TABLE IF NOT EXISTS attachments (id INTEGER PRIMARY KEY, card INTEGER NOT NULL, name TEXT NOT NULL, path TEXT NOT NULL)']
    exec[c, 'CREATE TABLE IF NOT EXISTS audit (id INTEGER PRIMARY KEY, who TEXT NOT NULL, what TEXT NOT NULL)']
    exec[c, 'INSERT OR IGNORE INTO people VALUES (?, ?, ?)', ['ada', 'admin', hash['lovelace', 'password']]]
    exec[c, 'INSERT OR IGNORE INTO people VALUES (?, ?, ?)', ['bob', 'member', hash['builder', 'password']]]
    exec[c, 'INSERT OR IGNORE INTO boards (id, name) VALUES (1, ?)', ['Launch']]

--- Everything that changes the board is written down, by whom.
fn note[c, who, what]
    exec[c, 'INSERT INTO audit (who, what) VALUES (?, ?)', [who, what]]
