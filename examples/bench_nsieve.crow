--- nsieve benchmark ---
--- tests: array creation, while loops ---
--- ISSUE FOUND: No array/map mutation by index ---
--- Workaround: trial division instead of sieve ---

fn is_prime[n]
    if n lt 2
        return false
    i = 2
    while i * i lte n
        if n % i eq 0
            return false
        i = i + 1
    return true

fn count_primes[n]
    count = 0
    i = 2
    while i lt n
        if is_prime[i]
            count = count + 1
        i = i + 1
    return count

log['primes below 100: {count_primes[100]}']
log['primes below 1000: {count_primes[1000]}']
log['primes below 10000: {count_primes[10000]}']

