--- Frame module test (string column references)

use frame

--- Load CSV
df = load['examples/test_data.csv']
log[df]
log[df.shape]
log[df.columns]
log[df.dtypes]

--- Select columns
subset = select[df, ['name', 'age']]
log[subset]

--- Head / tail
top2 = head[df, 2]
log[top2]

--- Sort
sorted = sort[df, 'age']
log[sorted]

--- Rename
renamed = rename[df, 'salary', 'pay']
log[renamed]

--- Stats
log[stats[df]]

--- Fill missing
filled = fill[df, 'age', 0]
log[filled]

--- Column access
ages = df.age
log[ages]
