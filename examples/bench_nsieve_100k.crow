--- nsieve benchmark - 100k (trial division) ---
--- website uses sieve up to 10M+, we use trial division workaround ---

fn is_prime[n]
    if n lt 2
        return false
    i = 2
    while i * i lte n
        if n % i eq 0
            return false
        i = i + 1
    return true

fn count_primes[n]
    count = 0
    i = 2
    while i lt n
        if is_prime[i]
            count = count + 1
        i = i + 1
    return count

log['primes below 100000: `count_primes[100000]`']

