--- io module test
use io

--- Write test files using builtins
write['/tmp/crow_io_test.txt', 'hello crow\nline two\nline three']
write['/tmp/crow_io_test.csv', 'name,age,city\nalice,30,nyc\nbob,25,sf\n']
log['files written']

--- Read lines (io module)
file_lines = lines['/tmp/crow_io_test.txt']
log['line count: `len[file_lines]`']
log['first line: `file_lines[0]`']
log['second line: `file_lines[1]`']

--- Parse CSV (io module)
rows = csv['/tmp/crow_io_test.csv']
log['csv row count: `len[rows]`']
first = rows[0]
log['first name: `first.name`']
log['first age: `first.age`']
log['first city: `first.city`']

--- CSV error handling
bad = csv['/tmp/crow_io_nonexistent_12345.csv']
log['bad ok: `bad.ok`']
log['bad reason: `bad.reason`']
