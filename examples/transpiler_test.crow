s = 'hello world'
sep = ' '
log['split: {split[s, sep]}']
padded = '  hi  '
log['trim: {trim[padded]}']
old = 'world'
new = 'crow'
log['replace: {replace[s, old, new]}']
abc = 'abc'
log['upper: {upper[abc]}']
uabc = 'ABC'
log['lower: {lower[uabc]}']
hello = 'hello'
log['starts: {starts[s, hello]}']
world = 'world'
log['ends: {ends[s, world]}']
parts = ['a', 'b', 'c']
dash = '-'
log['join: {join[parts, dash]}']
log['int from float: {int[3.7]}']
numstr = '42'
log['int from str: {int[numstr]}']
log['float from int: {float[5]}']
pistr = '3.14'
log['float from str: {float[pistr]}']
log['str from int: {str[99]}']
nums = [3, 1, 4, 1, 5]
log['len: {len[nums]}']
log['contains: {contains[nums, 4]}']
log['slice: {slice[nums, 1, 3]}']
items = [10, 20]
items = push[items, 30]
log['after push: {items}']
items = pop[items]
log['after pop: {items}']
items = sort[items]
log['after sort: {items}']
items = reverse[items]
log['after reverse: {items}']
more = [100, 200]
items = append[items, more]
log['after append: {items}']
log['abs: {abs[-5]}']
log['sqrt: {sqrt[16.0]}']
log['floor: {floor[3.7]}']
log['ceil: {ceil[3.2]}']
log['round: {round[3.5]}']
log['pow: {pow[2, 10]}']
log['min: {min[3, 7]}']
log['max: {max[3, 7]}']
m = map[]
m = set[m, 'a', 1]
m = set[m, 'b', 2]
m = set[m, 'c', 3]
log['keys: {keys[m]}']
log['values: {values[m]}']
akey = 'a'
zkey = 'z'
log['has a: {has[m, akey]}']
log['has z: {has[m, zkey]}']
m = del[m, 'c']
log['after del: {keys[m]}']
fn double[x]
    return x * 2
fn apply[f, val]
    return f[val]
log['apply double: {apply[double, 5]}']
log['range: {range[5]}']
log['range 2-5: {range[2, 5]}']
assert[true]
assert[1 eq 1, 'math works']
log['all transpiler tests passed']

