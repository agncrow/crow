use math
use math.stats

--- tensor creation
a = zeros[2, 3]
log[a]

b = ones[2, 3]
log[b]

c = eye[3]
log[c]

d = linspace[0, 1, 5]
log[d]

em = arange[0, 5, 1]
log[em]

f = full[2, 2, 7.0]
log[f]

--- element-wise math
g = exp[d]
log[g]

h = sqrt[b]
log[h]

--- reductions
log[sum[b]]
log[mean[b]]
log[min[d]]
log[max[d]]
log[prod[linspace[1, 4, 4]]]
log[argmax[d]]
log[argmin[d]]

--- sorting and selection
log[argsort[d]]
log[topk[d, 3]]
log[unique[linspace[1, 3, 5]]]

--- cumulative ops
log[cumsum[linspace[1, 4, 4]]]
log[cumprod[linspace[1, 4, 4]]]

--- combining ops
log[concat[linspace[1, 3, 3], linspace[4, 5, 2]]]
log[stack[[linspace[1, 3, 3], linspace[4, 6, 3]]]]

--- broadcasting
p = reshape[linspace[1, 3, 3], 3, 1]
q = reshape[linspace[10, 40, 4], 1, 4]
log[p + q]

--- advanced indexing
data = linspace[10, 50, 5]
idx = linspace[0, 2, 3]
log[data[idx]]

--- shape ops
i = reshape[b, 3, 2]
log[i]

j = flatten[c]
log[j]

k = transpose[c]
log[k]

--- linear algebra
m1 = eye[2]
m2 = full[2, 2, 2.0]
log[m1 * m2]
log[det[m1]]
log[inv[m1]]

--- norms
log[norm[linspace[3, 4, 2]]]
log[norm[linspace[1, 3, 3], 1]]

--- qr decomposition
decomp = qr[c]
log[decomp]

--- diag
v = diag[c]
log[v]

--- constants
log[pi]
log[em]
log[inf]
log[nan]

--- properties
log[b.shape]
log[b.dtype]
log[b.device]
log[b.grad]
log[b.len]

--- random and distributions
seed[42]
log[normal[0, 1, 3]]
log[uniform[2, 5, 4]]
log[poisson[3.5, 5]]
log[bernoulli[0.5, 6]]
log[shuffle[linspace[1, 5, 5]]]
log[choice[linspace[1, 10, 10], 3]]
log[permutation[5]]

--- signal processing
spec = fft[linspace[1, 4, 4]]
log[spec]
log[ifft[spec[0], spec[1]]]
log[conv[linspace[1, 3, 3], linspace[1, 2, 2]]]
log[hamming[5]]
log[hanning[5]]

--- special functions
log[gamma[linspace[1, 4, 4]]]
log[erf[linspace[0, 2, 3]]]
log[bessel[linspace[0, 3, 4], 0]]
log[factorial[linspace[0, 5, 6]]]
log[choose[linspace[5, 5, 3], linspace[0, 2, 3]]]

--- complex numbers
z = complex[3, 4]
log[real[z]]
log[imag[z]]
log[magnitude[z]]
log[phase[z]]
log[conjugate[z]]

--- sparse arrays
s = sparse[eye[3]]
log[s]
log[type[s]]
s2 = sparse[[0, 1, 2], [0, 1, 2], [5, 6, 7], [3, 3]]
r = s * [1, 2, 3]
log[r]
s3 = s + s2
log[s3]
d = dense[s3]
log[d]
x = solve[s2, [10, 12, 14]]
log[x]

--- statistics
data = linspace[1, 10, 10]
log['median:', median[data]]
log['std:', std[data]]
log['var:', var[data]]
log['p50:', percentile[data, 50]]
log['zscore:', zscore[data]]
data2 = linspace[2, 20, 10]
log['corr:', corr[data, data2]]
log['cov:', cov[data, data2]]
result = ttest[data, data2]
log['ttest:', result]

--- distributed computing
nodes[1]
log['distributed initialized']
