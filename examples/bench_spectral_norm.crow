--- spectral-norm benchmark ---
--- tests: nested loops, math, list operations, functions ---
--- NOTE: simplified since Crow lacks list mutation ---
--- computes the spectral norm approximation ---

--- A[i,j] = 1 / ((i+j)(i+j+1)/2 + i + 1) ---
fn a_element[i, j]
    return 1.0 / ((i + j) * (i + j + 1) / 2.0 + i + 1.0)

--- approximate sqrt using Newton's method ---
fn approx_sqrt[n]
    if n lte 0.0
        return 0.0
    guess = n / 2.0
    i = 0
    while i lt 15
        guess = (guess + n / guess) / 2.0
        i = i + 1
    return guess

--- multiply vector v by matrix A, return sum of result ---
--- since we can't mutate lists, we compute the dot product directly ---
fn multiply_Av_sum[n]
    total = 0.0
    i = 0
    while i lt n
        row_sum = 0.0
        j = 0
        while j lt n
            row_sum = row_sum + a_element[i, j] * 1.0
            j = j + 1
        total = total + row_sum * row_sum
        i = i + 1
    return total

--- compute approximate spectral norm for small n ---
fn spectral_norm_approx[n]
    --- compute ||A * v||^2 where v = [1, 1, ..., 1] ---
    sum_sq = 0.0
    i = 0
    while i lt n
        row_sum = 0.0
        j = 0
        while j lt n
            row_sum = row_sum + a_element[i, j]
            j = j + 1
        sum_sq = sum_sq + row_sum * row_sum
        i = i + 1
    return approx_sqrt[sum_sq]

--- run benchmarks ---
log['a_element[0,0] = {a_element[0, 0]}']
log['a_element[1,0] = {a_element[1, 0]}']
log['a_element[0,1] = {a_element[0, 1]}']
log['a_element[2,3] = {a_element[2, 3]}']

log['spectral norm approx n=10: {spectral_norm_approx[10]}']
log['spectral norm approx n=50: {spectral_norm_approx[50]}']
log['spectral norm approx n=100: {spectral_norm_approx[100]}']
log['spectral-norm benchmark complete']

