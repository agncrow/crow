--- Trading Dashboard
use web, ui, frame, math

--- Reactive data sources
positions = poll['/api/positions', 5]
trades = poll['/api/trades', 5]
playbooks = fetch['/api/playbooks']

--- Reactive UI state
filter_pb = 'all'
min_vol = 0

--- Event handlers
fn clear_filter[]
  filter_pb = 'all'
  min_vol = 0

--- Render
view render[]
  todays = filter[trades, trades.date eq today[]]
  pnl = sum[todays.pnl]
  count = len[todays]

  filtered = positions
  if filter_pb ne 'all'
    filtered = filter[filtered, filtered.playbook_code eq filter_pb]
  if min_vol gt 0
    filtered = filter[filtered, filtered.vol gte min_vol]
  filtered = sort[filtered, 'pnl', desc = true]
  top = head[filtered, 50]

  by_playbook = group[todays, 'playbook_code', ['pnl', 'sum'], ['pnl', 'count'], ['pnl', 'mean']]

  return div[
    h1['Trading Dashboard'],
    div[
      div['P&L: `pnl`'],
      div['Trades: `count`'],
      div['Positions: `len[positions]`'],
      class = 'stats'
    ],
    div[
      field['Min Volume', min_vol],
      select[unique[positions.playbook_code], filter_pb],
      class = 'controls'
    ],
    h2['Positions'],
    table[top],
    h2['P&L by Playbook'],
    table[by_playbook],
    button['Reset Filters', click = clear_filter],
    class = 'dashboard'
  ]

serve[3000]
page['/', render]
