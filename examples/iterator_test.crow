--- iterator transpiler parity test ---

--- 1. basic iter + collect ---
nums = [10, 20, 30, 40, 50]
all = collect[iter[nums]]
log['collect all: {all}']

--- 2. take ---
first3 = collect[take[iter[nums], 3]]
log['take 3: {first3}']

--- 3. skip ---
last3 = collect[skip[iter[nums], 2]]
log['skip 2: {last3}']

--- 4. take + skip chained ---
middle = collect[take[skip[iter[nums], 1], 3]]
log['skip 1 take 3: {middle}']

--- 5. each (map) ---
fn double[x]
    return x * 2

doubled = collect[each[iter[nums], double]]
log['each double: {doubled}']

--- 6. filter ---
fn big[x]
    return x gt 25

bigs = collect[filter[iter[nums], big]]
log['filter gt 25: {bigs}']

--- 7. filter + each chained ---
fn triple[x]
    return x * 3

result = collect[each[filter[iter[nums], big], triple]]
log['filter gt 25 then triple: {result}']

--- 8. each + collect on strings ---
words = ['hello', 'world', 'crow']
fn yell[s]
    return upper[s]

shouted = collect[each[iter[words], yell]]
log['each upper: {shouted}']

--- 9. skip + take on strings ---
mid_words = collect[take[skip[iter[words], 1], 1]]
log['mid word: {mid_words}']

log['all iterator tests complete']

