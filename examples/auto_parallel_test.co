--- parallelism without threads: statements run in the order written, and
--- work that should overlap is a for whose body only computes

--- count primes up to n using trial division
fn count_primes[n]
  count = 0
  i = 2
  while i lte n
    is_prime = true
    j = 2
    while j * j lte i
      if i % j eq 0
        is_prime = false
      j = j + 1
    if is_prime
      count = count + 1
    i = i + 1
  return count

--- four independent counts, one round each: nothing the body does can
--- show the order the rounds ran in, so they run across the cores
counts = for limit in [15000, 12000, 18000, 10000]
  count_primes[limit]
a = counts[0]
b = counts[1]
c = counts[2]
d = counts[3]

sum_ab = a + b
sum_cd = c + d
total = sum_ab + sum_cd

log['a (primes to 15000): `a`']
log['b (primes to 12000): `b`']
log['c (primes to 18000): `c`']
log['d (primes to 10000): `d`']
log['a + b: `sum_ab`']
log['c + d: `sum_cd`']
log['total: `total`']
