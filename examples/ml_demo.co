--- =====================================================
--- End-to-End Machine Learning in Crow
--- =====================================================

use math
use math.nn

--- =====================================================
--- Part 1: Linear Regression with Automatic Gradients
--- =====================================================
log['=== Part 1: Linear Regression (autograd) ===']
log['Learning y = 2x + 0.5 from 4 data points']

fn mse_loss[w, b]
  e1 = (1 * w + b - 2.5) * (1 * w + b - 2.5)
  e2 = (2 * w + b - 4.5) * (2 * w + b - 4.5)
  e3 = (3 * w + b - 6.5) * (3 * w + b - 6.5)
  e4 = (4 * w + b - 8.5) * (4 * w + b - 8.5)
  (e1 + e2 + e3 + e4) / 4

dmse = grad[mse_loss]

w = 0.0
b = 0.0
lr = 0.01
i = 0
while i lt 1000
  g = dmse[w, b]
  w = w - lr * g[0]
  b = b - lr * g[1]
  i = i + 1

log['w = `w` (target: 2.0)']
log['b = `b` (target: 0.5)']
log['loss = `mse_loss[w, b]`']
log['']

--- =====================================================
--- Part 2: XOR Neural Network (manual backprop)
--- 2-layer MLP: 2 inputs -> 4 hidden (sigmoid) -> 1 out
--- =====================================================
log['=== Part 2: XOR Neural Network ===']
log['2-layer MLP with sigmoid, trained with manual backprop']

--- training data: XOR truth table
x = reshape[[0, 0, 0, 1, 1, 0, 1, 1], 4, 2]
y = reshape[[0, 1, 1, 0], 4, 1]

--- initialize weights (small random)
w1 = randn[2, 4] * 0.5
b1 = zeros[4]
w2 = randn[4, 1] * 0.5
b2 = zeros[1]

lr = 2.0
sum_batch = ones[1, 4]

i = 0
while i lt 10000
  --- forward pass
  z1 = x * w1 + b1
  h = sigmoid[z1]
  z2 = h * w2 + b2
  pred = sigmoid[z2]
  loss = mse[pred, y]

  --- backward pass (chain rule)
  dpred = (pred - y) * 0.5
  dz2 = dpred .* pred .* (1 - pred)
  dw2 = transpose[h] * dz2
  db2 = reshape[sum_batch * dz2, 1] * 0.25
  dh = dz2 * transpose[w2]
  dz1 = dh .* h .* (1 - h)
  dw1 = transpose[x] * dz1
  db1 = reshape[sum_batch * dz1, 4] * 0.25

  --- gradient descent update
  w1 = w1 - lr * dw1
  b1 = b1 - lr * db1
  w2 = w2 - lr * dw2
  b2 = b2 - lr * db2

  if i % 2000 eq 0
    log['  step `i`: loss = `loss`']

  i = i + 1

--- final predictions
z1 = x * w1 + b1
h = sigmoid[z1]
z2 = h * w2 + b2
pred = sigmoid[z2]
log['']
log['predictions (target [0, 1, 1, 0]):']
log[pred]
log['final loss: `mse[pred, y]`']
