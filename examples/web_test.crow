--- Web framework integration test ---
--- Tests: route[], serve[], text[], html[], redirect[], respond[] ---

use web

--- Define route handlers ---

fn home[req]
    return text['hello from crow web']

fn about[req]
    return html['<h1>about</h1><p>crow web framework</p>']

fn not_here[req]
    return redirect['/']

fn error_page[req]
    return respond[404, 'page not found']

--- Register routes (implicit app -- no app variable in the current API)
route['/', home]
route['/about', about]
route['/redirect', not_here]
route['/error', error_page]

--- Start the server ---
log['starting server on port 3000']
serve[3000]

