--- parallel benchmark
--- compares cpu[1] vs cpu[8] on heavy computation

fn count_primes[limit]
  --- count primes up to limit using trial division
  count = 0
  n = 2
  while n lte limit
    is_prime = true
    d = 2
    while d * d lte n
      if n % d eq 0
        is_prime = false
      d = d + 1
    if is_prime
      count = count + 1
    n = n + 1
  return count

--- 8 independent heavy tasks
tasks = [15000, 12000, 18000, 10000, 20000, 8000, 16000, 14000]

--- the loops' bodies only compute, so each runs across as many threads as
--- cpu[] allows (a body that logged would run in order, on one thread)

--- run sequential: 1 thread
cpu[1]
start = now[]
results_seq = for limit in tasks
  count_primes[limit]
log['cpu[1]: `fmt[now[] - start, decimals = 2]` s, `results_seq`']

--- run parallel: 8 threads
cpu[8]
start = now[]
results_par = for limit in tasks
  count_primes[limit]
log['cpu[8]: `fmt[now[] - start, decimals = 2]` s, `results_par`']
