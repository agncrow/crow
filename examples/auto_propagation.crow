--- Auto-propagation of errors
--- Errors flow through function calls automatically

fn double[x]
  return x * 2

fn add_ten[x]
  return x + 10

--- Error propagates through function chain
bad = int['hello']
result = double[bad]
log['double status: `result.status`']
log['double reason: `result.reason`']
log['double line: `result.line`']

--- Error propagates through multiple functions
chained = add_ten[double[bad]]
log['chained status: `chained.status`']
log['chained reason: `chained.reason`']

--- Successful values work normally
good = int['42']
ok_result = double[good]
log['ok result: `ok_result`']

--- log prints errors without propagating
log['error value via log:', bad]
log['this line still runs']
