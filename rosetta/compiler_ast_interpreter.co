--- Rosetta Code: Compiler/AST interpreter
--- https://rosettacode.org/wiki/Compiler/AST_interpreter
--- Reads the syntax analyzer's flattened tree from standard input and rebuilds it as
--- records (0 for none), each variable's name turned into a slot, each integer into
--- its number and each string into the text it prints. Then it walks the tree:
--- expressions answer ints, with C's division (toward zero) and && and || that stop
--- at the left side when it decides (ints are Crow's, which do not wrap at 32 bits);
--- statements thread the variables' values and the line being printed, which is
--- logged as each line ends.
use bits

--- a node: a leaf's text and number; an inner node's children are nodes
struct Node [tag, text, number, left, right]

--- a subtree read from the listing, and the line after it
struct Loaded [node, next]

--- the variables' values, and what is printed on the line not yet ended
struct State [data, pending]

--- a string as it prints: quotes off, \n a newline, \\ a backslash
fn unescaped[text]
    chars = split[slice[text, 1, -1], '']
    out = []
    i = 0
    while i lt len[chars]
        c = chars[i]
        if c eq '\\' and i + 1 lt len[chars]
            i = i + 1
            if chars[i] eq 'n'
                c = '\n'
            else
                c = chars[i]
        out = push[out, c]
        i = i + 1
    return join[out, '']

--- each variable's slot, in the order the names first appear
fn slots_of[lines]
    slots = map[]
    for line in lines
        m = find[line, '^\s*Identifier\s+(\S+)']
        if m.ok and m.groups[1] not in slots
            slots = set[slots, m.groups[1], len[slots]]
    return slots

--- the tree whose listing starts at line i: a node, then its left and right subtrees
fn load[lines, i, slots]
    m = find[lines[i], '^\s*(\S+)\s*(.*)$']
    tag = m.groups[1]
    value = trim[m.groups[2]]
    if tag eq ';'
        return Loaded[0, i + 1]
    if tag eq 'Identifier'
        return Loaded[Node[tag, value, slots[value], 0, 0], i + 1]
    if tag eq 'Integer'
        n = int[value]
        if not n.ok
            return error['not an integer: `value`', 'interp']
        return Loaded[Node[tag, value, n, 0, 0], i + 1]
    if tag eq 'String'
        return Loaded[Node[tag, unescaped[value], 0, 0, 0], i + 1]
    left = load[lines, i + 1, slots]
    right = load[lines, left.next, slots]
    return Loaded[Node[tag, '', 0, left.node, right.node], right.next]

--- an expression's value
fn value_of[t, data]
    tag = t.tag
    if tag eq 'Integer'
        return t.number
    if tag eq 'Identifier'
        return data[t.number]
    if tag eq 'Negate'
        return -value_of[t.left, data]
    if tag eq 'Not'
        return int[value_of[t.left, data] eq 0]
    a = value_of[t.left, data]
    if tag eq 'And'
        if a eq 0
            return 0
        return int[value_of[t.right, data] ne 0]
    if tag eq 'Or'
        if a ne 0
            return 1
        return int[value_of[t.right, data] ne 0]
    b = value_of[t.right, data]
    if tag eq 'Add'
        return a + b
    if tag eq 'Subtract'
        return a - b
    if tag eq 'Multiply'
        return a * b
    if tag eq 'Divide'
        return a / b
    if tag eq 'Mod'
        return a % b
    if tag eq 'Less'
        return int[a lt b]
    if tag eq 'LessEqual'
        return int[a lte b]
    if tag eq 'Greater'
        return int[a gt b]
    if tag eq 'GreaterEqual'
        return int[a gte b]
    if tag eq 'Equal'
        return int[a eq b]
    if tag eq 'NotEqual'
        return int[a ne b]
    return error['unknown expression \'`tag`\'', 'interp']

--- the state once text is printed: each line logged as it ends, the rest kept pending
fn printing[st, text]
    lines = split['`st.pending``text`', '\n']
    for k in range[len[lines] - 1]
        log[lines[k]]
    st.pending = lines[-1]
    return st

--- the state once a variable is given a value
fn assigned[st, slot, value]
    st.data[slot] = value
    return st

--- a statement run: the state after it
fn run[t, st]
    if t eq 0
        return st
    tag = t.tag
    if tag eq 'Sequence'
        st = run[t.left, st]
        return run[t.right, st]
    if tag eq 'Assign'
        return assigned[st, t.left.number, value_of[t.right, st.data]]
    if tag eq 'If'
        if value_of[t.left, st.data] ne 0
            return run[t.right.left, st]
        return run[t.right.right, st]
    if tag eq 'While'
        while value_of[t.left, st.data] ne 0
            st = run[t.right, st]
        return st
    if tag eq 'Prts'
        return printing[st, t.left.text]
    if tag eq 'Prti'
        return printing[st, str[value_of[t.left, st.data]]]
    if tag eq 'Prtc'
        return printing[st, char[value_of[t.left, st.data]]]
    return error['unknown statement \'`tag`\'', 'interp']

lines = []
line = input[]
while line.ok
    if trim[line] ne ''
        lines = push[lines, line]
    line = input[]
slots = slots_of[lines]
tree = load[lines, 0, slots]
if not tree.ok
    log['error: `tree.reason`']
else
    data = for name in keys[slots]
        0
    done = run[tree.node, State[data, '']]
    if not done.ok
        log['error: `done.reason`']
    else if done.pending ne ''
        log[done.pending]
