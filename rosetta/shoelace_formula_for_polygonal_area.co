--- Rosetta Code: Shoelace formula for polygonal area
--- https://rosettacode.org/wiki/Shoelace_formula_for_polygonal_area
--- The task's formula as it is written: the sum of x[i] y[i+1] around the polygon
--- and the sum of x[i+1] y[i], the last vertex joined back to the first; the area
--- is half the size of their difference, whichever way round the points go.

struct Point [x, y]

fn shoelace[points]
    n = len[points]
    down = 0
    up = 0
    for i in range[n]
        p = points[i]
        q = points[(i + 1) % n]
        down = down + p.x * q.y
        up = up + q.x * p.y
    return abs[down - up] / 2.0

fn listed[points]
    parts = for p in points
        '(`p.x`, `p.y`)'
    return join[parts, ', ']

fn report[points]
    log['`listed[points]`: area `shoelace[points]`']

log['The task\'s polygon:']
report[[Point[3, 4], Point[5, 11], Point[12, 8], Point[9, 5], Point[5, 6]]]
log['']
log['The same points the other way round, and a few more:']
report[[Point[5, 6], Point[9, 5], Point[12, 8], Point[5, 11], Point[3, 4]]]
report[[Point[0, 0], Point[1, 0], Point[1, 1], Point[0, 1]]]
report[[Point[0, 0], Point[1, 0], Point[0, 1]]]
report[[Point[0, 0], Point[4, 0], Point[4, 3], Point[2, 1], Point[0, 3]]]
report[[Point[-1.5, 0], Point[0, 2.5], Point[1.5, 0], Point[0, -2.5]]]
