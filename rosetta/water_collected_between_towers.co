--- Rosetta Code: Water collected between towers
--- https://rosettacode.org/wiki/Water_collected_between_towers
--- Water stands over a tower up to the lower of the highest towers on its two sides
--- (each side counting the tower itself): two passes find the highest to the left
--- and to the right of every tower, and the water is what those levels leave above
--- the towers. Each chart is drawn as the task draws it, towers ██ and water ≈≈.

fn levels[towers]
    n = len[towers]
    left = towers
    for i in range[1, n]
        left[i] = max[left[i - 1], towers[i]]
    right = towers
    i = n - 2
    while i gte 0
        right[i] = max[right[i + 1], towers[i]]
        i = i - 1
    level = for i in range[n]
        min[left[i], right[i]]
    return level

fn water[towers]
    level = levels[towers]
    total = 0
    for i in range[len[towers]]
        total = total + level[i] - towers[i]
    return total

fn draw[towers]
    level = levels[towers]
    top = 0
    for h in towers
        top = max[top, h]
    row = top
    while row gte 1
        cells = for i in range[len[towers]]
            if towers[i] gte row
                '██'
            else if level[i] gte row
                '≈≈'
            else
                '  '
        line = trim_end[join[cells, '']]
        log['`fmt[row, width = 2]` `line`']
        row = row - 1

fn trim_end[text]
    letters = split[text, '']
    last = len[letters] - 1
    while last gte 0 and letters[last] eq ' '
        last = last - 1
    return join[slice[letters, 0, last + 1], '']

--- the series are of different lengths, so the list of them is grown (a nested
--- literal of numbers is a matrix)
series = []
series = push[series, [1, 5, 3, 7, 2]]
series = push[series, [5, 3, 7, 2, 6, 4, 5, 9, 1, 2]]
series = push[series, [2, 6, 3, 5, 2, 8, 1, 4, 2, 2, 5, 3, 5, 7, 4, 1]]
series = push[series, [5, 5, 5, 5]]
series = push[series, [5, 6, 7, 8]]
series = push[series, [8, 7, 7, 6]]
series = push[series, [6, 7, 10, 7, 6]]
for towers in series
    log['`str[towers]`: `water[towers]` units of water']
for towers in series
    log['']
    log[str[towers]]
    draw[towers]
