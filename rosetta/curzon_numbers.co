--- Rosetta Code: Curzon numbers
--- https://rosettacode.org/wiki/Curzon_numbers
--- n is a generalized Curzon number of base k when k^n + 1 is divisible by k*n + 1,
--- that is when k^n mod (k*n + 1) is k*n; the power is taken by repeated squaring.

fn power_mod[b, e, m]
    --- b^e mod m by repeated squaring
    result = 1
    b = b % m
    while e gt 0
        if e % 2 eq 1
            result = result * b % m
        b = b * b % m
        e = e / 2
    return result

fn is_curzon[n, k]
    r = k * n
    return power_mod[k, n, r + 1] eq r

fn curzons[k, count]
    --- the first `count` generalized Curzon numbers of base k
    found = []
    n = 1
    while len[found] lt count
        if is_curzon[n, k]
            found = push[found, n]
        n = n + 1
    return found

for k in range[2, 11, 2]
    numbers = curzons[k, 1000]
    log['The first 50 generalized Curzon numbers of base `k`:']
    for row in range[0, 50, 10]
        cells = for c in slice[numbers, row, row + 10]
            fmt[c, width = 5]
        log[join[cells, ' ']]
    log['The one thousandth: `numbers[999]`']
    log['']
