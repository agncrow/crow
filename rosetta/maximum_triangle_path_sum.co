--- Rosetta Code: Maximum triangle path sum
--- https://rosettacode.org/wiki/Maximum_triangle_path_sum
--- From the bottom row up, each number takes on the larger of the two totals below it,
--- so the top ends up holding the best total; the path is then walked down again.

fn rows_of[text]
    rows = []
    for line in split[text, '\n']
        if trim[line] ne ''
            numbers = for word in split[trim[line], ' ']
                int[word]
            rows = push[rows, numbers]
    return rows

--- best[r][i]: the largest total of a walk from row r, place i, to the bottom.
--- (The table is grown by push and turned over at the end: a list literal holding a
--- row of numbers read from text, [rows[-1]], is an internal error,
--- findings/maximum_triangle_path_sum-1.co.)
fn best_totals[rows]
    below = rows[-1]
    table = []
    table = push[table, below]
    r = len[rows] - 2
    while r gte 0
        below = for i in range[len[rows[r]]]
            rows[r][i] + max[below[i], below[i + 1]]
        table = push[table, below]
        r = r - 1
    return reverse[table]

fn best_path[rows, best]
    i = 0
    steps = []
    for r in range[len[rows]]
        if r gt 0 and best[r][i + 1] gt best[r][i]
            i = i + 1
        steps = push[steps, str[rows[r][i]]]
    return join[steps, ' + ']

fn report[text]
    rows = rows_of[text]
    best = best_totals[rows]
    log['`len[rows]` rows: the maximum total is `best[0][0]`']
    log['  `best_path[rows, best]`']

report['
    55
   94 48
  95 30 96
 77 71 26 67
']

