--- Rosetta Code: Range consolidation
--- https://rosettacode.org/wiki/Range_consolidation
--- Each range is normalized (the smaller bound first), the ranges are taken in
--- the order of their lower bounds, and a range that starts at or before the end
--- of the one being built joins it; any other starts a new one.

use math

struct Span [lo, hi]

fn normalized[r]
    return Span[min[r[0], r[1]], max[r[0], r[1]]]

fn consolidated[ranges]
    spans = for r in ranges
        normalized[r]
    lows = for s in spans
        s.lo
    merged = []
    for i in argsort[lows]
        s = spans[i]
        if len[merged] gt 0 and s.lo lte merged[-1].hi
            last = merged[-1]
            merged[-1] = Span[last.lo, max[last.hi, s.hi]]
        else
            merged = push[merged, s]
    return merged

fn shown[spans]
    parts = for s in spans
        '[`s.lo`, `s.hi`]'
    return join[parts, ', ']

fn written[ranges]
    parts = for r in ranges
        '[`r[0]`, `r[1]`]'
    return join[parts, ', ']

fn report[ranges]
    given = fmt[written[ranges], width = 44, align = 'right']
    log['`given`  ->  `shown[consolidated[ranges]]`']

log['The task\'s examples:']
report[[[1, 2.5], [3, 4.2]]]
report[[[1, 2.5], [1.8, 4.7]]]
report[[[6.1, 7.2], [7.2, 8.3]]]
report[[[1, 2], [4, 8], [2, 5]]]
log['']
log['The five sets of ranges:']
report[[[1.1, 2.2]]]
report[[[6.1, 7.2], [7.2, 8.3]]]
report[[[4, 3], [2, 1]]]
report[[[4, 3], [2, 1], [-1, -2], [3.9, 10]]]
report[[[1, 3], [-6, -1], [-4, -5], [8, 2], [-6, -6]]]
log['']
log['One range inside another, and ranges given high bound first:']
report[[[1, 10], [2, 3], [10, 9.5], [-0.5, -3.25]]]
