--- Rosetta Code: McNuggets problem
--- https://rosettacode.org/wiki/McNuggets_problem
--- n nuggets can be bought when n - 6, n - 9 or n - 20 can (and 0 can): fill that in from
--- 0 up to the limit; the largest number left out is the answer.

fn buyable[limit, boxes]
    can = for n in range[limit + 1]
        n eq 0
    for n in range[1, limit + 1]
        for b in boxes
            if n gte b and can[n - b]
                can[n] = true
    return can

--- One way to make n as 6x + 9y + 20z, as text.
fn boxes_for[n]
    found = ''
    z = 0
    while z * 20 lte n and found eq ''
        y = 0
        while z * 20 + y * 9 lte n and found eq ''
            rest = n - z * 20 - y * 9
            if rest % 6 eq 0
                found = '6 x `rest / 6` + 9 x `y` + 20 x `z`'
            y = y + 1
        z = z + 1
    return found

can = buyable[100, [6, 9, 20]]
cannot = for n in range[101]
    if not can[n]
        str[n]
log['Numbers of nuggets that boxes of 6, 9 and 20 cannot make, up to 100:']
log[join[cannot, ' ']]
log['The largest non-McNuggets number: `cannot[-1]`']
log['']
log['Six in a row can be made, so every larger number can too (add boxes of 6):']
for n in range[44, 50]
    log['`n` = `boxes_for[n]`']
