--- Rosetta Code: Damm algorithm
--- https://rosettacode.org/wiki/Damm_algorithm
--- The interim digit starts at 0 and each digit moves it through Damm's table (a
--- totally anti-symmetric quasigroup of order 10); a number whose last digit is its
--- check digit ends at 0. The check digit of a number is where its digits end.

fn table[]
    return [
        [0, 3, 1, 7, 5, 9, 8, 6, 4, 2],
        [7, 0, 9, 2, 1, 5, 4, 8, 6, 3],
        [4, 2, 0, 6, 8, 7, 1, 3, 5, 9],
        [1, 7, 5, 0, 9, 8, 3, 4, 2, 6],
        [6, 1, 2, 3, 0, 4, 5, 9, 7, 8],
        [3, 6, 7, 4, 2, 0, 9, 5, 8, 1],
        [5, 8, 6, 9, 7, 2, 0, 1, 3, 4],
        [8, 9, 4, 5, 3, 6, 2, 0, 1, 7],
        [9, 4, 3, 8, 6, 1, 7, 2, 0, 5],
        [2, 5, 8, 1, 4, 3, 6, 7, 9, 0]
    ]

fn interim[digits]
    --- where the digits of the text `digits` take the interim digit
    t = table[]
    row = 0
    for d in split[digits, '']
        row = t[row][int[d]]
    return row

fn valid[number]
    return interim[str[number]] eq 0

fn check_digit[number]
    return interim[str[number]]

for number in [5724, 5727, 112946, 112949]
    if valid[number]
        log['`fmt[number, width = 7]` is valid']
    else
        log['`fmt[number, width = 7]` is invalid']

log['']
for number in [572, 11294, 2026, 1234567890]
    log['the check digit of `number` is `check_digit[number]`, making `number``check_digit[number]`']
