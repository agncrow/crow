--- Rosetta Code: Product of min and max prime factors
--- https://rosettacode.org/wiki/Product_of_min_and_max_prime_factors
--- The smallest prime factor is the first divisor from 2 up; the largest is the last one
--- left when the smallest is divided out again and again. The term for 1 is 1, as the
--- task defines it.

--- the smallest prime factor of n (n > 1)
fn least_factor[n]
    d = 2
    while d * d lte n
        if n % d eq 0
            return d
        d = d + 1
    return n

--- the largest prime factor of n (n > 1)
fn greatest_factor[n]
    p = least_factor[n]
    while p ne n
        n = n / p
        p = least_factor[n]
    return n

fn product[n]
    if n eq 1
        return 1
    return least_factor[n] * greatest_factor[n]

terms = for n in range[1, 101]
    product[n]
log['Product of the smallest and largest prime factors of 1 to 100:']
for row in range[10]
    cells = for t in slice[terms, 10 * row, 10 * row + 10]
        fmt[t, width = 5]
    log[join[cells, '']]
