5 ^ 3 ^ 2   = 1953125
(5 ^ 3) ^ 2 = 15625
5 ^ (3 ^ 2) = 1953125

The same order elsewhere:
5.0 ^ 3.0 ^ 2.0           = 1953125.0  (floats)
decimal[5] ^ 3 ^ 2        = 1953125  (an exact decimal)
fraction[1, 5] ^ 3 ^ 2    = 1/1953125  (an exact fraction)
2 ^ 3 ^ 4                 = 2417851639229258349412352  (2 ^ 81: ints grow)
2 ^ 2 ^ 2 ^ 2             = 65536
-5 ^ 3 ^ 2                = -1953125  (a power binds tighter than a minus)
5.0 ^ -3 ^ 2              = 0.000000512  (5 ^ -(3 ^ 2): an exponent may carry a sign)
[5, 6, 7] .^ 3 ^ 2        = [1953125, 10077696, 40353607]
([5, 6, 7] .^ 3) .^ 2     = [15625, 46656, 117649]
