--- Rosetta Code: Include a file — the file that is included
--- https://rosettacode.org/wiki/Include_a_file
--- include_a_file.co includes this file with `use include_a_file_lib`. What it
--- brings is its declarations: a value, a record and functions. A module's
--- top-level statements other than declarations are not part of the program
--- that uses it, so run alone this file prints nothing.

greeting = 'Hello from include_a_file_lib.co'

struct Point [x, y]

fn origin[]
    return Point[0, 0]

fn moved[p, dx, dy]
    return Point[p.x + dx, p.y + dy]

fn distance[p, q]
    return sqrt[float[(p.x - q.x) ^ 2 + (p.y - q.y) ^ 2]]

fn shout[text]
    return '`upper[text]`!'
