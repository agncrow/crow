--- Rosetta Code: Execute SNUSP
--- https://rosettacode.org/wiki/Execute_SNUSP
--- RCSNUSP in Crow: Core SNUSP ($ \ / + - < > , . ! ?) and Modular SNUSP's @
--- and # (no Bloated SNUSP). The program is a grid of characters, padded with
--- spaces to a rectangle; the instruction pointer starts at the first $ (or the
--- top left corner) moving right and the program ends when it leaves the grid,
--- or at a # with nothing on the call stack. @ pushes where it stands and the
--- way it moves; # pops them and skips one instruction from there. Cells are
--- 8 bits on a tape that grows to the right; input comes from a text handed to
--- run, and , stores 0 at its end. In the sources every \ is written \\.
use bits

struct Spot [row, col, dr, dc]

fn grid_of[lines]
    --- each line's characters, padded with spaces to the longest line's width
    width = 0
    for line in lines
        width = max[width, len[line]]
    rows = for line in lines
        pad = repeat[' ', width - len[line]]
        split['`line``pad`', '']
    return rows

fn start_of[grid]
    --- the first $, row by row; the top left corner when there is none
    r = 0
    while r lt len[grid]
        c = 0
        while c lt len[grid[r]]
            if grid[r][c] eq '$'
                return [r, c]
            c = c + 1
        r = r + 1
    return [0, 0]

fn run[lines, feed]
    --- what the program prints, as text
    grid = grid_of[lines]
    at = start_of[grid]
    r = at[0]
    c = at[1]
    dr = 0
    dc = 1
    cells = [0]
    ptr = 0
    calls = []
    given = split[feed, '']
    taken = 0
    out = []
    going = true
    while going and r gte 0 and r lt len[grid] and c gte 0 and c lt len[grid[0]]
        op = grid[r][c]
        skip = 0
        if op eq '>'
            ptr = ptr + 1
            if ptr eq len[cells]
                cells = push[cells, 0]
        else if op eq '<'
            if ptr eq 0
                halt['the memory pointer moved left of the first cell']
            ptr = ptr - 1
        else if op eq '+'
            cells[ptr] = (cells[ptr] + 1) % 256
        else if op eq '-'
            cells[ptr] = (cells[ptr] + 255) % 256
        else if op eq '.'
            out = push[out, char[cells[ptr]]]
        else if op eq ','
            if taken lt len[given]
                cells[ptr] = code[given[taken]] % 256
                taken = taken + 1
            else
                cells[ptr] = 0
        else if op eq '/'
            turned = dr
            dr = -dc
            dc = -turned
        else if op eq '\\'
            turned = dr
            dr = dc
            dc = turned
        else if op eq '!'
            skip = 1
        else if op eq '?'
            if cells[ptr] eq 0
                skip = 1
        else if op eq '@'
            calls = push[calls, Spot[r, c, dr, dc]]
        else if op eq '#'
            if len[calls] eq 0
                going = false
            else
                back = calls[-1]
                calls = pop[calls]
                r = back.row
                c = back.col
                dr = back.dr
                dc = back.dc
                skip = 1
        r = r + dr * (1 + skip)
        c = c + dc * (1 + skip)
    return join[out, '']

fn show[title, lines, feed]
    log['`title`:']
    for line in lines
        log['    `line`']
    printed = run[lines, feed]
    if feed ne ''
        log['  given `feed`, it prints:']
    else
        log['  it prints:']
    for line in split[trim[printed], '\n']
        log['    `line`']

hello = [
    '/++++!/===========?\\>++.>+.+++++++..+++\\',
    '\\+++\\ | /+>+++++++>/ /++++++++++<<.++>./',
    '$+++/ | \\+++++++++>\\ \\+++++.>.+++.-----\\',
    '      \\==-<<<<+>+++/ /=.>.+>.--------.-/'
]
show['Hello World (the RCSNUSP sample)', hello, '']

--- two loops: 6 * 8 makes a 0, then ten rounds print and step it
digits = [
    '$++++++!/>++++++++<-?\\=++++++++++!/>.+<-?\\=>>++++++++++.',
    '        \\============/            \\======/'
]
log['']
show['Two loops (Core SNUSP)', digits, '']

--- Modular SNUSP: the Julia entry's echo, which calls its ECHO routine twice
echo = [
    '       /==!/======ECHO==,==.==#',
    '       |   |',
    '$==>==@/==@/==<==#'
]
log['']
show['Echo twice (Modular SNUSP)', echo, 'Hi']

--- Modular SNUSP: 13 * 5 makes an A, then three calls of PRINT print and step it
calls = [
    '                            /==!/==!/==PRINT==.+==#',
    '                            |   |   |',
    '$+++++++++++++!/>+++++<-?\\>@/==@/==@/==<++++++++++.#',
    '               \\=========/'
]
log['']
show['Three calls (Modular SNUSP)', calls, '']
