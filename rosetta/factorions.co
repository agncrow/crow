--- Rosetta Code: Factorions
--- https://rosettacode.org/wiki/Factorions
--- The sum of the factorials of the digits of i, in base b, is that sum for i / b (i
--- without its last digit) plus the factorial of i % b: one table entry per number.

--- 0!, 1!, ..., (n - 1)!
fn factorials[n]
    fact = [1]
    i = 1
    while i lt n
        fact = push[fact, fact[i - 1] * i]
        i = i + 1
    return fact

--- the numbers below limit equal to the sum of the factorials of their digits in base
fn factorions[base, limit]
    fact = factorials[base]
    sums = [0]
    found = []
    i = 1
    while i lt limit
        total = sums[i / base] + fact[i % base]
        sums = push[sums, total]
        if total eq i
            found = push[found, i]
        i = i + 1
    return found

for base in [9, 10, 11, 12]
    found = factorions[base, 1500000]
    shown = join[found, ' ']
    log['The `len[found]` factorions for base `base` are: `shown`']
