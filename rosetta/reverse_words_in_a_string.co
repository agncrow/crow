--- Rosetta Code: Reverse words in a string
--- https://rosettacode.org/wiki/Reverse_words_in_a_string
--- Each run of white space in a line becomes one space, the line is split into its
--- tokens there, and they are joined again in reverse order; a line with no tokens
--- comes out empty.

fn reversed_words[line]
    pieces = split[trim[sub[line, '\s+', ' ']], ' ']
    tokens = for piece in pieces
        if piece ne ''
            piece
    return join[reverse[tokens], ' ']

log[reversed_words['Hey you, Bub! ']]
log[reversed_words['  runs of\t white   space\tbecome one  ']]
log[reversed_words['    ']]
log['']

lines = ['---------- Ice and Fire ------------', '', 'fire, in end will world the say Some', 'ice. in say Some', 'desire of tasted I\'ve what From', 'fire. favor who those with hold I', '', '... elided paragraph last ...', '', 'Frost Robert -----------------------']
for line in lines
    log[reversed_words[line]]
