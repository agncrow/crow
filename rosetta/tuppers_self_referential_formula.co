--- Rosetta Code: Tupper's self-referential formula
--- https://rosettacode.org/wiki/Tupper's_self-referential_formula
--- The inequality is evaluated at every whole point 0 ≤ x < 106, k ≤ y < k + 17,
--- with ints that grow (k has 543 digits; the powers of two reach 2^1801), and
--- drawn in characters, as the Python entry draws it: y = k on the top line and
--- x = 105 on the left. Then the epilogue: a 17-line picture of my own encoded
--- as its k and drawn back by the same formula, and the formula's own picture
--- encoded back to the task's k.

--- 1/2 < ⌊mod(⌊y/17⌋ 2^(−17⌊x⌋ − mod(⌊y⌋, 17)), 2)⌋ for whole x and y, where a
--- product with a power of a half is a division by a power of two, floored
fn tupper[x, y]
    return fraction[1, 2] lt y / 17 / 2 ^ (17 * x + y % 17) % 2

fn pixel[on]
    if on
        return '█'
    return ' '

--- the picture of the plot of width `width` from k: a line per y, top down
fn drawing[k, width]
    lines = for j in range[17]
        cells = for x in range[width - 1, -1, -1]
            pixel[tupper[x, k + j]]
        sub[join[cells, ''], ' +$', '']
    return lines

--- the k whose plot draws `lines` (17 of them, `width` wide, read as drawn)
fn encoded[lines, width]
    n = 0
    for j in range[17]
        cs = split[lines[j], '']
        for c in range[len[cs]]
            if cs[c] ne ' '
                n = n + 2 ^ (17 * (width - 1 - c) + j)
    return 17 * n

k = 

picture = drawing[k, 106]
for line in picture
    log[line]
log['']
log['The picture encoded back gives the task\'s k: `encoded[picture, 106] eq k`']
log['']

--- the word, seven lines high, in the middle of the seventeen
mine = [
    '',
    '',
    '',
    '',
    '',
    '',
    ' ###  ####   ###  #   #',
    '#   # #   # #   # #   #',
    '#     #   # #   # #   #',
    '#     ####  #   # # # #',
    '#     # #   #   # # # #',
    '#   # #  #  #   # ## ##',
    ' ###  #   #  ###  #   #',
    '',
    '',
    '',
    ''
]
crow_k = encoded[mine, 24]
log['A picture of my own, 24 wide, is k = `crow_k`, which draws:']
bar = repeat['─', 24]
log['┌`bar`┐']
for line in drawing[crow_k, 24]
    padded = fmt[line, width = 24]
    log['│`padded`│']
log['└`bar`┘']
