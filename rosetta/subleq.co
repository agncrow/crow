--- Rosetta Code: Subleq
--- https://rosettacode.org/wiki/Subleq
--- The machine's memory is a list of ints (an int grows, so every word fits), loaded from
--- machine code: decimal numbers parted by any white space. Standard input is read a line at
--- a time and handed to the machine a character at a time, each line with its line break and
--- -1 after the last; what the machine writes is gathered and logged a line at a time. Given
--- a file on the command line, its machine code runs; otherwise the task's Hello, world! runs,
--- then a program written here for the input side, which writes what it reads in capitals
--- (subleq.in feeds it).

use bits

--- the words of machine code as ints, or why they are none
fn loaded[code_text]
    pieces = split[sub[trim[code_text], '\\s+', ' '], ' ']
    memory = []
    for piece in pieces
        n = int[piece]
        if not n.ok
            return error['\'`piece`\' is no number of machine code', 'subleq']
        memory = push[memory, n]
    return memory

--- the character a machine writes, or ? for a number that is none
fn shown[n]
    if n lt 0 or n gt 1114111 or (n gte 55296 and n lte 57343)
        return '?'
    return char[n]

--- memory grown with zeros so that the address is in it
fn reaching[memory, address]
    while len[memory] lte address
        memory = push[memory, 0]
    return memory

--- the machine run from address 0 until the instruction pointer goes below 0
fn run[memory]
    ip = 0
    pending = []
    taken = 0
    ended = false
    line = ''
    while ip gte 0
        memory = reaching[memory, ip + 2]
        a = memory[ip]
        b = memory[ip + 1]
        c = memory[ip + 2]
        ip = ip + 3
        if a eq -1
            if taken eq len[pending] and not ended
                got = input[]
                if got.ok
                    pending = push[split[got, ''], '\n']
                    taken = 0
                else
                    ended = true
            memory = reaching[memory, b]
            if taken lt len[pending]
                memory[b] = code[pending[taken]]
                taken = taken + 1
            else
                memory[b] = -1
        else if b eq -1
            memory = reaching[memory, a]
            if memory[a] eq 10
                log[line]
                line = ''
            else
                line = '`line``shown[memory[a]]`'
        else if a lt 0 or b lt 0
            halt['subleq: address `min[a, b]` at `ip - 3` is outside the memory']
        else
            memory = reaching[memory, max[a, b]]
            memory[b] = memory[b] - memory[a]
            if memory[b] lte 0
                ip = c
    if line ne ''
        log[line]

hello = '15 17 -1 17 -1 -1 16 1 -1 16 3 -1 15 15 0 0 -1 72 101 108 108 111 44 32 119 111 114 108 100 33 10 0'

--- reads characters to the end of input, writes each a to z as A to Z and the others as they came:
---  0  -1  X  3     X = the next character        30  C32  X  33   X = X - 32
---  3   T  T  6     T = 0                         33   X  -1  36   write X
---  6   X  T  12    T = -X; X at least 0: to 12   36   Z   Z  0    back to 0
---  9   Z  Z  -1    the end of input: halt
--- 12 M97  T  18    T = 97 - X; X at least 97: to 18
--- 15   Z  Z  33    else to 33
--- 18   U  U  21    U = 0
--- 21   T  U  24    U = X - 97
--- 24 C25  U  30    U = X - 122; X at most 122: to 30
--- 27   Z  Z  33    else to 33
--- with X, T, U, Z at 39 to 42, and -97, 25 and 32 at 43 to 45
capitals = '-1 39 3  40 40 6  39 40 12  42 42 -1  43 40 18  42 42 33  41 41 21  40 41 24
    44 41 30  42 42 33  45 39 33  39 -1 36  42 42 0  0 0 0 0 -97 25 32'

--- machine code loaded and run, or why it cannot be
fn load_and_run[code_text]
    memory = loaded[code_text]
    if memory.ok
        run[memory]
    else
        log['subleq: `memory.reason`']

given = args[]
if len[given] gt 0
    code_text = read[given[0]]
    if code_text.ok
        load_and_run[code_text]
    else
        log['subleq: `code_text.reason`']
else
    load_and_run[hello]
    load_and_run[capitals]
