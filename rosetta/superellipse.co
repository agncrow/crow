--- Rosetta Code: Superellipse
--- https://rosettacode.org/wiki/Superellipse
--- The curve |x/a|^n + |y/b|^n = 1 is traced through x = a cos(t)^(2/n) and
--- y = b sin(t)^(2/n), each power keeping its base's sign. With n = 2.5 and
--- a = b = 200 it is drawn as an SVG image, superellipse.svg, a polygon of 360
--- points written to the current directory and removed at the end unless the
--- program is given the argument keep. Crow draws on no screen of its own, so the
--- console shows the curve in characters: a cell is marked where its centre lies
--- inside the curve and a neighbour's does not.

use math

--- v ^ p with the sign of v
fn signed_power[v, p]
    if v lt 0.0
        return 0.0 - (0.0 - v) ^ p
    return v ^ p

fn point[t, n, a, b]
    return [a * signed_power[cos[t], 2.0 / n], b * signed_power[sin[t], 2.0 / n]]

fn inside[x, y, n, a, b]
    return abs[x / a] ^ n + abs[y / b] ^ n lte 1.0

fn at[value]
    return fmt[value, decimals = 2]

--- the curve as SVG, centred on a square of the given side, y downwards
fn svg[n, a, b, side, count]
    points = for k in range[count]
        p = point[2.0 * pi * k / count, n, a, b]
        '`at[side / 2.0 + p[0]]`,`at[side / 2.0 - p[1]]`'
    joined = join[points, ' ']
    lines = ['<svg xmlns="http://www.w3.org/2000/svg" width="`side`" height="`side`" viewBox="0 0 `side` `side`">']
    lines = push[lines, '<rect width="100%" height="100%" fill="white"/>']
    lines = push[lines, '<polygon points="`joined`" fill="#dbe9f6" stroke="#1f4e79" stroke-width="2"/>']
    lines = push[lines, '</svg>']
    text = join[lines, '\n']
    return '`text`\n'

--- the curve in characters: rows of the given number, each column half a row high
fn picture[n, a, b, rows]
    columns = 2 * rows
    cell_x = 2.0 * a / columns
    cell_y = 2.0 * b / rows
    lines = for r in range[rows]
        y = b - (r + 0.5) * cell_y
        cells = for c in range[columns]
            x = -a + (c + 0.5) * cell_x
            edge = not inside[x - cell_x, y, n, a, b] or not inside[x + cell_x, y, n, a, b]
            edge = edge or not inside[x, y - cell_y, n, a, b] or not inside[x, y + cell_y, n, a, b]
            if inside[x, y, n, a, b] and edge
                '*'
            else
                ' '
        line = join[cells, '']
        while ends[line, ' ']
            line = slice[line, 0, len[line] - 1]
        line
    return lines

n = 2.5
a = 200.0
b = 200.0
side = 440
saved = write['superellipse.svg', svg[n, a, b, side, 360]]
if not saved.ok
    halt['superellipse.svg could not be written: `saved.reason`']
log['superellipse.svg: |x/`a`|^`n` + |y/`b`|^`n` = 1 on a square of `side` pixels']
log['']
for line in picture[n, a, b, 30]
    log[line]

given = args[]
if 'keep' not in given
    removed = rm['superellipse.svg']
    if not removed.ok
        halt['superellipse.svg could not be removed: `removed.reason`']
