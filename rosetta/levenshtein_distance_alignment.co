--- Rosetta Code: Levenshtein distance/Alignment
--- https://rosettacode.org/wiki/Levenshtein_distance/Alignment
--- The whole dynamic-programming table, then a walk back from its far corner: a step
--- up and left is a match or a substitution, up a deletion (a '-' in the second line),
--- left an insertion (a '-' in the first). A third line marks each edit with '|'.

struct Alignment [top, bottom, distance]

--- The table: costs[i][j] is the distance from a's first i characters to b's first j.
fn costs_of[xs, ys]
    costs = [range[len[ys] + 1]]
    i = 1
    while i lte len[xs]
        row = [i]
        j = 1
        while j lte len[ys]
            substitution = costs[i - 1][j - 1]
            if xs[i - 1] ne ys[j - 1]
                substitution = substitution + 1
            row = push[row, min[min[costs[i - 1][j] + 1, row[j - 1] + 1], substitution]]
            j = j + 1
        costs = push[costs, row]
        i = i + 1
    return costs

fn align[a, b]
    xs = split[a, '']
    ys = split[b, '']
    costs = costs_of[xs, ys]
    top = []
    bottom = []
    i = len[xs]
    j = len[ys]
    while i gt 0 or j gt 0
        diagonal = false
        if i gt 0 and j gt 0
            step = 1
            if xs[i - 1] eq ys[j - 1]
                step = 0
            diagonal = costs[i][j] eq costs[i - 1][j - 1] + step
        if diagonal
            top = push[top, xs[i - 1]]
            bottom = push[bottom, ys[j - 1]]
            i = i - 1
            j = j - 1
        else if i gt 0 and costs[i][j] eq costs[i - 1][j] + 1
            top = push[top, xs[i - 1]]
            bottom = push[bottom, '-']
            i = i - 1
        else
            top = push[top, '-']
            bottom = push[bottom, ys[j - 1]]
            j = j - 1
    return Alignment[join[reverse[top], ''], join[reverse[bottom], ''], costs[-1][-1]]

--- '|' under each column where the two lines differ, one per edit (none past the last).
fn edits[t]
    tops = split[t.top, '']
    bottoms = split[t.bottom, '']
    last = len[tops] - 1
    while last gte 0 and tops[last] eq bottoms[last]
        last = last - 1
    marks = for k in range[last + 1]
        if tops[k] eq bottoms[k]
            ' '
        else
            '|'
    return join[marks, '']

fn show[a, b]
    t = align[a, b]
    log['"`a`" -> "`b`", distance `t.distance`:']
    log[t.top]
    log[t.bottom]
    log[edits[t]]

pairs = [['place', 'palace'], ['rosettacode', 'raisethysword'], ['kitten', 'sitting'],
    ['sunday', 'saturday'], ['abc', '']]
for k in range[len[pairs]]
    if k gt 0
        log['']
    show[pairs[k][0], pairs[k][1]]
