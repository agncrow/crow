--- Rosetta Code: Left factorials
--- https://rosettacode.org/wiki/Left_factorials
--- !n = 0! + 1! + ... + (n - 1)!: one walk up k keeps k! and the running sum !k, both
--- ints that keep every digit, and takes the sum at each n asked for.

--- The left factorials !n for each n of wanted, in ascending order.
fn left_factorials[wanted]
    found = []
    fact = 1
    total = 0
    k = 0
    i = 0
    while i lt len[wanted]
        if k eq wanted[i]
            found = push[found, total]
            i = i + 1
        else
            total = total + fact
            k = k + 1
            fact = fact * k
    return found

small = range[11]
tens = range[20, 111, 10]
thousands = range[1000, 10001, 1000]
lefts = left_factorials[concat[concat[small, tens], thousands]]

log['Left factorials 0 through 10:']
for i in range[len[small]]
    log['!`fmt[small[i], width = 2, align = \'left\']` = `lefts[i]`']
log['']
log['Left factorials 20 through 110 by tens:']
for i in range[len[tens]]
    log['!`fmt[tens[i], width = 3, align = \'left\']` = `lefts[len[small] + i]`']
log['']
log['Digits of the left factorials 1,000 through 10,000 by thousands:']
for i in range[len[thousands]]
    digits = len[str[lefts[len[small] + len[tens] + i]]]
    log['!`fmt[thousands[i], width = 5, align = \'left\']` has `fmt[digits, width = 5]` digits']
