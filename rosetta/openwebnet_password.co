--- Rosetta Code: OpenWebNet password
--- https://rosettacode.org/wiki/OpenWebNet_password
--- The gateway's "password open" is a 32-bit number scrambled by each digit of
--- the nonce in turn: 1 to 6 turn its bits, 7 and 8 reorder its bytes, 9 flips
--- every bit and 0 keeps it. Leading zeros of the nonce leave the start at 0.

use bits

fn low32[x]
    return bitand[x, 2 ^ 32 - 1]

--- x's 32 bits turned right by n places, the low bits coming round to the top
fn turned_right[x, n]
    return bitor[shift[x, -n], low32[shift[x, 32 - n]]]

fn turned_left[x, n]
    return turned_right[x, 32 - n]

--- x's four bytes, the highest first
fn bytes_of[x]
    return [shift[x, -24], bitand[shift[x, -16], 255], bitand[shift[x, -8], 255], bitand[x, 255]]

fn from_bytes[b]
    return ((b[0] * 256 + b[1]) * 256 + b[2]) * 256 + b[3]

--- the number after one digit of the nonce
fn scrambled[x, digit]
    b = bytes_of[x]
    if digit eq '1'
        return turned_right[x, 7]
    else if digit eq '2'
        return turned_right[x, 4]
    else if digit eq '3'
        return turned_right[x, 3]
    else if digit eq '4'
        return turned_left[x, 1]
    else if digit eq '5'
        return turned_left[x, 5]
    else if digit eq '6'
        return turned_left[x, 12]
    else if digit eq '7'
        return from_bytes[[b[3], b[0], b[2], b[1]]]
    else if digit eq '8'
        return from_bytes[[b[2], b[3], b[1], b[0]]]
    else if digit eq '9'
        return bitxor[x, 2 ^ 32 - 1]
    x

--- the password the gateway expects for a nonce
fn own_password[password, nonce]
    digits = split[nonce, '']
    x = 0
    started = false
    i = 0
    while i lt len[digits]
        if digits[i] ne '0' and not started
            x = int[password]
            started = true
        x = scrambled[x, digits[i]]
        i = i + 1
    x

--- the conversation of the task, then the checks the reference solutions make
log['← *#*1##']
log['→ *99*0##']
log['← *#603356072##']
log['→ *#`own_password[\'12345\', \'603356072\']`##']
log['← *#*1##']
log['']
checks = [['12345', '603356072', '25280520'], ['12345', '410501656', '119537670'], ['12345', '630292165', '4269684735']]
for c in checks
    got = own_password[c[0], c[1]]
    verdict = 'FAIL'
    if str[got] eq c[2]
        verdict = 'PASS'
    log['`verdict` password `c[0]`, nonce `c[1]`: `got` (expected `c[2]`)']
