--- Rosetta Code: Nonogram solver
--- https://rosettacode.org/wiki/Nonogram_solver
--- A cell is 1 (filled), 0 (empty) or -1 (not known yet), the grid a flat list. Line
--- logic settles a line without listing its arrangements: one table says which first
--- runs fit the cells before each place, another which last runs fit the cells after
--- it, and a cell is settled when every arrangement that fits both agrees on it.
--- Lines are settled again whenever a crossing line changes a cell of theirs, until
--- nothing changes; a cell still open is then guessed, filled and then empty, and the
--- search counts solutions up to two, so a puzzle is shown solved, unique or not, or
--- without solution. The problems are read from nonogram_problems.txt.
--- Extra credit: seeded random pictures of a size asked (on the command line, or
--- three sizes), kept when their clues have exactly one solution.

use bits, math

fn filled_with[n, v]
    out = []
    while len[out] lt n
        out = push[out, v]
    return out

--- The line's cells with every cell all fitting arrangements of its runs agree on
--- settled, or an error value when no arrangement fits.
fn settle[line, runs]
    cells = push[line, 0]
    n = len[cells]
    k = len[runs]
    width = k + 1
    --- empties[p]: the cells before p known empty
    empties = [0]
    p = 0
    while p lt n
        en = empties[p]
        if cells[p] eq 0
            en = en + 1
        empties = push[empties, en]
        p = p + 1
    --- before[i * width + j]: the first i cells hold the first j runs, each with an
    --- empty cell after it
    before = filled_with[(n + 1) * width, false]
    before[0] = true
    i = 1
    while i lte n
        j = 0
        while j lte k
            fits = cells[i - 1] ne 1 and before[(i - 1) * width + j]
            if not fits and j gt 0
                s = i - runs[j - 1] - 1
                if s gte 0 and cells[i - 1] ne 1
                    if empties[i - 1] eq empties[s] and before[s * width + j - 1]
                        fits = true
            before[i * width + j] = fits
            j = j + 1
        i = i + 1
    --- after[i * width + j]: the cells from i on hold the runs from j on, each with an
    --- empty cell after it
    after = filled_with[(n + 1) * width, false]
    after[n * width + k] = true
    i = n - 1
    while i gte 0
        j = k
        while j gte 0
            fits = cells[i] ne 1 and after[(i + 1) * width + j]
            if not fits and j lt k
                en = i + runs[j]
                if en lt n and cells[en] ne 1
                    if empties[en] eq empties[i] and after[(en + 1) * width + j + 1]
                        fits = true
            after[i * width + j] = fits
            j = j - 1
        i = i - 1
    if not after[0]
        return error['no arrangement of the runs fits the line', 'contradiction']
    --- marks: where the runs of fitting arrangements start (+1) and end (-1)
    marks = filled_with[n + 1, 0]
    j = 0
    while j lt k
        s = 0
        while s + runs[j] lt n
            en = s + runs[j]
            if before[s * width + j] and cells[en] ne 1 and empties[en] eq empties[s]
                if after[(en + 1) * width + j + 1]
                    marks[s] = marks[s] + 1
                    marks[en] = marks[en] - 1
            s = s + 1
        j = j + 1
    out = []
    covering = 0
    p = 0
    while p lt n - 1
        covering = covering + marks[p]
        can_fill = covering gt 0
        --- empty in an arrangement whose first j runs end, gaps and all, by p
        can_empty = false
        if cells[p] ne 1
            j = 0
            while j lte k and not can_empty
                if before[(p + 1) * width + j] and after[(p + 1) * width + j]
                    can_empty = true
                j = j + 1
        v = -1
        if can_fill and not can_empty
            v = 1
        if can_empty and not can_fill
            v = 0
        out = push[out, v]
        p = p + 1
    return out

fn column_of[grid, h, w, c]
    out = []
    r = 0
    while r lt h
        out = push[out, grid[r * w + c]]
        r = r + 1
    return out

--- The grid with every cell line logic settles, or an error value at a contradiction.
fn propagate[grid, h, w, rows, cols]
    row_due = filled_with[h, true]
    col_due = filled_with[w, true]
    busy = true
    while busy
        busy = false
        r = 0
        while r lt h
            if row_due[r]
                row_due[r] = false
                line = slice[grid, r * w, r * w + w]
                settled = settle[line, rows[r]]
                if not settled.ok
                    return error['row `r + 1`: `settled.reason`', 'contradiction']
                c = 0
                while c lt w
                    if settled[c] ne line[c]
                        grid[r * w + c] = settled[c]
                        col_due[c] = true
                        busy = true
                    c = c + 1
            r = r + 1
        c = 0
        while c lt w
            if col_due[c]
                col_due[c] = false
                line = column_of[grid, h, w, c]
                settled = settle[line, cols[c]]
                if not settled.ok
                    return error['column `c + 1`: `settled.reason`', 'contradiction']
                r = 0
                while r lt h
                    if settled[r] ne line[r]
                        grid[r * w + c] = settled[r]
                        row_due[r] = true
                        busy = true
                    r = r + 1
            c = c + 1
    return grid

fn first_open[grid]
    i = 0
    while i lt len[grid]
        if grid[i] eq -1
            return i
        i = i + 1
    return -1

--- Up to limit solutions from grid on: line logic, then a guess at the first cell it
--- leaves open, filled and then empty.
fn solutions[grid, h, w, rows, cols, limit]
    found = []
    settled = propagate[grid, h, w, rows, cols]
    if not settled.ok
        return found
    open = first_open[settled]
    if open lt 0
        found = push[found, settled]
        return found
    for guess in [1, 0]
        if len[found] lt limit
            tried = settled
            tried[open] = guess
            found = concat[found, solutions[tried, h, w, rows, cols, limit - len[found]]]
    return found

fn runs_of[word]
    out = for c in split[word, '']
        code[c] - 64
    return out

fn clues_of[line]
    out = for word in split[trim[line], ' ']
        if word ne ''
            runs_of[word]
    return out

fn picture[grid, h, w]
    lines = for r in range[h]
        marks = for c in range[w]
            if grid[r * w + c] eq 1
                '#'
            else
                '.'
        join[marks, ' ']
    return lines

--- The runs of a line of 0s and 1s, as lengths.
fn runs_in[line]
    out = []
    size = 0
    for v in push[line, 0]
        if v eq 1
            size = size + 1
        else if size gt 0
            out = push[out, size]
            size = 0
    return out

--- Runs written as letters (A is 1), a line with none as -.
fn letters_of[runs]
    if len[runs] eq 0
        return '-'
    out = for n in runs
        char[64 + n]
    return join[out, '']

fn clue_text[lines]
    words = for runs in lines
        letters_of[runs]
    return join[words, ' ']

fn show_puzzle[rows, cols]
    h = len[rows]
    w = len[cols]
    log['Rows:    `clue_text[rows]`']
    log['Columns: `clue_text[cols]`']
    start = filled_with[h * w, -1]
    logic = propagate[start, h, w, rows, cols]
    if logic.ok
        open = 0
        for v in logic
            if v eq -1
                open = open + 1
        if open eq 0
            log['Line logic alone settles every cell.']
        else
            log['Line logic leaves `open` of `h * w` cells open: guessing them.']
    found = solutions[start, h, w, rows, cols, 2]
    if len[found] eq 0
        log['No solution.']
    else
        for line in picture[found[0], h, w]
            log[line]
        if len[found] eq 1
            log['The only solution.']
        else
            log['A solution, and not the only one.']
    log['']

problems = split[trim[read['nonogram_problems.txt']], '\n\n']
for problem in problems
    two = split[trim[problem], '\n']
    show_puzzle[clues_of[two[0]], clues_of[two[1]]]

log['Two more, as the Python entry has: one line logic cannot finish, one with no solution.']
log['']
show_puzzle[clues_of['B B A A'], clues_of['B B A A']]
show_puzzle[clues_of['B A A'], clues_of['A A A']]

--- Extra credit: a random picture of h rows and w columns whose clues have exactly
--- one solution, drawn again until one has.
fn unique_puzzle[h, w]
    tries = 0
    while true
        tries = tries + 1
        cells = for i in range[h * w]
            if rand[100] lt 55
                1
            else
                0
        rows = for r in range[h]
            runs_in[slice[cells, r * w, r * w + w]]
        cols = for c in range[w]
            runs_in[column_of[cells, h, w, c]]
        if len[solutions[filled_with[h * w, -1], h, w, rows, cols, 2]] eq 1
            log['`h` rows by `w` columns, with one solution (found at draw `tries`):']
            show_puzzle[rows, cols]
            return

--- A height and a width on the command line ask for one puzzle of that size.
seed[98]
asked = args[]
if len[asked] eq 2
    h = int[asked[0]]
    w = int[asked[1]]
    if h.ok and w.ok and h gt 0 and w gt 0
        unique_puzzle[h, w]
    else
        log['Give a height and a width, both whole numbers above 0.']
else
    unique_puzzle[5, 5]
    unique_puzzle[8, 12]
    unique_puzzle[12, 10]
