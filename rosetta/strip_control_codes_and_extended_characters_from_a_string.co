--- Rosetta Code: Strip control codes and extended characters from a string
--- https://rosettacode.org/wiki/Strip_control_codes_and_extended_characters_from_a_string
--- A text is walked by its characters, each kept or dropped by its code (use bits): the
--- control codes are 0 to 31 and 127, the extended characters every code past 127, so what
--- is left of both is 32 to 126. The same is done again with a regular expression's class.
--- Control codes are shown as \xNN so the output holds none.

use bits

fn is_control[c]
    n = code[c]
    return n lt 32 or n eq 127

fn is_plain_ascii[c]
    n = code[c]
    return n gte 32 and n lte 126

--- the text without its control codes, extended characters kept
fn without_controls[s]
    kept = for c in split[s, '']
        if not is_control[c]
            c
    return join[kept, '']

--- the text without control codes or extended characters: codes 32 to 126 alone
fn plain_ascii[s]
    kept = for c in split[s, '']
        if is_plain_ascii[c]
            c
    return join[kept, '']

fn hex2[n]
    digits = split['0123456789abcdef', '']
    return '`digits[n / 16]``digits[n % 16]`'

--- the text with each control code written as \xNN
fn visible[s]
    shown = for c in split[s, '']
        if is_control[c]
            '\\x`hex2[code[c]]`'
        else
            c
    return join[shown, '']

fn report[s]
    a = without_controls[s]
    b = plain_ascii[s]
    log['text:                            \'`visible[s]`\' (`len[s]` characters)']
    log['without control codes:           \'`a`\' (`len[a]`)']
    log['without control codes, extended: \'`b`\' (`len[b]`)']
    same = a eq sub[s, '[\\x00-\\x1F\\x7F]', ''] and b eq sub[s, '[^\\x20-\\x7E]', '']
    log['the same by regular expression:  `same`']
    log['']

--- a text made of codes and pieces of text
fn spelled[parts]
    return join[parts, '']

--- the Python entry's example: backspace, NUL, line feed, return, form feed and an Ã
report[spelled[[char[8], 'a', char[0], 'b', '\n', '\r', 'c', char[12], 'd', char[195]]]]
esc = char[27]
report[spelled[['Crow: ¿dónde está?\t(tab) ', esc, '[1mbold', esc, '[0m, DEL', char[127],
    ', “naïve café”, 3×4 = 12 €']]]

--- every code from 0 to 255: 33 are control codes and 128 extended, so 95 are left
codes = for n in range[256]
    char[n]
every = join[codes, '']
log['codes 0 to 255: `len[every]` characters, `len[without_controls[every]]` without control codes, `len[plain_ascii[every]]` without either:']
log[plain_ascii[every]]
