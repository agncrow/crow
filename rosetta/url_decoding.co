--- Rosetta Code: URL decoding
--- https://rosettacode.org/wiki/URL_decoding
--- Each %XX is one byte and any other character its own UTF-8 bytes; the bytes are then
--- read back as UTF-8 into characters (use bits for char). Each escape is read once, so
--- %25%32%35 is %25, not %. The core's decode[text, 'url'] agrees.

use bits

--- The value of a hexadecimal digit, or -1 for a character that is none.
fn hex_value[c]
    digits = '0123456789abcdef'
    l = lower[c]
    i = 0
    while i lt 16
        if digits[i] eq l
            return i
        i = i + 1
    return -1

--- The UTF-8 bytes of the character whose code is n.
fn utf8[n]
    if n lt 128
        return [n]
    if n lt 2048
        return [192 + n / 64, 128 + n % 64]
    if n lt 65536
        return [224 + n / 4096, 128 + n / 64 % 64, 128 + n % 64]
    return [240 + n / 262144, 128 + n / 4096 % 64, 128 + n / 64 % 64, 128 + n % 64]

--- The bytes the encoded text stands for: an escape is one byte, and a '%' that
--- begins no escape stands for itself.
fn bytes_of[s]
    cs = split[s, '']
    out = []
    i = 0
    while i lt len[cs]
        c = cs[i]
        hi = -1
        lo = -1
        if c eq '%' and i + 2 lt len[cs]
            hi = hex_value[cs[i + 1]]
            lo = hex_value[cs[i + 2]]
        if hi gte 0 and lo gte 0
            out = push[out, hi * 16 + lo]
            i = i + 3
        else
            for b in utf8[code[c]]
                out = push[out, b]
            i = i + 1
    return out

--- The text UTF-8 bytes spell, or an error where they spell none.
fn utf8_text[bs]
    out = []
    i = 0
    while i lt len[bs]
        b = bs[i]
        n = b
        more = 0
        if b gte 240
            n = b - 240
            more = 3
        else if b gte 224
            n = b - 224
            more = 2
        else if b gte 192
            n = b - 192
            more = 1
        else if b gte 128
            return error['byte `i + 1` begins no character', 'parse']
        if i + more gte len[bs]
            return error['the text ends inside a character', 'parse']
        j = 1
        while j lte more
            if bs[i + j] lt 128 or bs[i + j] gte 192
                return error['byte `i + j + 1` continues no character', 'parse']
            n = n * 64 + bs[i + j] - 128
            j = j + 1
        out = push[out, char[n]]
        i = i + more + 1
    return join[out, '']

fn url_decode[s]
    return utf8_text[bytes_of[s]]

for s in ['http%3A%2F%2Ffoo%20bar%2F', 'google.com/search?q=%60Abdu%27l-Bah%C3%A1', '%25%32%35']
    plain = url_decode[s]
    log[s]
    log['  -> `plain`']
    log['  agrees with decode[s, \'url\']: `plain eq decode[s, \'url\']`']

bad = url_decode['caf%E9']
log['caf%E9 (Latin-1, no UTF-8) -> error: `bad.reason`']
