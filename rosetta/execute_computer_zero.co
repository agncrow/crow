--- Rosetta Code: Execute Computer/Zero
--- https://rosettacode.org/wiki/Execute_Computer/Zero
--- An assembler and an emulator. Each source line is one byte of the 32-byte
--- memory, as on the reference page: an optional label, then an instruction
--- (three bits of opcode, five of address, the address a number or a label) or
--- a number; a comment runs from ; to the end of the line. The machine runs
--- until STP (or past the last address), answering its accumulator; it keeps
--- its memory and program counter, so a stopped machine can be resumed after a
--- byte is written into it, as the Prisoner's Dilemma sample expects: after the
--- five samples, a game of it is played that way, then the wrap-around tests of
--- the Python entry.

struct Machine [memory, pc, acc, labels]

fn opcodes[]
    return map[NOP = 0, LDA = 1, STA = 2, ADD = 3, SUB = 4, BRZ = 5, JMP = 6, STP = 7]

fn words[line]
    --- the words of a line, its comment dropped
    body = split[line, ';'][0]
    kept = for w in split[body, ' ']
        if w ne ''
            w
    return kept

fn labelled[ws]
    return len[ws] gt 0 and ends[ws[0], ':']

fn value_of[w, labels]
    if w in labels
        return labels[w]
    return int[w]

fn byte_of[line, labels]
    ws = words[line]
    if labelled[ws]
        ws = slice[ws, 1, len[ws]]
    if len[ws] eq 0
        return 0
    ops = opcodes[]
    if ws[0] in ops
        address = 0
        if len[ws] gt 1
            address = value_of[ws[1], labels]
        return ops[ws[0]] * 32 + address
    return value_of[ws[0], labels]

fn assemble[lines]
    labels = map[]
    i = 0
    while i lt len[lines]
        ws = words[lines[i]]
        if labelled[ws]
            labels = set[labels, replace[ws[0], ':', ''], i]
        i = i + 1
    memory = for line in lines
        byte_of[line, labels]
    while len[memory] lt 32
        memory = push[memory, 0]
    return Machine[memory, 0, 0, labels]

fn move_name[move]
    if move eq 0
        return 'co-operates'
    return 'defects    '

fn play[m, moves]
    --- the game stops at start to wait; each round writes the player's move
    --- (0 co-operate, 1 defect) into pmove and resumes the machine, which plays
    --- tit for tat and adds up the years each side is sentenced to
    m = run[m]
    k = 0
    while k lt len[moves]
        computer = m.memory[m.labels['cmove']]
        m.memory[m.labels['pmove']] = moves[k]
        m = run[m]
        p = m.memory[m.labels['p']]
        c = m.memory[m.labels['c']]
        log['    round `k + 1`: p `move_name[moves[k]]` c `move_name[computer]` years so far: p `p`, c `c`']
        k = k + 1

fn arithmetic[op, x, y]
    --- x op y on the machine: LDA 3, op 4, STP, then the two numbers
    lines = ['LDA 3', '`op` 4', 'STP 0', str[x], str[y]]
    return run[assemble[lines]].acc

fn minus[x, y]
    return arithmetic['SUB', x, y]

fn plus[x, y]
    return arithmetic['ADD', x, y]

fn run[m]
    --- from where the machine stands to its next STP: the machine as it stops
    memory = m.memory
    pc = m.pc
    acc = m.acc
    going = true
    while going and pc lt 32
        op = memory[pc] / 32
        address = memory[pc] % 32
        pc = pc + 1
        if op eq 1                      --- LDA
            acc = memory[address]
        else if op eq 2                 --- STA
            memory[address] = acc
        else if op eq 3                 --- ADD
            acc = (acc + memory[address]) % 256
        else if op eq 4                 --- SUB
            acc = (acc - memory[address] + 256) % 256
        else if op eq 5                 --- BRZ
            if acc eq 0
                pc = address
        else if op eq 6                 --- JMP
            pc = address
        else if op eq 7                 --- STP; 0 is NOP
            going = false
    return Machine[memory, pc, acc, m.labels]

add = [
    '        LDA   x',
    '        ADD   y       ; accumulator = x + y',
    '        STP',
    'x:            2',
    'y:            2'
]

multiply = [
    'loop:   LDA   prodt',
    '        ADD   x',
    '        STA   prodt',
    '        LDA   y',
    '        SUB   one',
    '        STA   y',
    '        BRZ   done',
    '        JMP   loop',
    'done:   LDA   prodt   ; to display it',
    '        STP',
    'x:            8',
    'y:            7',
    'prodt:        0',
    'one:          1'
]

fibonacci = [
    'loop:   LDA   n',
    '        STA   temp',
    '        ADD   m',
    '        STA   n',
    '        LDA   temp',
    '        STA   m',
    '        LDA   count',
    '        SUB   one',
    '        BRZ   done',
    '        STA   count',
    '        JMP   loop',
    'done:   LDA   n       ; to display it',
    '        STP',
    'm:            1',
    'n:            1',
    'temp:         0',
    'count:        8       ; valid range: 1-11',
    'one:          1'
]

linked_list = [
    'start:  LDA   load',
    '        ADD   car     ; head of list',
    '        STA   ldcar',
    '        ADD   one',
    '        STA   ldcdr   ; next CONS cell',
    'ldcar:  NOP',
    '        STA   value',
    'ldcdr:  NOP',
    '        BRZ   done    ; 0 stands for NIL',
    '        STA   car',
    '        JMP   start',
    'done:   LDA   value   ; CAR of last CONS',
    '        STP',
    'load:   LDA   0',
    'value:        0',
    'car:          28',
    'one:          1',
    '                      ; order of CONS cells',
    '                      ; in memory',
    '                      ; does not matter',
    '              6',
    '              0       ; 0 stands for NIL',
    '              2       ; (CADR ls)',
    '              26      ; (CDDR ls) -- etc.',
    '              5',
    '              20',
    '              3',
    '              30',
    '              1       ; value of (CAR ls)',
    '              22      ; points to (CDR ls)',
    '              4',
    '              24'
]

prisoner = [
    'p:            0       ; NOP in first round',
    'c:            0',
    'start:  STP           ; wait for p\'s move',
    'pmove:  NOP',
    '        LDA   pmove',
    '        SUB   cmove',
    '        BRZ   same',
    '        LDA   pmove',
    '        STA   cmove   ; tit for tat',
    '        BRZ   cdeft',
    '        LDA   c       ; p defected, c did not',
    '        ADD   three',
    '        STA   c',
    '        JMP   start',
    'cdeft:  LDA   p',
    '        ADD   three',
    '        STA   p',
    '        JMP   start',
    'same:   LDA   pmove',
    '        STA   cmove   ; tit for tat',
    '        LDA   p',
    '        ADD   one',
    '        ADD   pmove',
    '        STA   p',
    '        LDA   c',
    '        ADD   one',
    '        ADD   pmove',
    '        STA   c',
    '        JMP   start',
    'cmove:        0       ; co-operate initially',
    'one:          1',
    'three:        3'
]

log['2+2:                `run[assemble[add]].acc`']
log['7*8:                `run[assemble[multiply]].acc`']
log['Fibonacci:          `run[assemble[fibonacci]].acc`']
log['Linked list:        `run[assemble[linked_list]].acc`']
log['Prisoner\'s Dilemma: `run[assemble[prisoner]].acc`']

log['A game of it, resumed after each STP:']
play[assemble[prisoner], [0, 0, 1, 0, 1, 1, 0]]

log['Wrapping arithmetic, as in the Python entry:']
log['    0 - 255 = `minus[0, 255]`']
log['    0 - 1   = `minus[0, 1]`']
log['    1 + 255 = `plus[1, 255]`']
