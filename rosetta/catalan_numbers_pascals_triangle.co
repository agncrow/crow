--- Rosetta Code: Catalan numbers/Pascal's triangle
--- https://rosettacode.org/wiki/Catalan_numbers/Pascal's_triangle
--- Pascal's triangle is built by addition alone; the n-th Catalan number is the
--- middle of row 2n less its right-hand neighbour, C(2n, n) - C(2n, n + 1).

fn next_row[row]
    inner = for i in range[1, len[row]]
        row[i - 1] + row[i]
    return concat[concat[[1], inner], [1]]

fn catalans[n]
    row = [1]
    found = []
    for r in range[1, 2 * n + 1]
        row = next_row[row]
        if r % 2 eq 0
            middle = r / 2
            found = push[found, row[middle] - row[middle + 1]]
    return found

texts = for c in catalans[15]
    str[c]
log[join[texts, ' ']]
