--- Rosetta Code: Next highest int from digits
--- https://rosettacode.org/wiki/Next_highest_int_from_digits
--- Algorithm 2: from the right, find the first digit with a larger one after it, swap
--- it with the smallest larger digit after it (the rightmost, since the digits after it
--- never rise), and put the digits after it in rising order (reverse them). Algorithm
--- 1, every ordering of the digits sorted, checks it on seeded random numbers. Ints
--- grow without limit, so the stretch goal is an ordinary int.

use math

--- The decimal digits of n >= 0, most significant first.
fn digits_of[n]
    if n eq 0
        return [0]
    ds = []
    while n gt 0
        ds = push[ds, n % 10]
        n = n / 10
    return reverse[ds]

fn number_of[ds]
    n = 0
    for d in ds
        n = n * 10 + d
    return n

--- Algorithm 2: the next larger number made of n's digits, or 0 when there is none.
fn next_highest[n]
    ds = digits_of[n]
    i = len[ds] - 2
    while i gte 0 and ds[i] gte ds[i + 1]
        i = i - 1
    if i lt 0
        return 0
    j = len[ds] - 1
    while ds[j] lte ds[i]
        j = j - 1
    swapped = ds[i]
    ds[i] = ds[j]
    ds[j] = swapped
    after = reverse[slice[ds, i + 1, len[ds]]]
    return number_of[concat[slice[ds, 0, i + 1], after]]

--- Every number whose digits are rest's, in some order, after the digits of prefix.
fn all_orders[prefix, rest]
    if len[rest] eq 0
        return [prefix]
    found = []
    i = 0
    while i lt len[rest]
        others = concat[slice[rest, 0, i], slice[rest, i + 1, len[rest]]]
        found = concat[found, all_orders[prefix * 10 + rest[i], others]]
        i = i + 1
    return found

--- Algorithm 1: every ordering of the digits, sorted; the first one past n.
fn next_by_search[n]
    orders = sort[all_orders[0, digits_of[n]]]
    i = 0
    while i lt len[orders]
        if orders[i] gt n
            return orders[i]
        i = i + 1
    return 0

fn grouped[n]
    return replace[fmt[n, commas = true], ',', '_']

fn show[n]
    log['`fmt[grouped[n], width = 29, align = \'right\']` -> `fmt[grouped[next_highest[n]], width = 29, align = \'right\']`']

for n in [0, 9, 12, 21, 12453, 738440, 45072010, 95322020]
    show[n]
show[9589776899767587796600]

seed[2026]
tried = 0
agreed = 0
while tried lt 1000
    n = rand[10 ^ rand[1, 7]]
    if next_highest[n] eq next_by_search[n]
        agreed = agreed + 1
    tried = tried + 1
log['']
log['Both algorithms agree on `agreed` of `tried` seeded random numbers below 10,000,000']
