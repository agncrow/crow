--- Rosetta Code: Arithmetic derivative
--- https://rosettacode.org/wiki/Arithmetic_derivative
--- For n = p1^e1 ... pk^ek the Leibniz rule gives D(n) = n (e1/p1 + ... + ek/pk):
--- trial division adds n / p once for each prime factor p, counted with its
--- exponent. D(-n) = -D(n), and ints grow, so D(10^20) is exact.

fn derivative[n]
    if n lt 0
        return -derivative[-n]
    if n lt 2
        return 0
    total = 0
    rest = n
    p = 2
    while p * p lte rest
        while rest % p eq 0
            total = total + n / p
            rest = rest / p
        p = p + 1
    if rest gt 1
        total = total + n / rest
    return total

log['The arithmetic derivatives of -99 through 100:']
for row in range[20]
    cells = for n in range[-99 + row * 10, -89 + row * 10]
        fmt[derivative[n], width = 5]
    log[join[cells, '']]

log['']
for m in range[1, 21]
    log['D(10^`m`) / 7 = `derivative[10 ^ m] / 7`']
