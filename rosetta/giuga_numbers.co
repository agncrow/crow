--- Rosetta Code: Giuga numbers
--- https://rosettacode.org/wiki/Giuga_numbers
--- The first four by the definition, testing each number's prime factors in turn. The
--- stretch searches sets of primes instead (the talk page's PARI/GP method, as in the Wren
--- and Phix entries): a Giuga number's distinct primes p have sum 1/p - 1/n a whole number,
--- 1 for every one known; the primes but the last two are searched with that sum kept
--- exact, and the last two solve an equation over the divisors of a number.

--- whether n is composite and each distinct prime factor f divides n / f - 1
fn is_giuga[n]
    m = n
    f = 2
    count = 0
    while f * f lte m
        if m % f eq 0
            if (n / f - 1) % f ne 0
                return false
            m = m / f
            count = count + 1
        else
            f = f + 1
    if m gt 1
        if (n / m - 1) % m ne 0
            return false
        count = count + 1
    return count gt 1

fn is_prime[n]
    if n lt 2
        return false
    f = 2
    while f * f lte n
        if n % f eq 0
            return false
        f = f + 1
    return true

fn next_prime[n]
    m = n + 1
    while not is_prime[m]
        m = m + 1
    return m

--- the numbers d r1 r2 with r1 and r2 two primes above above, such that c/d + 1/r1 + 1/r2
--- - 1/(d r1 r2) is 1: that is ((d - c) r1 - d) ((d - c) r2 - d) = d^2 - d + c
fn last_two[c, d, above]
    found = []
    e = d - c
    m = d * d - e
    h = 1
    while h * h lte m
        if m % h eq 0 and (h + d) % e eq 0 and (m / h + d) % e eq 0
            r1 = (h + d) / e
            r2 = (m / h + d) / e
            if r1 gt above and r2 gt above and r1 ne r2 and is_prime[r1] and is_prime[r2]
                found = push[found, d * r1 * r2]
        h = h + 1
    return found

--- the Giuga numbers of k prime factors whose reciprocals sum to 1 + 1/n, 2 the first
--- (as it is of every one known). p[t] is the t-th prime, and c[t]/d[t] the sum of the
--- reciprocals of the first t (d[t] their product, so the fraction is in lowest terms).
--- A prime too small makes the sum 1 or more; one too large leaves the sum no way past 1
--- with the primes still to come, each smaller than 1/p[t]: then the search steps back.
fn giuga_with[k]
    found = []
    p = for i in range[k]
        0
    c = p
    d = p
    p[1] = 2
    c[1] = 1
    d[1] = 2
    p[2] = 2
    t = 2
    while t gt 1
        p[t] = next_prime[p[t]]
        c[t] = c[t - 1] * p[t] + d[t - 1]
        d[t] = d[t - 1] * p[t]
        if c[t] eq d[t] or c[t] * p[t] + (k - t) * d[t] lte d[t] * p[t]
            t = t - 1
        else if t lt k - 2
            t = t + 1
            p[t] = max[p[t - 1], c[t - 1] / (d[t - 1] - c[t - 1])]
        else
            for n in last_two[c[k - 2], d[k - 2], p[k - 2]]
                found = push[found, n]
    return sort[found]

first = []
n = 2
while len[first] lt 4
    if is_giuga[n]
        first = push[first, n]
    n = n + 1
shown = join[first, ' ']
log['The first four Giuga numbers, by the definition: `shown`']
log['']
log['By the search over sets of primes:']
every = []
for k in range[3, 7]
    found = giuga_with[k]
    shown = join[found, ' ']
    log['    `k` prime factors: `shown`']
    every = concat[every, found]
every = sort[every]
log['The fifth Giuga number is `every[4]`, and the sixth `every[5]`; by the definition: `is_giuga[every[4]]`, `is_giuga[every[5]]`']
