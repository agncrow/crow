--- Rosetta Code: Riordan numbers
--- https://rosettacode.org/wiki/Riordan_numbers
--- The recurrence a(n) = (n - 1)(2 a(n-1) + 3 a(n-2)) / (n + 1) from a(0) = 1 and
--- a(1) = 0, in ints that grow; the division always comes out whole. The 1,000th
--- number is a(999), and a digit count is the length of the number's text.

--- The first count Riordan numbers, a(0) to a(count - 1).
fn riordan[count]
    a = [1, 0]
    n = 2
    while n lt count
        a = push[a, (n - 1) * (2 * a[n - 1] + 3 * a[n - 2]) / (n + 1)]
        n = n + 1
    return a

a = riordan[10000]
log['The first 32 Riordan numbers:']
for r in range[8]
    cells = for c in range[4]
        fmt[a[4 * r + c], commas = true, width = 18]
    log[join[cells, '']]
log['']
log['The 1,000th Riordan number has `len[str[a[999]]]` digits.']
log['The 10,000th Riordan number has `len[str[a[9999]]]` digits.']
