--- Rosetta Code: Hamiltonian Cycle via Chvátal Closure
--- https://rosettacode.org/wiki/Hamiltonian_Cycle_via_Chvátal_Closure
--- A graph is an adjacency matrix of bools. The closure adds, one at a time, the
--- first non-edge whose ends' degrees sum to n or more; a complete closure proves
--- the graph Hamiltonian (Bondy–Chvátal), and a backtracking search then finds a cycle.

struct Closure [adj, added]

--- the adjacency matrix of n vertices joined by the given edges
fn graph[n, edges]
    adj = for u in range[n]
        row = for v in range[n]
            false
        row
    for e in edges
        adj[e[0]][e[1]] = true
        adj[e[1]][e[0]] = true
    return adj

--- every edge of the complete graph on n vertices but the one left out
fn complete_but[n, left_out]
    edges = []
    for u in range[n]
        for v in range[u + 1, n]
            if [u, v] ne left_out
                edges = push[edges, [u, v]]
    return edges

fn degrees[adj]
    counts = for row in adj
        picked = for linked in row
            if linked
                1
        len[picked]
    return counts

--- the first pair of non-adjacent vertices whose degrees sum to n or more, or none
fn addable[adj, deg]
    n = len[adj]
    u = 0
    while u lt n
        v = u + 1
        while v lt n
            if not adj[u][v] and deg[u] + deg[v] gte n
                return [u, v]
            v = v + 1
        u = u + 1
    return []

fn closure[adj]
    deg = degrees[adj]
    added = []
    pair = addable[adj, deg]
    while len[pair] gt 0
        u = pair[0]
        v = pair[1]
        adj[u][v] = true
        adj[v][u] = true
        deg[u] = deg[u] + 1
        deg[v] = deg[v] + 1
        added = push[added, pair]
        pair = addable[adj, deg]
    return Closure[adj, added]

fn is_complete[adj]
    n = len[adj]
    for u in range[n]
        for v in range[u + 1, n]
            if not adj[u][v]
                return false
    return true

--- extend the path by backtracking; the cycle back to its start, or none
fn extend[adj, path, seen]
    n = len[adj]
    u = path[-1]
    if len[path] eq n
        if adj[u][path[0]]
            return push[path, path[0]]
        return []
    v = 0
    while v lt n
        if not seen[v] and adj[u][v]
            seen[v] = true
            cycle = extend[adj, push[path, v], seen]
            if len[cycle] gt 0
                return cycle
            seen[v] = false
        v = v + 1
    return []

fn hamiltonian_cycle[adj]
    seen = for u in range[len[adj]]
        u eq 0
    return extend[adj, [0], seen]

fn shown[cycle]
    words = for v in cycle
        str[v]
    return join[words, ' → ']

fn report[title, adj]
    log['== `title` ==']
    log['Original graph degrees:']
    deg = degrees[adj]
    for u in range[len[adj]]
        log[' deg(`u`) = `deg[u]`']
    c = closure[adj]
    log['']
    log['After Chvátal closure:']
    for u in range[len[adj]]
        marks = for v in range[len[adj]]
            if c.adj[u][v]
                ' `v`'
        line = join[marks, '']
        log['  `u`:`line`']
    if len[c.added] gt 0
        pieces = for e in c.added
            '`e[0]`-`e[1]`'
        added = join[pieces, ', ']
        log['Edges added, in order: `added`']
    else
        log['Edges added: none']
    log['']
    cycle = hamiltonian_cycle[adj]
    if is_complete[c.adj]
        log['Closure is complete ⇒ graph is Hamiltonian (by Bondy–Chvátal).']
        if len[cycle] gt 0
            log['Found Hamiltonian cycle in original graph:']
            log[shown[cycle]]
        else
            log['Unexpected: could not find a Hamiltonian cycle.']
    else
        log['Closure is not complete ⇒ no guarantee of Hamiltonian cycle.']
        if len[cycle] gt 0
            log['(A backtracking search finds one all the same: `shown[cycle]`)']
        else
            log['(A backtracking search finds none: the graph is not Hamiltonian.)']
    log['']

--- the task's example: K5 without the edge 0-1, which Ore's condition covers
report['K5 less the edge 0-1', graph[5, complete_but[5, [0, 1]]]]

--- Ore's condition fails here (3 and 4 are not adjacent, and their degrees sum
--- to 4 < 6), yet the closure grows, edge by edge, to K6
cascade = [[0, 1], [0, 2], [0, 3], [0, 4], [1, 2], [1, 3], [2, 5], [4, 5]]
report['A graph whose closure grows in a cascade', graph[6, cascade]]

--- a cycle is Hamiltonian, but the test cannot tell: no edge is ever added
ring = for u in range[6]
    [u, (u + 1) % 6]
report['The cycle C6', graph[6, ring]]

--- the Petersen graph: 3-regular on 10 vertices, and not Hamiltonian
outer = for u in range[5]
    [u, (u + 1) % 5]
spokes = for u in range[5]
    [u, u + 5]
inner = for u in range[5]
    [u + 5, (u + 2) % 5 + 5]
petersen = concat[concat[outer, spokes], inner]
report['The Petersen graph', graph[10, petersen]]
