--- Rosetta Code: Roman numerals/Decode
--- https://rosettacode.org/wiki/Roman_numerals/Decode
--- Each letter's value is added, except that one written before a larger letter
--- is taken away (the I of IV, the C of CM). A character that is no Roman letter
--- makes the answer an error value saying which.

fn letter_value[ch]
    worth = map[M = 1000, D = 500, C = 100, L = 50, X = 10, V = 5, I = 1]
    if ch not in worth
        return error['\'`ch`\' is not a Roman numeral', 'roman']
    return worth[ch]

fn from_roman[roman]
    letters = split[upper[roman], '']
    total = 0
    i = 0
    while i lt len[letters]
        value = letter_value[letters[i]]
        if i + 1 lt len[letters] and value lt letter_value[letters[i + 1]]
            total = total - value
        else
            total = total + value
        i = i + 1
    return total

for roman in ['MCMXC', 'MMVIII', 'MDCLXVI', 'MMXXVI', 'MCMLIV', 'MMMCMXCIX', 'CDXLIV', 'XLII', 'IV', 'i', 'MXQ']
    value = from_roman[roman]
    if value.ok
        log['`fmt[roman, width = 10]` `value`']
    else
        log['`fmt[roman, width = 10]` error: `value.reason`']
