--- Rosetta Code: Numbers with equal rises and falls
--- https://rosettacode.org/wiki/Numbers_with_equal_rises_and_falls
--- The first 200 are found by reading each number's digits. The 10 millionth is
--- not searched for: it is built a digit at a time from counts. ways[l][d] holds,
--- for each balance h from −l to l, how many strings of l digits after a digit d
--- rise h times more than they fall; with it, the numbers of each length are
--- counted, then each digit is chosen as the one whose numbers hold the rank.

fn step[a, b]
    --- 1 where b rises from a, −1 where it falls, 0 where it is level
    if b gt a
        return 1
    if b lt a
        return -1
    0

fn balanced[n]
    --- whether n's digits rise as often as they fall
    height = 0
    rest = n
    while rest gte 10
        height = height + step[rest / 10 % 10, rest % 10]
        rest = rest / 10
    height eq 0

fn ways_at[level, l, d, h]
    --- how many strings of l digits after a digit d rise h times more than they fall
    if h lt -l or h gt l
        return 0
    level[d][h + l]

fn ways_after[shorter, l, d, h]
    --- the same count for l digits, from the counts for l − 1 digits
    total = 0
    for e in range[10]
        total = total + ways_at[shorter, l - 1, e, h - step[d, e]]
    total

fn next_level[shorter, l]
    --- the counts for l digits after each digit, from those for l − 1 digits
    rows = for d in range[10]
        row = for h in range[-l, l + 1]
            ways_after[shorter, l, d, h]
        row
    rows

fn level_zero[]
    --- the counts for no digits: after any digit, one way, of balance 0
    rows = for d in range[10]
        row = for h in range[1]
            1
        row
    rows

fn of_length[levels, n]
    --- how many n-digit numbers have equal rises and falls
    total = 0
    for first in range[1, 10]
        total = total + ways_at[levels[n - 1], n - 1, first, 0]
    total

fn nth_balanced[k]
    --- the k-th number (from 1) with equal rises and falls
    levels = []
    levels = push[levels, level_zero[]]
    rank = k
    n = 1
    while rank gt of_length[levels, n]
        rank = rank - of_length[levels, n]
        levels = push[levels, next_level[levels[n - 1], n]]
        n = n + 1
    number = 0
    height = 0
    last = 0
    position = 0
    while position lt n
        left = n - 1 - position
        digit = 0
        if position eq 0
            digit = 1
        moved = height
        chosen = false
        while not chosen
            moved = height
            if position gt 0
                moved = height + step[last, digit]
            count = ways_at[levels[left], left, digit, -moved]
            if rank lte count
                chosen = true
            else
                rank = rank - count
                digit = digit + 1
        number = number * 10 + digit
        height = moved
        last = digit
        position = position + 1
    number

first = []
n = 0
while len[first] lt 200
    n = n + 1
    if balanced[n]
        first = push[first, n]
log['The first 200 numbers with equal rises and falls:']
for start in range[0, 200, 20]
    row = for x in slice[first, start, start + 20]
        fmt[x, width = 3]
    log[join[row, ' ']]

differing = for k in range[1, 201]
    if nth_balanced[k] ne first[k - 1]
        str[k]
log['Built from the counts instead, the 1st to the 200th are the same: `len[differing] eq 0`']

seen = 0
n = 0
while seen lt 100000
    n = n + 1
    if balanced[n]
        seen = seen + 1
log['']
log['The 100,000th, by reading digits: `fmt[n, commas = true]`; built from the counts: `fmt[nth_balanced[100000], commas = true]`']
log['The 10,000,000th, built from the counts: `fmt[nth_balanced[10000000], commas = true]`']
