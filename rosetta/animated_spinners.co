--- Rosetta Code: Animated Spinners
--- https://rosettacode.org/wiki/Animated_Spinners
--- Crow has no window to draw in, so the spinners are an animated SVG image,
--- spinners.svg, written to the current directory (a browser plays it): five
--- spinners, one in the middle and four around it. Each is a set of radius lines
--- drawn around its centre, and a clock hand that loops through them a frame at a
--- time, 60 frames a second, a fading trail behind it; a hand that jumps far each
--- frame fills its spinner in. One frame is drawn here in characters too. The
--- stretch goal, offsetting the spinners with the mouse, needs mouse events, which
--- Crow has none of.

use math

--- a spinner: its centre, colour and the degrees its hand turns each frame
struct Spinner [x, y, colour, step]

fn gcd[a, b]
    while b ne 0
        a, b = b, a % b
    return a

--- the frames before the hand is back where it started
fn frames_of[s]
    return 360 / gcd[360, abs[s.step]]

--- the hand's angle, in degrees clockwise from twelve o'clock, at a frame
fn angle_at[s, frame]
    return (frame * s.step) % 360

--- an SVG line from a spinner's centre out to the radius at an angle
fn ray[s, radius, degrees, colour, width, opacity]
    a = degrees * pi / 180.0
    x = fmt[s.x + radius * sin[a], decimals = 2]
    y = fmt[s.y - radius * cos[a], decimals = 2]
    return '<line x1="`s.x`" y1="`s.y`" x2="`x`" y2="`y`" stroke="`colour`" stroke-width="`width`" stroke-linecap="round" opacity="`opacity`"'

--- the hand `lag` frames behind: a line whose rotation steps through the frames
fn hand[s, radius, lag, fps]
    frames = frames_of[s]
    turns = for f in range[frames]
        '`angle_at[s, f - lag]` `s.x` `s.y`'
    stops = join[turns, ';']
    seconds = fmt[frames / fps, decimals = 3]
    opacity = fmt[1.0 - lag * 0.2, decimals = 1]
    line = ray[s, radius, 0, s.colour, 4, opacity]
    animate = '<animateTransform attributeName="transform" type="rotate" values="`stops`" dur="`seconds`s" calcMode="discrete" repeatCount="indefinite"/>'
    return '`line`>`animate`</line>'

--- a spinner: a radius line at every place its hand stops, then the hand
fn spinner_svg[s, radius, fps]
    spokes = for f in range[frames_of[s]]
        '`ray[s, radius, f * 360 / frames_of[s], s.colour, 1, 0.3]`/>'
    trail = for lag in [4, 3, 2, 1, 0]
        hand[s, radius, lag, fps]
    return join[concat[spokes, trail], '\n']

fn svg[spinners, side, radius, fps]
    head = '<svg xmlns="http://www.w3.org/2000/svg" width="`side`" height="`side`">'
    back = '<rect width="100%" height="100%" fill="#2c2d2c"/>'
    dial = '<circle cx="`side / 2`" cy="`side / 2`" r="`side / 2 - 8`" fill="black" stroke="#646464" stroke-width="3"/>'
    parts = for s in spinners
        spinner_svg[s, radius, fps]
    body = join[parts, '\n']
    return '`head`\n`back`\n`dial`\n`body`\n</svg>\n'

--- a row of cells as text, without the blanks after its last mark
fn row_text[row]
    last = len[row] - 1
    while last gte 0 and row[last] eq ' '
        last = last - 1
    return join[slice[row, 0, last + 1], '']

--- the spinners at a frame on a grid of characters: '.' for the radius lines,
--- the hand in its colour's initial, 'o' for a centre; the empty rows above and
--- below them are left out
fn picture[spinners, side, radius, frame, columns, rows]
    cells = for i in range[columns * rows]
        ' '
    for s in spinners
        frames = frames_of[s]
        for f in range[frames]
            is_hand = f eq frame % frames
            a = angle_at[s, f] * pi / 180.0
            for k in range[1, 13]
                t = radius * k / 12.0
                c = round[(s.x + t * sin[a]) * (columns - 1) / side]
                r = round[(s.y - t * cos[a]) * (rows - 1) / side]
                if is_hand
                    cells[r * columns + c] = upper[slice[s.colour, 0, 1]]
                else if cells[r * columns + c] eq ' '
                    cells[r * columns + c] = '.'
        c = round[s.x * (columns - 1) / side]
        r = round[s.y * (rows - 1) / side]
        cells[r * columns + c] = 'o'
    lines = for r in range[rows]
        row_text[slice[cells, r * columns, (r + 1) * columns]]
    first = 0
    while first lt rows and lines[first] eq ''
        first = first + 1
    last = rows - 1
    while last gt first and lines[last] eq ''
        last = last - 1
    return slice[lines, first, last + 1]

side = 500.0
radius = 70.0
fps = 60
spinners = [Spinner[250.0, 250.0, 'lime', 25], Spinner[125.0, 125.0, 'red', -20], Spinner[375.0, 125.0, 'yellow', 30], Spinner[125.0, 375.0, 'white', -35], Spinner[375.0, 375.0, 'orange', 15]]

written = write['spinners.svg', svg[spinners, side, radius, fps]]
log['spinners.svg: five spinners at `fps` frames a second']
for s in spinners
    log['  `fmt[s.colour, width = 7]` at (`s.x`, `s.y`): its hand turns `s.step` degrees a frame, `frames_of[s]` frames a loop']
log['']
log['Frame 3, in characters:']
for line in picture[spinners, side, radius, 3, 77, 39]
    log[line]
