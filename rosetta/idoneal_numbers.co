--- Rosetta Code: Idoneal numbers
--- https://rosettacode.org/wiki/Idoneal_numbers
--- n is idoneal when no a < b < c make ab + bc + ca = n: every such sum up to
--- a limit is marked once, by walking c with b and a fixed, and the unmarked
--- numbers are the idoneal ones.

--- for each n up to limit, whether n = ab + bc + ca for some 0 < a < b < c
fn representable[limit]
    hit = for i in range[limit + 1]
        false
    a = 1
    while a * (a + 1) + (2 * a + 1) * (a + 2) lte limit
        b = a + 1
        while a * b + (a + b) * (b + 1) lte limit
            s = a * b + (a + b) * (b + 1)
            while s lte limit
                hit[s] = true
                s = s + a + b
            b = b + 1
        a = a + 1
    return hit

fn idoneal_up_to[limit]
    hit = representable[limit]
    found = for n in range[1, limit + 1]
        if not hit[n]
            n
    return found

--- numbers in rows of `per`, each `width` wide
fn show[ns, per, width]
    row = ''
    for i in range[len[ns]]
        row = '`row``fmt[ns[i], width = width]`'
        if (i + 1) % per eq 0 or i eq len[ns] - 1
            log[row]
            row = ''

found = idoneal_up_to[2000]
log['The first 50 idoneal numbers:']
show[slice[found, 0, 50], 10, 5]
log['']
log['All `len[found]` known idoneal numbers:']
show[found, 13, 5]

limit = 100000
beyond = idoneal_up_to[limit]
log['']
log['Idoneal numbers up to `fmt[limit, commas = true]`: `len[beyond]`, the largest `beyond[-1]`']
