--- Rosetta Code: Balanced ternary
--- https://rosettacode.org/wiki/Balanced_ternary
--- A balanced ternary number is a list of digits -1, 0 and 1, the least significant
--- first, with no zero at the top (zero is the empty list). Addition carries digit by
--- digit, negation flips every digit, and multiplication shifts and adds: the native
--- int is used only to convert to and from, and an int grows without limit.

fn digit_of[c]
    if c eq '+'
        return 1
    if c eq '-' or c eq '−'
        return -1
    return 0

fn symbol_of[d]
    if d eq 1
        return '+'
    if d eq -1
        return '-'
    return '0'

--- Drop the zeros at the top.
fn trimmed[digits]
    n = len[digits]
    while n gt 0 and digits[n - 1] eq 0
        n = n - 1
    return slice[digits, 0, n]

fn from_text[text]
    digits = for c in reverse[split[text, '']]
        digit_of[c]
    return trimmed[digits]

fn to_text[digits]
    if len[digits] eq 0
        return '0'
    chars = for d in reverse[digits]
        symbol_of[d]
    return join[chars, '']

--- The remainder by 3, taken from 0 to 2, says the next digit: 2 is a -1 with one
--- carried into what is left.
fn from_int[n]
    digits = []
    while n ne 0
        r = n % 3
        if r lt 0
            r = r + 3
        if r eq 2
            r = -1
        digits = push[digits, r]
        n = (n - r) / 3
    return digits

fn to_int[digits]
    n = 0
    for d in reverse[digits]
        n = 3 * n + d
    return n

fn negate[digits]
    flipped = for d in digits
        -d
    return flipped

--- Two digits and a carry sum to -3 … 3; the digit kept is that sum brought into
--- -1 … 1, and what it was brought by is carried.
fn plus[a, b]
    digits = []
    carry = 0
    i = 0
    while i lt len[a] or i lt len[b] or carry ne 0
        s = carry
        if i lt len[a]
            s = s + a[i]
        if i lt len[b]
            s = s + b[i]
        carry = 0
        if s gt 1
            s = s - 3
            carry = 1
        else if s lt -1
            s = s + 3
            carry = -1
        digits = push[digits, s]
        i = i + 1
    return trimmed[digits]

fn minus[a, b]
    return plus[a, negate[b]]

--- Each digit of a adds b, takes b away, or does nothing, b shifted one place
--- further up for each.
fn times[a, b]
    product = []
    shifted = b
    for d in a
        if d eq 1
            product = plus[product, shifted]
        else if d eq -1
            product = minus[product, shifted]
        shifted = concat[[0], shifted]
    return product

fn show[name, digits]
    log['`fmt[name, width = 12]` `fmt[to_text[digits], width = 14]` `to_int[digits]`']

a = from_text['+-0++0+']
b = from_int[-436]
c = from_text['+-++-']
show['a', a]
show['b', b]
show['c', c]
show['a * (b - c)', times[a, minus[b, c]]]

--- Large numbers: the conversions and the arithmetic, checked against the native ints.
x = from_int[2 ^ 100]
y = from_int[-(3 ^ 60) + 12345]
log['']
log['2^100 = `to_text[x]`']
log['back to an int: `to_int[x]`']
log['x * y - x checked natively: `to_int[minus[times[x, y], x]] eq (2 ^ 100) * (-(3 ^ 60) + 12345) - 2 ^ 100`']
