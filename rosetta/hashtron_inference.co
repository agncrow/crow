--- Rosetta Code: Hashtron inference
--- https://rosettacode.org/wiki/Hashtron_inference
--- A Hashtron program is a list of [salt, max] pairs. To infer bit j of a command,
--- the command (with j in bits 16 and up) is hashed through each pair in turn,
--- the range shrinking by each later pair's max, and the last hash's low bit is
--- the answer's bit j. The hash works on 32-bit words: Crow's ints grow, so each
--- step keeps the low 32 bits with bitand.

use bits

fn word[x]
    return bitand[x, 4294967295]

--- n mixed with the salt s, xor-shifted, and reduced to 0 .. top - 1 by
--- Lemire's multiply-and-shift
fn hashed[n, s, top]
    m = word[n - s]
    m = bitxor[m, word[shift[m, 2]]]
    m = bitxor[m, word[shift[m, 3]]]
    m = bitxor[m, shift[m, -5]]
    m = bitxor[m, shift[m, -7]]
    m = bitxor[m, word[shift[m, 11]]]
    m = bitxor[m, word[shift[m, 13]]]
    m = bitxor[m, shift[m, -17]]
    m = bitxor[m, word[shift[m, 19]]]
    m = word[m + s]
    return shift[m * top, -32]

fn inference[command, width, program]
    out = 0
    j = 0
    while j lt width and len[program] gt 0
        top = program[0][1]
        value = hashed[bitor[command, shift[j, 16]], program[0][0], top]
        i = 1
        while i lt len[program]
            top = top - program[i][1]
            value = hashed[value, program[i][0], top]
            i = i + 1
        if bitand[value, 1] ne 0
            out = bitor[out, shift[1, j]]
        j = j + 1
    return out

--- the whole square root, to check the program's answers
fn isqrt[n]
    r = 0
    while (r + 1) * (r + 1) lte n
        r = r + 1
    return r

log['Test demo: command 42, 64 bits, program [[0, 2]]:']
log[inference[42, 64, [[0, 2]]]]

--- a program machine-learned to answer the square root of a byte, in 4 bits
