log['']
log['Square root demo: 4 bits of each command 0 to 255 (16 commands a row):']
roots = for n in range[256]
    inference[n, 4, square_root]
for row in range[16]
    cells = for k in range[16]
        fmt[roots[16 * row + k], width = 3]
    line = join[cells, '']
    log['`fmt[16 * row, width = 3]`:`line`']
right = for n in range[256]
    if roots[n] eq isqrt[n]
        n
log['Right for `len[right]` of the 256 commands']
