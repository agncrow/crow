--- Rosetta Code: Perlin noise
--- https://rosettacode.org/wiki/Perlin_noise
--- Ken Perlin's improved noise (his 2002 Java reference) in 64-bit floats: the unit cube
--- holding the point is hashed through the permutation table at its eight corners, each
--- corner's gradient is dotted with the point's offset from it, and the eight are blended
--- by the fade curve 6t^5 - 15t^4 + 10t^3. noise(3.14, 42, 7) is 0.13691995878400012.
--- After it, a few more points and a slice of the noise drawn in characters.

use bits

--- Ken Perlin's permutation of 0..255, written twice so an index up to 511 needs no wrap.
fn permutation[]
    once = [151, 160, 137, 91, 90, 15, 131, 13, 201, 95, 96, 53, 194, 233, 7, 225, 140, 36,
        103, 30, 69, 142, 8, 99, 37, 240, 21, 10, 23, 190, 6, 148, 247, 120, 234, 75, 0, 26,
        197, 62, 94, 252, 219, 203, 117, 35, 11, 32, 57, 177, 33, 88, 237, 149, 56, 87, 174,
        20, 125, 136, 171, 168, 68, 175, 74, 165, 71, 134, 139, 48, 27, 166, 77, 146, 158,
        231, 83, 111, 229, 122, 60, 211, 133, 230, 220, 105, 92, 41, 55, 46, 245, 40, 244,
        102, 143, 54, 65, 25, 63, 161, 1, 216, 80, 73, 209, 76, 132, 187, 208, 89, 18, 169,
        200, 196, 135, 130, 116, 188, 159, 86, 164, 100, 109, 198, 173, 186, 3, 64, 52, 217,
        226, 250, 124, 123, 5, 202, 38, 147, 118, 126, 255, 82, 85, 212, 207, 206, 59, 227,
        47, 16, 58, 17, 182, 189, 28, 42, 223, 183, 170, 213, 119, 248, 152, 2, 44, 154, 163,
        70, 221, 153, 101, 155, 167, 43, 172, 9, 129, 22, 39, 253, 19, 98, 108, 110, 79, 113,
        224, 232, 178, 185, 112, 104, 218, 246, 97, 228, 251, 34, 242, 193, 238, 210, 144, 12,
        191, 179, 162, 241, 81, 51, 145, 235, 249, 14, 239, 107, 49, 192, 214, 31, 181, 199,
        106, 157, 184, 84, 204, 176, 115, 121, 50, 45, 127, 4, 150, 254, 138, 236, 205, 93,
        222, 114, 67, 29, 24, 72, 243, 141, 128, 195, 78, 66, 215, 61, 156, 180]
    concat[once, once]

--- The fade curve 6t^5 - 15t^4 + 10t^3: flat at both ends of the cube.
fn fade[t]
    t * t * t * (t * (t * 6.0 - 15.0) + 10.0)

fn lerp[t, a, b]
    a + t * (b - a)

--- The low four bits of a corner's hash pick one of twelve gradient directions, and the
--- answer is that gradient dotted with the offset (x, y, z) from the corner.
fn gradient[corner, x, y, z]
    h = bitand[corner, 15]
    u = y
    if h lt 8
        u = x
    v = z
    if h lt 4
        v = y
    else if h eq 12 or h eq 14
        v = x
    if bitand[h, 1] ne 0
        u = -u
    if bitand[h, 2] ne 0
        v = -v
    u + v

fn noise[p, x, y, z]
    --- the unit cube that holds the point, and where the point lies inside it
    fx = floor[x]
    fy = floor[y]
    fz = floor[z]
    cx = bitand[fx, 255]
    cy = bitand[fy, 255]
    cz = bitand[fz, 255]
    x = x - float[fx]
    y = y - float[fy]
    z = z - float[fz]
    u = fade[x]
    v = fade[y]
    w = fade[z]
    --- the hashes of the cube's eight corners
    a = p[cx] + cy
    aa = p[a] + cz
    ab = p[a + 1] + cz
    b = p[cx + 1] + cy
    ba = p[b] + cz
    bb = p[b + 1] + cz
    --- each corner's gradient dotted with the offset from it; c101 is the corner on the
    --- high side in x, the low side in y and the high side in z
    c000 = gradient[p[aa], x, y, z]
    c100 = gradient[p[ba], x - 1.0, y, z]
    c010 = gradient[p[ab], x, y - 1.0, z]
    c110 = gradient[p[bb], x - 1.0, y - 1.0, z]
    c001 = gradient[p[aa + 1], x, y, z - 1.0]
    c101 = gradient[p[ba + 1], x - 1.0, y, z - 1.0]
    c011 = gradient[p[ab + 1], x, y - 1.0, z - 1.0]
    c111 = gradient[p[bb + 1], x - 1.0, y - 1.0, z - 1.0]
    --- blended along x, then y, then z
    near = lerp[v, lerp[u, c000, c100], lerp[u, c010, c110]]
    far = lerp[v, lerp[u, c001, c101], lerp[u, c011, c111]]
    lerp[w, near, far]

--- A row of the slice z = 0.5 in characters, lighter to darker as the noise rises.
fn shade_row[p, row, columns]
    shades = split[' .:-=+*#%@', '']
    cells = for col in range[columns]
        n = noise[p, float[col] / 8.0, float[row] / 4.0, 0.5]
        level = floor[(n + 1.0) / 2.0 * 10.0]
        shades[min[max[level, 0], 9]]
    join[cells, '']

p = permutation[]
log['noise(3.14, 42, 7) = `noise[p, 3.14, 42.0, 7.0]`']
log['']
log['More points:']
points = [[0.5, 0.5, 0.5], [1.25, 2.5, 3.75], [-3.14, -42.0, -7.0], [10.0, 20.0, 30.0], [0.1, 0.2, 0.3], [100.7, -0.3, 255.9]]
for q in points
    log['  noise(`q[0]`, `q[1]`, `q[2]`) = `noise[p, q[0], q[1], q[2]]`']
log['']
log['The slice z = 0.5, x from 0 to 8 across and y from 0 to 6 down:']
for row in range[24]
    log[shade_row[p, row, 64]]
