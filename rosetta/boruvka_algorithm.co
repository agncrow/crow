--- Rosetta Code: Borůvka algorithm
--- https://rosettacode.org/wiki/Borůvka_algorithm
--- Each stage finds, for every tree of the forest, its cheapest edge to another tree
--- (ties broken by the edge's place in the list, so no cycle can form), then adds
--- those edges, joining trees through a union-find by rank, until one tree is left.

struct Edge [u, v, weight]

struct Forest [parent, rank]

struct Pick [stage, edge]

fn filled[n, value]
    xs = for i in range[n]
        value
    return xs

fn root[parent, x]
    while parent[x] ne x
        x = parent[x]
    return x

fn joined[f, a, b]
    --- The trees of roots a and b made one, the lower-ranked under the other.
    if f.rank[a] lt f.rank[b]
        f.parent[a] = b
    else if f.rank[a] gt f.rank[b]
        f.parent[b] = a
    else
        f.parent[b] = a
        f.rank[a] = f.rank[a] + 1
    return f

fn cheapest_edges[f, edges]
    --- For each tree's root, the index of its cheapest edge to another tree, or -1.
    cheapest = filled[len[f.parent], -1]
    for i in range[len[edges]]
        e = edges[i]
        a = root[f.parent, e.u]
        b = root[f.parent, e.v]
        if a ne b
            if cheapest[a] eq -1 or edges[cheapest[a]].weight gt e.weight
                cheapest[a] = i
            if cheapest[b] eq -1 or edges[cheapest[b]].weight gt e.weight
                cheapest[b] = i
    return cheapest

fn boruvka[n, edges]
    --- The edges of a minimum spanning tree (a forest, if the graph falls apart),
    --- each with the stage that added it.
    f = Forest[range[n], filled[n, 0]]
    picks = []
    trees = n
    stage = 0
    grown = true
    while trees gt 1 and grown
        stage = stage + 1
        grown = false
        for i in cheapest_edges[f, edges]
            if i ne -1
                a = root[f.parent, edges[i].u]
                b = root[f.parent, edges[i].v]
                if a ne b
                    f = joined[f, a, b]
                    picks = push[picks, Pick[stage, edges[i]]]
                    trees = trees - 1
                    grown = true
    return picks

fn total_weight[picks]
    total = 0
    for p in picks
        total = total + p.edge.weight
    return total

fn task_example[]
    edges = [Edge[0, 1, 10], Edge[0, 2, 6], Edge[0, 3, 5], Edge[1, 3, 15], Edge[2, 3, 4]]
    picks = boruvka[4, edges]
    for p in picks
        log['Edge `p.edge.u`--`p.edge.v` with weight `p.edge.weight` is included in the minimum spanning tree']
    log['Weight of minimum spanning tree is `total_weight[picks]`']

fn by_stages[title, names, edges]
    picks = boruvka[len[names], edges]
    log[title]
    stage = 0
    for p in picks
        if p.stage ne stage
            stage = p.stage
            log['  Stage `stage`:']
        log['    `names[p.edge.u]`-`names[p.edge.v]` (`p.edge.weight`)']
    trees = len[names] - len[picks]
    if trees eq 1
        log['  `len[picks]` edges of weight `total_weight[picks]` in all: one tree']
    else
        log['  `len[picks]` edges of weight `total_weight[picks]` in all: `trees` trees']

task_example[]
log['']
--- The seven-town graph of Wikipedia's Kruskal and Prim articles.
by_stages['Towns A to G, by stages:', ['A', 'B', 'C', 'D', 'E', 'F', 'G'], [Edge[0, 1, 7], Edge[0, 3, 5], Edge[1, 2, 8], Edge[1, 3, 9], Edge[1, 4, 7], Edge[2, 4, 5], Edge[3, 4, 15], Edge[3, 5, 6], Edge[4, 5, 8], Edge[4, 6, 9], Edge[5, 6, 11]]]
log['']
by_stages['Two islands (a minimum spanning forest):', ['P', 'Q', 'R', 'S', 'T'], [Edge[0, 1, 3], Edge[1, 2, 1], Edge[0, 2, 2], Edge[3, 4, 7]]]
