--- Rosetta Code: Euclidean rhythm
--- https://rosettacode.org/wiki/Euclidean_rhythm
--- The grouping the task describes: m groups "1" in front and n - m groups "0"
--- behind. A round appends a group from behind to each of as many groups in
--- front as it can, and the groups left over, front or behind, are the new back.
--- The zeros are handed out until none is left; after that the rounds go on
--- while more than one group would be paired. Then the groups are read out.

fn euclid[m, n]
    front = for i in range[m]
        '1'
    back = for i in range[n - m]
        '0'
    zeros = true
    while len[front] gt 0 and len[back] gt 0 and (zeros or min[len[front], len[back]] gt 1)
        k = min[len[front], len[back]]
        paired = for i in range[k]
            '`front[i]``back[i]`'
        if len[front] gt k
            back = slice[front, k, len[front]]
            zeros = false
        else
            back = slice[back, k, len[back]]
        front = paired
    head = join[front, '']
    tail = join[back, '']
    return '`head``tail`'

log['E(5, 13) = `euclid[5, 13]`']
log['']
log['More onsets in more steps:']
pairs = [[2, 5], [3, 4], [3, 8], [4, 9], [5, 7], [5, 8], [5, 12], [7, 12], [7, 16], [9, 16], [13, 24], [0, 4], [4, 4]]
for p in pairs
    log['E(`p[0]`, `p[1]`) = `euclid[p[0], p[1]]`']
