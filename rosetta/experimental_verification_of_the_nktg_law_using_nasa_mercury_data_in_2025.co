--- Rosetta Code: Experimental Verification of the NKTg Law Using NASA Mercury Data in 2025
--- https://rosettacode.org/wiki/Experimental_Verification_of_the_NKTg_Law_Using_NASA_Mercury_Data_in_2025
--- NKTg₁ = x·m·v is fixed by the reference row (2024-12-31); for each 2025 row the law gives
--- v = NKTg₁ / (x·m), then p = m·v, NKTg₂ = (dm/dt)·p and the error against NASA's v.
--- The rows are the task's tables as text; fmt has no exponent form, so `sci` writes C's %e.

use math

struct Row [date, x, v, m]

fn row_of[line]
    --- a line of a table: the date, then x (m), v (m/s) and m (kg)
    cells = split[line, ' ']
    return Row[cells[0], float[cells[1]], float[cells[2]], float[cells[3]]]

fn sci[x, digits]
    --- x as C's %.<digits>e writes it: one digit, the point, `digits` more, then the exponent
    if x eq 0.0
        zeros = repeat['0', digits]
        return '0.`zeros`e+00'
    sign = ''
    a = x
    if x lt 0.0
        sign = '-'
        a = -x
    e = floor[log10[a]]
    mantissa = a / 10.0 ^ e
    if mantissa lt 1.0
        mantissa = mantissa * 10.0
        e = e - 1
    text = fmt[mantissa, decimals = digits]
    if starts[text, '10']
        e = e + 1
        text = fmt[mantissa / 10.0, decimals = digits]
    esign = '+'
    if e lt 0
        esign = '-'
    power = fmt[abs[e], width = 2, fill = '0']
    return '`sign``text`e`esign``power`'

fn right[text, width]
    return fmt[text, width = width, align = 'right']

--- NASA JPL Horizons, the last row of 2024 (table 1) and the rows of 2025 (table 3)
reference = row_of['2024-12-31 4.64E+10 5.81E+04 3.30E+23']
nasa_2025 = for line in [
    '2025-01-01 5.16E+10 5.34E+04 3.30E+23',
    '2025-04-01 6.97E+10 3.89E+04 3.30E+23',
    '2025-07-01 5.49E+10 5.04E+04 3.30E+23',
    '2025-10-01 6.83E+10 3.98E+04 3.30E+23',
    '2025-12-31 4.61E+10 5.89E+04 3.30E+23'
]
    row_of[line]
dm_dt = -0.5

nktg1 = reference.x * (reference.m * reference.v)
log['Reference, NASA `reference.date`: x = `sci[reference.x, 2]` m, v = `sci[reference.v, 2]` m/s, m = `sci[reference.m, 2]` kg']
log['NKTg₁ = x·m·v = `sci[nktg1, 3]`, held constant; dm/dt = `dm_dt` kg/s']
log['']
header = [fmt['Date', width = 10], right['v NKTg (m/s)', 12], right['v NASA (m/s)', 12], right['Error (%)', 9], right['p = m·v', 10], right['NKTg₂ = (dm/dt)·p', 17]]
log[join[header, '  ']]
for row in nasa_2025
    v = nktg1 / (row.x * row.m)
    p = row.m * v
    nktg2 = dm_dt * p
    deviation = (v - row.v) / row.v * 100.0
    cells = [row.date, right[sci[v, 3], 12], right[sci[row.v, 3], 12], right[fmt[deviation, decimals = 4], 9], right[sci[p, 3], 10], right[sci[nktg2, 3], 17]]
    log[join[cells, '  ']]
log['']
log['NKTg₂ is negative on every date: the loss of mass works against the motion.']
