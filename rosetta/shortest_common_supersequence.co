--- Rosetta Code: Shortest common supersequence
--- https://rosettacode.org/wiki/Shortest_common_supersequence
--- A longest common subsequence comes from the table of LCS lengths of every two
--- prefixes, read back from the end. The supersequence walks both strings beside
--- it: a character of the LCS is written once when both strings reach it, and
--- every other character as it comes, so the result has len(u) + len(v) - len(lcs)
--- characters, which is the least possible.

fn lcs[u, v]
    a = split[u, '']
    b = split[v, '']
    n = len[a]
    m = len[b]
    lengths = for i in range[n + 1]
        row = for j in range[m + 1]
            0
        row
    for i in range[1, n + 1]
        for j in range[1, m + 1]
            if a[i - 1] eq b[j - 1]
                lengths[i][j] = lengths[i - 1][j - 1] + 1
            else
                lengths[i][j] = max[lengths[i - 1][j], lengths[i][j - 1]]
    common = []
    i = n
    j = m
    while i gt 0 and j gt 0
        if a[i - 1] eq b[j - 1]
            common = push[common, a[i - 1]]
            i = i - 1
            j = j - 1
        else if lengths[i - 1][j] gte lengths[i][j - 1]
            i = i - 1
        else
            j = j - 1
    return join[reverse[common], '']

fn scs[u, v]
    common = split[lcs[u, v], '']
    a = split[u, '']
    b = split[v, '']
    out = []
    i = 0
    j = 0
    for c in common
        while a[i] ne c
            out = push[out, a[i]]
            i = i + 1
        while b[j] ne c
            out = push[out, b[j]]
            j = j + 1
        out = push[out, c]
        i = i + 1
        j = j + 1
    rest = concat[slice[a, i, len[a]], slice[b, j, len[b]]]
    return join[concat[out, rest], '']

--- whether the characters of part appear in whole in order
fn is_subsequence[part, whole]
    p = split[part, '']
    k = 0
    for c in split[whole, '']
        if k lt len[p] and p[k] eq c
            k = k + 1
    return k eq len[p]

fn shown[s]
    if s eq ''
        return '(none)'
    return s

fn report[u, v]
    common = lcs[u, v]
    s = scs[u, v]
    holds = is_subsequence[u, s] and is_subsequence[v, s]
    log['u = `u`, v = `v`']
    log['    longest common subsequence:   `shown[common]`']
    log['    shortest common supersequence: `s`']
    log['    `len[s]` characters = `len[u]` + `len[v]` - `len[common]`; u and v are subsequences of it: `holds`']

report['abcbdab', 'bdcaba']
report['WEASELS', 'WARDANCE']
report['AGGTAB', 'GXTXAYB']
report['abc', 'def']
report['crow', 'crow']
