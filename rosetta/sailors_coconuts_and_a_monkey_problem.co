--- Rosetta Code: Sailors, coconuts and a monkey problem
--- https://rosettacode.org/wiki/Sailors,_coconuts_and_a_monkey_problem
--- Every pile size is tried, smallest first, and the tale is told over it with
--- integer division and remainders: each sailor in turn finds one coconut over
--- when he divides the pile into as many shares as there are sailors, gives it
--- to the monkey, hides a share and leaves the rest; in the morning the pile
--- divides among them with none over. The first pile the tale holds for is the
--- answer. Each night is shown as it goes, as the extra credit asks.

--- whether the tale holds for a pile of n coconuts and k sailors
fn tale_holds[n, k]
    pile = n
    s = 0
    while s lt k
        if pile % k ne 1 or pile lt k
            return false
        pile = pile - pile / k - 1
        s = s + 1
    pile % k eq 0 and pile gt 0

fn smallest_pile[k]
    n = 1
    while not tale_holds[n, k]
        n = n + 1
    n

fn tell[n, k]
    log['`k` sailors: the pile held `n` coconuts']
    pile = n
    s = 1
    while s lte k
        share = pile / k
        left = pile - share - 1
        log['    sailor `s` divides `fmt[pile, width = 6]`: 1 to the monkey, hides `fmt[share, width = 5]`, leaves `left`']
        pile = left
        s = s + 1
    log['    in the morning `pile` coconuts make `k` shares of `pile / k`, none over']
    log['']

for k in [5, 6]
    tell[smallest_pile[k], k]

log['the smallest pile for other numbers of sailors:']
for k in range[2, 8]
    log['    `k` sailors: `smallest_pile[k]`']
