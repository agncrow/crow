--- Rosetta Code: Password generator
--- https://rosettacode.org/wiki/Password_generator
--- One character drawn from each of the four groups, the rest from all of them, then
--- shuffled (Fisher-Yates), so every password holds each group at least once. The
--- options come from the command line (--help lists them); the draws are the program's
--- random generator, seeded only when --seed is given. Run with no arguments, the
--- program shows itself on a few command lines, each seeded so that every run prints
--- the same, then checks 2,000 more passwords for the four groups.

use math

struct Options [length, count, seed, seeded, exclude, help]

fn help_text[]
    lines = [
        'password_generator: random passwords of printable ASCII, one per line, each',
        'holding at least one lower-case letter, one upper-case letter, one digit and',
        'one other character of !"#$%&\'()*+,-./:;<=>?@[]^_{|}~',
        '',
        'options:',
        '  -l, --length N          characters in each password (default 12, at least 4)',
        '  -c, --count N           how many passwords (default 1)',
        '  -s, --seed N            seed the generator: the same passwords every run',
        '  -x, --exclude-similar   leave out the look-alikes I l 1 O 0 5 S 2 Z',
        '  -h, --help              this text'
    ]
    return join[lines, '\n']

--- the number after the option at `i`
fn number_after[given, i]
    if i + 1 gte len[given]
        return error['`given[i]` needs a number after it', 'usage']
    n = int[given[i + 1]]
    if not n.ok or n lt 0
        return error['`given[i]` needs a number after it, not \'`given[i + 1]`\'', 'usage']
    return n

fn options_of[given]
    o = Options[12, 1, 0, false, false, false]
    i = 0
    while i lt len[given]
        a = given[i]
        if a eq '-h' or a eq '--help'
            o.help = true
        else if a eq '-x' or a eq '--exclude-similar'
            o.exclude = true
        else if a in ['-l', '--length', '-c', '--count', '-s', '--seed']
            n = number_after[given, i]
            if not n.ok
                return n
            if a eq '-l' or a eq '--length'
                o.length = n
            else if a eq '-c' or a eq '--count'
                o.count = n
            else
                o.seed = n
                o.seeded = true
            i = i + 1
        else
            return error['\'`a`\' is no option', 'usage']
        i = i + 1
    if o.length lt 4
        return error['a password holds one of each of four groups: --length is 4 or more', 'usage']
    return o

fn without[s, similar]
    kept = for c in split[s, '']
        if c not in similar
            c
    return join[kept, '']

--- lower-case letters, upper-case letters, digits and the other printable characters
fn groups[exclude]
    lowers = 'abcdefghijklmnopqrstuvwxyz'
    uppers = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ'
    digits = '0123456789'
    others = '!"#$%&\'()*+,-./:;<=>?@[]^_{|}~'
    sets = [lowers, uppers, digits, others]
    if exclude
        sets = for s in sets
            without[s, 'Il1O05S2Z']
    return sets

fn pick[s]
    return s[rand[len[s]]]

fn shuffled[xs]
    ys = xs
    i = len[ys] - 1
    while i gt 0
        j = rand[i + 1]
        t = ys[i]
        ys[i] = ys[j]
        ys[j] = t
        i = i - 1
    return ys

fn password[sets, length]
    one_each = for s in sets
        pick[s]
    every = join[sets, '']
    rest = for i in range[length - len[sets]]
        pick[every]
    return join[shuffled[concat[one_each, rest]], '']

--- the program as run with these command-line arguments
fn run[given]
    o = options_of[given]
    if not o.ok
        log['password_generator: `o.reason` (--help lists the options)']
    else if o.help
        log[help_text[]]
    else
        if o.seeded
            seed[o.seed]
        sets = groups[o.exclude]
        for k in range[o.count]
            log[password[sets, o.length]]

fn holds_each[p, sets]
    for s in sets
        found = false
        for c in split[p, '']
            if c in s
                found = true
        if not found
            return false
    return true

given = args[]
if len[given] gt 0
    run[given]
else
    demos = [
        ['--help'], ['--length', '12', '--count', '5', '--seed', '42'],
        ['-l', '20', '-c', '3', '-s', '7', '-x'], ['-l', '4', '-c', '4', '-s', '1'], ['-l', '3'],
        ['--count'], ['-q']
    ]
    for demo in demos
        line = join[demo, ' ']
        log['$ crow run password_generator.co `line`']
        run[demo]
        log['']
    --- 2,000 more: every one holds each group, and none a look-alike when they are left out
    seed[2026]
    plain = groups[false]
    apart = groups[true]
    bad = 0
    for k in range[1000]
        p = password[plain, 4]
        q = password[apart, 8]
        if not holds_each[p, plain] or not holds_each[q, apart] or len[without[q, 'Il1O05S2Z']] ne 8
            bad = bad + 1
    log['2,000 more checked (of 4, and of 8 without look-alikes): `bad` lack a group or hold a look-alike']
