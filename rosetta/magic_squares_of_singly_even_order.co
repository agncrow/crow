--- Rosetta Code: Magic squares of singly even order
--- https://rosettacode.org/wiki/Magic_squares_of_singly_even_order
--- Strachey's method: an odd magic square of order n/2 fills the four quadrants, raised by
--- 0, 2, 3 and 1 times (n/2)^2 (top left, top right, bottom left, bottom right); then
--- some columns of the top half trade places with the bottom half's to mend the sums.

--- The Siamese method for the odd quadrant.
fn odd_magic_square[n]
    square = for r in range[n]
        row = for c in range[n]
            0
        row
    r = 0
    c = n / 2
    for k in range[1, n * n + 1]
        square[r][c] = k
        up = (r - 1 + n) % n
        right = (c + 1) % n
        if square[up][right] eq 0
            r = up
            c = right
        else
            r = (r + 1) % n
    return square

fn singly_even_square[n]
    half = n / 2
    base = odd_magic_square[half]
    block = half * half
    raise = [0, 2, 3, 1]
    square = for r in range[n]
        row = for c in range[n]
            quadrant = r / half * 2 + c / half
            base[r % half][c % half] + raise[quadrant] * block
        row
    --- The leftmost half/2 columns trade (in the middle row, shifted one to the right),
    --- and the rightmost half/2 - 1.
    left = half / 2
    right = left - 1
    for r in range[half]
        for c in range[n]
            trade = c lt left or c gte n - right or (c eq left and r eq left)
            if trade and not (c eq 0 and r eq left)
                t = square[r][c]
                square[r][c] = square[r + half][c]
                square[r + half][c] = t
    return square

fn magic_number[n]
    return n * (n * n + 1) / 2

--- Every row, every column and both diagonals add up to the magic number,
--- and the square holds each of 1 to n^2 once.
fn is_magic[square]
    n = len[square]
    want = magic_number[n]
    seen = for i in range[n * n + 1]
        false
    diagonal = 0
    anti = 0
    good = true
    for i in range[n]
        across = 0
        down = 0
        for j in range[n]
            across = across + square[i][j]
            down = down + square[j][i]
            seen[square[i][j]] = true
        if across ne want or down ne want
            good = false
        diagonal = diagonal + square[i][i]
        anti = anti + square[i][n - 1 - i]
    every = all[slice[seen, 1, n * n + 1], is_true]
    return good and every and diagonal eq want and anti eq want

fn is_true[b]
    return b

fn show[square]
    n = len[square]
    width = len[str[n * n]]
    for row in square
        cells = for x in row
            fmt[x, width = width]
        log[join[cells, ' ']]

for n in [6, 10]
    log['Order `n`']
    square = singly_even_square[n]
    show[square]
    log['Magic number: `magic_number[n]` (checked: `is_magic[square]`)']
    log['']
