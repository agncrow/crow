--- Rosetta Code: Kolakoski sequence
--- https://rosettacode.org/wiki/Kolakoski_sequence
--- The sequence grows from the cycle's items in turn, the k-th member saying
--- how many times the k-th item is written. The check compares the sequence
--- with the lengths of its runs, the last run left out (it may be cut short).

--- the item of the cycle c at step k (the cycle read over and over)
fn next_in_cycle[c, k]
    return c[k % len[c]]

--- the first n members of the sequence the cycle c generates
fn kolakoski[c, n]
    s = []
    k = 0
    while len[s] lt n
        item = next_in_cycle[c, k]
        s = push[s, item]
        j = 1
        while j lt s[k]
            s = push[s, item]
            j = j + 1
        k = k + 1
    return slice[s, 0, n]

--- the lengths of the runs of equal members, the last run's left out
fn run_lengths[s]
    lengths = []
    count = 1
    i = 1
    while i lt len[s]
        if s[i] eq s[i - 1]
            count = count + 1
        else
            lengths = push[lengths, count]
            count = 1
        i = i + 1
    return lengths

--- whether s starts with the lengths of its own runs
fn possible_kolakoski[s]
    lengths = run_lengths[s]
    return lengths eq slice[s, 0, len[lengths]]

--- a nested literal of numbers is a rectangular matrix: cycles of two lengths
--- are pushed one by one
cycles = []
cycles = push[cycles, [1, 2]]
cycles = push[cycles, [2, 1]]
cycles = push[cycles, [1, 3, 1, 2]]
cycles = push[cycles, [1, 3, 2, 1]]
lengths = [20, 20, 30, 30]
for i in range[len[cycles]]
    s = kolakoski[cycles[i], lengths[i]]
    answer = 'No'
    if possible_kolakoski[s]
        answer = 'Yes'
    log['First `lengths[i]` members of the sequence generated by `cycles[i]`:']
    log[s]
    log['Possible Kolakoski sequence? `answer`']
    log['']

long = kolakoski[[1, 2], 100000]
log['The first 100,000 members from [1, 2] start with their own run lengths: `possible_kolakoski[long]`']
