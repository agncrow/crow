--- Rosetta Code: Largest int from concatenated ints
--- https://rosettacode.org/wiki/Largest_int_from_concatenated_ints
--- Two ways: an insertion sort of the numbers' texts where x goes before y when
--- x then y reads larger than y then x, and a sort by key, each text repeated to
--- twice the longest one's length, largest first. Trying every order checks both.

fn goes_first[x, y]
    --- x then y and y then x have one length, so text compares as the number
    return join[[x, y], ''] gt join[[y, x], '']

fn texts_of[nums]
    texts = for n in nums
        str[n]
    return texts

fn largest_by_pairs[nums]
    texts = texts_of[nums]
    i = 1
    while i lt len[texts]
        j = i
        while j gt 0 and goes_first[texts[j], texts[j - 1]]
            held = texts[j]
            texts[j] = texts[j - 1]
            texts[j - 1] = held
            j = j - 1
        i = i + 1
    return int[join[texts, '']]

fn largest_by_keys[nums]
    --- x then y beats y then x exactly where x repeated forever beats y repeated
    --- forever, and two such repetitions that differ do so within the first
    --- len x + len y characters: twice the longest length is enough
    texts = texts_of[nums]
    longest = 0
    for t in texts
        longest = max[longest, len[t]]
    keyed = for t in texts
        key = slice[repeat[t, 2 * longest], 0, 2 * longest]
        '`key` `t`'
    parts = for k in reverse[sort[keyed]]
        split[k, ' '][1]
    return int[join[parts, '']]

fn best_order[texts]
    --- the largest text of every order of the texts: each first in turn, then
    --- the best order of the rest (every order has the same length)
    if len[texts] eq 1
        return texts[0]
    best = ''
    i = 0
    while i lt len[texts]
        rest = concat[slice[texts, 0, i], slice[texts, i + 1, len[texts]]]
        candidate = join[[texts[i], best_order[rest]], '']
        if candidate gt best
            best = candidate
        i = i + 1
    return best

fn report[nums]
    by_pairs = largest_by_pairs[nums]
    by_keys = largest_by_keys[nums]
    by_trying = int[best_order[texts_of[nums]]]
    log['Numbers: `nums`']
    log['  Largest integer: `fmt[by_pairs, width = 15]`']
    log['  by keys: `by_keys eq by_pairs`, by trying every order: `by_trying eq by_pairs`']

report[[1, 34, 3, 98, 9, 76, 45, 4]]
report[[54, 546, 548, 60]]
--- keys only as long as the longest text would tie here (212 repeated and cut to
--- five is 21221), and the two orders give different numbers
report[[212, 21221]]
