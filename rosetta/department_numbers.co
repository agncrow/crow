--- Rosetta Code: Department numbers
--- https://rosettacode.org/wiki/Department_numbers
--- Police takes each even number and sanitation each number from 1 to 7; fire
--- is what is left of 12, kept when it lies in 1 to 7 and all three differ.

fn assignments[]
    found = []
    for police in range[2, 8, 2]
        for sanitation in range[1, 8]
            fire = 12 - police - sanitation
            if fire gte 1 and fire lte 7 and sanitation ne police and fire ne police and fire ne sanitation
                found = push[found, [police, sanitation, fire]]
    return found

found = assignments[]
log['police  sanitation  fire']
for a in found
    log['`fmt[a[0], width = 6]`  `fmt[a[1], width = 10]`  `fmt[a[2], width = 4]`']
log['`len[found]` valid combinations']
