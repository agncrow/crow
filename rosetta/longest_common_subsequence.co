--- Rosetta Code: Longest common subsequence
--- https://rosettacode.org/wiki/Longest_common_subsequence
--- Dynamic programming: lengths[i][j] is the length of an LCS of the first i
--- characters of a and the first j of b. A walk back from the far corner reads one
--- LCS off the table: a character the two share at that corner is taken, otherwise
--- the walk moves to the neighbour that keeps the longer length. The characters an
--- LCS takes are marked under each string, as the task's examples underline them.

struct Common [text, in_a, in_b]

fn lcs_lengths[xs, ys]
    lengths = for i in range[len[xs] + 1]
        row = for j in range[len[ys] + 1]
            0
        row
    i = 1
    while i lte len[xs]
        j = 1
        while j lte len[ys]
            if xs[i - 1] eq ys[j - 1]
                lengths[i][j] = lengths[i - 1][j - 1] + 1
            else
                lengths[i][j] = max[lengths[i - 1][j], lengths[i][j - 1]]
            j = j + 1
        i = i + 1
    return lengths

--- An LCS of a and b, with the positions its characters hold in each.
fn lcs[a, b]
    xs = split[a, '']
    ys = split[b, '']
    lengths = lcs_lengths[xs, ys]
    taken = []
    in_a = []
    in_b = []
    i = len[xs]
    j = len[ys]
    while i gt 0 and j gt 0
        if xs[i - 1] eq ys[j - 1]
            taken = push[taken, xs[i - 1]]
            in_a = push[in_a, i - 1]
            in_b = push[in_b, j - 1]
            i = i - 1
            j = j - 1
        else if lengths[i - 1][j] gte lengths[i][j - 1]
            i = i - 1
        else
            j = j - 1
    return Common[join[reverse[taken], ''], reverse[in_a], reverse[in_b]]

--- A '^' under each position of a text that the LCS takes.
fn marks[positions]
    line = for k in range[positions[-1] + 1]
        if k in positions
            '^'
        else
            ' '
    return join[line, '']

fn show[a, b]
    c = lcs[a, b]
    log['"`a`" and "`b`": "`c.text`", `len[c.in_a]` characters']
    log['  `a`']
    if c.text ne ''
        log['  `marks[c.in_a]`']
    log['  `b`']
    if c.text ne ''
        log['  `marks[c.in_b]`']

show['1234', '1224533324']
log['']
show['thisisatest', 'testing123testing']
log['']
show['AGGTAB', 'GXTXAYB']
log['']
show['ABCBDAB', 'BDCABA']
log['']
show['abc', 'xyz']
