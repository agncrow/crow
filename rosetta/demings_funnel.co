--- Rosetta Code: Deming's funnel
--- https://rosettacode.org/wiki/Deming's_funnel
--- Each rule is a function from the funnel's position and the drop's displacement
--- to the funnel's next position; a run keeps where every marble lands. The
--- 100 displacements of the Racket solution give the required table; stretch 1
--- repeats it on fresh seeded draws (radius from a normal distribution, angle
--- uniform), and stretch 2 draws the four scatter plots in characters.

use math, math.stats

--- rule 1: the funnel stays over the target
fn rule1[z, d]
    0.0

--- rule 2: move the funnel by the miss, from where it is
fn rule2[z, d]
    z - (z + d)

--- rule 3: back over the target, then move by the miss
fn rule3[z, d]
    0.0 - (z + d)

--- rule 4: the funnel goes where the marble landed
fn rule4[z, d]
    z + d

--- where the marbles land, one axis at a time
fn funnel[ds, rule]
    z = 0.0
    landed = []
    for d in ds
        landed = push[landed, z + d]
        z = rule[z, d]
    return landed

fn four[x]
    fmt[x, decimals = 4]

fn experiment[label, dxs, dys, rule]
    xs = funnel[dxs, rule]
    ys = funnel[dys, rule]
    log[label]
    log['Mean x, y    : `four[mean[xs]]`, `four[mean[ys]]`']
    log['Std dev x, y : `four[std[xs]]`, `four[std[ys]]`']
    log['']

fn experiments[dxs, dys]
    experiment['Rule 1:', dxs, dys, rule1]
    experiment['Rule 2:', dxs, dys, rule2]
    experiment['Rule 3:', dxs, dys, rule3]
    experiment['Rule 4:', dxs, dys, rule4]

--- a scatter plot in characters, -13 to 13 on each axis: a column a unit,
--- a row two units; + is the target, o a marble
fn plot[label, xs, ys]
    grid = for row in range[14]
        cells = for col in range[27]
            ' '
        cells
    grid[7][13] = '+'
    for i in range[len[xs]]
        col = round[xs[i]] + 13
        row = round[(13.0 - ys[i]) / 2.0]
        if col gte 0 and col lt 27 and row gte 0 and row lt 14
            grid[row][col] = 'o'
    edge = repeat['-', 27]
    lines = [fmt[label, width = 29], '+`edge`+']
    for cells in grid
        line = join[cells, '']
        lines = push[lines, '|`line`|']
    lines = push[lines, '+`edge`+']
    return lines

fn panel[label, dxs, dys, rule]
    plot[label, funnel[dxs, rule], funnel[dys, rule]]

fn side_by_side[left, right]
    for i in range[len[left]]
        line = '`left[i]`    `right[i]`'
        log[trim[line]]

fn scatter_plots[dxs, dys]
    side_by_side[panel['Rule 1', dxs, dys, rule1], panel['Rule 2', dxs, dys, rule2]]
    log['']
    side_by_side[panel['Rule 3', dxs, dys, rule3], panel['Rule 4', dxs, dys, rule4]]

dxs = [-0.533, 0.27, 0.859, -0.043, -0.205, -0.127, -0.071, 0.275, 1.251, -0.231, -0.401, 0.269, 0.491, 0.951, 1.15, 0.001, -0.382, 0.161, 0.915, 2.08, -2.337, 0.034, -0.126, 0.014, 0.709, 0.129, -1.093, -0.483, -1.193, 0.02, -0.051, 0.047, -0.095, 0.695, 0.34, -0.182, 0.287, 0.213, -0.423, -0.021, -0.134, 1.798, 0.021, -1.099, -0.361, 1.636, -1.134, 1.315, 0.201, 0.034, 0.097, -0.17, 0.054, -0.553, -0.024, -0.181, -0.7, -0.361, -0.789, 0.279, -0.174, -0.009, -0.323, -0.658, 0.348, -0.528, 0.881, 0.021, -0.853, 0.157, 0.648, 1.774, -1.043, 0.051, 0.021, 0.247, -0.31, 0.171, 0.0, 0.106, 0.024, -0.386, 0.962, 0.765, -0.125, -0.289, 0.521, 0.017, 0.281, -0.749, -0.149, -2.436, -0.909, 0.394, -0.113, -0.598, 0.443, -0.521, -0.799, 0.087]
dys = [0.136, 0.717, 0.459, -0.225, 1.392, 0.385, 0.121, -0.395, 0.49, -0.682, -0.065, 0.242, -0.288, 0.658, 0.459, 0.0, 0.426, 0.205, -0.765, -2.188, -0.742, -0.01, 0.089, 0.208, 0.585, 0.633, -0.444, -0.351, -1.087, 0.199, 0.701, 0.096, -0.025, -0.868, 1.051, 0.157, 0.216, 0.162, 0.249, -0.007, 0.009, 0.508, -0.79, 0.723, 0.881, -0.508, 0.393, -0.226, 0.71, 0.038, -0.217, 0.831, 0.48, 0.407, 0.447, -0.295, 1.126, 0.38, 0.549, -0.445, -0.046, 0.428, -0.074, 0.217, -0.822, 0.491, 1.347, -0.141, 1.23, -0.044, 0.079, 0.219, 0.698, 0.275, 0.056, 0.031, 0.421, 0.064, 0.721, 0.104, -0.729, 0.65, -1.103, 0.154, -1.72, 0.051, -0.385, 0.477, 1.537, -0.901, 0.939, -0.411, 0.341, -0.411, 0.106, 0.224, -0.947, -1.424, -0.542, -1.032]

experiments[dxs, dys]

--- stretch 1: fresh displacements, a normal radius and a uniform angle
seed[1950]
radii = abs[randn[100]]
angles = uniform[0.0 - pi, pi, 100]
log['Fresh data (seeded): radius from N(0, 1), angle uniform']
log['']
experiments[radii .* cos[angles], radii .* sin[angles]]

--- stretch 2: the four scatter plots of the given data
scatter_plots[dxs, dys]
