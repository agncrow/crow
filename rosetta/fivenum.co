--- Rosetta Code: Fivenum
--- https://rosettacode.org/wiki/Fivenum
--- Tukey's five-number summary as R's fivenum computes it: the minimum, the lower
--- hinge, the median, the upper hinge and the maximum of the sorted numbers, each
--- the mean of the two items around its depth (one item when the depth is whole).

fn fivenum[numbers]
    n = len[numbers]
    if n eq 0
        return error['an empty list has no five-number summary', 'empty']
    x = sort[numbers]
    hinge = ((n + 3) / 2) / 2.0
    depths = [1.0, hinge, (n + 1) / 2.0, n + 1 - hinge, float[n]]
    summary = for depth in depths
        0.5 * (x[floor[depth - 1]] + x[ceil[depth - 1]])
    return summary

log[fivenum[[15.0, 6.0, 42.0, 41.0, 7.0, 36.0, 49.0, 40.0, 39.0, 47.0, 43.0]]]
log[fivenum[[36.0, 40.0, 7.0, 39.0, 41.0, 15.0]]]
log[fivenum[[0.14082834, 0.09748790, 1.73131507, 0.87636009, -1.95059594,
    0.73438555, -0.03035726, 1.46675970, -0.74621349, -0.72588772,
    0.63905160, 0.61501527, -0.98983780, -1.00447874, -0.62759469,
    0.66206163, 1.04312009, -0.10305385, 0.75775634, 0.32566578]]]
log[fivenum[[1, 2, 3, 4, 5, 6]]]
empty = fivenum[[]]
log[empty.reason]
