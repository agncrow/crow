--- Rosetta Code: Magic squares of odd order
--- https://rosettacode.org/wiki/Magic_squares_of_odd_order
--- The Siamese method: 1 goes in the middle of the top row, and each next number
--- goes one up and one right (wrapping round the edges), or one down when that cell is taken.

fn empty_square[n]
    rows = for r in range[n]
        row = for c in range[n]
            0
        row
    rows

fn magic_square[n]
    square = empty_square[n]
    r = 0
    c = n / 2
    for k in range[1, n * n + 1]
        square[r][c] = k
        up = (r - 1 + n) % n
        right = (c + 1) % n
        if square[up][right] eq 0
            r = up
            c = right
        else
            r = (r + 1) % n
    return square

fn magic_number[n]
    return n * (n * n + 1) / 2

--- Every row, every column and both diagonals add up to the magic number.
fn is_magic[square]
    n = len[square]
    want = magic_number[n]
    diagonal = 0
    anti = 0
    good = true
    for i in range[n]
        across = 0
        down = 0
        for j in range[n]
            across = across + square[i][j]
            down = down + square[j][i]
        if across ne want or down ne want
            good = false
        diagonal = diagonal + square[i][i]
        anti = anti + square[i][n - 1 - i]
    return good and diagonal eq want and anti eq want

fn show[square]
    n = len[square]
    width = len[str[n * n]]
    for row in square
        cells = for x in row
            fmt[x, width = width]
        log[join[cells, ' ']]

for n in [5, 3, 7]
    log['Order `n`']
    square = magic_square[n]
    show[square]
    log['Magic number: `magic_number[n]` (checked: `is_magic[square]`)']
    log['']
