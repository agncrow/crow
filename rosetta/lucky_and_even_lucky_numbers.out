usage: crow run lucky_and_even_lucky_numbers.co j [k | ,] [lucky | evenLucky]
  j          the j-th number
  j k        the j-th through the k-th
  j -k       those from j to |k| in value

args: 1 20 lucky
    lucky numbers 1 through 20: 1 3 7 9 13 15 21 25 31 33 37 43 49 51 63 67 69 73 75 79
args: 1 20 evenLucky
    even lucky numbers 1 through 20: 2 4 6 10 12 18 20 22 26 34 36 42 44 50 52 54 58 68 70 76
args: 6000 -6100 lucky
    lucky numbers from 6000 to 6100: 6009 6019 6031 6049 6055 6061 6079 6093
args: 6000 -6100 evenLucky
    even lucky numbers from 6000 to 6100: 6018 6020 6022 6026 6036 6038 6050 6058 6074 6090 6092
args: 10000
    lucky number 10000: 115591
args: 10000 , lucky
    lucky number 10000: 115591
args: 10000 , evenLucky
    even lucky number 10000: 111842
args: 10000,evenlucky
    even lucky number 10000: 111842
args: 5 EVENLUCKY
    even lucky number 5: 12
args: 
    error: missing arguments: give at least j
args: 1 20 lucky 30
    error: too many arguments: 4 given, at most 3
args: 1 x lucky
    error: k must be a whole number, not 'x'
args: 0 20
    error: j must be 1 to 100000, not 0
args: 20 10
    error: |k| must not be below j: 10 is less than 20
args: 6100 -6000
    error: |k| must not be below j: 6000 is less than 6100
args: 1 20 lucki
    error: 'lucki' is neither lucky nor evenLucky
args: 1.5
    error: j must be a whole number, not '1.5'
