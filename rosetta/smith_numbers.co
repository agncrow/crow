--- Rosetta Code: Smith numbers
--- https://rosettacode.org/wiki/Smith_numbers
--- A Smith number is composite, and the digits of its prime factors, each factor
--- counted as often as it divides, add up to as much as its own digits. The factors
--- come from a table of each number's least prime factor, made by a sieve, and the
--- digit sums from a table made a digit at a time (the sum for n is the sum for n / 10
--- plus n's last digit). All 376 below 10,000, then how many there are below each power
--- of ten to a million (OEIS A104170: 1, 6, 49, 376, 3294, 29928).

--- the least prime factor of each number below n (0 for 0 and 1)
fn least_factors[n]
    least = for i in range[n]
        0
    for p in range[2, n]
        if least[p] eq 0
            j = p
            while j lt n
                if least[j] eq 0
                    least[j] = p
                j = j + p
    return least

--- the sum of the decimal digits of each number below n
fn digit_sums[n]
    sums = for i in range[n]
        0
    for i in range[1, n]
        sums[i] = sums[i / 10] + i % 10
    return sums

fn is_smith[n, least, sums]
    if n lt 4 or least[n] eq n
        return false
    total = 0
    m = n
    while m gt 1
        p = least[m]
        total = total + sums[p]
        m = m / p
    return total eq sums[n]

limit = 1000000
least = least_factors[limit]
sums = digit_sums[limit]
smith = for n in range[limit]
    if is_smith[n, least, sums]
        n
below = for n in smith
    if n lt 10000
        n
log['The `len[below]` Smith numbers below 10,000:']
for r in range[(len[below] + 15) / 16]
    cells = for n in slice[below, 16 * r, 16 * r + 16]
        fmt[n, width = 5]
    log[join[cells, '']]
log['']
power = 10
while power lte limit
    count = 0
    for n in smith
        if n lt power
            count = count + 1
    shown = fmt[power, width = 9, commas = true]
    counted = fmt[count, width = 6, commas = true]
    log['Smith numbers below `shown`: `counted`']
    power = power * 10
