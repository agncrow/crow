--- Rosetta Code: Abbreviations, simple
--- https://rosettacode.org/wiki/Abbreviations,_simple
--- The table is read into commands, each with the shortest abbreviation the
--- number after it allows (no number: none but the whole word); a word stands
--- for the first command, in the table's order, that it abbreviates.

struct Command [name, least]

command_table = 'add 1  alter 3  backup 2  bottom 1  Cappend 2  change 1  Schange  Cinsert 2  Clast 3
compress 4 copy 2 count 3 Coverlay 3 cursor 3  delete 3 Cdelete 2  down 1  duplicate
3 xEdit 1 expand 3 extract 3  find 1 Nfind 2 Nfindup 6 NfUP 3 Cfind 2 findUP 3 fUP 2
forward 2  get  help 1 hexType 4  input 1 powerInput 3  join 1 split 2 spltJOIN load
locate 1 Clocate 2 lowerCase 3 upperCase 3 Lprefix 2  macro  merge 2 modify 3 move 2
msg  next 1 overlay 1 parse preserve 4 purge 3 put putD query 1 quit  read recover 3
refresh renum 3 repeat 3 replace 1 Creplace 2 reset 3 restore 4 rgtLEFT right 2 left
2  save  set  shift 2  si  sort  sos  stack 3 status 4 top  transfer 3  type 1  up 1'

--- the words of a text, however many blanks or line breaks part them
fn split_words[text]
    pieces = split[replace[text, '\n', ' '], ' ']
    words = for w in pieces
        if w ne ''
            w
    return words

fn is_number[word]
    return matches[word, '^[0-9]+$']

--- each command, with the number after it as its shortest abbreviation
fn read_table[text]
    tokens = split_words[text]
    commands = []
    i = 0
    while i lt len[tokens]
        name = tokens[i]
        least = len[name]
        if i + 1 lt len[tokens] and is_number[tokens[i + 1]]
            least = int[tokens[i + 1]]
            i = i + 1
        commands = push[commands, Command[name, least]]
        i = i + 1
    return commands

fn abbreviates[word, command]
    n = len[word]
    return n gte command.least and n lte len[command.name] and starts[upper[command.name], upper[word]]

--- the full command a word stands for, or *error*
fn expand[word, commands]
    i = 0
    while i lt len[commands]
        if abbreviates[word, commands[i]]
            return upper[commands[i].name]
        i = i + 1
    return '*error*'

--- a blank input answers the null string
fn expand_all[user, commands]
    full = for w in split_words[user]
        expand[w, commands]
    return join[full, ' ']

commands = read_table[command_table]
for user in ['', 'riG   rePEAT copies  put mo   rest    types   fup.    6       poweRin']
    full = expand_all[user, commands]
    log['input:  "`user`"']
    log['output: "`full`"']
