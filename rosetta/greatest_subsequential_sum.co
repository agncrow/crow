--- Rosetta Code: Greatest subsequential sum
--- https://rosettacode.org/wiki/Greatest_subsequential_sum
--- Kadane's scan from Programming Pearls, keeping where the best run starts and
--- ends: a running sum restarts after the place it falls below zero, and the best
--- run so far is replaced only by a greater sum, so it is the first of the best.
--- The empty run sums to 0, so a sequence of negatives answers []. Each answer is
--- checked against the greatest sum over every run, found by trying them all.

fn total[xs]
    t = 0
    for x in xs
        t = t + x
    return t

fn greatest_run[xs]
    --- the first run of xs with the greatest sum, empty where none sums above 0
    best = 0
    best_start = 0
    best_end = 0
    run_sum = 0
    start = 0
    for i in range[len[xs]]
        run_sum = run_sum + xs[i]
        if run_sum gt best
            best = run_sum
            best_start = start
            best_end = i + 1
        else if run_sum lt 0
            run_sum = 0
            start = i + 1
    return slice[xs, best_start, best_end]

fn greatest_by_trying[xs]
    --- the greatest sum of any run, the empty one's 0 among them
    best = 0
    for a in range[len[xs]]
        for b in range[a + 1, len[xs] + 1]
            best = max[best, total[slice[xs, a, b]]]
    return best

fn is_true[b]
    return b

--- a nested literal of numbers is a matrix, so lists of several lengths are pushed
sequences = []
sequences = push[sequences, [-1, -2, 3, 5, 6, -2, -1, 4, -4, 2, -1]]
sequences = push[sequences, []]
sequences = push[sequences, [-1]]
sequences = push[sequences, [0]]
sequences = push[sequences, [1, 0]]
sequences = push[sequences, [0, 1, 0]]
sequences = push[sequences, [2, -1, 3, -1]]
sequences = push[sequences, [-1, 1, 2, -5, -6]]
sequences = push[sequences, [-5, -3, -8, -1]]
sequences = push[sequences, [5, -9, 6, -2, 3]]
checks = for xs in sequences
    run = greatest_run[xs]
    log['`fmt[str[xs], width = 40]` -> `str[run]`, sum `total[run]`']
    total[run] eq greatest_by_trying[xs]
log['Each sum is the greatest found by trying every run: `all[checks, is_true]`']
