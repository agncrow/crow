--- OPEN (docs/roadmap.md): runs interpreted, does not build compiled — a record or none through a function
--- a record or none through a function: a child or 0 answered, held, read
struct N [op, a, b]

fn child[n, side]
    if side eq 'a'
        return n.a
    return n.b

fn deepest[n]
    if n.op eq 'leaf'
        return n
    return deepest[child[n, 'a']]

t = N['+', N['*', N['leaf', 0, 0], N['leaf', 0, 0]], N['leaf', 0, 0]]
x = child[t, 'a']
log[x.op]
log[deepest[t].op]
y = child[child[t, 'a'], 'b']
log[y.op]
