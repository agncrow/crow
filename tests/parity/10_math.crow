--- math module: tensors, linalg, reductions
use math
z = zeros[3]
log[z]
o = ones[2, 2]
log[o]
e = eye[2]
log[e]
l = linspace[0, 4, 5]
log[l]
log[l + 10]
log[l * 2]
log[sum[l]]
log[mean[l]]
log[max[l]]
log[min[l]]
w = eye[2]
x = ones[2, 1]
log[w * x]
a = ones[3] .* full[3, 5]
log[a]
log[det[eye[3]]]
r = reshape[linspace[1, 6, 6], 2, 3]
log[r]
log[transpose[r]]
log[pi]
