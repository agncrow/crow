--- The collection builtins at their edges, one meaning in both modes:
--- slice clamps to the array and is empty when start is past end, pop of
--- an empty array is the empty array, push and set grow in place when the
--- variable is reassigned to its own result, sort orders ints, floats and
--- strings, range walks up and down.
xs = [10, 20, 30, 40, 50]
log[slice[xs, 1, 3]]
log[slice[xs, 3, 99]]
log[slice[xs, -2, 2]]
log[slice[xs, 4, 1]]
log[slice['héllo wörld', 1, 4]]
log[slice['abc', 2, 99]]

empty = []
p = pop[empty]
log[len[p]]
log[pop[[1, 2, 3]]]

acc = []
i = 0
while i lt 5
    acc = push[acc, i * i]
    i = i + 1
log[acc]
log[len[acc]]

m = map[]
i = 0
while i lt 4
    m = set[m, 'k`i`', i]
    i = i + 1
log[keys[m]]
log[len[del[m, 'k1']]]
log['k1' in m]

log[sort[[3, 1, 2]]]
log[sort[[2.5, -1.0, 0.5]]]
log[sort[['pear', 'apple', 'fig']]]
log[reverse[[1, 2, 3]]]
log[range[5]]
log[range[2, 8, 3]]
log[range[5, 0, -2]]
log[concat[[1, 2], [3]]]
log[30 in xs]
log['ro' in 'crow']

--- the in-place shape reads the other arguments first, and a variable
--- read twice on the right is copied, not moved
xs2 = [1, 2]
xs2 = push[xs2, len[xs2]]
log[xs2]
xs2 = concat[xs2, xs2]
log[xs2]
xs2 = sort[reverse[xs2]]
log[xs2]
