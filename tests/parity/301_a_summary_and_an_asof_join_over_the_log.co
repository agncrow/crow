--- aggregates pushed below the reader and the as-of join over the log
--- (docs/magpie-design.md, phase 8): what `summary` answers is what
--- `group` answers over `scan`, and `prior` the newest row at or before
--- each label's moment — in both modes
use magpie
use frame
use math

d = 'parity-301-log'
gone = rm[d]
made = mkdir[d]
a = batch[d, frame.new[day = [1, 1, 1, 2, 2, 2], sym = ['A', 'B', 'A', 'B', 'A', 'B'], px = [10.0, 20.0, 12.0, 22.0, 14.0, 24.0], vol = [1, 2, 3, 4, 5, 6]], by = ['day', 'sym']]
b = batch[d, frame.new[day = [3, 3], sym = ['A', 'B'], px = [16.0, 26.0], vol = [7, 8]]]
s = summary[d, ['sym'], ['px', 'vol', 'px', 'vol', 'px'], ['mean', 'sum', 'max', 'count', 'std']]
log[s.columns]
log[s.sym]
log[s.px_mean]
log[s.vol_sum]
log[s.px_max]
log[s.vol_count]
log[round[s.px_std[0] * 1000.0]]
rows = scan[d]
g = sort[group[rows, 'sym', ['px', 'mean'], ['vol', 'sum'], ['px', 'max']], 'sym']
log[g.px_mean]
log[g.vol_sum]
log[summary[d, ['sym'], ['vol'], ['sum'], on = ['day'], ops = ['eq'], equal = ['2']].vol_sum]
log[summary[d, ['day'], ['vol'], ['count'], on = ['sym', 'sym'], ops = ['eq', 'eq'], equal = ['A', 'B'], lo = '2'].vol_count]
log[summary[d, ['sym'], ['vol'], ['last'], upto = 4].vol_last]
log[summary[d, ['sym'], ['px'], ['first'], on = ['px'], ops = ['gt'], equal = ['11']].px_first]
log[len[summary[d, ['sym'], ['vol'], ['sum'], on = ['day'], ops = ['gt'], equal = ['9']]]]
log[summary[d, [], ['vol'], ['sum']].vol_sum]
log[summary[d, ['sym'], ['px'], ['median']].kind]
m = merge[d]
again = summary[d, ['sym'], ['px', 'vol'], ['mean', 'sum']]
log[again.px_mean]
log[again.vol_sum]
t = 'parity-301-times'
gone = rm[t]
made = mkdir[t]
c = batch[t, frame.new[sym = ['A', 'A', 'B', 'A', 'B'], t = [10, 20, 15, 30, 35], px = [1.0, 2.0, 5.0, 3.0, 6.0]], by = ['sym'], time = 't']
labels = frame.new[sym = ['A', 'A', 'B', 'C', 'A'], t = [25, 9, 40, 10, 20], tag = [1, 2, 3, 4, 5]]
j = prior[t, labels]
log[j.columns]
log[j.px[0]]
log[j.px[1].ok]
log[j.px[2]]
log[j.px[3].ok]
log[j.px[4]]
m = merge[t]
log[prior[t, labels, ['px']].px[0]]
log[prior[d, labels].kind]
gone = rm[t]
gone = rm[d]
