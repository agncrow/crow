--- Inside a function grad differentiates, a tensor compared with a
--- number is its mask, as it is outside: a constant, the decision passing
--- no gradient. `where` takes each number from one side or the other, and
--- the gradient reaches the side it took — leaky ReLU, ELU and the Huber
--- loss are written so. A matrix's mask is of its shape, and a number on
--- the left compares the same. The numbers are PyTorch's in float64.
use math

fn leaky[x]
    return where[x gt 0.0, x, x * 0.01]

fn elu[x]
    return where[0.0 lt x, x, exp[x] - 1.0]

fn huber[d]
    a = abs[d]
    return where[a lt 1.0, d .* d * 0.5, a - 0.5]

fn loss[w, x, y]
    h = leaky[x * w]
    s = elu[h - 0.2]
    return sum[huber[s - y]]

w = reshape[sin[tensor[range[6]] * 0.37 + 0.1] * 1.5, 3, 2]
x = [[0.5, -1.0, 2.0], [1.5, 0.25, -0.75], [-2.0, 1.0, 0.5], [0.1, -0.3, 3.0]]
y = [[0.2, -0.4], [1.0, 2.5], [-0.5, 0.0], [3.0, -1.0]]
log[loss[w, x, y]]
log[grad[loss][w, x, y][0]]
--- a vector's mask decides each number; where neither side is the
--- parameter's own, the gradient is zero there
fn floor_half[v]
    return sum[where[v gte 0.5, v, v * 0.0 + 0.5] .* v]
log[grad[floor_half][[0.25, 0.5, 1.0, -2.0]]]
