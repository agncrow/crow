--- A frame loaded from a file has the columns the program's reads of its
--- cells say (spec, Frames: a frame's type is its columns): a cell handed
--- to a function that uppercases it is text, one halved a float, one
--- compared with an int an int — nothing is written, nothing is read
--- first. The frame is held to that shape where it is bound, and typed by
--- it from then on, the same in both modes (its cells had been parsed
--- values, each read first by hand; a function handed one had taken a
--- parsed value, and the compiled program had not held it).
use frame

write['parity_192.csv', 'sym,px,qty,note\nAAPL,191.5,100,ok\nmsft,415.25,50,late\nnvda,900.0,10,\n']

fn label[t]
    return upper[t]

fn half[x]
    return x / 2.0

fn big[q]
    return q gt 20

df = frame.load['parity_192.csv']
labels = for t in df.sym
    label[t]
log[labels]
halves = for p in df.px
    half[p]
log[halves]
total = 0
for q in df.qty
    if big[q]
        total = total + q
log[total]
--- a column no read says anything of stays as it comes
log[df.note]
log[len[df]]
rm['parity_192.csv']
