--- A long text read by position in a loop — cut into pieces, read a
--- character at a time — reads each place where it lies, in both modes,
--- with what the loop learned of the text's start kept for its rounds:
--- the interpreter had walked the text from its start at every read (60-
--- character pieces of a 50 MB sequence took eleven trillion instructions).
--- A text that is not ASCII past its start is read by its characters, and
--- a text written in the loop is learned anew.
fn pieces[s, w]
    n = len[s]
    out = for k in range[(n + w - 1) / w]
        slice[s, k * w, min[n, k * w + w]]
    return out

bases = for i in range[3000]
    'acgt'
long = join[bases, '']
cut = pieces[long, 7]
log[len[cut]]
log[cut[0]]
log[cut[len[cut] - 1]]

--- past an ASCII start, characters of two bytes
mixed = join[[slice[long, 0, 40], 'é—ü', slice[long, 0, 10]], '']
parts = pieces[mixed, 6]
log[parts]

--- a character at a time, at the top level
seen = 0
i = 0
while i lt len[mixed]
    if mixed[i] eq 'é' or mixed[i] eq 'ü'
        seen = seen + 1
    i = i + 1
log[seen]

--- written in the loop: what was learned of it goes with the old text
s = long
firsts = ''
r = 0
while r lt 5
    firsts = '`firsts``s[0]``slice[s, 1, 3]`|'
    s = slice[s, 1, len[s]]
    if r eq 2
        s = 'ñ`s`'
    r = r + 1
log[firsts]
