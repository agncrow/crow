--- use frame's functions are rows of the builtin table (docs/bug-classes.md
--- §4). A misuse — a column the frame lacks, an aggregation or a join it
--- does not know, a mask of another length — was an error value
--- interpreted and a stop compiled (a panic, for an aggregation); it stops
--- both modes now. Text that is no time is an error value in both, and a
--- column copied with `with` keeps its missing cells.
use frame
use db
book = db.connect['sqlite://:memory:']
exec[book, 'CREATE TABLE t (id INTEGER PRIMARY KEY, name TEXT NOT NULL, score REAL)']
exec[book, 'INSERT INTO t (name, score) VALUES (?, ?)', ['a', 1.5]]
exec[book, 'INSERT INTO t (name) VALUES (?)', ['b']]
exec[book, 'INSERT INTO t (name, score) VALUES (?, ?)', ['c', 3.5]]
df = query[book, 'SELECT name, score FROM t ORDER BY id']
copied = with[df, 'again', df.score]
log[copied.again.ok]
log[head[sort[df, 'name', desc = true], 2]]
log[group[df, 'name', ['score', 'count']]]
d = moment['not a time']
log[d.ok]
log[d.kind]
log[moment[moment['2026-07-14T13:30:00Z'], tz = '+09:00']]
log[join[df, df, 'name', 'lefty']]
log['not reached']
