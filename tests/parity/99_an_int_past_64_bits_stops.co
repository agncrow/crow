--- An int that no longer fits in 64 bits stops the program. The
--- interpreter wrapped it round silently, `crow build`'s optimized binary
--- did too, and only `crow run`'s debug build stopped.
big = 9223372036854775000
step = 800
log[big + step - step]
fn grow[n]
    return n * 1000
log[grow[big / 1000]]
log[grow[big]]
log['not reached']
