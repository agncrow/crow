--- A loop runs in parallel only when nothing its body does can show the
--- order (spec §14, For Loops), decided once for both modes. Seeded
--- draws in a loop came out different on every run; an error handed back
--- from a loop's condition could name any failing item, or none.
use math

seed[7]
draws = for i in range[200]
    rand[]
log[draws[0]]
log[draws[199]]
picks = for i in range[5]
    rand[1, 6]
log[picks]

fn sq[x]
    return x * x

fn say[x]
    log['item `x`']
    return x

fn relay[x]
    return say[x]

squares = for i in range[1, 6]
    sq[i]
log[squares]
said = for i in range[1, 6]
    relay[i]
log[said]

fn keep[items, f]
    out = for x in items
        if f[x]
            x
    return out

fn loud[x]
    log['checking `x`']
    return x gt 2

log[keep[[1, 2, 3, 4], loud]]

fn parse_all[xs]
    out = for x in xs
        if int[x] gt 0
            x
    return out

log[parse_all[['1', '2', '3']]]
log[parse_all[['1', 'a', 'b', 'c']]]
