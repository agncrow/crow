--- encode[] and json[] agree in both modes: whole floats and tensor
--- cells print as ints, a NaN or infinite float encodes as null, strings
--- keep their quotes and unicode, nesting round-trips, and a parsed
--- object answers field reads, len[] and str[].
log[encode[[1, 2, 3]]]
log[encode[[1.5, 2.0, -0.5]]]
log[encode[['a', 'b "q"', 'héllo']]]
log[encode[map[n = 3, m = 4]]]
log[encode[map[name = 'crow', kind = 'bird']]]
log[encode[map[xs = [1, 2], ys = [3]]]]
log[encode[[[1, 2], [3, 4]]]]
log[encode[[true, false]]]
log[encode['plain']]
log[encode[7]]
log[encode[2.5]]
log[encode[[0.0 / 0.0, 1.0]]]
text = encode[map[a = 1, b = 2]]
log[text]
obj = json[text]
log[int[obj.a]]
log[len[obj]]
nested = json['{"a": 1, "b": [1, 2, 3], "c": {"d": "x"}}']
log[int[nested.a]]
log[len[nested.b]]
log[str[nested.c.d]]
log[len[nested]]
arr = json['[1, 2, 3]']
log[arr[1]]
log[len[arr]]
bad = json['{"a": ']
log[bad.ok]
log[bad.kind]
nul = json['null']
log[nul.ok]
