--- The left side of an operator runs before the right side's own
--- statements: `put[p, …] eq 1 and frame.load[p].id eq ['a', 'b']` must
--- write the file before it is read, though the read of a value that can
--- fail is hoisted ahead of the statement while the write stays in the
--- expression — wherever both sides are computed (a mask's `and`, a
--- comparison, arithmetic). And a column compared with a list, a column
--- or a tensor is one truth, not a mask, so such an `and` decides from the
--- left and builds compiled. (Found as Magpie's `put` beside its
--- `latest`; Magpie's parity program of this number keeps that form.)
use frame

p = 'parity-302.csv'
gone = rm[p]

--- the ids so far written as the file, the last one's position answered
fn put[path, ids]
    saved = frame.save[frame.new[id = ids], path]
    return len[ids] - 1

log[put[p, ['a', 'b']] eq 1 and frame.load[p].id eq ['a', 'b']]
log[put[p, ['a', 'b', 'c']] eq 2 and len[frame.load[p].id] gt 2]
log[put[p, ['a', 'b', 'c', 'd']] eq 3 and frame.load[p].id eq frame.load[p].id]
log[put[p, ['a', 'b', 'c', 'd', 'e']] eq len[frame.load[p].id] - 1]
log[put[p, ['a', 'b', 'c', 'd', 'e', 'f']] eq 5 or len[frame.load[p].id] gt 5]
log[['a', 'b'] eq ['a', 'b'] and true]
log[true and ['x'] eq ['x']]
log[(len[frame.load[p].id] gt 2) eq (len[frame.load[p].id] gt 2)]
gone = rm[p]
