--- A frame's missing cell: a column shows it as nan, its .ok says it is
--- missing, and read one at a time it is its column's placeholder, as a
--- filter reads it: NaN in a number column, so it compares as false. A
--- left join leaves cells missing. (The interpreter read a missing cell
--- as an error, so a collecting loop over one dropped the row; compiled, a
--- comparison with a cell read did not build.)
use frame
write['parity65.csv', 'a,b,s\n1,,x\n2,3,\n']
df = load['parity65.csv']
log[df.b]
log[df.s]
log[df.b.ok]
log[df.s[1]]
rm['parity65.csv']
a = with[with[frame.new[], 'symbol', ['A', 'B', 'C']], 'gate', [1, 0, 0]]
b = with[with[frame.new[], 'symbol', ['C', 'A']], 'rsi', [75.0, 20.0]]
j = join[a, b, 'symbol', 'left']
x = j.rsi[1]
log[x gt 70.0]
log[x lte 70.0]
hot = for i in range[len[j]]
    j.gate[i] eq 1 or j.rsi[i] gt 70.0
log[hot]
log[len[filter[j, hot]]]
log[len[filter[j, j.rsi gt 70.0]]]
