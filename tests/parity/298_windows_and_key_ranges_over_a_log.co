--- a read of a log is bounded (docs/magpie-design.md, phase 5): `since`
--- and `scan` take a position window, `latest` a range of the first key;
--- the whole log is walked in windows, and the windows add up to the
--- whole, in both modes
use magpie
use frame
use math

d = 'parity-298-log'
gone = rm[d]
made = mkdir[d]
a = magpie.batch[d, frame.new[day = ['d1', 'd1', 'd2', 'd2'], sym = ['A', 'B', 'A', 'B'], px = [1, 2, 3, 4]], by = ['day', 'sym']]
b = magpie.batch[d, frame.new[day = ['d2', 'd3', 'd3'], sym = ['A', 'A', 'B'], px = [5, 6, 7]]]
c = magpie.batch[d, frame.new[day = ['d1'], sym = ['A'], px = [8]]]
log[magpie.head[d]]
log[magpie.since[d, 2, 4].px]
log[magpie.since[d, 6].px]
log[len[magpie.since[d, 9]]]
log[magpie.scan[d, 1, 2, ['px']].px]
log[magpie.scan[d, 0, 3].sym]
log[magpie.scan[d, 5].day]
log[magpie.latest[d].px]
log[magpie.latest[d, lo = 'd2', hi = 'd2'].px]
log[magpie.latest[d, hi = 'd1'].px]
log[magpie.latest[d, lo = 'd3', columns = ['day', 'sym', 'px', '_pos']].columns]
log[magpie.latest[d, upto = 3, lo = 'd2'].px]
log[len[magpie.latest[d, lo = 'd9']]]
log[magpie.latest[d, lo = '0'].kind]
total = 0
at = 0
last = magpie.head[d]
while at lte last
    window = magpie.since[d, at, at + 2, ['px']]
    total = total + int[sum[window.px]]
    at = at + 3
log[total]
log[int[sum[magpie.scan[d].px]] eq total]
m = magpie.merge[d]
log[magpie.since[d, 2, 4].px]
log[magpie.latest[d, lo = 'd2', hi = 'd2'].px]
log[magpie.latest[d, hi = 'd1'].px]
seen = 0
at = 0
while at lte last
    window = magpie.scan[d, at, at + 1]
    seen = seen + len[window]
    at = at + 2
log[seen]
gone = rm[d]
