--- A decimal is an exact base-ten number and a fraction an exact ratio, in
--- both modes: sums of money never drift, a quotient has 28 significant
--- digits (or the digits a decimal was given), and kinds meet the exact way.
a = decimal['0.1']
b = decimal['0.2']
log[a + b]
log[a + b eq decimal['0.3']]
price = decimal['12.30']
log[price]
log[price + decimal['1.1']]
log[decimal['1.10'] * decimal['2.0']]
log[price * 3]
log[price * 1.1]
log[decimal[1] / decimal[3]]
log[decimal[2] / decimal[3]]
log[decimal['1.20'] / 2]
log[decimal[10] / 4]
log[decimal['1.1'] ^ 3]
log[decimal[2] ^ -2]
log[round[decimal['2.345'], 2]]
log[round[decimal['-2.345'], 2]]
log[round[decimal['2.5'], 2]]
log[round[decimal['2.5']]]
log[floor[decimal['-2.5']]]
log[ceil[decimal['-2.5']]]
log[int[decimal['-2.5']]]
log[float[decimal['0.1']]]
log[decimal[0.1]]
log[decimal[12]]
log[abs[decimal['-3.25']]]
log[max[decimal['2.50'], decimal['2.5']]]
log[decimal['2.50'] eq decimal['2.5']]
log[decimal['2.5'] gt 2]
--- digits: every answer the decimal takes part in rounds to them
x = decimal[2, digits = 50]
log[sqrt[x]]
log[decimal['123.456', digits = 4]]
log[decimal[1, digits = 10] / 3]
log[type[x]]
log[encode[[price, decimal['0.5']]]]

--- fractions: lowest terms, the sign on top, exact
third = fraction[1, 3]
log[third]
log[fraction[2, -4]]
log[third + third + third]
log[third * third]
log[third ^ -2]
log[fraction[decimal['0.25']]]
log[fraction[5, 2] + 1]
log[fraction[1, 2] eq decimal['0.5']]
log[round[fraction[5, 2]]]
log[round[fraction[-5, 2]]]
log[floor[fraction[-5, 2]]]
log[float[third]]
log[type[third]]
log[str[fraction[4, 2]]]
bad = fraction[1, 0]
log[bad.ok]
log[bad.kind]
