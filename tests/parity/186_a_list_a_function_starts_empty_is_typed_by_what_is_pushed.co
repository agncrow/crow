--- A list a function starts empty is typed by what is pushed onto it,
--- `xs = push[xs, v]` — the compiled program had not built with a bare
--- push, its items unknown. A bare push (`push[xs, v]` answers a new list
--- and, alone, changes nothing) is refused now, in both modes
--- (tests/errors/c24).
--- A list of cells read from a loaded file, whose kinds show as the
--- program runs, joins as text in both modes (compiled, it had not built).
use frame

fn kept[]
    xs = []
    xs = push[xs, 2.5]
    xs = push[xs, 1.5]
    return xs

fn flags[]
    marks = []
    marks = push[marks, true]
    return marks

fn named[]
    names = []
    names = push[names, 'b']
    return names

log[kept[]]
log[flags[]]
log[named[]]

write['cells-note.csv', 'sym,day,px\nAAPL,3,191.5\nMSFT,4,415.2\n']
t = frame.load['cells-note.csv']
cells = [t.sym[0], t.day[0], t.px[0]]
log[join[cells, ' ']]
log[join[[t.day[1], t.day[0]], '-']]
rm['cells-note.csv']
