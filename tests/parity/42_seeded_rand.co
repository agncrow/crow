--- rand[] draws from the program's RNG, the one seed[n] seeds, so a
--- seeded program draws the same numbers in both modes and twice over.
--- Three draws in three statements come in the order written.
use math as m

m.seed[42]
a = rand[]
b = rand[10]
c = rand[1, 6]
log[a gte 0.0 and a lt 1.0]
log[b gte 0 and b lt 10]
log[c gte 1 and c lte 6]
m.seed[42]
log[rand[] eq a]
log[rand[10] eq b]
log[rand[1, 6] eq c]
log[fmt[a, decimals = 6]]
log[b]
log[c]
