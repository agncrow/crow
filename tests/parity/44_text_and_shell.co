--- str[] is the text log[] prints, for every kind of value; join[] of
--- numbers prints whole numbers bare and an empty list joins to nothing;
--- shell[] trims trailing whitespace from both streams and reports the
--- exit status, and only a command that cannot start is an error.
log[str[0.1 + 0.2]]
log[str[1.0]]
log[str[2.5]]
log[str[-7]]
log[str[true]]
log[str['x']]
log[str[[1, 2, 3]]]
log[str[[1.5, 2.0]]]
log[str[['a', 'b']]]
log[str[map[a = 1, b = 2]]]
log[join[[1, 2, 3], ', ']]
log[join[[1.5, 2.0, 3.25], '|']]
log[join[['a', 'b', 'c'], '-']]
log[join[[true, false], ' ']]
none = join[[], ',']
log['[`none`]']
r = shell['printf "out\n\n"; printf "err \n" >&2; exit 3']
log[r.status]
log['[`r.stdout`]']
log['[`r.stderr`]']
fine = shell['echo hi']
log[fine.ok]
log[fine.stdout]
bad = shell['exit 1']
log[bad.ok]
log[bad.status]
