--- first-class fn values: arrays, for-expressions, maps of fns

fn double[x]
  return x * 2

fn square[x]
  return x * x

op = double
log['op 5: `op[5]`']

ops = [double, square]
log['ops0: `ops[0][3]`']
log['ops1: `ops[1][3]`']

results = for f in [double, square]
  f[10]
log['mapped: `results`']

fn add[a, b]
  return a + b

fn mul[a, b]
  return a * b

ops_map = map[add = add, mul = mul]
r1 = ops_map.add
log['map add: `r1[3, 4]`']
r2 = ops_map.mul
log['map mul: `r2[3, 4]`']
