--- A statement whose text can fail: `exec` and `query` are handed the
--- text's failure as their value, and run the statement when it is good.
--- The compiled program wrapped their result in a second result and did
--- not build (finch's migrate job reads each migration with read[]).
use db

conn = connect['sqlite://:memory:']
query[conn, 'CREATE TABLE t (x INTEGER)']
seven = int['7']
r = query[conn, 'INSERT INTO t (x) VALUES (`seven`)']
log[r.ok]
q = int['q']
r2 = query[conn, 'INSERT INTO t (x) VALUES (`q`)']
log[r2.ok]
log[r2.reason]
zero = int['0']
seen = query[conn, 'SELECT x FROM t WHERE x > `zero`']
log[len[seen]]
log[seen.x[0]]
none = query[conn, 'SELECT x FROM t WHERE x > `q`']
log[none.ok]
