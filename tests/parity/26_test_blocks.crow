--- test blocks are check-time only: both modes strip them and run the
--- program identically. crow check runs the truths; crow run never does.
fn fee[notional]
    return max[1.0, notional * 0.001]
test[n]
    fee[50000.0] eq 50.0
    fee[n] gte 1.0

test floor_holds[]
    assert[fee[100.0] eq 1.0]

log[fee[50000.0]]
