--- A log removed while a flush of its rows runs keeps none of them.
--- Compiled, Magpie's flush runs on a thread of its own (`later`), and a
--- flush that had claimed the rows before the `rm` wrote them into the log
--- made again at the path a moment later: the removed log's 50,000 rows
--- read back beside the one row the new log was given. `rm` forgets the
--- log's tail before it removes the directory, and the flush now links
--- its file under the tail's lock only where its claim still holds, so
--- the rows go with the log — as they do under `crow run -i`, where the
--- flush runs inline.
use magpie, frame
d = 'parity-434'
gone = rm[d]
made = mkdir[d]
p = magpie.put[d, frame.new[v = range[50000]]]
--- (a moment for the flush to claim the rows and begin writing them)
sleep[5]
gone = rm[d]
made = mkdir[d]
q = magpie.put[d, frame.new[v = [7]]]
s = magpie.sync[d]
--- (and time for a flush still running to write what it would)
sleep[1000]
log[len[magpie.latest[d]]]
files = 0
for name in ls[d]
    if ends[name, '.batch']
        files = files + 1
log[files]
gone = rm[d]
log[exists[d]]
