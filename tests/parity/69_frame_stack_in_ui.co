--- `frame.stack` in a program that uses ui is the frame function, whose
--- arguments that can fail propagate — the compiled program took it for
--- the `stack` element, which renders a failed child in place, and did not
--- build.
use web, ui, frame

fn one[k]
    return frame.new[x = [k]]

a = one[1.0]
b = one[2.0]
both = frame.stack[a, b]
log[len[both]]
log[both.x]
