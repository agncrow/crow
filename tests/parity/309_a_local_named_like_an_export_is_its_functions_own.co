--- A function's local named like an imported module's export is that
--- function's own: every other function still reaches the export. A local
--- `relu` in `g` had kept `f`'s `relu[x]` from reaching the module's —
--- "module has no function 'relu'", in both modes — since the
--- inliner had read every name the program binds anywhere as shadowing
--- the export everywhere (found writing Magpie's read verbs in Crow). The
--- import is qualified: a bare import's names are refused as a function's
--- locals, as they are at the top level (Vijay, 2026-10-29); a standard
--- module's own functions, which meet this, are held by their own tests.
use web.auth as a

fn f[user]
    token = a.sign[map[user = user], 'a-secret-of-at-least-thirty-two-chars']
    return str[a.verify[token, 'a-secret-of-at-least-thirty-two-chars'].user]

fn g[y]
    verify = y + 1
    return verify

log[f['ada']]
log[g[1]]
