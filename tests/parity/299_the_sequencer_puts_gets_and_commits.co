--- every write of a process goes through the log's sequencer
--- (docs/magpie-design.md, phase 6): a put is visible at once and
--- durable at the flush, a get reads the image, a commit over the keys
--- is decided in memory — the same in both modes
use magpie
use frame
use math

d = 'parity-299-log'
gone = rm[d]
made = mkdir[d]
log[magpie.put[d, frame.new[id = [1, 2], qty = [10, 20]], by = ['id']]]
log[int[sum[magpie.batches[d].rows]]]
log[magpie.head[d]]
log[magpie.since[d, 0].qty]
log[magpie.latest[d].qty]
log[magpie.lookup[d, ['id'], ['2']].qty]
log[magpie.put[d, frame.new[id = [2, 3], qty = [25, 30]]]]
log[magpie.latest[d, equal = ['2']].qty]
log[magpie.latest[d, equal = ['3']].qty]
log[len[magpie.latest[d, equal = ['9']]]]
log[magpie.latest[d, equal = ['x']].kind]
log[magpie.sync[d] gte 1]
log[int[sum[magpie.batches[d].rows]]]
log[magpie.batch[d, frame.new[id = [1], qty = [11]]]]
log[int[sum[magpie.batches[d].rows]]]
log[magpie.latest[d, equal = ['1']].qty]
stale = magpie.commit[d, frame.new[id = [1], qty = [12]], seen = 3, columns = ['id'], equal = ['1']]
log[stale.reason]
log[magpie.commit[d, frame.new[id = [1], qty = [13]], seen = 4, columns = ['id'], equal = ['1']]]
log[magpie.latest[d, equal = ['1']].qty]
other = magpie.commit[d, frame.new[id = [7], qty = [70]], seen = 4, columns = ['qty'], equal = ['13']]
log[other.reason]
log[magpie.commit[d, frame.new[id = [7], qty = [70]], seen = 5, columns = ['qty'], equal = ['13']]]
m = magpie.merge[d]
log[magpie.batches[d].form]
log[magpie.latest[d, equal = ['2']].qty]
log[magpie.latest[d].qty]
log[magpie.put[d, frame.new[id = [8], qty = [80]]]]
log[magpie.latest[d].qty]
log[magpie.scan[d, 7].id]
gone = rm[d]
