--- A standard module written in Crow declares its functions by writing
--- them (docs/extending-crow.md, phase 2): a program's call of one — bare,
--- by the module's path, by an alias, handed as a value, inside an
--- interpolation — is the inlined function's call, typed by its use, a
--- copy per signature, and a value a program holds crosses as itself (no
--- JSON text at the door). (Its lines over math.stats and math.nn moved
--- with them to Pie, and its lines over llm — a module function's options
--- as its defaults — with llm to Raven, 2026-11-07: no standard module's
--- function written in Crow has options now, and a package's are a
--- part's, errors k45.)
use web, web.auth
use web.auth as a

secret = 'a-secret-of-at-least-thirty-two-chars'
log[len[split[sign[map[user = 'one'], secret], '.']]]
log[len[split[web.auth.sign[map[user = 'two'], secret], '.']]]
log[len[split[a.sign[map[user = 'three'], secret], '.']]]
f = verify
log[str[f[sign[map[user = 'four'], secret], secret].user]]
q = sign[map[user = 'five'], secret]
log['`str[verify[q, secret].user]`']

t = sign[map[user = 'ada', role = 'admin'], secret]
log[len[split[t, '.']]]
claims = verify[t, secret]
log[str[claims.user]]
log[int[claims.exp] - int[claims.iat]]
log[sign[[1, 2], secret].reason]
log[sign[json['{"user": "bob"}'], 'short'].reason]
log[verify['not.a.token', secret].reason]
