--- 2-D tensors from literals: unified arrays made real ---
use math
m = [[1, 2], [3, 4]]
log[m]
log[m.shape]
log[sum[m]]
log[sum[m, axis = 0]]
log[mean[m]]
log[transpose[m]]
log[m[0]]
log[m[1][0]]
log[m[-1]]
r = m[0] + m[1]
log[r]
p = m * m
log[p]
--- row iteration ---
totals = for row in m
    sum[row]
log[totals]
--- comparison masks on tensors ---
x = [1, 2, 3, 4]
log[x gt 2]
log[x eq 3]
log[(x gt 1) and (x lt 4)]
--- growing: push rows, concat, stack ---
m2 = push[m, [5, 6]]
log[m2.shape]
log[m2[2]]
c = concat[[1, 2], [3, 4]]
log[c]
c2 = concat[m, m, 0]
log[c2.shape]
c3 = concat[m, m, 1]
log[c3.shape]
s = stack[[[1, 2], [3, 4]]]
log[s.shape]
strs = concat[['a'], ['b', 'c']]
log[strs]
