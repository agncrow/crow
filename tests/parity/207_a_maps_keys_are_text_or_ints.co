--- A map's keys are one kind, text or ints, and `2` is not `'2'`: a map
--- from two lists keyed by what the keys are, a literal with int keys,
--- an open map taking its first key's kind, `in`, `keys`, `values`,
--- `set`, `del`, `len`, equality, a map walked, and one shown. Both modes
--- print the same.
m = map[[1, 2, 3], ['a', 'b', 'c']]
log[m]
log[m[2]]
log[2 in m]
log[9 not in m]
log[keys[m]]
log[values[m]]
log[len[m]]
m2 = set[m, 4, 'd']
log[m2[4]]
log[len[del[m2, 1]]]
t = map[a = 1, b = 2]
log[t['a']]
log['a' in t]
lit = map[10 = 'x', 2 = 'y']
log[lit[2]]
log[keys[lit]]
open = map[]
open = set[open, 7, 'seven']
log[open[7]]
log[str[m]]
total = 0
for k in keys[m]
    total = total + k
log[total]
log[m eq map[[3, 2, 1], ['c', 'b', 'a']]]
counts = map[]
for n in [3, 1, 3, 2, 3]
    if n in counts
        counts = set[counts, n, counts[n] + 1]
    else
        counts = set[counts, n, 1]
log[counts]
log[counts[3]]
fn by_id[ids, names]
    return map[ids, names]
log[by_id[[5, 6], ['e', 'f']][6]]
