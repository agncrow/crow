--- conversion, json, regex, hashing ---
--- NOTE: json object literals need braces which interpolation intercepts, no escape yet (see docs/design-review.md) ---
log[int[3.99]]
log[float[3]]
log[str[42]]
log[int['7'] + 1]
j = json['[10, 20, 30]']
log[j[0]]
log[j]
log[encode[[1, 2, 3]]]
log[matches['hello', '[a-z]+']]
log[matches['hello', '[0-9]+']]
m = find['2024-01-15', '([0-9]+)-([0-9]+)']
log[m.ok]
log[m.groups]
log[sub['hello world', 'world', 'crow']]
log[hash['hello', 'sha256']]
