--- array builtins, indexing, immutability
nums = [3, 1, 2]
log[nums[0]]
log[nums[-1]]
log[len[nums]]
nums = push[nums, 4]
log[nums]
nums = pop[nums]
log[nums]
log[sort[nums]]
log[reverse[nums]]
log[2 in nums]
log[99 in nums]
log[slice[[10, 20, 30, 40], 1, 3]]
log[concat[[1, 2], [3, 4]]]
names = ['b', 'a', 'c']
log[sort[names]]
nums[0] = 99
log[nums]
