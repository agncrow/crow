--- A frame's column compared whole — with a column, a list or a tensor —
--- is compared as a list is: the same number of cells, each there and
--- equal as two values are, an int as its float; a missing cell equals
--- nothing, not even another missing one, whatever its column holds in its
--- place. Either side may be the column. (Compiled, a column of text with
--- a missing cell had equalled itself, and a column compared with a list
--- or a tensor had not built.)
use frame

a = with[with[frame.new[], 'symbol', ['A', 'B']], 'x', [1.0, 2.0]]
a = with[a, 'n', [1, 2]]
a = with[a, 's', ['p', 'q']]
r = with[with[frame.new[], 'symbol', ['A']], 't', ['hi']]
r = with[r, 'y', [1.0]]
j = join[a, r, 'symbol', 'left']
log[a.x eq a.x]
log[a.x eq a.n]
log[a.x eq [1.0, 2.0]]
log[a.x eq [1, 2]]
log[[1.0, 2.0] eq a.x]
log[a.x ne [1.0, 3.0]]
log[a.x eq [1.0]]
log[a.x eq [[1.0, 2.0]]]
log[a.s eq ['p', 'q']]
log[['p', 'r'] ne a.s]
log[j.t eq j.t]
log[j.t ne j.t]
log[j.y eq j.y]
log[j.t eq ['hi', '']]
log[a.s eq a.x]
