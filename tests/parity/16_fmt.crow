--- fmt: value formatting with named arguments
pnl = 1234.567
log[fmt[pnl, decimals = 2]]
log[fmt[pnl, decimals = 2, commas = true]]
log[fmt[-1234567.89, decimals = 0, commas = true]]
log[fmt[0.123, percent = true, decimals = 1]]
log[fmt[42, width = 8]]
log[fmt[42, width = 5, fill = '0']]
log[fmt['alice', width = 8]]
log[fmt['alice', width = 8, align = 'right']]
log[fmt[7]]
log[fmt[2.5, decimals = 3]]
--- the named-formatter idiom: name your formats
fn money[x]
  return fmt[x, decimals = 2, commas = true]
fn pct[x]
  return fmt[x, percent = true, decimals = 1]
log['P&L: `money[pnl]` (`pct[0.042]`)']
--- positional works too (decimals is the first named slot)
log[fmt[pnl, 1]]
