--- A function of a group may itself apply a group: the dispatch is copied
--- per group, the inner copy reached through the outer copy's application
--- of `research` by name, `research` typed by its body (`trim[question]`
--- reads the question as text) and by the direct call below, and
--- `weather` a member of both groups. Both modes agree and the compiled
--- program builds, which is the test. (Held over llm's subagent — a tool
--- that runs the loop — until llm moved to its own repository,
--- 2026-11-07.)
use sys

--- the current weather in a city
fn weather[city]
    return 'sunny in `upper[city]`'

--- what a smaller dispatch finds out about a question, with the weather
--- as its only function
fn research[question]
    return run_all[[weather], trim[question]]

--- each function applied by name to one argument, under its parameter's
--- name: what each answered, or why it could not
fn run_all[tools, arg]
    said = []
    for t in tools
        d = describe[t]
        named = str[d.params[0].name]
        out = apply[t, json['{"`named`": `encode[arg]`}']]
        if out.ok
            said = push[said, '`str[d.name]`: `out`']
        else
            said = push[said, '`str[d.name]` failed: `out.reason`']
    return join[said, '; ']

log[run_all[[research, weather], ' Lisbon ']]
log[research['Porto']]
