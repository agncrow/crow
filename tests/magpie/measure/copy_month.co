--- a month of finch's data into the lake: the 1-second bars and the NBBO
--- from ClickHouse, a batch file per day; the datasets, their metadata,
--- their news and the scanner's config from Postgres; then each log
--- merged into one segment
use magpie
use db
use frame
use math

ch = db.connect['clickhouse://localhost:9000/finch_trading']
pg = db.connect['postgres://vijay@localhost:5432/finch_trading']
root = env['ROOT', 'lakehouse3']
most = int[env['DAYS', '99']]
made = mkdir[root]

fn stamp[what]
    t = fmt[now[], style = 'iso']
    log['`t` `what`']

days = query[ch, 'SELECT toString(date) AS day FROM dataset_bars WHERE toYYYYMM(date) = 202609 GROUP BY date ORDER BY date']
stamp['`len[days]` days of bars in the month']
copied = 0
for i in range[len[days]]
    if i lt most
        day = days.day[i]
        f = query[ch, 'SELECT dataset_id, symbol, toString(date) AS day, timestamp, open, high, low, close, volume, vwap, trade_count FROM dataset_bars WHERE date = toDate(?) ORDER BY dataset_id, symbol, timestamp', [day]]
        first = batch['`root`/bars', f, by = ['day', 'symbol', 'timestamp']]
        if not first.ok
            halt[first.reason]
        stamp['bars `day`: `len[f]` rows at position `first`']
        copied = copied + len[f]
stamp['bars copied: `copied` rows']

copied = 0
for i in range[len[days]]
    if i lt most
        day = days.day[i]
        f = query[ch, 'SELECT symbol, toString(date) AS day, timestamp, bid_price, bid_size, ask_price, ask_size, spread, mid_price FROM nbbo_1s WHERE date = toDate(?) ORDER BY symbol, timestamp', [day]]
        first = batch['`root`/nbbo', f, by = ['day', 'symbol', 'timestamp']]
        if not first.ok
            halt[first.reason]
        stamp['nbbo `day`: `len[f]` rows at position `first`']
        copied = copied + len[f]
stamp['nbbo copied: `copied` rows']

d = query[pg, 'SELECT id, name, symbols[1] AS symbol, granularity::text AS granularity, dataset_type::text AS dataset_type, to_char(trade_date, \'YYYY-MM-DD\') AS day, total_bars, status::text AS status, created_at, source FROM trading_app.datasets WHERE trade_date BETWEEN \'2026-09-01\' AND \'2026-09-30\' ORDER BY id']
p1 = batch['`root`/datasets', d, by = ['id']]
stamp['datasets: `len[d]` rows']
m = query[pg, 'SELECT m.id, m.dataset_id, m.symbol, m.float, m.rel_volume, m.change, m.gap, m.market_cap, m.sector, m.industry, m.country FROM trading_app.dataset_metadata m JOIN trading_app.datasets d ON d.id = m.dataset_id WHERE d.trade_date BETWEEN \'2026-09-01\' AND \'2026-09-30\' ORDER BY m.id']
p2 = batch['`root`/metadata', m, by = ['dataset_id']]
stamp['metadata: `len[m]` rows']
n = query[pg, 'SELECT n.id, n.dataset_id, n.symbol, n.news_title, n.news_time, n.news_url FROM trading_app.dataset_news n JOIN trading_app.datasets d ON d.id = n.dataset_id WHERE d.trade_date BETWEEN \'2026-09-01\' AND \'2026-09-30\' ORDER BY n.id']
p3 = batch['`root`/news', n, by = ['dataset_id', 'id']]
stamp['news: `len[n]` rows']
c = query[pg, 'SELECT id, min_price, max_price, min_change_percent, max_float_millions, min_rel_volume, min_dvol_per_min FROM trading_app.scanner_vwap_config ORDER BY id']
p4 = batch['`root`/config', c, by = ['id']]
if not p1.ok or not p2.ok or not p3.ok or not p4.ok
    halt['a postgres table did not land: `p1.reason` `p2.reason` `p3.reason` `p4.reason`']
stamp['config: `len[c]` rows']

for name in ['bars', 'nbbo', 'datasets', 'metadata', 'news', 'config']
    cols = ['id']
    all_rows = false
    if name eq 'bars'
        cols = ['day', 'symbol', 'timestamp']
        all_rows = true
    if name eq 'nbbo'
        cols = ['day', 'symbol', 'timestamp']
        all_rows = true
    if name eq 'metadata'
        cols = ['dataset_id']
    if name eq 'news'
        cols = ['dataset_id', 'id']
    seg = merge['`root`/`name`', every = all_rows]
    if not seg.ok
        halt[seg.reason]
    stamp['merged `name`: `seg`']
stamp['done']
