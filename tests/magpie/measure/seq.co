--- the sequencer against Redis and Postgres on the loopback, small: N
--- point writes (a key's row put, flushed within ten milliseconds — or a
--- batch, durable before it answers), then N point reads of a key's
--- newest row; Redis asked by redis-benchmark beside it (SET/GET, Redis's
--- default durability, no flush), Postgres by INSERT and SELECT
--- on a primary key (a commit per statement, flushed as Postgres flushes)
use magpie, frame, math, db

n = int[env['N', '2000']]
d = 'measure-seq'
gone = rm[d]

fn ms[a, b]
    return (float[b] - float[a]) * 1000.0

--- Magpie: put one row at a time, then latest by key
a = now[]
for i in range[n]
    p = put[d, frame.new[k = ['k`i`'], v = [i]], by = ['k']]
synced = sync[d]
b = now[]
log['magpie put x `n` + sync: `fmt[ms[a, b], decimals = 0]` ms (`fmt[ms[a, b] * 1000.0 / float[n], decimals = 1]` us per put)']
a = now[]
for i in range[n]
    r = latest[d, equal = ['k`i`']]
b = now[]
log['magpie latest by key x `n`: `fmt[ms[a, b], decimals = 0]` ms (`fmt[ms[a, b] * 1000.0 / float[n], decimals = 1]` us per read)']
a = now[]
for i in range[200]
    p = batch[d, frame.new[k = ['b`i`'], v = [i]]]
b = now[]
log['magpie batch (durable) x 200: `fmt[ms[a, b], decimals = 0]` ms (`fmt[ms[a, b] * 1000.0 / 200.0, decimals = 0]` us per batch)']
gone = rm[d]

--- (Redis is asked by its own redis-benchmark, run beside this program: a
--- program has no raw socket — the sys layer is the modules')

--- Postgres, a scratch table
pg = db.connect[env['PG', 'postgres://vijay@localhost:5432/crow_bench']]
if pg.ok
    made = query[pg, 'DROP TABLE IF EXISTS measure_seq']
    made = query[pg, 'CREATE TABLE measure_seq (k text PRIMARY KEY, v bigint)']
    a = now[]
    for i in range[n]
        w = query[pg, 'INSERT INTO measure_seq (k, v) VALUES (?, ?)', ['k`i`', i]]
    b = now[]
    log['postgres INSERT x `n`: `fmt[ms[a, b], decimals = 0]` ms (`fmt[ms[a, b] * 1000.0 / float[n], decimals = 1]` us per write)']
    a = now[]
    for i in range[n]
        r = query[pg, 'SELECT v FROM measure_seq WHERE k = ?', ['k`i`']]
    b = now[]
    log['postgres SELECT by key x `n`: `fmt[ms[a, b], decimals = 0]` ms (`fmt[ms[a, b] * 1000.0 / float[n], decimals = 1]` us per read)']
    dropped = query[pg, 'DROP TABLE measure_seq']
else
    log['postgres: not reached']
