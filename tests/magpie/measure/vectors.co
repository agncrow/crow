--- nearest over N vectors of width W: Magpie's exact scan from the files
--- (warm, the median of reps) against the vectors package's flat index
--- over the matrix held in memory; the positions must agree
use magpie, frame, math
use vectors.flat

n = int[env['N', '20000']]
w = int[env['W', '64']]
reps = int[env['REPS', '5']]
k = 10
d = 'measure-vectors'
gone = rm[d]

fn ms[a, b]
    return (float[b] - float[a]) * 1000.0

fn median[xs]
    s = sort[xs]
    return s[len[s] / 2]

--- the vectors, seeded, in batches of 5000 rows
seed[7]
per = 5000
written = 0
while written lt n
    rows = randn[per, w]
    ids = range[written, written + per]
    f = frame.new[id = ids, e = rows]
    p = magpie.batch[d, f, by = ['id']]
    written = written + per
t_merge0 = now[]
seg = magpie.merge[d]
t_merge1 = now[]
log['rows `n` width `w` merged in `fmt[ms[t_merge0, t_merge1], decimals = 0]` ms']
q = randn[w]

--- Magpie, from the files
times = []
hits = magpie.nearest[d, 'e', q, k]
for r in range[reps]
    a = now[]
    hits = magpie.nearest[d, 'e', q, k]
    b = now[]
    times = push[times, ms[a, b]]
log['magpie nearest from the files: `fmt[median[times], decimals = 1]` ms (k = `k`)']

--- the flat index over the matrix in memory
whole = magpie.latest[d, columns = ['id', 'e']]
m = tensor[whole.e]
a = now[]
ix = flat.index[m]
b = now[]
log['flat index built over `len[whole]` rows in `fmt[ms[a, b], decimals = 1]` ms']
times2 = []
found = flat.nearest[ix, q, k]
for r in range[reps]
    a = now[]
    found = flat.nearest[ix, q, k]
    b = now[]
    times2 = push[times2, ms[a, b]]
log['flat nearest in memory: `fmt[median[times2], decimals = 1]` ms']
--- the same rows, in the same order
mine = for i in range[k]
    int[hits.id[i]]
theirs = for p in found.positions
    int[whole.id[p]]
log[mine eq theirs]
log[abs[hits.score[0] - found.scores[0]] lt 0.000000001]
gone = rm[d]
