--- Training: linear regression by hand-written gradient descent over
--- tensors, an MLP forward pass over a batch, and many scalar grad calls.
use math, math.nn

q = env['BENCH_QUICK']
quick = q.ok
n = 20000
if quick
    n = 2000
epochs = 200
if quick
    epochs = 20

seed[3]
x = randn[n, 8]
true_w = randn[8, 1]
y = x * true_w + randn[n, 1] * 0.1

w = zeros[8, 1]
lr = 0.05
t0 = now[]
ep = 0
while ep lt epochs
    pred = x * w
    g = transpose[x] * (pred - y) / float[n]
    w = w - g * lr
    ep = ep + 1
log['bench: linreg_gd `now[] - t0`']
log[mse[x * w, y] lt mse[x * zeros[8, 1], y]]

w1 = randn[8, 64]
b1 = zeros[64]
w2 = randn[64, 4]
b2 = zeros[4]
t0 = now[]
h = relu[linear[x, w1, b1]]
out = softmax[linear[h, w2, b2]]
log['bench: mlp_forward `now[] - t0`']
log[out.shape]

fn f[a, b]
    return a * a * b + b * b * 3.0 + sqrt[a + 10.0]

df = grad[f]
t0 = now[]
acc = 0.0
i = 0
while i lt n
    g2 = df[float[i], 2.0]
    acc = acc + g2[0]
    i = i + 1
log['bench: grad_calls `now[] - t0`']
log[acc gt 0.0]
