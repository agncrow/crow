--- a tool takes what a model can hand it: a function whose parameter is a
--- frame is refused as a tool, before the program runs
use llm, frame

--- the rows of the table that match
fn rows[table]
    return len[table]

m = reach['openai://127.0.0.1:1/llama3.2']
df = frame.new[n = [1, 2]]
log[rows[df]]
r = chat[m, ask['How many?'], tools = [rows]]
log[r.ok]
