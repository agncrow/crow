--- what describe says of a function says what each parameter is: one
--- nothing types — a function only ever handed a parsed value it shows in
--- text — is refused with the fix, before the program runs
use sys

--- the current weather in a city
fn weather[city]
    return 'sunny in `city`'

tools = [weather]
for t in tools
    log[describe[t]]
call = json['{"args": {"city": "Lisbon"}}']
log[weather[call.args.city]]
