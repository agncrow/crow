    file = 'tests/layout/expected/primitives_390.csv'
    rows = csv[file]
    assert[rows.ok, 'no measurements at `file` — run tests/layout/measure.py']
    for r in rows
        boxes = box[s, r.sel]
        assert[len[boxes] gt int[r.i], '`r.sel` #`r.i` is missing from the engine']
        b = boxes[int[r.i]]
        assert[within[b, r], '`r.sel` #`r.i`: engine `b.x`,`b.y` `b.width`x`b.height` vs browser `r.x`,`r.y` `r.w`x`r.h`']
