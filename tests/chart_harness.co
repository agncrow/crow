use ui, frame, math

--- (the rows are the view's own: a view reaches no database, and a
--- test's facts are its literal defaults)
view render[]
    bars = frame.new[]
    bars = with[bars, 'ts', [1753702200.0, 1753702260.0, 1753702320.0]]
    bars = with[bars, 'o', [3.1, 3.3, 3.2]]
    bars = with[bars, 'hi', [3.4, 3.5, 3.6]]
    bars = with[bars, 'lo', [3.0, 3.2, 3.2]]
    bars = with[bars, 'c', [3.3, 3.2, 3.6]]
    bars = with[bars, 'vol', [1200.0, 900.0, 2100.0]]
    return div[
        chart[bars, candles = ['o', 'hi', 'lo', 'c'], bars_y = 'vol', marker = 1753702260.0, tz = 'America/New_York', height = 200]
    ]

test chart_renders[]
    a = app[render]
    h = html[a]
    assert['crow-chart' in h]
    assert['var(--crow-up)' in h]
    assert['var(--crow-down)' in h]
    assert['crow-marker' in h]
    assert['<rect' in h]

--- panes with reference levels, trade markers, and a seek target
use chart
at = 0.0

fn jump[t]
    at = t

view study[]
    bars = frame.new[]
    bars = with[bars, 'ts', [1753702200.0, 1753702260.0, 1753702320.0, 1753702380.0, 1753702440.0]]
    bars = with[bars, 'c', [3.1, 3.3, 3.2, 3.6, 3.4]]
    bars = with[bars, 'vol', [1200.0, 900.0, 2100.0, 1500.0, 800.0]]
    bars = with[bars, 'rsi', rsi[bars.c, 2]]
    bars = with[bars, 'cvd', cvd[bars.c, bars.vol]]
    marks = frame.new[]
    marks = with[marks, 'ts', [1753702260.0, 1753702380.0]]
    marks = with[marks, 'y', [3.3, 3.6]]
    marks = with[marks, 'label', ['B', 'S']]
    marks = with[marks, 'kind', ['buy', 'sell']]
    return div[
        chart[bars, lines = ['c'], bars_y = 'vol', panes = [['rsi'], ['cvd']],
              levels = map[rsi = [30, 70], cvd = [0]], points = marks, seek = jump,
              tz = 'America/New_York', height = 300]
    ]

test panes_points_and_seek[]
    a = app[study]
    h = html[a]
    assert['crow-pane' in h]
    assert['crow-series-rsi' in h]
    assert['crow-series-cvd' in h]
    assert['crow-level' in h]
    assert['crow-point-buy' in h]
    assert['crow-point-sell' in h]
    assert['data-crow-args="[1753702320]" data-crow-click="jump"' in h]
    click[a, jump[1753702320.0]]
    assert[at eq 1753702320.0]
