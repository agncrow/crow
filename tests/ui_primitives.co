--- The element vocabulary's primitives, rendered by the interpreter and
--- checked as markup; the compiled renderer emits the same (parity is held
--- by the kernel table both call).
use web, ui

agree = false
notify = true
mode = 'Practice'
side = 'buy'
name = 'Ann'
qty = 100
notes = ''
show_help = false
show_panel = false
saved = false
pct = 0.4

fn open_help[]
    show_help = true

fn close_help[]
    show_help = false

view render[]
    return stack[
        nav[a['Home', href = '/'], a['Scanner', href = '/scanner'], a['Sim', href = '/sim'], active = '/scanner'],
        tabs[['Scanner Replay', 'Practice'], mode],
        row[icon['search'], field['Name', name], field['Qty', qty], field['Notes', notes, lines = 3], gap = 'm'],
        row[checkbox['I agree', agree], toggle['Notify', notify], radio[['buy', 'sell'], side], gap = 'l'],
        progress[pct],
        divider[],
        details[summary['More filters'], p['Min price, max float'], open = true],
        dropdown[summary['Actions'], stack[button['Rename', click = open_help], button['Delete', click = close_help]], side = 'right'],
        modal[stack[h3['Help'], p['Click a bar to seek.'], button['Close', click = close_help]], open = show_help],
        drawer[h3['Panel'], p['Side panel'], open = show_panel, side = 'left'],
        toast[p['Saved'], open = saved, color = 'up'],
        img[src = '/x.png', alt = 'a wide picture', fit = 'cover', aspect = '16/9'],
        span['hover me', tip = 'a tooltip'],
        gap = 'm'
    ]

test primitives_render[]
    a = app[render]
    h = html[a]
    assert['<a aria-current="page" href="/scanner">' in h]
    assert['class="crow-tabs" role="tablist"' in h]
    assert['aria-selected="true" role="tab"' in h]
    assert['<svg aria-hidden="true" class="icon icon-search"' in h]
    assert['<input aria-label="Qty" data-crow-input="__field:qty" type="number" value="100">' in h]
    assert['<textarea aria-label="Notes" data-crow-input="__field:notes" rows="3">' in h]
    assert['class="crow-check"><input data-crow-input="__field:agree" type="checkbox">' in h]
    assert['crow-toggle"><input checked="" data-crow-input="__field:notify" type="checkbox">' in h]
    assert['class="crow-radio"' in h]
    assert['<progress class="crow-progress" max="1" value="0.4">' in h]
    assert['<hr class="divider">' in h]
    assert['<details open="">' in h]
    assert['<details class="dropdown" data-side="right">' in h]
    assert['aria-modal="true" class="modal" data-open="false" role="dialog"' in h]
    assert['class="drawer" data-open="false" data-side="left"' in h]
    assert['class="toast" data-open="false" role="status"' in h]
    assert['object-fit:cover' in h]
    assert['title="a tooltip"' in h]

test modal_opens_from_state[]
    a = app[render]
    click[a, open_help]
    h = html[a]
    assert['class="modal" data-open="true"' in h]

test unknown_icon_names_the_set[]
    a = app[render]
    assert['icon-search' in html[a]]

--- a list child contributes each item; a boolean attribute follows state
past = ['A', 'B', 'C']
starting = true

view session_row[s]
    return row[span[s], button['delete', click = forget], gap = 's']

fn forget[]
    past = ['A']
    starting = false

view sessions_view[]
    rows = for s in past
        session_row[s]
    return stack[h2['Sessions'], rows, button['Start', disabled = starting, class = 'primary'], gap = 'm']

test lists_and_booleans[]
    a = app[sessions_view]
    assert[len[elements[a, 'row']] eq 3]
    assert['<button class="primary" disabled="">Start</button>' in html[a]]
    click[a, forget]
    assert[len[elements[a, 'row']] eq 1]
    assert['<button class="primary">Start</button>' in html[a]]

page['/', render]
page['/past', sessions_view]

--- a list of records: actions per row send the row's key; a hidden column
--- stays in the frame; a numeric key travels as a number
use frame

deleted = 0
replayed = 0

fn ask_delete[id]
    deleted = id

fn replay[id]
    replayed = id

view records[]
    rows = frame.new[]
    rows.id = [3, 4]
    rows.symbol = ['IMRN', 'AXTX']
    rows.pnl = [-1.5, 2.0]
    return stack[
        header[h1['finch', size = 'm'], nav[a['Simulation', href = '/'], active = '/'], gap = 'm'],
        table[rows, click = replay, key = 'id', delta = ['pnl'], actions = map[Delete = ask_delete], hide = ['id']]
    ]

test rows_carry_actions_and_hide_their_key[]
    a = app[records]
    h = html[a]
    assert['<header' in h]
    assert['<button data-crow-args="[3]" data-crow-click="ask_delete">Delete</button>' in h]
    assert['<tr data-crow-args="[4]" data-crow-click="replay" tabindex="0">' in h]
    assert['<th class="num">id</th>' not in h]
    assert['class="num down"' in h]
    click[a, ask_delete[4]]
    assert[deleted eq 4]

--- an open layer is laid out where it sits: the engine once read a
--- column it never set for a modal's children
view opened[]
    return stack[p['behind'], modal[p['inside the modal'], button['Close'], open = true], gap = 'm']

test an_open_modal_lays_out[]
    a = app[opened, width = 800]
    assert[len[box[a, 'div.modal']] eq 1]
    assert[len[box[a, 'div.modal button']] eq 1]
    assert[fits[a, 800]]
