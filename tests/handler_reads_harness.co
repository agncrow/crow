use ui

--- A handler reads a derivation as a render does (one-view-design.md,
--- phase 2): through the session's cache, its own write moving what
--- reads it at once — `step` reads `doubled` before and after it moves
--- `a`, `other` writes `b` and reads `total` over it, `grow` counts the
--- list it grows — and a handler that stops lands nothing.
a = 0
b = 1
seen = ['start']
names = ['x']

derive total
    return a + b

derive doubled
    return total * 2

derive many
    return len[names]

fn step[]
    first = doubled
    a = a + 1
    second = doubled
    seen = push[seen, 'step `first`/`second`']

fn other[]
    b = 2
    x = total
    b = b + x
    seen = push[seen, 'other `total`']

fn grow[]
    before = many
    names = push[names, 'y']
    seen = push[seen, 'grow `before`-`many`']

fn refuse[]
    a = a + 5
    x = doubled
    px = float['no `x`']
    if px gt 1.0
        a = 99

view counts[]
    return p['counts `a` `b` `total` `doubled` `many`']

view render[]
    buttons = row[button['Step', click = step], button['Other', click = other], button['Grow', click = grow], button['Refuse', click = refuse]]
    shown = join[seen, ', ']
    return stack[buttons, counts[], p['seen `shown`']]

test a_handler_reads_what_it_wrote[]
    s = app[render]
    assert['counts 0 1 1 2 1' in html[s]]
    click[s, step]
    h = html[s]
    assert['counts 1 1 2 4 1' in h]
    assert['step 2/4' in h]
    click[s, other]
    h = html[s]
    assert['counts 1 5 6 12 1' in h]
    assert['other 6' in h]
    click[s, grow]
    assert['grow 1-2' in html[s]]
    click[s, refuse]
    assert['counts 1 5 6 12 2' in html[s]]
    click[s, step]
    h = html[s]
    assert['counts 2 5 7 14 2' in h]
    assert['step 12/14' in h]
