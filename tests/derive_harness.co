--- Derivations: values computed from facts and sources, read by name,
--- recomputed only when something they read changed (derive-design.md).
--- A derivation reads and never writes, so no program can count its own
--- recomputations: that count is the runtime's own tests' to hold. What a
--- program can see is that a derivation follows the facts it reads.
use web, ui, db

conn = db.connect['sqlite://:memory:']

sym = 'IMRN'
qty = 100

derive total
  return qty * 2

derive label
  return 'x `sym` total `total`'

derive trades[fresh = 300]
  return query[conn, 'SELECT id, symbol, px FROM trades WHERE symbol = ?', [sym]]

fn double[]
  qty = qty * 2

fn rename[]
  sym = 'AXTX'

fn same[]
  qty = qty

fn setup[]
  exec[conn, 'CREATE TABLE IF NOT EXISTS trades (id INTEGER PRIMARY KEY, symbol TEXT, px REAL)']

fn buy[]
  exec[conn, 'INSERT INTO trades (symbol, px) VALUES (?, ?)', [sym, 1.79]]

--- the handlers are wired here: a function that writes a fact is a
--- handler, pressed by the tests below
view render[]
  return stack[
    p[label],
    p['`len[trades]` trades'],
    button['setup', click = setup],
    button['buy', click = buy],
    button['double', click = double],
    button['rename', click = rename],
    button['same', click = same],
    gap = 's'
  ]

test a_derivation_follows_the_facts_it_reads[]
  a = app[render]
  click[a, setup]
  assert[contains[html[a], 'x IMRN total 200']]
  click[a, double]
  assert[contains[html[a], 'total 400']]
  --- a fact rewritten to the same value moves nothing: the page is as it was
  click[a, same]
  assert[contains[html[a], 'total 400']]

test a_derivation_reads_another[]
  a = app[render]
  click[a, setup]
  click[a, rename]
  assert[contains[html[a], 'x AXTX']]

test a_table_write_recomputes_a_query[]
  a = app[render]
  click[a, setup]
  assert[contains[html[a], '0 trades']]
  click[a, buy]
  assert[contains[html[a], '1 trades']]
  click[a, buy]
  assert[contains[html[a], '2 trades']]

page['/', render]
