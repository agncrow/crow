--- A variable whose first value could not fail holds no error: a view
--- renders an id the log has the failure's reason under, in place of
--- itself, and a handler stops, so
--- nothing its click did lands. The interpreter kept the error in the
--- variable and ran on: the view drew its own text, the handler counted.
--- CI runs it against the interpreter and against the compiled program
--- (crow test --compiled).
use web, ui
entry = '1.5'
count = 0
view reading[]
    v = 1.0
    v = float[entry]
    kept = [v]
    return p['reading `len[kept]`']
fn apply[]
    n = 1.0
    n = float[entry]
    count = count + 1
    kept = [n]
    log[len[kept]]
view panel[]
    return stack[
        reading[],
        p['count `count`'],
        p['`notice.text`'],
        button['Apply', click = apply]
    ]
page['/', panel]

test a_failed_value_is_refused_where_it_is_assigned[]
    a = app[panel]
    assert['reading 1' in html[a], 'the page `html[a]`']
    click[a, apply]
    assert[a.count eq 1, 'count `a.count`']
    change[a, 'entry', 'x']
    assert['error: the server\'s log has why' in html[a], 'the page `html[a]`']
    assert['cannot convert' not in html[a], 'the reason is the log\'s, not the page\'s: `html[a]`']
    assert['reading' not in html[a], 'the view is the error: `html[a]`']
    r = click[a, apply]
    assert[not r.ok]
    assert[a.count eq 1, 'nothing the click did landed: `a.count`']
    assert['cannot convert' in r.reason, 'why it stopped: `r.reason`']
    assert['apply stopped, and nothing changed — the server\'s log has why, as ' in html[a], 'the page `html[a]`']
    assert['apply stopped: cannot convert' not in html[a], 'the reader is not told the reason: `html[a]`']
