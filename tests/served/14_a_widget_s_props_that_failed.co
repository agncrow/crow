--- A widget handed props that failed shows the reason in its place, as a
--- control shows a failed argument, in both modes. (The interpreter gave
--- the widget no props; the compiled page did not build — the taskboard's
--- stars, read from a column that can hold NULL.)
use web, ui

raw = 'x'

fn fix[]
    raw = '3'

view render[]
    n = int[raw]
    return stack[
        widget['stars', props = map[stars = n]],
        button['Fix', click = fix]
    ]

serve[3414]
page['/', render]
