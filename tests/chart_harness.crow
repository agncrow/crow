use ui, db, frame, math

view render[]
    conn = db.connect['sqlite://:memory:']
    exec[conn, 'CREATE TABLE bars (ts REAL, o REAL, hi REAL, lo REAL, c REAL, vol REAL)']
    exec[conn, 'INSERT INTO bars VALUES (1753702200, 3.1, 3.4, 3.0, 3.3, 1200), (1753702260, 3.3, 3.5, 3.2, 3.2, 900), (1753702320, 3.2, 3.6, 3.2, 3.6, 2100)']
    bars = query[conn, 'SELECT ts, o, hi, lo, c, vol FROM bars ORDER BY ts']
    return div[
        chart[bars, candles = ['o', 'hi', 'lo', 'c'], bars_y = 'vol', marker = 1753702260.0, tz = 'America/New_York', height = 200]
    ]

test chart_renders[]
    a = app[render]
    h = html[a]
    assert[contains[h, 'crow-chart']]
    assert[contains[h, 'var(--crow-up)']]
    assert[contains[h, 'var(--crow-down)']]
    assert[contains[h, 'crow-marker']]
    assert[contains[h, '<rect']]

--- panes with reference levels, trade markers, and a seek target
use chart
at = 0.0

fn jump[t]
    at = t

view study[]
    bars = frame.new[]
    bars = with[bars, 'ts', [1753702200.0, 1753702260.0, 1753702320.0, 1753702380.0, 1753702440.0]]
    bars = with[bars, 'c', [3.1, 3.3, 3.2, 3.6, 3.4]]
    bars = with[bars, 'vol', [1200.0, 900.0, 2100.0, 1500.0, 800.0]]
    bars = with[bars, 'rsi', rsi[bars.c, 2]]
    bars = with[bars, 'cvd', cvd[bars.c, bars.vol]]
    marks = frame.new[]
    marks = with[marks, 'ts', [1753702260.0, 1753702380.0]]
    marks = with[marks, 'y', [3.3, 3.6]]
    marks = with[marks, 'label', ['B', 'S']]
    marks = with[marks, 'kind', ['buy', 'sell']]
    return div[
        chart[bars, lines = ['c'], bars_y = 'vol', panes = [['rsi'], ['cvd']],
              levels = map[rsi = [30, 70], cvd = [0]], points = marks, seek = jump,
              tz = 'America/New_York', height = 300]
    ]

test panes_points_and_seek[]
    a = app[study]
    h = html[a]
    assert[contains[h, 'crow-pane']]
    assert[contains[h, 'crow-series-rsi']]
    assert[contains[h, 'crow-series-cvd']]
    assert[contains[h, 'crow-level']]
    assert[contains[h, 'crow-point-buy']]
    assert[contains[h, 'crow-point-sell']]
    assert[contains[h, 'data-crow-click="jump" data-crow-args="[1753702320]"']]
    click[a, jump[1753702320.0]]
    assert[at eq 1753702320.0]
