{
  "comments": {
    "lineComment": "---"
  },
  "brackets": [["[", "]"]],
  "autoClosingPairs": [
    { "open": "[", "close": "]" },
    { "open": "'", "close": "'", "notIn": ["string"] },
    { "open": "`", "close": "`", "notIn": ["comment"] }
  ],
  "surroundingPairs": [
    ["[", "]"],
    ["'", "'"],
    ["`", "`"]
  ],
  "indentationRules": {
    "increaseIndentPattern": "^\\s*(fn|view|if|else|for|while)\\b.*$",
    "decreaseIndentPattern": "^\\s*(else)\\b.*$"
  }
}
