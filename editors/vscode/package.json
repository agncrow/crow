{
  "name": "crow-lang",
  "displayName": "Crow",
  "description": "Crow language support: diagnostics, completions, hover, navigation — powered by `crow lsp`",
  "version": "0.1.0",
  "publisher": "crow-lang",
  "icon": "icon.png",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/agncrow/crow"
  },
  "homepage": "https://agncrow.github.io/crow/",
  "bugs": {
    "url": "https://github.com/agncrow/crow/issues"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "crow",
    "language",
    "data",
    "web",
    "rust"
  ],
  "galleryBanner": {
    "color": "#0f1317",
    "theme": "dark"
  },
  "main": "./extension.js",
  "activationEvents": [],
  "contributes": {
    "languages": [
      {
        "id": "crow",
        "aliases": [
          "Crow"
        ],
        "extensions": [
          ".co"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "crow",
        "scopeName": "source.crow",
        "path": "./syntaxes/crow.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "Crow",
      "properties": {
        "crow.serverPath": {
          "type": "string",
          "default": "crow",
          "description": "Path to the crow binary (the server runs as `crow lsp`)."
        }
      }
    }
  }
}
