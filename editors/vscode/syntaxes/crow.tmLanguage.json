{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Crow",
  "scopeName": "source.crow",
  "patterns": [
    { "include": "#comment" },
    { "include": "#string" },
    { "include": "#column-name" },
    { "include": "#number" },
    { "include": "#declaration" },
    { "include": "#control" },
    { "include": "#word-operator" },
    { "include": "#constant" },
    { "include": "#call" }
  ],
  "repository": {
    "comment": {
      "name": "comment.line.crow",
      "match": "---.*$"
    },
    "string": {
      "name": "string.quoted.single.crow",
      "begin": "'",
      "end": "'",
      "patterns": [
        { "name": "constant.character.escape.crow", "match": "\\\\['`\\\\]" },
        {
          "name": "meta.embedded.line.crow",
          "begin": "`",
          "end": "`",
          "patterns": [{ "include": "$self" }],
          "beginCaptures": { "0": { "name": "punctuation.section.embedded.begin.crow" } },
          "endCaptures": { "0": { "name": "punctuation.section.embedded.end.crow" } }
        }
      ]
    },
    "column-name": {
      "comment": "a column's name after a dot with an interpolation piece (df.lag_`k`, df.`name`): the pieces are code, as a string's are",
      "begin": "\\.(?=[A-Za-z_0-9]*`)",
      "end": "(?![A-Za-z_0-9`])",
      "beginCaptures": { "0": { "name": "punctuation.accessor.crow" } },
      "patterns": [
        {
          "name": "meta.embedded.line.crow",
          "begin": "`",
          "end": "`",
          "patterns": [{ "include": "$self" }],
          "beginCaptures": { "0": { "name": "punctuation.section.embedded.begin.crow" } },
          "endCaptures": { "0": { "name": "punctuation.section.embedded.end.crow" } }
        },
        { "name": "variable.other.member.crow", "match": "[A-Za-z_0-9]+" }
      ]
    },
    "number": {
      "name": "constant.numeric.crow",
      "match": "\\b\\d+(\\.\\d+)?\\b"
    },
    "declaration": {
      "name": "keyword.declaration.crow",
      "match": "\\b(fn|view|struct|use|as)\\b"
    },
    "control": {
      "name": "keyword.control.crow",
      "match": "\\b(if|else|for|while|return|in)\\b"
    },
    "word-operator": {
      "name": "keyword.operator.word.crow",
      "match": "\\b(and|or|not|eq|ne|gt|lt|gte|lte)\\b"
    },
    "constant": {
      "name": "constant.language.crow",
      "match": "\\b(true|false)\\b"
    },
    "call": {
      "name": "entity.name.function.crow",
      "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)(?=\\[)"
    }
  }
}
