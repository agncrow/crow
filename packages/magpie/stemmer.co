--- `use magpie.stemmer`: the Porter stemmer (Porter, 1980), in Crow — for
--- English, as a log that declares `stem` applies it to every token at
--- the index and at the query: `running`, `runs` and `runner` all `run`.
--- The algorithm's five steps, written out as the paper gives them, over
--- a word's bytes as ASCII letters; a token with any other character, or
--- of two letters or fewer, is left as it is. The kernel's answer word
--- for word (docs/magpie-in-crow.md, section 3). The tests are the
--- part's own: `crow test packages/magpie/stemmer.co`, held to the kernel
--- through its test-only row until the kernel goes.
use sys

--- whether letter `i` of the word is a consonant: a `y` is one after a
--- vowel and at the start
fn _consonant[w, i]
    c = byte[w, i]
    if c eq 97 or c eq 101 or c eq 105 or c eq 111 or c eq 117
        return false
    if c eq 121
        if i eq 0
            return true
        return not _consonant[w, i - 1]
    return true

--- the measure of the word's first `end` letters: how many times a run
--- of vowels is followed by a run of consonants
fn _measure[w, end]
    m = 0
    i = 0
    while i lt end and _consonant[w, i]
        i = i + 1
    going = true
    while going
        while i lt end and not _consonant[w, i]
            i = i + 1
        if i gte end
            going = false
        else
            m = m + 1
            while i lt end and _consonant[w, i]
                i = i + 1
            if i gte end
                going = false
    return m

--- whether the first `end` letters hold a vowel
fn _has_vowel[w, end]
    for i in range[end]
        if not _consonant[w, i]
            return true
    return false

--- whether the word ends in a doubled consonant
fn _double[w]
    n = len[w]
    return n gte 2 and byte[w, n - 1] eq byte[w, n - 2] and _consonant[w, n - 1]

--- consonant, vowel, consonant at the end of the first `n` letters, the
--- last not w, x or y
fn _cvc[w, n]
    if n lt 3
        return false
    last = byte[w, n - 1]
    if last eq 119 or last eq 120 or last eq 121
        return false
    return _consonant[w, n - 1] and not _consonant[w, n - 2] and _consonant[w, n - 3]

--- whether the word ends in the suffix
fn _ends[w, suffix]
    tail = sys.bytes[suffix]
    n = len[w]
    k = len[tail]
    if n lt k
        return false
    return same[slice[w, n - k, n], tail]

--- a word and whether a step applied to it
struct Step [w, done]

--- `suffix` replaced by `with` where the stem before it has measure past
--- `m`; done where the suffix was there, replaced or not
fn _replace_if[w, suffix, with, m]
    if not _ends[w, suffix]
        return Step[w, false]
    stem_end = len[w] - len[sys.bytes[suffix]]
    if _measure[w, stem_end] gt m
        return Step[concat[slice[w, 0, stem_end], sys.bytes[with]], true]
    return Step[w, true]

--- the first `n` letters
fn _cut[w, n]
    return slice[w, 0, n]

--- `stem[word]`: the word's stem, as Porter's algorithm gives it; a word
--- that is not all lowercase ASCII letters, or has two or fewer, is
--- itself
fn stem[word]
    w = sys.bytes[word]
    n = len[w]
    if n lte 2
        return word
    for i in range[n]
        c = byte[w, i]
        if c lt 97 or c gt 122
            return word
    --- step 1a: sses → ss and ies → i both lose two letters
    if _ends[w, 'sses'] or _ends[w, 'ies']
        w = _cut[w, len[w] - 2]
    else
        if not _ends[w, 'ss'] and _ends[w, 's']
            w = _cut[w, len[w] - 1]
    --- step 1b
    more = false
    if _ends[w, 'eed']
        if _measure[w, len[w] - 3] gt 0
            w = _cut[w, len[w] - 1]
    else
        if _ends[w, 'ed'] and _has_vowel[w, len[w] - 2]
            w = _cut[w, len[w] - 2]
            more = true
        else
            if _ends[w, 'ing'] and _has_vowel[w, len[w] - 3]
                w = _cut[w, len[w] - 3]
                more = true
    if more
        if _ends[w, 'at'] or _ends[w, 'bl'] or _ends[w, 'iz']
            w = push[w, 101]
        else
            last = byte[w, len[w] - 1]
            if _double[w] and last ne 108 and last ne 115 and last ne 122
                w = _cut[w, len[w] - 1]
            else
                if _measure[w, len[w]] eq 1 and _cvc[w, len[w]]
                    w = push[w, 101]
    --- step 1c
    if _ends[w, 'y'] and _has_vowel[w, len[w] - 1]
        w = set[w, len[w] - 1, 105]
    --- step 2
    suffixes = ['ational', 'tional', 'enci', 'anci', 'izer', 'abli', 'alli', 'entli', 'eli', 'ousli', 'ization', 'ation', 'ator', 'alism', 'iveness', 'fulness', 'ousness', 'aliti', 'iviti', 'biliti']
    replacements = ['ate', 'tion', 'ence', 'ance', 'ize', 'able', 'al', 'ent', 'e', 'ous', 'ize', 'ate', 'ate', 'al', 'ive', 'ful', 'ous', 'al', 'ive', 'ble']
    stepped = false
    i = 0
    while i lt len[suffixes] and not stepped
        step = _replace_if[w, suffixes[i], replacements[i], 0]
        w = step.w
        stepped = step.done
        i = i + 1
    --- step 3
    suffixes3 = ['icate', 'ative', 'alize', 'iciti', 'ical', 'ful', 'ness']
    replacements3 = ['ic', '', 'al', 'ic', 'ic', '', '']
    stepped = false
    i = 0
    while i lt len[suffixes3] and not stepped
        step = _replace_if[w, suffixes3[i], replacements3[i], 0]
        w = step.w
        stepped = step.done
        i = i + 1
    --- step 4
    suffixes4 = ['al', 'ance', 'ence', 'er', 'ic', 'able', 'ible', 'ant', 'ement', 'ment', 'ent', 'ou', 'ism', 'ate', 'iti', 'ous', 'ive', 'ize']
    stepped = false
    i = 0
    while i lt len[suffixes4] and not stepped
        s = suffixes4[i]
        if _ends[w, s]
            stem_end = len[w] - len[sys.bytes[s]]
            if _measure[w, stem_end] gt 1
                w = _cut[w, stem_end]
            stepped = true
        i = i + 1
    if not stepped and _ends[w, 'ion']
        stem_end = len[w] - 3
        if stem_end gt 0 and _measure[w, stem_end] gt 1
            before = byte[w, stem_end - 1]
            if before eq 115 or before eq 116
                w = _cut[w, stem_end]
    --- step 5a
    if _ends[w, 'e']
        stem_end = len[w] - 1
        m = _measure[w, stem_end]
        if m gt 1 or (m eq 1 and not _cvc[w, stem_end])
            w = _cut[w, stem_end]
    --- step 5b
    if _measure[w, len[w]] gt 1 and _double[w] and byte[w, len[w] - 1] eq 108
        w = _cut[w, len[w] - 1]
    return sys.text[w, '']

--- Porter's own examples stem as the paper says, and every word of a
--- paragraph stems as the kernel stems it
test porters_examples_stem_as_the_paper_says[]
    samples = ['caresses', 'ponies', 'ties', 'caress', 'cats', 'feed', 'agreed', 'plastered', 'bled', 'motoring', 'sing', 'conflated', 'troubled', 'sized', 'hopping', 'tanned', 'falling', 'hissing', 'fizzed', 'failing', 'filing', 'happy', 'sky', 'relational', 'conditional', 'rational', 'valenci', 'hesitanci', 'digitizer', 'conformabli', 'radicalli', 'differentli', 'vileli', 'analogousli', 'vietnamization', 'predication', 'operator', 'feudalism', 'decisiveness', 'hopefulness', 'callousness', 'formaliti', 'sensitiviti', 'sensibiliti', 'triplicate', 'formative', 'formalize', 'electriciti', 'electrical', 'hopeful', 'goodness', 'revival', 'allowance', 'inference', 'airliner', 'gyroscopic', 'adjustable', 'defensible', 'irritant', 'replacement', 'adjustment', 'dependent', 'adoption', 'homologou', 'communism', 'activate', 'angulariti', 'homologous', 'effective', 'bowdlerize', 'probate', 'rate', 'cease', 'controll', 'roll', 'running', 'generalization', 'the', 'a', 'Fox', '2026']
    stems = ['caress', 'poni', 'ti', 'caress', 'cat', 'feed', 'agre', 'plaster', 'bled', 'motor', 'sing', 'conflat', 'troubl', 'size', 'hop', 'tan', 'fall', 'hiss', 'fizz', 'fail', 'file', 'happi', 'sky', 'relat', 'condit', 'ration', 'valenc', 'hesit', 'digit', 'conform', 'radic', 'differ', 'vile', 'analog', 'vietnam', 'predic', 'oper', 'feudal', 'decis', 'hope', 'callous', 'formal', 'sensit', 'sensibl', 'triplic', 'form', 'formal', 'electr', 'electr', 'hope', 'good', 'reviv', 'allow', 'infer', 'airlin', 'gyroscop', 'adjust', 'defens', 'irrit', 'replac', 'adjust', 'depend', 'adopt', 'homolog', 'commun', 'activ', 'angular', 'homolog', 'effect', 'bowdler', 'probat', 'rate', 'ceas', 'control', 'roll', 'run', 'gener', 'the', 'a', 'Fox', '2026']
    for i in range[len[samples]]
        assert[stem[samples[i]] eq stems[i]]
    text = 'the quick brown foxes jumped over the lazily sleeping dogs while hopping and running generalizations about relational conditionals'
    seen = []
    for w in split[text, ' ']
        seen = push[seen, stem[w]]
    --- (recorded from the Rust kernel before it was deleted, 2026-10-28)
    assert[seen eq ['the', 'quick', 'brown', 'fox', 'jump', 'over', 'the', 'lazili', 'sleep', 'dog', 'while', 'hop', 'and', 'run', 'gener', 'about', 'relat', 'condit']]
