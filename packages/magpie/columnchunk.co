--- `use magpie.columnchunk`: a column chunk, in Crow — the cells of one column
--- over one row group as a Magpie file writes them, encoded by the
--- column's kind and passed through the codec where that shrinks them,
--- the Rust kernel's bytes byte for byte (docs/magpie-in-crow.md,
--- section 3). A chunk is self-describing past its kind: an encoding
--- byte, a flags byte (bit 0: a presence bitmap follows the header; bit
--- 1: the payload went through the codec), the row count, the raw
--- payload's length and the stored payload's length (four bytes each,
--- little-endian), the bitmap where cells are missing, then the payload.
--- Encodings: ints by frame of reference (a base and each value's offset
--- from it, bit-packed) or by delta from the cell before (a monotone
--- column packs to a few bits a row), whichever is smaller; floats as
--- their bits, 32 of them where the log declared the column narrow; text
--- as bit-packed lengths and bytes, or as a dictionary of distinct values
--- and bit-packed codes where the distinct values are at most half the
--- cells; bools as a bitmap; moments as their milliseconds (an int
--- encoding) and their offsets (frame of reference); a column of vectors
--- as the rows' floats laid flat. A missing cell is written as its
--- neighbour's value, so it widens nothing, and read back as missing by
--- the bitmap. The column's cells come and go as the vectors they are
--- held in (sys's `ints_of`, `ints_column` and their kin), never one at a
--- time; the arithmetic over ints wraps to 64 bits where the kernel's does
--- (`wrapsub`, `wrapadd`), the one place a span past 64 bits is decided
--- running on growing ints, as the kernel decides it on 128. The tests
--- are the part's own: `crow test packages/magpie/columnchunk.co`, held to the
--- kernel through its test-only rows until the kernel goes.
use sys
use bits
use frame
use bitpack
use lz77

--- an encoding and its payload
struct Part [enc, payload]

--- values decoded and the position after them
struct Read [vals, at]

--- whether cell `i` is present, by the bitmap (every cell is where the
--- bitmap is empty)
fn _present[present, i]
    if len[present] eq 0
        return true
    return bitand[byte[present, shift[i, -3]], shift[1, bitand[i, 7]]] ne 0

--- how many bytes `n` values of `width` bits take
fn _packed_bytes[n, width]
    return shift[n * width + 7, -3]

--- the ints with each missing cell replaced by the cell before it (or the
--- first present one), so a placeholder widens no range
fn _filled_ints[vals, present]
    if len[present] eq 0
        return vals
    n = len[vals]
    first = 0
    found = false
    i = 0
    while i lt n and not found
        if _present[present, i]
            first = vals[i]
            found = true
        i = i + 1
    out = []
    last = first
    for i in range[n]
        if _present[present, i]
            last = vals[i]
        out = push[out, last]
    return out

--- an int sequence encoded: the smaller of frame of reference (0) and
--- delta (1). The offsets and the deltas are 64-bit patterns, computed
--- wrapped as the kernel computes them on 128 bits and cuts them; the
--- choice between the two needs the deltas' exact span, which the wrapped
--- deltas give where none overflowed 64 bits, and the growing ints
--- otherwise
fn _encode_ints[vals]
    n = len[vals]
    if n eq 0
        return Part[0, sys.bytes[9]]
    base = vals[0]
    top = vals[0]
    for v in vals
        if v lt base
            base = v
        if v gt top
            top = v
    for_width = bitpack.width_of[wrapsub[top, base]]
    for_size = 9 + _packed_bytes[n, for_width]
    use_delta = false
    dmin = 0
    width = 0
    if n gt 1
        overflow = false
        wmin = 0
        wmax = 0
        i = 1
        while i lt n
            d = wrapsub[vals[i], vals[i - 1]]
            --- a difference past 64 bits: the operands' signs differ, and
            --- the answer's differs from the first's
            if bitand[bitxor[vals[i], vals[i - 1]], bitxor[vals[i], d]] lt 0
                overflow = true
            if i eq 1
                wmin = d
                wmax = d
            else
                if d lt wmin
                    wmin = d
                if d gt wmax
                    wmax = d
            i = i + 1
        if not overflow
            width = bitpack.width_of[wrapsub[wmax, wmin]]
            size = 17 + _packed_bytes[n - 1, width]
            if size lt for_size
                use_delta = true
                dmin = wmin
        else
            --- the exact span decides, as the kernel's 128 bits do: a span
            --- past 64 bits, or a least delta outside them, is not packed
            emin = vals[1] - vals[0]
            emax = emin
            i = 2
            while i lt n
                e = vals[i] - vals[i - 1]
                if e lt emin
                    emin = e
                if e gt emax
                    emax = e
                i = i + 1
            if emax - emin lte 18446744073709551615 and emin gte -9223372036854775808 and emin lte 9223372036854775807
                width = bitpack.width_of[wrap[emax - emin]]
                size = 17 + _packed_bytes[n - 1, width]
                if size lt for_size
                    use_delta = true
                    dmin = wrap[emin]
    if use_delta
        out = pack[vals[0], 8, little = true]
        out = concat[out, pack[dmin, 8, little = true]]
        out = push[out, width]
        deltas = []
        i = 1
        while i lt n
            deltas = push[deltas, wrapsub[wrapsub[vals[i], vals[i - 1]], dmin]]
            i = i + 1
        out = concat[out, bitpack.packed[deltas, width]]
        return Part[1, out]
    out = pack[base, 8, little = true]
    out = push[out, for_width]
    offsets = []
    for v in vals
        offsets = push[offsets, wrapsub[v, base]]
    out = concat[out, bitpack.packed[offsets, for_width]]
    return Part[0, out]

--- `n` ints decoded from the payload at `at` by the encoding, and the
--- position after them
fn _decode_ints[enc, data, at, n]
    if enc eq 0
        if at + 9 gt len[data]
            return error['the file ends `at + 9 - len[data]` bytes early', 'magpie']
        base = unpack[data, at, 8, little = true]
        width = byte[data, at + 8]
        count = _packed_bytes[n, width]
        offs = bitpack.unpacked[data, at + 9, n, width]
        if not offs.ok
            return error[offs.reason, 'magpie']
        vals = []
        for o in offs
            vals = push[vals, wrapadd[base, o]]
        return Read[vals, at + 9 + count]
    if enc eq 1
        if at + 17 gt len[data]
            return error['the file ends `at + 17 - len[data]` bytes early', 'magpie']
        first = unpack[data, at, 8, little = true]
        dmin = unpack[data, at + 8, 8, little = true]
        width = byte[data, at + 16]
        vals = []
        if n eq 0
            return Read[vals, at + 17]
        count = _packed_bytes[n - 1, width]
        deltas = bitpack.unpacked[data, at + 17, n - 1, width]
        if not deltas.ok
            return error[deltas.reason, 'magpie']
        vals = push[vals, first]
        cur = first
        for d in deltas
            cur = wrapadd[cur, wrapadd[dmin, d]]
            vals = push[vals, cur]
        return Read[vals, at + 17 + count]
    return error['no int encoding is numbered `enc`', 'magpie']

--- text cells as bit-packed lengths and their bytes
fn _plain_text[cell_bytes, cuts]
    lens = []
    last = 0
    longest = 0
    for e in cuts
        l = e - last
        lens = push[lens, l]
        if l gt longest
            longest = l
        last = e
    width = bitpack.width_of[longest]
    out = sys.bytes[0]
    out = push[out, width]
    out = concat[out, bitpack.packed[lens, width]]
    out = concat[out, cell_bytes]
    return out

--- the bytes and the cuts of `n` plain text cells at `at`, and the
--- position after them: a record whose `vals` is the cuts, with the bytes
--- beside it
struct Plain [data, cuts, at]

fn _read_plain_text[data, at, n]
    if at + 1 gt len[data]
        return error['the file ends 1 bytes early', 'magpie']
    width = byte[data, at]
    count = _packed_bytes[n, width]
    lens = bitpack.unpacked[data, at + 1, n, width]
    if not lens.ok
        return error[lens.reason, 'magpie']
    cuts = []
    total = 0
    for l in lens
        total = total + l
        cuts = push[cuts, total]
    begin = at + 1 + count
    if begin + total gt len[data]
        return error['the file ends `begin + total - len[data]` bytes early', 'magpie']
    return Plain[slice[data, begin, begin + total], cuts, begin + total]

--- a text column's chunk: a dictionary where the distinct values are at
--- most half the cells (4), plain lengths and bytes otherwise (3)
fn _encode_text[col, from, to]
    n = to - from
    cell_bytes = text_bytes_of[col, from, to]
    cuts = text_ends_of[col, from, to]
    limit = n / 2
    if limit lt 1
        limit = 1
    seen = map[]
    codes = []
    dict_bytes = sys.bytes[0]
    dict_ends = []
    dictionary = true
    begin = 0
    i = 0
    while i lt n and dictionary
        stop = cuts[i]
        cell = sys.text[slice[cell_bytes, begin, stop], '']
        if cell in seen
            codes = push[codes, seen[cell]]
        else
            if len[dict_ends] gte limit
                dictionary = false
            else
                seen = set[seen, cell, len[dict_ends]]
                codes = push[codes, len[dict_ends]]
                dict_bytes = concat[dict_bytes, slice[cell_bytes, begin, stop]]
                dict_ends = push[dict_ends, len[dict_bytes]]
        begin = stop
        i = i + 1
    if dictionary and n gt 1
        out = pack[len[dict_ends], 4, little = true]
        out = concat[out, _plain_text[dict_bytes, dict_ends]]
        width = bitpack.width_of[len[dict_ends] - 1]
        out = push[out, width]
        out = concat[out, bitpack.packed[codes, width]]
        return Part[4, out]
    return Part[3, _plain_text[cell_bytes, cuts]]

--- a bitmap's bytes of the cells where `flags[i]` holds and the cell is
--- present: bit i of byte i / 8
fn _bitmap[flags, present]
    n = len[flags]
    out = sys.bytes[shift[n + 7, -3]]
    for i in range[n]
        if flags[i] and _present[present, i]
            at = shift[i, -3]
            out = set[out, at, bitor[byte[out, at], shift[1, bitand[i, 7]]]]
    return out

--- `chunk[col, from, to, narrow]`: the chunk of rows `from` to `to`
--- (excluded) of the column, as the file's bytes; a float column with
--- `narrow` is written in 32 bits
fn chunk[col, from, to, narrow]
    n = to - from
    present = present_of[col, from, to]
    kind = cell_kind[col]
    part = Part[0, sys.bytes[0]]
    if kind eq 'int'
        part = _encode_ints[_filled_ints[ints_of[col, from, to], present]]
    if kind eq 'float'
        vals = floats_of[col, from, to]
        if len[present] gt 0
            for i in range[n]
                if not _present[present, i]
                    vals[i] = 0.0
        if narrow
            part = Part[7, float_bytes[vals, 4, true]]
        else
            part = Part[2, float_bytes[vals, 8, true]]
    if kind eq 'text'
        part = _encode_text[col, from, to]
    if kind eq 'bool'
        part = Part[5, _bitmap[bools_of[col, from, to], present]]
    if kind eq 'moment'
        ms = _encode_ints[_filled_ints[millis_of[col, from, to], present]]
        offs = _encode_ints[zones_of[col, from, to]]
        payload = sys.bytes[0]
        payload = push[payload, ms.enc]
        payload = concat[payload, ms.payload]
        payload = push[payload, offs.enc]
        payload = concat[payload, offs.payload]
        part = Part[6, payload]
    if kind eq 'vector'
        w = vector_width[col]
        vals = vectors_of[col, from, to]
        if len[present] gt 0
            for i in range[n]
                if not _present[present, i]
                    for j in range[w]
                        vals[i * w + j] = 0.0
        payload = pack[w, 4, little = true]
        if narrow
            part = Part[9, concat[payload, float_bytes[vals, 4, true]]]
        else
            part = Part[8, concat[payload, float_bytes[vals, 8, true]]]
    raw_len = len[part.payload]
    stored = part.payload
    coded = false
    --- past 64 bytes the codec is tried, and kept where it shrinks the
    --- payload by a tenth or more
    if raw_len gte 64
        c = lz77.compress[part.payload]
        if len[c] + len[c] / 10 lt raw_len
            stored = c
            coded = true
    flags = 0
    if len[present] gt 0
        flags = flags + 1
    if coded
        flags = flags + 2
    out = sys.bytes[0]
    out = push[out, part.enc]
    out = push[out, flags]
    out = concat[out, pack[n, 4, little = true]]
    out = concat[out, pack[raw_len, 4, little = true]]
    out = concat[out, pack[len[stored], 4, little = true]]
    if len[present] gt 0
        out = concat[out, present]
    out = concat[out, stored]
    return out

--- the chunk's header alone, so a reader knows how much to read before
--- decoding: 14 bytes
fn header[]
    return 14

--- `unchunk[data, kind]`: the column a chunk's bytes hold, its missing
--- cells marked, `kind` the column's as the file's footer says (`int`,
--- `float`, `text`, `bool`, `moment`, `vector`); an error value of kind
--- `'magpie'` where the bytes are cut short, promise rows they do not
--- hold, or are no encoding of the kind
fn unchunk[data, kind]
    total = len[data]
    if total lt 14
        return error['the file ends `14 - total` bytes early', 'magpie']
    enc = byte[data, 0]
    flags = byte[data, 1]
    n = unpack[data, 2, 4, little = true, signed = false]
    raw_len = unpack[data, 6, 4, little = true, signed = false]
    stored_len = unpack[data, 10, 4, little = true, signed = false]
    at = 14
    present = sys.bytes[0]
    if bitand[flags, 1] ne 0
        count = shift[n + 7, -3]
        if at + count gt total
            return error['the file ends `at + count - total` bytes early', 'magpie']
        present = slice[data, at, at + count]
        at = at + count
    if at + stored_len gt total
        return error['the file ends `at + stored_len - total` bytes early', 'magpie']
    stored = slice[data, at, at + stored_len]
    payload = stored
    if bitand[flags, 2] ne 0
        plain = lz77.decompress[stored, raw_len]
        if not plain.ok
            return error[plain.reason, 'magpie']
        payload = plain
    else
        if stored_len ne raw_len
            return error['a chunk promises `raw_len` bytes and holds `stored_len`', 'magpie']
    if kind eq 'int'
        got = _decode_ints[enc, payload, 0, n]
        if not got.ok
            return got
        return ints_column[got.vals, present]
    if kind eq 'float'
        if enc eq 2
            if n * 8 gt len[payload]
                return error['the file ends `n * 8 - len[payload]` bytes early', 'magpie']
            return floats_column[float_values[payload, 0, n, 8, true], present]
        if enc eq 7
            if n * 4 gt len[payload]
                return error['the file ends `n * 4 - len[payload]` bytes early', 'magpie']
            return floats_column[float_values[payload, 0, n, 4, true], present]
        return error['a float chunk is not encoding `enc`', 'magpie']
    if kind eq 'text'
        if enc eq 3
            plain = _read_plain_text[payload, 0, n]
            if not plain.ok
                return plain
            return text_column[plain.data, plain.cuts, present]
        if enc eq 4
            if len[payload] lt 4
                return error['the file ends `4 - len[payload]` bytes early', 'magpie']
            nd = unpack[payload, 0, 4, little = true, signed = false]
            dict_read = _read_plain_text[payload, 4, nd]
            if not dict_read.ok
                return dict_read
            at = dict_read.at
            if at + 1 gt len[payload]
                return error['the file ends 1 bytes early', 'magpie']
            width = byte[payload, at]
            codes = bitpack.unpacked[payload, at + 1, n, width]
            if not codes.ok
                return error[codes.reason, 'magpie']
            --- (a code naming no value stops, as the row says)
            return text_dict_column[dict_read.data, dict_read.cuts, codes, present]
        return error['no text encoding is numbered `enc`', 'magpie']
    if kind eq 'bool'
        if enc ne 5
            return error['a bool chunk is not encoding `enc`', 'magpie']
        count = shift[n + 7, -3]
        if count gt len[payload]
            return error['the file ends `count - len[payload]` bytes early', 'magpie']
        return bools_column[slice[payload, 0, count], n, present]
    if kind eq 'moment'
        if enc ne 6
            return error['a moment chunk is not encoding `enc`', 'magpie']
        if len[payload] lt 1
            return error['the file ends 1 bytes early', 'magpie']
        ms = _decode_ints[byte[payload, 0], payload, 1, n]
        if not ms.ok
            return ms
        if ms.at + 1 gt len[payload]
            return error['the file ends 1 bytes early', 'magpie']
        offs = _decode_ints[byte[payload, ms.at], payload, ms.at + 1, n]
        if not offs.ok
            return offs
        return moments_column[ms.vals, offs.vals, present]
    if kind eq 'vector'
        if enc ne 8 and enc ne 9
            return error['a vector chunk is not encoding `enc`', 'magpie']
        if len[payload] lt 4
            return error['the file ends `4 - len[payload]` bytes early', 'magpie']
        w = unpack[payload, 0, 4, little = true, signed = false]
        per = 8
        if enc eq 9
            per = 4
        if 4 + n * w * per gt len[payload]
            return error['the file ends `4 + n * w * per - len[payload]` bytes early', 'magpie']
        return vectors_column[w, float_values[payload, 4, n * w, per, true], present]
    return error['no column kind is named `kind`', 'magpie']

--- a list of ints
fn _ints[a, b, c, d, e]
    out = []
    out = push[out, a]
    out = push[out, b]
    out = push[out, c]
    out = push[out, d]
    out = push[out, e]
    return out

--- a list of floats
fn _floats[a, b, c, d, e]
    out = []
    out = push[out, a]
    out = push[out, b]
    out = push[out, c]
    out = push[out, d]
    out = push[out, e]
    return out

--- a presence bitmap over five cells with the second missing
fn _second_missing[]
    present = sys.bytes[1]
    present = set[present, 0, 29]
    return present

--- a short digest of bytes: what a recorded answer is held to
fn _digest[b]
    return slice[hash[b, 'sha256'], 0, 16]

--- every kind of column encoded as the kernel encodes it, byte for byte,
--- with every cell present and with one missing, and read back whole:
--- ints by frame of reference and by delta, a monotone column packed to
--- a few bits a row, floats at 64 and 32 bits, text plain and as a
--- dictionary, bools, moments, vectors, and a payload the codec shrinks
test the_chunks_are_the_kernels_byte_for_byte[]
    seen = []
    none = sys.bytes[0]
    gap = _second_missing[]
    cols = []
    cols = push[cols, ints_column[_ints[3, 1, 2, 1000000, -7], none]]
    cols = push[cols, ints_column[_ints[3, 1, 2, 1000000, -7], gap]]
    cols = push[cols, ints_column[_ints[100, 101, 102, 103, 104], none]]
    cols = push[cols, ints_column[_ints[9223372036854775807, -9223372036854775808, 0, 1, -1], none]]
    cols = push[cols, floats_column[_floats[1.5, -2.25, 0.0, 10.0 ^ 300, -0.0], gap]]
    truths = sys.bytes[1]
    truths = set[truths, 0, 21]
    cols = push[cols, bools_column[truths, 5, gap]]
    cols = push[cols, moments_column[_ints[0, 1000, 2000, 3000, 4000], _ints[0, 60, 0, -300, 0], gap]]
    cols = push[cols, vectors_column[2, concat[_floats[1.0, 0.0, 0.0, 1.0, 0.5], _floats[0.5, 2.0, 3.0, -1.0, 4.0]], gap]]
    for col in cols
        kind = cell_kind[col]
        narrow = false
        chunk = chunk[col, 0, 5, narrow]
        seen = push[seen, _digest[chunk]]
        back = unchunk[chunk, kind]
        assert[same[present_of[back, 0, 5], present_of[col, 0, 5]]]
        if kind eq 'int'
            assert[ints_of[back, 0, 5] eq ints_of[col, 0, 5]]
        if kind eq 'float' or kind eq 'vector'
            assert[floats_of[back, 0, 5] eq floats_of[col, 0, 5]]
        if kind eq 'bool'
            assert[bools_of[back, 0, 5] eq bools_of[col, 0, 5]]
        if kind eq 'moment'
            assert[millis_of[back, 0, 5] eq millis_of[col, 0, 5] and zones_of[back, 0, 5] eq zones_of[col, 0, 5]]
        --- a part of the column, too
        part = chunk[col, 1, 4, narrow]
        seen = push[seen, _digest[part]]
        assert[same[present_of[unchunk[part, kind], 0, 3], present_of[col, 1, 4]]]
    --- floats and vectors at 32 bits
    narrow_cols = []
    narrow_cols = push[narrow_cols, floats_column[_floats[1.5, -2.25, 0.0, 3.0, -0.0], gap]]
    narrow_cols = push[narrow_cols, vectors_column[2, concat[_floats[1.0, 0.0, 0.0, 1.0, 0.5], _floats[0.5, 2.0, 3.0, -1.0, 4.0]], none]]
    for col in narrow_cols
        chunk = chunk[col, 0, 5, true]
        seen = push[seen, _digest[chunk]]
        assert[floats_of[unchunk[chunk, cell_kind[col]], 0, 5] eq floats_of[col, 0, 5]]
    --- text: plain where the values are mostly distinct, a dictionary
    --- where they repeat, and a missing cell among them
    names = frame.new[plain = ['Apple', 'banana', 'cherry', 'durian', 'elder'], few = ['a', 'b', 'a', 'a', 'b']]
    for col in [names.plain, names.few]
        chunk = chunk[col, 0, 5, false]
        seen = push[seen, _digest[chunk]]
        back = unchunk[chunk, 'text']
        assert[same[text_bytes_of[back, 0, 5], text_bytes_of[col, 0, 5]] and text_ends_of[back, 0, 5] eq text_ends_of[col, 0, 5]]
    holed = text_column[text_bytes_of[names.few, 0, 5], text_ends_of[names.few, 0, 5], gap]
    chunk = chunk[holed, 0, 5, false]
    seen = push[seen, _digest[chunk]]
    assert[same[present_of[unchunk[chunk, 'text'], 0, 5], gap]]
    --- a long column: the codec shrinks a monotone int column's payload
    --- (a delta of a few bits a row) and the chunk says so
    many = []
    for i in range[5000]
        many = push[many, 1000 + i * 3]
    long = ints_column[many, none]
    chunk = chunk[long, 0, 5000, false]
    seen = push[seen, _digest[chunk]]
    assert[ints_of[unchunk[chunk, 'int'], 0, 5000] eq many]
    words = []
    for i in range[300]
        words = push[words, 'word `i - 7 * (i / 7)`']
    texts = frame.new[w = words]
    chunk = chunk[texts.w, 0, 300, false]
    seen = push[seen, _digest[chunk]]
    assert[same[text_bytes_of[unchunk[chunk, 'text'], 0, 300], text_bytes_of[texts.w, 0, 300]]]
    --- (recorded from the Rust kernel before it was deleted, 2026-10-28)
    assert[seen eq ['b55524ec0c594392', '24a538d604701e69', '97d4efb7665dcae8', 'fb2eb0165e133715', 'afa32084a4c0c6c2', '7d89c4353d25f291', 'af40d346896ed808', 'b41829d39fc0b470', '710b9badedc531da', '4ee9968fb3a2aa35', '42db67ca44b8fe9e', 'e2b419c631b37f66', 'a1f40fef71e8629e', '7fa8249a240c720e', '8b4768316c69f139', '08e115fe3b76e2c1', '5dd79c777d1230e0', '2cfd193b5d0b5fac', '29b8504767ad24d1', '43d38bc3bc0607ea', '726d38bec1858cb7', '93febba0f7d8ff2a', '99230a84e6984c73']]

--- a chunk cut short, or promising what it does not hold, is refused with
--- its reason, as the kernel refuses it
test a_torn_chunk_is_refused[]
    col = ints_column[_ints[3, 1, 2, 1000000, -7], _second_missing[]]
    chunk = chunk[col, 0, 5, false]
    assert[unchunk[slice[chunk, 0, 10], 'int'].reason eq 'the file ends 4 bytes early']
    assert[not unchunk[slice[chunk, 0, len[chunk] - 1], 'int'].ok]
    assert[unchunk[chunk, 'float'].reason eq 'a float chunk is not encoding 0']
    assert[unchunk[chunk, 'bool'].reason eq 'a bool chunk is not encoding 0']
    assert[not unchunk[chunk, 'nosuch'].ok]
