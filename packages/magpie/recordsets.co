--- `use magpie.recordsets`: the Kafka wire's record sets, the
--- per-byte half of the Kafka door, in Crow: a legacy message set (magic
--- 1, the format brokers of 0.10 wrote and every client still reads)
--- decoded into a frame and encoded from one, each message's CRC-32
--- checked and written, a compressed wrapper (gzip, or snappy raw or in
--- xerial's framing) read as the records it holds. The kernel's answer
--- byte for byte (docs/magpie-in-crow.md)
use sys
use bits
use frame
use inflate
use snappy
use columnchunk

--- the rows of a message set as columns being built
struct Rows [offsets, ats, keys, key_ends, key_held, values, value_ends, value_held, count]

--- a field read: its bytes, whether it is there (a length of -1 is
--- none), and the position after it
struct Field [data, held, at]

fn _field[msg, at, n, what]
    if at + 4 gt len[msg]
        return error['records: message `n` is cut inside its `what`\'s length', 'kafka']
    size = unpack[msg, at, 4]
    if size lt 0
        return Field[sys.bytes[0], false, at + 4]
    if at + 4 + size gt len[msg]
        return error['records: message `n` is cut inside its `what`', 'kafka']
    return Field[slice[msg, at + 4, at + 4 + size], true, at + 4 + size]

--- Snappy as Kafka clients write it: xerial's framing — the magic
--- `\x82SNAPPY\x00`, two ints of version, then blocks each led by its
--- compressed length — or one raw block
fn _snappy_kafka[v]
    magic = sys.bytes[0]
    for b in [130, 83, 78, 65, 80, 80, 89, 0]
        magic = push[magic, int[b]]
    if len[v] gte 16 and same[slice[v, 0, 8], magic]
        out = sys.bytes[0]
        p = 16
        while p + 4 lte len[v]
            size = unpack[v, p, 4, signed = false]
            p = p + 4
            if p + size gt len[v]
                return error['a snappy block is cut short', 'kafka']
            block = snappy.unsnapped[slice[v, p, p + size]]
            if not block.ok
                return error['snappy: `block.reason`', 'kafka']
            out = concat[out, block]
            p = p + size
        return out
    whole = snappy.unsnapped[v]
    if not whole.ok
        return error['snappy: `whole.reason`', 'kafka']
    return whole

--- no rows yet
fn _no_rows[]
    none = []
    held = slice[[true], 0, 0]
    return Rows[none, none, sys.bytes[0], none, held, sys.bytes[0], none, held, 0]

--- the rows read so far with one message set's more
fn _rows_of[data, rows]
    pos = 0
    n = rows.count
    offsets = rows.offsets
    ats = rows.ats
    key_text = rows.keys
    key_ends = rows.key_ends
    key_held = rows.key_held
    value_text = rows.values
    value_ends = rows.value_ends
    value_held = rows.value_held
    total = len[data]
    reading = true
    while reading and pos + 12 lte total
        offset = unpack[data, pos, 8]
        size = unpack[data, pos + 8, 4]
        if size lt 0
            return error['records: message `n` has a negative length', 'kafka']
        begin = pos + 12
        if begin + size gt total
            reading = false
        else
            msg = slice[data, begin, begin + size]
            if size lt 6
                return error['records: message `n` is `size` bytes, too few for a message', 'kafka']
            if unpack[msg, 0, 4, signed = false] ne inflate.crc32[slice[msg, 4, size]]
                return error['records: message `n` does not match its checksum', 'kafka']
            magic = byte[msg, 4]
            attributes = byte[msg, 5]
            at = -1
            p = 6
            if magic eq 1
                if size lt 14
                    return error['records: message `n` is cut inside its timestamp', 'kafka']
                at = unpack[msg, 6, 8]
                p = 14
            if magic gt 1
                return error['records: message `n` has magic `magic` — the door reads 0 and 1', 'kafka']
            key = _field[msg, p, n, 'key']
            if not key.ok
                return error[key.reason, 'kafka']
            value = _field[msg, key.at, n, 'value']
            if not value.ok
                return error[value.reason, 'kafka']
            codec = bitand[attributes, 7]
            if codec ne 0
                --- a wrapper: its value is an inner message set, compressed —
                --- the inner messages are the records
                if not value.held
                    return error['records: message `n` is compressed and holds nothing', 'kafka']
                inner = sys.bytes[0]
                if codec eq 1
                    unzipped = inflate.gunzipped[value.data]
                    if not unzipped.ok
                        return error['records: message `n` does not unzip: `unzipped.reason`', 'kafka']
                    inner = unzipped
                if codec eq 2
                    unsnapped_set = _snappy_kafka[value.data]
                    if not unsnapped_set.ok
                        return error['records: message `n`: `unsnapped_set.reason`', 'kafka']
                    inner = unsnapped_set
                if codec gt 2
                    return error['records: message `n` is compressed with codec `codec` — the door reads gzip and snappy', 'kafka']
                --- (read as a set of its own: its messages are counted
                --- from 0 in what it refuses, as the kernel reads one)
                more = _rows_of[inner, _no_rows[]]
                if not more.ok
                    return error[more.reason, 'kafka']
                key_base = len[key_text]
                value_base = len[value_text]
                for r in range[more.count]
                    offsets = push[offsets, more.offsets[r]]
                    ats = push[ats, more.ats[r]]
                    key_ends = push[key_ends, key_base + more.key_ends[r]]
                    key_held = push[key_held, more.key_held[r]]
                    value_ends = push[value_ends, value_base + more.value_ends[r]]
                    value_held = push[value_held, more.value_held[r]]
                key_text = concat[key_text, more.keys]
                value_text = concat[value_text, more.values]
                n = n + more.count
            else
                if key.held and not sys.text[key.data].ok
                    return error['records: message `n`\'s key is no UTF-8 text', 'kafka']
                if value.held and not sys.text[value.data].ok
                    return error['records: message `n`\'s value is no UTF-8 text', 'kafka']
                offsets = push[offsets, offset]
                ats = push[ats, at]
                key_text = concat[key_text, key.data]
                key_ends = push[key_ends, len[key_text]]
                key_held = push[key_held, key.held]
                value_text = concat[value_text, value.data]
                value_ends = push[value_ends, len[value_text]]
                value_held = push[value_held, value.held]
                n = n + 1
            pos = begin + size
    return Rows[offsets, ats, key_text, key_ends, key_held, value_text, value_ends, value_held, n]

--- the bitmap of which cells are present (no bytes where every one is)
fn _bitmap_of[flags]
    every = true
    for f in flags
        if not f
            every = false
    if every
        return sys.bytes[0]
    out = sys.bytes[shift[len[flags] + 7, -3]]
    for i in range[len[flags]]
        if flags[i]
            out = set[out, shift[i, -3], bitor[byte[out, shift[i, -3]], shift[1, bitand[i, 7]]]]
    return out

--- `message_rows[data]`: a message set as a frame — `offset` (as the
--- producer wrote it), `at` (the timestamp in milliseconds, -1 where the
--- message has none), `key` and `value` as text (an absent key is a
--- missing cell; a payload that is no UTF-8 is refused, naming the
--- message). Magic 0 and 1 are read, a wrapper compressed with gzip or
--- snappy as the records it holds; a message whose checksum does not
--- match is refused. A partial message at the end is skipped
fn message_rows[data]
    rows = _rows_of[data, _no_rows[]]
    if not rows.ok
        return error[rows.reason, 'kafka']
    f = frame.new[]
    f.offset = ints_column[rows.offsets, sys.bytes[0]]
    f.at = ints_column[rows.ats, sys.bytes[0]]
    f.key = text_column[rows.keys, rows.key_ends, _bitmap_of[rows.key_held]]
    f.value = text_column[rows.values, rows.value_ends, _bitmap_of[rows.value_held]]
    return f

--- whether cell `i` is present, by the bitmap
fn _present[present, i]
    if len[present] eq 0
        return true
    return bitand[byte[present, shift[i, -3]], shift[1, bitand[i, 7]]] ne 0

--- `message_set[df]`: a frame's rows as a message set of magic 1, each
--- message's offset from its `offset` column, its timestamp from `at`
--- (ms; -1 or a missing cell for none), its `key` (a missing cell is no
--- key) and `value` as text; the checksum written. A frame lacking a
--- column is refused
fn message_set[df]
    for name in ['offset', 'at', 'key', 'value']
        if name not in df.columns
            return error['records: the frame holds no column \'`name`\'', 'kafka']
    n = len[df]
    out = sys.bytes[0]
    if n eq 0
        return out
    --- (the kinds as the first row meets them, as the kernel's rows do)
    if cell_kind[df.offset] ne 'int'
        return error['records: \'offset\' holds no ints', 'kafka']
    offsets = ints_of[df.offset, 0, n]
    at_kind = cell_kind[df.at]
    if at_kind ne 'int' and at_kind ne 'moment'
        return error['records: \'at\' holds no moments or milliseconds', 'kafka']
    ats = []
    if at_kind eq 'int'
        ats = ints_of[df.at, 0, n]
    else
        ats = millis_of[df.at, 0, n]
    at_present = present_of[df.at, 0, n]
    for name in ['key', 'value']
        if cell_kind[df.`name`] ne 'text'
            return error['records: \'`name`\' holds no text', 'kafka']
    key_bytes = text_bytes_of[df.key, 0, n]
    key_ends = text_ends_of[df.key, 0, n]
    key_present = present_of[df.key, 0, n]
    value_bytes = text_bytes_of[df.value, 0, n]
    value_ends = text_ends_of[df.value, 0, n]
    value_present = present_of[df.value, 0, n]
    key_from = 0
    value_from = 0
    for r in range[n]
        stamp = ats[r]
        if not _present[at_present, r]
            stamp = -1
        msg = sys.bytes[0]
        msg = push[msg, 1]
        msg = push[msg, 0]
        msg = concat[msg, pack[stamp, 8]]
        if _present[key_present, r]
            msg = concat[msg, pack[key_ends[r] - key_from, 4]]
            msg = concat[msg, slice[key_bytes, key_from, key_ends[r]]]
        else
            msg = concat[msg, pack[-1, 4]]
        if _present[value_present, r]
            msg = concat[msg, pack[value_ends[r] - value_from, 4]]
            msg = concat[msg, slice[value_bytes, value_from, value_ends[r]]]
        else
            msg = concat[msg, pack[-1, 4]]
        key_from = key_ends[r]
        value_from = value_ends[r]
        out = concat[out, pack[offsets[r], 8]]
        out = concat[out, pack[len[msg] + 4, 4]]
        out = concat[out, pack[inflate.crc32[msg], 4]]
        out = concat[out, msg]
    return out

--- bytes from a list of numbers
fn _bytes_of[nums]
    out = sys.bytes[0]
    for x in nums
        out = push[out, int[x]]
    return out

--- a short digest of bytes: what a recorded answer is held to
fn _digest[b]
    return slice[hash[b, 'sha256'], 0, 16]

--- a frame's image, digested — each column's name and its chunk (its
--- kind, its missing cells, its cells, as magpie.columnchunk writes them)
fn _image[f]
    n = len[f]
    out = sys.bytes['`n`']
    for name in f.columns
        out = concat[out, sys.bytes[name]]
        out = concat[out, columnchunk.chunk[f.`name`, 0, n, false]]
    return _digest[out]

--- a wrapper message around an inner set: magic 1, the codec, no key,
--- the compressed set as its value, offset 1
fn _wrapped[inner, codec]
    msg = sys.bytes[0]
    msg = push[msg, 1]
    msg = push[msg, codec]
    msg = concat[msg, pack[7, 8]]
    msg = concat[msg, pack[-1, 4]]
    msg = concat[msg, pack[len[inner], 4]]
    msg = concat[msg, inner]
    out = pack[1, 8]
    out = concat[out, pack[len[msg] + 4, 4]]
    out = concat[out, pack[inflate.crc32[msg], 4]]
    return concat[out, msg]

--- the same message sets as the kernel's both ways, plain and wrapped
--- with gzip or snappy (raw and in xerial's framing); a checksum that
--- does not match and a partial message at the end as the kernel reads them
test records_are_the_kernels[]
    f = frame.new[offset = [7, 8, 9], at = [1700000000000, -1, 5], value = ['hello', 'wörld', '']]
    --- (the second message has no key: its cell is missing)
    cut_ends = []
    for e in [2, 2, 4]
        cut_ends = push[cut_ends, int[e]]
    f.key = text_column[sys.bytes['k1k3'], cut_ends, push[sys.bytes[0], 5]]
    mine = message_set[f]
    seen = []
    seen = push[seen, _digest[mine]]
    seen = push[seen, _image[message_rows[mine]]]
    gz = _wrapped[inflate.gzip_stored[mine], 1]
    seen = push[seen, _image[message_rows[gz]]]
    sn = _wrapped[snappy.snappy_literal[mine], 2]
    seen = push[seen, _image[message_rows[sn]]]
    framing = _bytes_of[[130, 83, 78, 65, 80, 80, 89, 0, 0, 0, 0, 1, 0, 0, 0, 1]]
    block = snappy.snappy_literal[mine]
    xerial = concat[concat[framing, pack[len[block], 4]], block]
    xs = _wrapped[xerial, 2]
    seen = push[seen, _image[message_rows[xs]]]
    flipped = set[mine, len[mine] - 1, bitxor[byte[mine, len[mine] - 1], 1]]
    --- (the kernel's sets, rows and words, recorded before it was deleted,
    --- 2026-10-28: the four wrappings decode to the same rows, a set cut
    --- short to the messages it holds whole, no rows to no bytes)
    assert[message_rows[flipped].reason eq 'records: message 2 does not match its checksum']
    cut = slice[mine, 0, len[mine] - 3]
    seen = push[seen, _image[message_rows[cut]]]
    nothing_set = message_set[frame.head[f, 0]]
    seen = push[seen, _digest[nothing_set]]
    assert[seen eq ['fa902f91a14b9c4d', '309e1cb18f679c9f', '309e1cb18f679c9f', '309e1cb18f679c9f', '309e1cb18f679c9f', '25fc8fe2a82c253f', 'e3b0c44298fc1c14']]
