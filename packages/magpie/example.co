--- Search over the log
fn _tour_6[]
    gone = rm['ex_search']
    made = mkdir['ex_search']
    a = magpie.batch['ex_search', frame.new[id = [1, 2, 3], text = ['the quick brown fox', 'a lazy dog', 'the fox and the dog']]]
    b = magpie.batch['ex_search', frame.new[id = [4], text = ['brown bread']]]
