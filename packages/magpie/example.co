    b = magpie.batch['ex_flush', frame.new[id = [3], qty = [30]], by = ['id'], flush = false]
    log[magpie.latest['ex_flush'].qty]
    log[magpie.sync['ex_flush'] gt 0]
    gone = rm['ex_flush']

