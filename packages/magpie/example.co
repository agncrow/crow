--- a part at work: inflate, snappy, recordsets
fn _part_27[]
    data = bytes['hello hello hello hello']
    log[text[inflate.gunzipped[inflate.gzip_stored[data]]]]
    log[inflate.crc32[bytes['123456789']]]
