--- Each optimiser of the package on a small problem, the same answers in
--- both modes (CI runs this interpreted and compiled and compares the two).
use math
use scalar, roots, multi

--- a function of one number: a parabola with a wave on it
fn wavy[x]
    return (x - 1.3) ^ 2 + 0.7 * sin[3.0 * x]

--- a cubic with one real root, and its slope for Newton's method
fn cubic[x]
    return x ^ 3 - 2.0 * x - 5.0

--- Rosenbrock's valley in two, written over whole tensors so that `grad`
--- differentiates it
fn rosen[x]
    lo = flatten[tensor[[[1.0, 0.0]]] * reshape[x, 2, 1]]
    hi = flatten[tensor[[[0.0, 1.0]]] * reshape[x, 2, 1]]
    return sum[100.0 * (hi - lo .^ 2) .^ 2 + (1.0 - lo) .^ 2]

b = scalar.brent[wavy, 0.0, 1.0]
log['brent: x `fmt[b.x, decimals = 8]` value `fmt[b.value, decimals = 8]` in `b.iterations` iterations, `b.calls` calls']
g = scalar.golden[wavy, 0.0, 1.0]
log['golden: x `fmt[g.x, decimals = 8]` in `g.iterations` iterations']
bd = scalar.bounded[wavy, -1.0, 3.0]
log['bounded: x `fmt[bd.x, decimals = 6]` in `bd.calls` calls']

r = roots.brentq[cubic, 2.0, 3.0]
log['brentq: root `fmt[r.x, decimals = 10]` in `r.iterations` iterations']
n = roots.newton[cubic, grad[cubic], 2.5]
log['newton: root `fmt[n.x, decimals = 10]` in `n.iterations` iterations']
s = roots.secant[cubic, 2.5]
log['secant: root `fmt[s.x, decimals = 10]` in `s.iterations` iterations']
bi = roots.bisect[cubic, 2.0, 3.0]
log['bisect: root `fmt[bi.x, decimals = 10]` in `bi.iterations` iterations']

nm = multi.nelder_mead[rosen, tensor[[-1.2, 1.0]]]
log['nelder-mead: x `fmt[nm.x[0], decimals = 5]` `fmt[nm.x[1], decimals = 5]` in `nm.iterations` iterations, `nm.calls` calls']
bf = multi.bfgs[rosen, grad[rosen], tensor[[-1.2, 1.0]]]
log['bfgs: x `fmt[bf.x[0], decimals = 7]` `fmt[bf.x[1], decimals = 7]` in `bf.iterations` iterations, `bf.calls` calls']
