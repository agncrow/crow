--- Roots of a function of one number, as scipy.optimize finds them:
--- `bisect` halves an interval whose ends differ in sign; `brentq` is
--- Brent's method on such an interval (a secant or inverse quadratic
--- step where it helps, a bisection otherwise); `newton` steps by the
--- derivative — `df`, which `grad[f]` gives — from a point, and `secant`
--- by the secant through two. Each stops where scipy stops and answers
--- what scipy answers: the root, the iterations and the calls of `f`.
use math

--- a root found: where, the iterations and the calls
struct Root [x, iterations, calls]

--- the tolerances scipy's interval methods stop at: an absolute one and
--- four times the machine's epsilon, relative to the root
fn xtol_default[]
    return 0.000000000002

fn rtol_default[]
    return 4.0 * (0.5 ^ 52)

--- bisection: the half of the interval whose ends differ in sign, until
--- the half is within the tolerances; an error of kind 'optimize' where
--- the ends do not differ in sign
fn bisect[f, a, b, xtol = 0.000000000002]
    rtol = rtol_default[]
    maxiter = 100
    xa = a
    xb = b
    fa = f[xa]
    fb = f[xb]
    calls = 2
    if fa * fb gt 0.0
        return error['bisect: f[a] and f[b] must have different signs', 'optimize']
    if fa eq 0.0
        return Root[xa, 0, calls]
    if fb eq 0.0
        return Root[xb, 0, calls]
    dm = xb - xa
    for i in range[maxiter]
        dm = dm * 0.5
        xm = xa + dm
        fm = f[xm]
        calls = calls + 1
        if fm * fa gte 0.0
            xa = xm
        if fm eq 0.0 or abs[dm] lt xtol + rtol * abs[xm]
            return Root[xm, i + 1, calls]
    return error['bisect: no convergence in `maxiter` iterations', 'optimize']

--- Brent's method for a root, as scipy's `brentq`: the interval's ends
--- bracket the root; an interpolated step where it is short and inside,
--- a bisection otherwise
fn brentq[f, a, b, xtol = 0.000000000002]
    rtol = rtol_default[]
    maxiter = 100
    xpre = a
    xcur = b
    xblk = 0.0
    fblk = 0.0
    spre = 0.0
    scur = 0.0
    fpre = f[xpre]
    fcur = f[xcur]
    calls = 2
    if fpre eq 0.0
        return Root[xpre, 0, calls]
    if fcur eq 0.0
        return Root[xcur, 0, calls]
    if fpre * fcur gt 0.0
        return error['brentq: f[a] and f[b] must have different signs', 'optimize']
    for i in range[maxiter]
        if fpre ne 0.0 and fcur ne 0.0 and fpre * fcur lt 0.0
            xblk = xpre
            fblk = fpre
            spre = xcur - xpre
            scur = xcur - xpre
        if abs[fblk] lt abs[fcur]
            xpre = xcur
            xcur = xblk
            xblk = xpre
            fpre = fcur
            fcur = fblk
            fblk = fpre
        delta = (xtol + rtol * abs[xcur]) / 2.0
        sbis = (xblk - xcur) / 2.0
        if fcur eq 0.0 or abs[sbis] lt delta
            return Root[xcur, i + 1, calls]
        if abs[spre] gt delta and abs[fcur] lt abs[fpre]
            stry = 0.0
            if xpre eq xblk
                stry = 0.0 - fcur * (xcur - xpre) / (fcur - fpre)
            else
                dpre = (fpre - fcur) / (xpre - xcur)
                dblk = (fblk - fcur) / (xblk - xcur)
                stry = 0.0 - fcur * (fblk * dblk - fpre * dpre) / (dblk * dpre * (fblk - fpre))
            if 2.0 * abs[stry] lt min[abs[spre], 3.0 * abs[sbis] - delta]
                spre = scur
                scur = stry
            else
                spre = sbis
                scur = sbis
        else
            spre = sbis
            scur = sbis
        xpre = xcur
        fpre = fcur
        if abs[scur] gt delta
            xcur = xcur + scur
        else
            if sbis gt 0.0
                xcur = xcur + delta
            else
                xcur = xcur - delta
        fcur = f[xcur]
        calls = calls + 1
    return error['brentq: no convergence in `maxiter` iterations', 'optimize']

--- Newton's method from `x0` by the derivative `df` (`grad[f]`), until a
--- step is within `tol`; an error of kind 'optimize' where the
--- derivative is zero or fifty steps do not converge
fn newton[f, df, x0, tol = 0.0000000148]
    maxiter = 50
    p0 = x0
    calls = 0
    for itr in range[maxiter]
        fval = f[p0]
        calls = calls + 1
        if fval eq 0.0
            return Root[p0, itr, calls]
        fder = df[p0]
        calls = calls + 1
        if fder eq 0.0
            return error['newton: the derivative is zero at `p0`', 'optimize']
        p = p0 - fval / fder
        if abs[p - p0] lte tol
            return Root[p, itr + 1, calls]
        p0 = p
    return error['newton: no convergence in `maxiter` iterations', 'optimize']

--- the secant method from `x0` (scipy's `newton` without a derivative):
--- the second point a tenth of a percent away, then the secant through
--- the last two, until a step is within `tol`
fn secant[f, x0, tol = 0.0000000148]
    maxiter = 50
    eps = 0.0001
    p0 = x0
    p1 = x0 * (1.0 + eps)
    if p1 gte 0.0
        p1 = p1 + eps
    else
        p1 = p1 - eps
    q0 = f[p0]
    q1 = f[p1]
    calls = 2
    if abs[q1] lt abs[q0]
        p0, p1 = p1, p0
        q0, q1 = q1, q0
    p = 0.0
    for itr in range[maxiter]
        if q1 eq q0
            return Root[(p1 + p0) / 2.0, itr + 1, calls]
        if abs[q1] gt abs[q0]
            p = (0.0 - q0 / q1 * p1 + p0) / (1.0 - q0 / q1)
        else
            p = (0.0 - q1 / q0 * p0 + p1) / (1.0 - q1 / q0)
        if abs[p - p1] lte tol
            return Root[p, itr + 1, calls]
        p0 = p1
        q0 = q1
        p1 = p
        q1 = f[p1]
        calls = calls + 1
    return error['secant: no convergence in `maxiter` iterations', 'optimize']

fn cubic[x]
    return x ^ 3 - 2.0 * x - 5.0

fn cosine_gap[x]
    return cos[x] - x

--- its derivative by hand: `grad` differentiates arithmetic and `sqrt`,
--- `abs`, `floor`, `ceil`, `round` of a number, not `cos`
fn cosine_gap_slope[x]
    return 0.0 - sin[x] - 1.0

--- the root of x³ − 2x − 5 between 2 and 3 by each method: scipy's
--- root, iterations and calls to the last digit, Newton's derivative by
--- `grad`
test finds_a_root_as_scipy_does[]
    b = bisect[cubic, 2.0, 3.0]
    assert[abs[b.x - 2.0945514815412025] lt 0.000000000001]
    assert[b.iterations eq 39 and b.calls eq 41]
    q = brentq[cubic, 2.0, 3.0]
    assert[abs[q.x - 2.094551481542327] lt 0.000000000001]
    assert[q.iterations eq 7 and q.calls eq 8]
    n = newton[cubic, grad[cubic], 2.5]
    assert[abs[n.x - 2.0945514815423265] lt 0.000000000001]
    assert[n.iterations eq 5 and n.calls eq 10]
    s = secant[cubic, 2.5]
    assert[abs[s.x - 2.0945514815423287] lt 0.000000000001]
    assert[s.iterations eq 6 and s.calls eq 7]

--- cos x = x, and an interval whose ends share a sign is an error
test refuses_an_interval_without_a_sign_change[]
    r = brentq[cosine_gap, 0.0, 1.0]
    assert[abs[r.x - 0.7390851332151559] lt 0.000000000001]
    assert[not bisect[cosine_gap, 1.0, 2.0].ok]
    assert[not brentq[cosine_gap, 1.0, 2.0].ok]
    n = newton[cosine_gap, cosine_gap_slope, 1.0]
    assert[abs[n.x - 0.73908513321516067] lt 0.000000000001]
    assert[n.iterations eq 4]
