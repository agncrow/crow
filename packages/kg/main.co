--- A knowledge graph over Magpie: two logs under a root — the nodes,
--- keyed by `id`, and the edges, keyed by `src`, `rel`, `dst` — and the
--- edges again in reverse (`back`, keyed by `dst`, `rel`, `src`), so a
--- node's out-edges and its in-edges are each one key's run of a merged
--- segment. A write is a `put` stamped with its moment (`at`, in
--- milliseconds; now where none is handed); a removal is a tombstone
--- row (`gone`), which every read skips; the graph as of a position is
--- `upto` on every read, and a node's history its key's versions.
--- `walk` and `path` read the graph a hop at a time (`latest` over the
--- frontier's range of keys, or each node's key for a few nodes); `match` reads each triple's edges and joins the
--- triples on the variables they share with the frame module's join;
--- `subgraph` answers the edges among some nodes as the graph package
--- takes them; a `rule` derives edges and links them back.
use math
use magpie, frame

--- the logs under the root
fn _nodes[root]
    return '`root`/nodes'

fn _vectors[root]
    return '`root`/vectors'

fn _edges[root]
    return '`root`/edges'

fn _back[root]
    return '`root`/back'

--- a write's moment in milliseconds: the one handed, or now
fn _when[at]
    if at gte 0
        return at
    return int[float[now[]] * 1000.0]

--- an edges frame of no rows, with every column an edge has
fn _none[]
    blank = frame.new[src = [''], rel = [''], dst = [''], weight = [0.0], source = [''], gone = [true], at = [0], _pos = [-1]]
    return blank[blank.gone eq false]

--- the rows of a read with the tombstones dropped
fn _live[es]
    return es[es.gone eq false]

--- a node written: its id, a label and its properties (JSON text);
--- answers the position the row took in the nodes log
fn node[root, id, label = '', props = '{}', at = -1]
    t = _when[at]
    f = frame.new[id = [id], label = [label], props = [props], gone = [false], at = [t]]
    return put[_nodes[root], f, by = ['id'], time = 'at']

--- a node retired: a tombstone, which `nodes` skips (its edges stay
--- until unlinked)
fn retire[root, id, at = -1]
    t = _when[at]
    f = frame.new[id = [id], label = [''], props = ['{}'], gone = [true], at = [t]]
    return put[_nodes[root], f, by = ['id'], time = 'at']

--- an edge from `src` to `dst` by the relation `rel`, with a weight and
--- its provenance (`origin`: where the fact came from, kept in the
--- column `source`), written forward and back; answers the position
--- the edge took in the edges log
fn link[root, src, rel, dst, weight = 1.0, origin = '', at = -1]
    return _edge[root, src, rel, dst, weight, origin, false, at]

--- an edge removed: a tombstone forward and back
fn unlink[root, src, rel, dst, at = -1]
    return _edge[root, src, rel, dst, 0.0, '', true, at]

fn _edge[root, src, rel, dst, weight, origin, gone, at]
    t = _when[at]
    fwd = frame.new[src = [src], rel = [rel], dst = [dst], weight = [weight], source = [origin], gone = [gone], at = [t]]
    rev = frame.new[dst = [dst], rel = [rel], src = [src], weight = [weight], source = [origin], gone = [gone], at = [t]]
    p = put[_edges[root], fwd, by = ['src', 'rel', 'dst'], time = 'at']
    if not p.ok
        return p
    q = put[_back[root], rev, by = ['dst', 'rel', 'src'], time = 'at']
    if not q.ok
        return q
    return p

--- the nodes as of a position (every one with -1): the newest row of
--- each id, the retired left out; no rows before the first node
fn nodes[root, upto = -1]
    d = _nodes[root]
    if not exists[d]
        blank = frame.new[id = [''], label = [''], props = [''], gone = [true], at = [0], _pos = [-1]]
        return blank[blank.gone eq false]
    n = latest[d, upto]
    if not n.ok
        return error[n.reason, 'kg']
    return _live[n]

--- the edges as of a position, the removed left out: the whole graph as
--- a frame, for a graph that fits one; a node's are `neighbors`
fn edges[root, upto = -1]
    d = _edges[root]
    if not exists[d]
        return _none[]
    es = latest[d, upto]
    if not es.ok
        return error[es.reason, 'kg']
    return _live[es]

--- a node's out-edges as of a position, by one relation or all (''):
--- one key's range of the edges log, read as `latest` reads a range
fn neighbors[root, id, rel = '', upto = -1]
    return _run[_edges[root], id, rel, upto]

--- a node's in-edges, from the reverse log, each as the edge is
--- written (`src`, `rel`, `dst`)
fn inbound[root, id, rel = '', upto = -1]
    return _run[_back[root], id, rel, upto]

fn _run[d, id, rel, upto]
    if not exists[d]
        return _none[]
    got = latest[d, upto, lo = id, hi = id]
    if not got.ok
        return error[got.reason, 'kg']
    live = _live[got]
    if rel eq ''
        return live
    return live[live.rel eq rel]

--- every version of a node's out-edges, oldest first, the tombstones
--- among them: its history, up to a position
fn history[root, id, upto = -1]
    d = _edges[root]
    if not exists[d]
        return _none[]
    got = lookup[d, ['src'], [id]]
    if not got.ok
        return error[got.reason, 'kg']
    if upto lt 0
        return got
    return got[got._pos lte upto]

--- a hop's frontier's out-edges, as each node's `dst` ids in the order
--- `neighbors` reads them: a key's range read per node for up to four,
--- and one range from the least id to the greatest, read once, for more
--- — the log's keys are in order, so each node's edges come out as its
--- own read gives them (a walk of three hops had read the edges log's
--- files a thousand times)
fn _hop[root, frontier, rel, upto]
    out = map[]
    if len[frontier] lte 4
        for id in frontier
            es = neighbors[root, id, rel, upto]
            if not es.ok
                return error[es.reason, 'kg']
            dsts = slice[['x'], 0, 0]
            for i in range[len[es]]
                dsts = push[dsts, str[es.dst[i]]]
            out = set[out, id, dsts]
        return out
    d = _edges[root]
    if not exists[d]
        return out
    wanted = map[]
    lo = frontier[0]
    hi = frontier[0]
    for id in frontier
        wanted = set[wanted, id, true]
        if id lt lo
            lo = id
        if id gt hi
            hi = id
    got = latest[d, upto, lo = lo, hi = hi]
    if not got.ok
        return error[got.reason, 'kg']
    live = _live[got]
    for i in range[len[live]]
        src = str[live.src[i]]
        if src in wanted and (rel eq '' or str[live.rel[i]] eq rel)
            dst = str[live.dst[i]]
            if src in out
                out[src] = push[out[src], dst]
            else
                first = slice[['x'], 0, 0]
                out = set[out, src, push[first, dst]]
    return out

--- the nodes within `hops` edges of `start`, breadth first, as a frame
--- of `id`, `hops` (the fewest edges from the start) and `via` (the
--- node each was reached from; '' at the start), in the order reached
fn walk[root, origin, hops, rel = '', upto = -1]
    ids = [origin]
    steps = [0]
    via = ['']
    seen = map[]
    seen = set[seen, origin, 0]
    frontier = [origin]
    depth = 0
    while depth lt hops and len[frontier] gt 0
        depth = depth + 1
        reached = []
        hop = _hop[root, frontier, rel, upto]
        if not hop.ok
            return error[hop.reason, 'kg']
        for from_id in frontier
            if from_id in hop
                for to_id in hop[from_id]
                    if to_id not in seen
                        seen = set[seen, to_id, depth]
                        ids = push[ids, to_id]
                        steps = push[steps, depth]
                        via = push[via, from_id]
                        reached = push[reached, to_id]
        frontier = reached
    return frame.new[id = ids, hops = steps, via = via]

--- the path from `a` to `b` of the fewest edges, within `hops`, as the
--- ids along it (`a` first, `b` last); an empty list where none is
--- found, `[a]` where they are one node
fn path[root, a, b, hops = 6, rel = '', upto = -1]
    if a eq b
        return [a]
    parent = map[]
    parent = set[parent, a, '']
    frontier = [a]
    depth = 0
    found = false
    while depth lt hops and len[frontier] gt 0 and not found
        depth = depth + 1
        reached = []
        hop = _hop[root, frontier, rel, upto]
        if not hop.ok
            return error[hop.reason, 'kg']
        for from_id in frontier
            if not found and from_id in hop
                for to_id in hop[from_id]
                    if to_id not in parent
                        parent = set[parent, to_id, from_id]
                        reached = push[reached, to_id]
                        if to_id eq b
                            found = true
        frontier = reached
    if not found
        return []
    way = [b]
    here = b
    while here ne a
        here = parent[here]
        way = push[way, here]
    return reverse[way]

--- a variable of a pattern begins with `?`
fn _var[x]
    return starts[x, '?']

--- its name, without the `?`
fn _name[x]
    return slice[x, 1, len[x]]

--- the variables of a triple, in order
fn _vars[s, r, o]
    names = []
    if _var[s]
        names = push[names, _name[s]]
    if _var[r]
        names = push[names, _name[r]]
    if _var[o]
        names = push[names, _name[o]]
    return names

--- a triple's edges, projected to its variables: a node's run where the
--- subject or the object is a constant, the whole graph where neither is
fn _triple[root, s, r, o, upto]
    rel = ''
    if not _var[r]
        rel = r
    es = _none[]
    if not _var[s]
        got = neighbors[root, s, rel, upto]
        if not got.ok
            return error[got.reason, 'kg']
        if _var[o]
            es = got
        else
            es = got[got.dst eq o]
    else
        if not _var[o]
            got = inbound[root, o, rel, upto]
            if not got.ok
                return error[got.reason, 'kg']
            es = got
        else
            got = edges[root, upto]
            if not got.ok
                return error[got.reason, 'kg']
            if rel eq ''
                es = got
            else
                es = got[got.rel eq rel]
    cols = []
    names = []
    if _var[s]
        cols = push[cols, 'src']
        names = push[names, _name[s]]
    if _var[r]
        cols = push[cols, 'rel']
        names = push[names, _name[r]]
    if _var[o]
        cols = push[cols, 'dst']
        names = push[names, _name[o]]
    if len[cols] eq 0
        return error['a triple of three constants binds nothing: `s` `r` `o`', 'kg']
    out = select[es, cols]
    for i in range[len[cols]]
        out = rename[out, cols[i], names[i]]
    return out

--- the bindings of a pattern over the graph as of a position: three
--- lists — subjects, relations, objects — a triple each, a name
--- beginning with `?` a variable, any other text a constant. Answers a
--- frame with a column per variable and a row per way the pattern
--- holds: each triple's edges read as `neighbors` or `inbound` reads
--- them (the whole graph where a triple names no node), the triples
--- joined on the variables they share (an inner join), so every triple
--- after the first shares a variable with an earlier one, and a
--- variable appears once in a triple
fn match[root, s, r, o, upto = -1]
    if len[s] ne len[r] or len[s] ne len[o]
        return error['match takes three lists of one length: subjects, relations, objects', 'kg']
    if len[s] eq 0
        return error['match takes at least one triple', 'kg']
    for i in range[len[s]]
        twice = (_var[s[i]] and s[i] eq o[i]) or (_var[s[i]] and s[i] eq r[i]) or (_var[r[i]] and r[i] eq o[i])
        if twice
            return error['a variable appears once in a triple: `s[i]` `r[i]` `o[i]`', 'kg']
    first = _triple[root, s[0], r[0], o[0], upto]
    if not first.ok
        return error[first.reason, 'kg']
    acc = first
    bound = _vars[s[0], r[0], o[0]]
    for i in range[1, len[s]]
        nxt = _triple[root, s[i], r[i], o[i], upto]
        if not nxt.ok
            return error[nxt.reason, 'kg']
        names = _vars[s[i], r[i], o[i]]
        shared = []
        fresh = []
        for v in names
            if v in bound
                shared = push[shared, v]
            else
                fresh = push[fresh, v]
        if len[shared] eq 0
            nth = i + 1
            return error['triple `nth` shares no variable with an earlier triple', 'kg']
        acc = join[acc, nxt, shared]
        for v in fresh
            bound = push[bound, v]
    return acc

--- the edges among the nodes `ids`, as of a position: a frame of `a`,
--- `b`, `rel` and `weight` — what the graph package's `of_edges` takes,
--- an `Edge[a, b, weight]` per row, for pagerank, components and paths
fn subgraph[root, ids, upto = -1]
    a = []
    b = []
    rels = []
    weights = []
    for id in ids
        es = neighbors[root, id, '', upto]
        if not es.ok
            return error[es.reason, 'kg']
        for i in range[len[es]]
            to_id = str[es.dst[i]]
            if to_id in ids
                a = push[a, id]
                b = push[b, to_id]
                rels = push[rels, str[es.rel[i]]]
                weights = push[weights, float[es.weight[i]]]
    return frame.new[a = a, b = b, rel = rels, weight = weights]

--- a rule applied: `f` takes the edges as a frame and answers a frame
--- of `src`, `rel`, `dst` — the edges it derives — which are linked
--- with the provenance `rule`; answers how many it linked
fn rule[root, f, at = -1]
    es = edges[root]
    if not es.ok
        return error[es.reason, 'kg']
    derived = f[es]
    added = 0
    for i in range[len[derived]]
        p = link[root, str[derived.src[i]], str[derived.rel[i]], str[derived.dst[i]], 1.0, 'rule', at]
        if not p.ok
            return error[p.reason, 'kg']
        added = added + 1
    return added

--- a node's embedding written: a vector (a tensor of one axis, or a
--- list of numbers) keyed by the node's id in the `vectors` log, so a
--- node re-embedded has a newer version; answers the position the row
--- took
fn embed[root, id, v, at = -1]
    t = _when[at]
    rows = push[[], tensor[v]]
    f = frame.new[id = [id], e = rows, at = [t]]
    return put[_vectors[root], f, by = ['id'], time = 'at']

--- the k nodes whose newest embedding lies nearest the vector by the
--- cosine (Magpie's `nearest` over the vectors log; `similar`, since a
--- package's function is not named like an export it imports): a frame of `id`
--- and `score`, the best first — an entity found by meaning, before
--- the edges expand it. A node's older embeddings are skipped (a merge
--- folds them away; until one, the newest row of each id is the one
--- read); as of a position with `upto`
fn similar[root, v, k = 10, upto = -1]
    d = _vectors[root]
    blank = frame.new[id = [''], score = [0.0]]
    if not exists[d]
        return blank[blank.score gt 1.0]
    newest = latest[d, upto, ['id', '_pos']]
    if not newest.ok
        return error[newest.reason, 'kg']
    m = metrics[d]
    if not m.ok
        return error[m.reason, 'kg']
    rows = m.rows[0]
    if not rows.ok
        return error['no figures for the vectors log at \'`d`\'', 'kg']
    --- the stale versions asked for beside the k wanted, then dropped
    extra = rows - len[newest]
    hits = magpie.nearest[d, 'e', v, k + extra]
    if not hits.ok
        return error[hits.reason, 'kg']
    live = join[hits, newest, ['id', '_pos'], 'semi']
    if upto gte 0
        live = live[live._pos lte upto]
    kept = frame.head[live, k]
    return select[kept, ['id', 'score']]

--- the edges as they stood at each row's moment: `f` holds `src`,
--- `rel`, `dst` and `at` (milliseconds); beside each row the edge's
--- newest version at or before that moment, with its `columns` (every
--- column the row lacks when none is named), missing cells where none
--- — Magpie's `prior` over the edges log
fn asof[root, f, columns = []]
    return prior[_edges[root], f, columns]

--- a fresh root for a test: whatever a run before left, removed
fn _fresh[root]
    gone = rm[root]
    return root

test a_graph_is_two_logs[]
    root = _fresh['kg-test-logs']
    assert[node[root, 'alice', 'person', '{"age": 30}', 1000] eq 0]
    assert[node[root, 'bob', 'person', '{}', 1001] eq 1 and node[root, 'acme', 'company', '{}', 1002] eq 2]
    assert[link[root, 'alice', 'knows', 'bob', 1.0, 'crm', 2000] eq 0]
    assert[link[root, 'alice', 'works_at', 'acme', 1.0, 'crm', 2001] eq 1]
    assert[link[root, 'bob', 'works_at', 'acme', 0.5, 'crm', 2002] eq 2]
    n = nodes[root]
    assert[len[n] eq 3 and n.id eq ['alice', 'bob', 'acme'] and n.label eq ['person', 'person', 'company']]
    out = neighbors[root, 'alice']
    assert[len[out] eq 2 and sort[out, 'dst'].dst eq ['acme', 'bob']]
    assert[neighbors[root, 'alice', 'knows'].dst eq ['bob']]
    at_acme = sort[inbound[root, 'acme'], 'src']
    assert[len[at_acme] eq 2 and at_acme.src eq ['alice', 'bob'] and at_acme.weight eq [1.0, 0.5] and at_acme.source eq ['crm', 'crm']]
    assert[len[inbound[root, 'acme', 'knows']] eq 0]
    assert[unlink[root, 'alice', 'knows', 'bob', 3000] eq 3]
    assert[neighbors[root, 'alice'].dst eq ['acme']]
    assert[len[inbound[root, 'bob']] eq 0]
    assert[len[edges[root]] eq 2 and len[edges[root, 2]] eq 3]
    assert[len[neighbors[root, 'alice', '', 2]] eq 2]
    assert[retire[root, 'bob', 1003] eq 3]
    assert[nodes[root].id eq ['alice', 'acme']]
    h = history[root, 'alice']
    assert[len[h] eq 3 and h.gone eq [false, false, true]]
    assert[len[history[root, 'alice', 1]] eq 2]
    assert[len[neighbors['kg-test-nowhere', 'alice']] eq 0 and len[nodes['kg-test-nowhere']] eq 0 and len[edges['kg-test-nowhere']] eq 0]
    gone = rm[root]

--- an embedding per node, the nearest nodes by meaning, a node
--- re-embedded answering by its newest vector, and the graph as of a
--- position before the re-embedding
test a_node_is_found_by_its_embedding[]
    root = _fresh['kg-test-vectors']
    assert[embed[root, 'alice', [1.0, 0.0], 1000] eq 0]
    assert[embed[root, 'bob', [0.0, 1.0], 1001] eq 1]
    assert[embed[root, 'carol', [1.0, 1.0], 1002] eq 2]
    near = similar[root, [1.0, 0.1], 2]
    assert[near.id eq ['alice', 'carol']]
    assert[near.score[0] gt 0.99 and near.score[1] lt 0.8]
    assert[embed[root, 'alice', [0.0, 1.0], 1003] eq 3]
    --- alice's newest vector is bob's, and bob's earlier position wins the tie
    again = similar[root, [1.0, 0.1], 2]
    assert[again.id eq ['carol', 'bob']]
    assert[similar[root, [1.0, 0.1], 2, 2].id eq ['alice', 'carol']]
    assert[len[similar['kg-test-nowhere', [1.0, 0.0]]] eq 0]
    gone = rm[root]

test a_walk_is_breadth_first[]
    root = _fresh['kg-test-walk']
    assert[link[root, 'a', 'to', 'b', 1.0, '', 1] eq 0]
    assert[link[root, 'b', 'to', 'c', 1.0, '', 2] eq 1]
    assert[link[root, 'c', 'to', 'd', 1.0, '', 3] eq 2]
    assert[link[root, 'a', 'to', 'c', 1.0, '', 4] eq 3]
    assert[link[root, 'd', 'to', 'a', 1.0, '', 5] eq 4]
    w = walk[root, 'a', 2]
    assert[w.id eq ['a', 'b', 'c', 'd'] and w.hops eq [0, 1, 1, 2] and w.via eq ['', 'a', 'a', 'c']]
    assert[walk[root, 'a', 1].id eq ['a', 'b', 'c']]
    assert[walk[root, 'a', 0].id eq ['a']]
    assert[walk[root, 'a', 3, 'other'].id eq ['a']]
    assert[path[root, 'a', 'd'] eq ['a', 'c', 'd']]
    assert[path[root, 'd', 'b'] eq ['d', 'a', 'b']]
    assert[len[path[root, 'a', 'z']] eq 0]
    assert[path[root, 'a', 'a'] eq ['a']]
    assert[len[path[root, 'a', 'd', 1]] eq 0]
    assert[unlink[root, 'a', 'to', 'c', 6] eq 5]
    assert[path[root, 'a', 'd'] eq ['a', 'b', 'c', 'd']]
    assert[path[root, 'a', 'd', 6, '', 4] eq ['a', 'c', 'd']]
    gone = rm[root]

test a_match_joins_the_triples[]
    root = _fresh['kg-test-match']
    assert[link[root, 'alice', 'knows', 'bob', 1.0, '', 1] eq 0]
    assert[link[root, 'bob', 'knows', 'carol', 1.0, '', 2] eq 1]
    assert[link[root, 'alice', 'works_at', 'acme', 1.0, '', 3] eq 2]
    assert[link[root, 'carol', 'works_at', 'acme', 1.0, '', 4] eq 3]
    assert[link[root, 'bob', 'works_at', 'globex', 1.0, '', 5] eq 4]
    m = match[root, ['?x', '?x'], ['knows', 'works_at'], ['?y', 'acme']]
    assert[m.columns eq ['x', 'y'] and m.x eq ['alice'] and m.y eq ['bob']]
    pairs = match[root, ['?a', '?b'], ['works_at', 'works_at'], ['?c', '?c']]
    assert[len[pairs] eq 5 and pairs.columns eq ['a', 'c', 'b']]
    who = sort[match[root, ['?x'], ['knows'], ['?y']], 'x']
    assert[who.x eq ['alice', 'bob'] and who.y eq ['bob', 'carol']]
    of_alice = sort[match[root, ['alice'], ['?r'], ['?y']], 'r']
    assert[of_alice.columns eq ['r', 'y'] and of_alice.r eq ['knows', 'works_at'] and of_alice.y eq ['bob', 'acme']]
    at_acme = sort[match[root, ['?who'], ['works_at'], ['acme']], 'who']
    assert[at_acme.columns eq ['who'] and at_acme.who eq ['alice', 'carol']]
    assert[match[root, ['?x'], ['knows'], ['?x']].kind eq 'kg']
    assert[match[root, ['?x', '?z'], ['knows', 'knows'], ['?y', '?w']].kind eq 'kg']
    assert[match[root, ['alice'], ['knows'], ['bob']].kind eq 'kg']
    assert[match[root, ['?x'], [], ['?y']].kind eq 'kg']
    gone = rm[root]

--- a rule for the tests: a parent's parent is a grandparent
fn _grandparents[es]
    parents = es[es.rel eq 'parent']
    src = []
    dst = []
    for i in range[len[parents]]
        for j in range[len[parents]]
            if parents.dst[i] eq parents.src[j]
                src = push[src, str[parents.src[i]]]
                dst = push[dst, str[parents.dst[j]]]
    rels = for s in src
        'grandparent'
    return frame.new[src = src, rel = rels, dst = dst]

test a_rule_derives_edges[]
    root = _fresh['kg-test-rule']
    assert[link[root, 'ann', 'parent', 'bea', 1.0, 'census', 1] eq 0]
    assert[link[root, 'bea', 'parent', 'cal', 1.0, 'census', 2] eq 1]
    assert[link[root, 'cal', 'parent', 'dee', 1.0, 'census', 3] eq 2]
    assert[rule[root, _grandparents, 10] eq 2]
    g = neighbors[root, 'ann', 'grandparent']
    assert[g.dst eq ['cal'] and g.source eq ['rule'] and g.at eq [10]]
    assert[neighbors[root, 'bea', 'grandparent'].dst eq ['dee']]
    assert[len[neighbors[root, 'cal', 'grandparent']] eq 0]
    gone = rm[root]

test a_subgraph_is_what_the_graph_package_takes[]
    root = _fresh['kg-test-sub']
    assert[link[root, 'a', 'to', 'b', 1.0, '', 1] eq 0]
    assert[link[root, 'b', 'to', 'c', 2.0, '', 2] eq 1]
    assert[link[root, 'c', 'to', 'a', 3.0, '', 3] eq 2]
    assert[link[root, 'a', 'to', 'd', 4.0, '', 4] eq 3]
    s = subgraph[root, ['a', 'b', 'c']]
    assert[len[s] eq 3 and s.a eq ['a', 'b', 'c'] and s.b eq ['b', 'c', 'a'] and s.rel eq ['to', 'to', 'to'] and s.weight eq [1.0, 2.0, 3.0]]
    assert[subgraph[root, ['a', 'd']].weight eq [4.0]]
    assert[len[subgraph[root, ['z']]] eq 0]
    gone = rm[root]

test the_edges_as_of_a_moment[]
    root = _fresh['kg-test-asof']
    assert[link[root, 'a', 'likes', 'b', 1.0, '', 100] eq 0]
    assert[link[root, 'a', 'likes', 'b', 2.0, '', 200] eq 1]
    assert[unlink[root, 'a', 'likes', 'b', 300] eq 2]
    labels = frame.new[src = ['a', 'a', 'a', 'a'], rel = ['likes', 'likes', 'likes', 'likes'], dst = ['b', 'b', 'b', 'b'], at = [50, 150, 250, 350]]
    j = asof[root, labels, ['weight', 'gone']]
    assert[j.columns eq ['src', 'rel', 'dst', 'at', 'weight', 'gone']]
    assert[not j.weight[0].ok and j.weight[1] eq 1.0 and j.weight[2] eq 2.0 and j.gone[3] eq true]
    gone = rm[root]
