--- A small knowledge graph written, walked, matched and read as of an
--- earlier position, with the same answers in both modes (CI runs this
--- interpreted and compiled and compares the two). The moments are
--- handed in, so the output is the same at every run.
use math
use magpie, frame
use kg

root = 'kg-example'
gone = rm[root]

--- people and companies, from a CRM export
p = kg.node[root, 'alice', 'person', '{"title": "engineer"}', 1000]
p = kg.node[root, 'bob', 'person', '{"title": "designer"}', 1001]
p = kg.node[root, 'carol', 'person', '{"title": "founder"}', 1002]
p = kg.node[root, 'acme', 'company', '{"city": "Austin"}', 1003]
p = kg.node[root, 'globex', 'company', '{"city": "Boston"}', 1004]
p = kg.link[root, 'alice', 'knows', 'bob', 1.0, 'crm', 2000]
p = kg.link[root, 'bob', 'knows', 'carol', 1.0, 'crm', 2001]
p = kg.link[root, 'alice', 'works_at', 'acme', 1.0, 'crm', 2002]
p = kg.link[root, 'carol', 'works_at', 'acme', 1.0, 'crm', 2003]
p = kg.link[root, 'bob', 'works_at', 'globex', 1.0, 'crm', 2004]
p = kg.link[root, 'carol', 'founded', 'acme', 1.0, 'press', 2005]
log['nodes: `len[kg.nodes[root]]`, edges: `len[kg.edges[root]]`']

--- a node's edges, out and in
out = sort[kg.neighbors[root, 'alice'], 'rel']
rels = join[out.rel, ' ']
dsts = join[out.dst, ' ']
log['alice: `rels` to `dsts`']
at_acme = sort[kg.inbound[root, 'acme', 'works_at'], 'src']
staff = join[at_acme.src, ' ']
log['works at acme: `staff`']

--- a walk and a path
w = kg.walk[root, 'alice', 2]
reached = join[w.id, ' ']
hops = join[w.hops, ' ']
log['within two hops of alice: `reached` (hops `hops`)']
way = join[kg.path[root, 'alice', 'globex'], ' to ']
log['alice to globex: `way`']

--- a pattern: who knows someone at acme?
m = sort[kg.match[root, ['?x', '?y'], ['knows', 'works_at'], ['?y', 'acme']], 'x']
xs = join[m.x, ' ']
ys = join[m.y, ' ']
log['knows someone at acme: `xs` (`ys`)']

--- a rule: a colleague is someone at the same company
fn colleagues[es]
    jobs = es[es.rel eq 'works_at']
    src = []
    dst = []
    for i in range[len[jobs]]
        for j in range[len[jobs]]
            if i ne j and jobs.dst[i] eq jobs.dst[j]
                src = push[src, str[jobs.src[i]]]
                dst = push[dst, str[jobs.src[j]]]
    rels = for s in src
        'colleague'
    return frame.new[src = src, rel = rels, dst = dst]

added = kg.rule[root, colleagues, 3000]
log['colleague edges derived: `added`']
mates = join[kg.neighbors[root, 'alice', 'colleague'].dst, ' ']
log['colleagues of alice: `mates`']

--- a fact withdrawn, and the graph as it was before
before = magpie.head['`root`/edges']
cut = kg.unlink[root, 'bob', 'works_at', 'globex', 4000]
now_at = join[kg.neighbors[root, 'bob', 'works_at'].dst, ' ']
log['bob works at: `now_at`']
then_at = join[kg.neighbors[root, 'bob', 'works_at', before].dst, ' ']
log['bob worked at, as of position `before`: `then_at`']

--- the subgraph of the people, as the graph package takes it
s = kg.subgraph[root, ['alice', 'bob', 'carol']]
kinds = join[s.rel, ' ']
log['edges among the people: `len[s]` (`kinds`)']

gone = rm[root]
