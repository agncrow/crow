--- A feature store over Magpie: a feature group is a log keyed by its
--- entity with its event-time column declared, so one write is both
--- stores — the history is the log (`history`, a window of it), the
--- newest value per entity is the sequencer's image (`online`, one
--- key's newest row, read in microseconds) — and the materialisation
--- job between them is gone. A feature's definition is a Crow function
--- from source rows to feature rows: `backfill` runs it over windows of
--- a source log and appends what it answers, `stream` runs the same
--- function over the source's tail, so the training path and the
--- serving path are one function and training-serving skew has no
--- place to come from. A training set is the labels joined against each
--- group's history as of each label's moment (Magpie's `prior`: the
--- newest row at or before it), the same rows every time the log holds
--- the same positions. The registry is a log of its own (`define`,
--- `defined`), with its history.
use math
use magpie, frame

--- a feature group: its log, the entity's columns and the event-time
--- column (milliseconds, or a column of moments)
struct Group [dir, entity, time]

--- a feature group declared: the log at `dir`, keyed by the entity's
--- columns, each row's moment in `time`; nothing is written until the
--- first `append`, which declares the log so
fn declare[dir, entity, time]
    return Group[dir, entity, time]

--- feature rows appended: the entity's columns, the time column and
--- the features, visible to `online` at once and durable within ten
--- milliseconds (Magpie's `sync` of the log, for sooner). A `_pos`
--- column a read left on the rows is dropped. Answers the first
--- position the rows took
fn append[g, f]
    return put[g.dir, _without_pos[f], by = g.entity, time = g.time]

--- the rows without the position column a read leaves
fn _without_pos[f]
    if '_pos' not in f.columns
        return f
    kept = []
    for c in f.columns
        if c ne '_pos'
            kept = push[kept, c]
    return select[f, kept]

--- the newest feature row of one entity (its key's values, each as
--- text), from the image the sequencer keeps in memory: the online
--- store's read; a frame of one row, or of none where the entity has
--- no row yet
fn online[g, key]
    return latest[g.dir, equal = key]

--- a window of the group's history: every row from position `from` up
--- to `upto` (every row with -1), in position order, with `columns`
--- (every column when none is named): the offline store, read a window
--- at a time
fn history[g, from = 0, upto = -1, columns = []]
    return scan[g.dir, from, upto, columns]

--- a training set: the labels — the entity's columns and a moment in
--- the groups' time column — with each group's features beside them as
--- they stood at each label's moment (the newest row at or before it,
--- by time then by position; missing cells where none precedes), the
--- labels' columns first and in their order. `columns` names the
--- features taken from each group (every column the labels lack, when
--- none is named). The labels carry a column named as each group's
--- time column; `upto` is the position the set is as of (-1 is now), so
--- a dataset a position names comes out the same at every run
fn training[labels, groups, columns = [], upto = -1]
    acc = labels
    for g in groups
        joined = prior[g.dir, acc, columns, upto]
        if not joined.ok
            return error[joined.reason, 'features']
        acc = joined
    return acc

--- the feature function `f` run over the source log in windows of
--- `per` positions, from `from` up to `upto` (the source's last
--- position with -1), each window's rows handed to `f` and what it
--- answers appended to the group: the backfill. Answers how many
--- feature rows it wrote
fn backfill[g, source, f, from = 0, upto = -1, per = 100000]
    end_pos = upto
    if end_pos lt 0
        end_pos = magpie.head[source]
    written = 0
    lo_pos = from
    while lo_pos lte end_pos
        hi_pos = lo_pos + per - 1
        if hi_pos gt end_pos
            hi_pos = end_pos
        piece = scan[source, lo_pos, hi_pos]
        if not piece.ok
            return error[piece.reason, 'features']
        if len[piece] gt 0
            made = f[piece]
            if len[made] gt 0
                p = append[g, made]
                if not p.ok
                    return error[p.reason, 'features']
                written = written + len[made]
        lo_pos = hi_pos + 1
    return written

--- the same function over the source's tail: the rows past `after`,
--- waited for up to the seconds, handed to `f` and what it answers
--- appended; answers the last source position taken — `after` where
--- none came in time — the loop's next `after`
fn stream[g, source, f, after, seconds]
    fresh = tail[source, after, seconds]
    if not fresh.ok
        return error[fresh.reason, 'features']
    if len[fresh] eq 0
        return after
    made = f[fresh]
    if len[made] gt 0
        p = append[g, made]
        if not p.ok
            return error[p.reason, 'features']
    return int[max[fresh._pos]]

--- how fresh a group is: a frame of one row — `head` (the log's last
--- position, -1 for none), `rows` (live), `newest` (the time column's
--- largest value written, as the group keeps it; missing where the
--- group has no rows) — from the log's figures and a summary pushed
--- below the reader, the history never read whole
fn freshness[g]
    m = metrics[g.dir]
    if not m.ok
        return error[m.reason, 'features']
    s = summary[g.dir, [], [g.time], ['max']]
    if not s.ok
        return error[s.reason, 'features']
    col = '`g.time`_max'
    out = rename[s, col, 'newest']
    h = magpie.head[g.dir]
    if not h.ok
        return error[h.reason, 'features']
    out.head = [h + 0]
    rows = m.rows[0]
    if not rows.ok
        return error['no figures for the group at \'`g.dir`\'', 'features']
    out.rows = [rows + 0]
    return out

--- a write's moment in milliseconds: the one handed, or now
fn _when[at]
    if at gte 0
        return at
    return int[float[now[]] * 1000.0]

--- a feature registered: its name, its group, what it means and which
--- function computes it, written to the registry log at `dir` (keyed
--- by the feature's name, so the newest row is its definition and the
--- log the definitions' history); answers the position the row took
fn define[dir, feature, g, meaning, computed = '', at = -1]
    t = _when[at]
    f = frame.new[feature = [feature], log = [g.dir], entity = [join[g.entity, ',']], moment = [g.time], meaning = [meaning], computed = [computed], at = [t]]
    return put[dir, f, by = ['feature'], time = 'at']

--- the entities whose embedding feature `column` lies nearest the
--- vector by the cosine (Magpie's `nearest` over the group's log): the
--- group's rows with a `score`, the best first — an embedding is a
--- feature like any other, written by `append` as a column of vectors,
--- served by `online` and joined into a training set by `training`
fn similar[g, column, v, k = 10]
    return nearest[g.dir, column, v, k]

--- the registry: every feature's newest definition, in the order the
--- newest definitions were written
fn defined[dir]
    return latest[dir]

--- a fresh log for a test: whatever a run before left, removed
fn _fresh[dir]
    gone = rm[dir]
    return dir

--- a feature function for the tests, row by row: whether the amount is
--- big, and the amount in cents
fn _spend[rows]
    out = select[rows, ['user', 'at']]
    out.big = rows.amount gt 50.0
    out.cents = rows.amount * 100.0
    return out

test one_write_is_both_stores[]
    g = declare[_fresh['features-test-both'], ['user'], 'at']
    assert[append[g, frame.new[user = ['u1', 'u2'], at = [10, 20], clicks = [1, 2]]] eq 0]
    assert[online[g, ['u2']].clicks eq [2] and len[online[g, ['u9']]] eq 0]
    assert[append[g, frame.new[user = ['u2'], at = [30], clicks = [3]]] eq 2]
    assert[online[g, ['u2']].clicks eq [3]]
    h = history[g]
    assert[len[h] eq 3 and h.clicks eq [1, 2, 3] and h._pos eq [0, 1, 2]]
    assert[history[g, 1, 1].clicks eq [2]]
    assert[len[history[g, 0, -1, ['user']]] eq 3]
    again = append[g, h]
    assert[again eq 3 and len[history[g]] eq 6]
    assert['_pos' in history[g].columns]
    for i in range[20]
        p = append[g, frame.new[user = ['u3'], at = [100 + i], clicks = [i]]]
        assert[online[g, ['u3']].clicks eq [i]]
    assert[online[g, ['u3']].at eq [119]]
    fr = freshness[g]
    assert[fr.head eq [25] and fr.rows eq [26] and fr.newest eq [119]]
    gone = rm[g.dir]

test a_backfill_and_a_stream_answer_the_same_rows[]
    src = _fresh['features-test-source']
    assert[put[src, frame.new[user = ['a', 'b', 'a', 'c', 'b', 'a', 'c'], at = [1, 2, 3, 4, 5, 6, 7], amount = [10.0, 60.0, 20.0, 80.0, 5.0, 90.0, 15.0]], by = ['user'], time = 'at'] eq 0]
    back = declare[_fresh['features-test-back'], ['user'], 'at']
    live = declare[_fresh['features-test-live'], ['user'], 'at']
    assert[backfill[back, src, _spend, 0, -1, 3] eq 7]
    after = -1
    while after lt 6
        after = stream[live, src, _spend, after, 1.0]
    assert[after eq 6]
    a = history[back]
    b = history[live]
    assert[len[a] eq 7 and a.columns eq b.columns]
    assert[a.user eq b.user and a.at eq b.at and a.big eq b.big and a.cents eq b.cents]
    assert[a.big eq [false, true, false, true, false, true, false]]
    assert[a.cents eq [1000.0, 6000.0, 2000.0, 8000.0, 500.0, 9000.0, 1500.0]]
    assert[online[live, ['a']].cents eq [9000.0] and online[back, ['c']].at eq [7]]
    assert[stream[live, src, _spend, 6, 0.05] eq 6]
    assert[backfill[back, src, _spend, 0, 2, 10] eq 3]
    assert[len[history[back]] eq 10]
    gone = rm[src]
    gone = rm[back.dir]
    gone = rm[live.dir]

test a_training_set_is_as_of_a_position[]
    g = declare[_fresh['features-test-asof'], ['user'], 'at']
    assert[append[g, frame.new[user = ['u1', 'u1', 'u2'], at = [10, 20, 15], clicks = [1, 2, 5]]] eq 0]
    assert[append[g, frame.new[user = ['u1', 'u2'], at = [30, 35], clicks = [3, 6]]] eq 3]
    labels = frame.new[user = ['u1', 'u2', 'u1'], at = [25, 40, 5], y = [1, 0, 1]]
    whole = training[labels, [g], ['clicks']]
    assert[whole.columns eq ['user', 'at', 'y', 'clicks']]
    assert[whole.clicks[0] eq 2 and whole.clicks[1] eq 6]
    assert[not whole.clicks[2].ok]
    cut = training[labels, [g], ['clicks'], 2]
    assert[cut.clicks[0] eq 2 and cut.clicks[1] eq 5]
    first = training[labels, [g], ['clicks'], 0]
    assert[first.clicks[0] eq 1]
    assert[not first.clicks[1].ok]
    gone = rm[g.dir]

--- an embedding is a feature: written as a column of vectors, served
--- by the online store, joined into a training set as of a moment, and
--- the nearest entities found by it
test an_embedding_is_a_feature[]
    g = declare[_fresh['features-test-embed'], ['user'], 'at']
    vs = push[push[[], tensor[[1.0, 0.0]]], tensor[[0.0, 1.0]]]
    assert[append[g, frame.new[user = ['u1', 'u2'], at = [10, 20], emb = vs]] eq 0]
    assert[online[g, ['u2']].emb[0] eq [0.0, 1.0]]
    labels = frame.new[user = ['u1', 'u2'], at = [15, 25], y = [1, 0]]
    whole = training[labels, [g], ['emb']]
    assert[whole.columns eq ['user', 'at', 'y', 'emb']]
    assert[whole.emb[0] eq [1.0, 0.0] and whole.emb[1] eq [0.0, 1.0]]
    near = similar[g, 'emb', [0.9, 0.1], 1]
    assert[near.user eq ['u1'] and near.score[0] gt 0.99]
    gone = rm[g.dir]

test the_registry_is_a_log[]
    reg = _fresh['features-test-registry']
    g = declare['features-test-registry-group', ['user', 'day'], 'at']
    assert[define[reg, 'clicks', g, 'clicks in the trailing day', 'clicks_of', 1000] eq 0]
    assert[define[reg, 'spent', g, 'amount spent in the trailing day', 'spent_of', 1001] eq 1]
    assert[define[reg, 'clicks', g, 'clicks in the trailing day, bots left out', 'clicks_of', 1002] eq 2]
    d = defined[reg]
    assert[len[d] eq 2]
    assert[d.feature eq ['spent', 'clicks']]
    assert[d.meaning eq ['amount spent in the trailing day', 'clicks in the trailing day, bots left out']]
    assert[d.entity eq ['user,day', 'user,day'] and d.moment eq ['at', 'at'] and d.log eq ['features-test-registry-group', 'features-test-registry-group']]
    assert[len[scan[reg]] eq 3]
    gone = rm[reg]
