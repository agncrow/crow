--- The feature store held to pandas (reference/reference.py): sixty
--- feature rows of four users — the running count and sum of their
--- events, as pandas computes them — appended to a group, twelve
--- labels at moments of their own, and the training set pandas's
--- `merge_asof` builds from the labels and the feature rows (by user,
--- backward, an exact moment matching), against which `training` is
--- held cell for cell: the same rows in the labels' order, the same
--- features beside each label, a missing cell where no feature row
--- precedes the label's moment.
use math
use magpie, frame, features

--- a table of the reference's
fn _table[name]
    return frame.load['packages/features/reference/`name`.csv']

test the_training_set_is_pandas_s_merge_asof[]
    gone = rm['features-held']
    g = features.declare['features-held', ['user'], 'at']
    rows = _table['data/features']
    assert[len[rows] eq 60]
    assert[features.append[g, rows] eq 0]
    labels = _table['data/labels']
    expected = _table['expected/training']
    assert[len[labels] eq 12 and len[expected] eq 12]
    got = features.training[labels, [g], ['clicks', 'spent']]
    assert[got.columns eq ['user', 'at', 'label', 'clicks', 'spent']]
    assert[len[got] eq 12]
    for i in range[12]
        assert[got.user[i] eq expected.user[i] and got.at[i] eq expected.at[i] and got.label[i] eq expected.label[i]]
        if expected.clicks[i].ok
            assert[got.clicks[i] eq expected.clicks[i] and got.spent[i] eq expected.spent[i]]
        else
            assert[not got.clicks[i].ok and not got.spent[i].ok]
    --- every column the labels lack, when none is named
    whole = features.training[labels, [g]]
    assert['clicks' in whole.columns and 'spent' in whole.columns and len[whole] eq 12]
    assert[whole.clicks[11] eq got.clicks[11]]
    --- the newest row of each user, from the image, is the last feature
    --- row pandas wrote for them
    for u in ['u1', 'u2', 'u3', 'u4']
        last_row = features.online[g, [u]]
        theirs = rows[rows.user eq u]
        assert[last_row.clicks eq [len[theirs]]]
    gone = rm['features-held']
