--- A random forest for classes: `trees` decision trees, each grown on a
--- bootstrap sample of the rows (drawn with replacement from `seed`, so a
--- fit is the same every run), answering the class most of them give.
--- `x` holds a row of features per sample, `y` an int class for each.
use math
use tree

struct Forest [trees]
struct Sample [xs, ys]

--- a bootstrap sample: n rows drawn with replacement
fn bootstrap[x, y]
    n = len[y]
    xs = []
    ys = []
    for i in range[n]
        j = rand[n]
        xs = push[xs, x[j]]
        ys = push[ys, y[j]]
    return Sample[xs, ys]

fn fit[x, y, trees, depth, seed_n]
    if trees lt 1
        return error['forest: trees is 1 or more', 'forest']
    seed[seed_n]
    grown = []
    for t in range[trees]
        sample = bootstrap[x, y]
        grown = push[grown, tree.fit[sample.xs, sample.ys, depth]]
    return Forest[grown]

--- the class most trees give, the smaller class on a tie
fn classify[f, r]
    votes = map[]
    for t in f.trees
        c = tree.classify[t, r]
        key = '`c`'
        if has[votes, key]
            votes[key] = votes[key] + 1
        else
            votes[key] = 1
    best = tree.classify[f.trees[0], r]
    best_n = 0
    for t in f.trees
        c = tree.classify[t, r]
        n = votes['`c`']
        if n gt best_n or (n eq best_n and c lt best)
            best = c
            best_n = n
    return best

--- two classes a tree separates on one feature: every tree of the forest
--- agrees, and the forest is the same forest every run
test agrees_with_its_trees[]
    x = [[1.0, 9.0], [2.0, 1.0], [3.0, 8.0], [4.0, 2.0], [0.5, 3.0], [3.5, 7.0], [1.5, 2.0], [3.8, 6.0]]
    y = [0, 0, 1, 1, 0, 1, 0, 1]
    f = fit[x, y, 7, 3, 11]
    assert[len[f.trees] eq 7]
    assert[classify[f, [1.0, 5.0]] eq 0]
    assert[classify[f, [3.9, 5.0]] eq 1]
    again = fit[x, y, 7, 3, 11]
    assert[classify[again, [2.4, 4.0]] eq classify[f, [2.4, 4.0]]]
    assert[not fit[x, y, 0, 3, 1].ok]
