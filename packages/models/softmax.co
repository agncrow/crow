--- Softmax regression: one weight column per class, a sample's class
--- the one whose score x·w + b is greatest, fitted by gradient descent on
--- the mean cross-entropy — the gradient by `grad`, no derivative written
--- out. `x` holds a row of features per sample, `y` an int class for
--- each, 0 to classes − 1.
use math, math.nn

struct Softmax [w, b, classes]

--- the mean cross-entropy of the scores against the classes
fn loss[w, b, x, y]
    return crossentropy[x * w + b, y]

fn fit[x, y, classes, steps, rate]
    k = len[x[0]]
    w = zeros[k, classes]
    b = zeros[1, classes]
    xs = tensor[x]
    ys = tensor[y]
    g = grad[loss]
    for s in range[steps]
        gs = g[w, b, xs, ys]
        w = w - gs[0] * rate
        b = b - gs[1] * rate
    return Softmax[w, b, classes]

--- each sample's score per class, a row per sample
fn scores[m, x]
    return reshape[tensor[x] * m.w + m.b, len[x], m.classes]

--- each sample's class: the greatest score's
fn classify[m, x]
    rows = scores[m, x]
    out = for r in rows
        argmax[r]
    return out

--- three classes on a line, a feature apart: the fit tells them
test tells_three_classes_apart[]
    x = [[0.0], [0.2], [1.0], [1.2], [2.0], [2.2]]
    y = [0, 0, 1, 1, 2, 2]
    m = fit[x, y, 3, 400, 0.5]
    assert[classify[m, x] eq [0, 0, 1, 1, 2, 2]]
    assert[loss[m.w, m.b, tensor[x], tensor[y]] lt loss[zeros[1, 3], zeros[1, 3], tensor[x], tensor[y]]]
