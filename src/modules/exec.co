--- `use magpie.exec`: `summary` over a log's files, in Crow — the
--- kernel's answer exactly: each row group pruned by its statistics,
--- its rows masked by the positions, the first key's range and the
--- predicates, grouped by the keys' cells into partials (a count, a sum
--- of ints wrapping and of floats in row order, Welford's mean and
--- squared deviations, the least and the most, the first and the last
--- by position), the groups' partials merged in the files' order (Chan's
--- merge for the variance), a row per key in the keys' order
use sys
use bits
use frame
use magpie.file
use magpie.tail
use magpie.bloom
use magpie.manifest
use magpie.merge
use magpie.encode
use math

--- a cell of a column (1 an int, 2 a float, 3 a bool, 4 text, 5 a vector
--- held as its numbers' text, 6 a moment — its milliseconds in `whole`,
--- its offset in `zone`; 0 none); a vector's numbers in `raw`, as their
--- bytes
struct Cell [form, whole, real, word, zone, raw]

--- one aggregate's partial over one key
struct Partial [count, int_sum, sum, mean, m2, least, most, first_pos, first, last_pos, last]

--- a unit's rows grouped: each row's group as its place among the
--- groups (-1 for a row left out), and each group's key text and cells
struct Grouped [places, keys, cells]

fn _none_cell[]
    return Cell[0, 0, 0.0, '', 0, bytes[0]]

fn _empty_partial[]
    return Partial[0, 0, 0.0, 0.0, 0.0, _none_cell[], _none_cell[], -1, _none_cell[], -1, _none_cell[]]

--- -1, 0 or 1: two cells of one form compared (equal where the forms
--- differ, or a float is not a number)
fn _cmp[a, b]
    if a.form ne b.form
        return 0
    if a.form eq 1 or a.form eq 3 or a.form eq 6
        if a.whole lt b.whole
            return -1
        if a.whole gt b.whole
            return 1
        return 0
    if a.form eq 2
        if a.real lt b.real
            return -1
        if a.real gt b.real
            return 1
        return 0
    if a.form eq 4
        if a.word lt b.word
            return -1
        if a.word gt b.word
            return 1
        return 0
    return 0

--- a partial with one more cell: a float that is not a number is no
--- cell; an int or a bool adds to the wrapping sum; a number to the sum
--- and to Welford's running mean and squared deviations; any cell to the
--- count, the least, the most, the first and the last by position
fn _added[p, c, pos]
    if c.form eq 2 and c.real ne c.real
        return p
    count = p.count + 1
    int_sum = p.int_sum
    x = 0.0
    numeric = false
    if c.form eq 1
        int_sum = wrapadd[int_sum, c.whole]
        x = float[c.whole]
        numeric = true
    if c.form eq 2
        x = c.real
        numeric = true
    if c.form eq 3
        int_sum = int_sum + c.whole
        x = float[c.whole]
        numeric = true
    total = p.sum
    average = p.mean
    m2 = p.m2
    if numeric
        total = total + x
        delta = x - average
        average = average + delta / float[count]
        m2 = m2 + delta * (x - average)
    least = p.least
    if least.form eq 0 or _cmp[c, least] lt 0
        least = c
    most = p.most
    if most.form eq 0 or _cmp[c, most] gt 0
        most = c
    first_pos = p.first_pos
    first = p.first
    if first.form eq 0 or pos lt first_pos
        first_pos = pos
        first = c
    last_pos = p.last_pos
    last = p.last
    if last.form eq 0 or pos gt last_pos
        last_pos = pos
        last = c
    return Partial[count, int_sum, total, average, m2, least, most, first_pos, first, last_pos, last]

--- two partials of one key merged (Chan's merge for the variance), the
--- later one's into the earlier one's
fn _merged[a, o]
    if o.count eq 0
        return a
    if a.count eq 0
        return o
    na = float[a.count]
    nb = float[o.count]
    delta = o.mean - a.mean
    n = na + nb
    average = a.mean + delta * nb / n
    m2 = a.m2 + (o.m2 + delta * delta * na * nb / n)
    least = a.least
    if o.least.form ne 0 and (least.form eq 0 or _cmp[o.least, least] lt 0)
        least = o.least
    most = a.most
    if o.most.form ne 0 and (most.form eq 0 or _cmp[o.most, most] gt 0)
        most = o.most
    first_pos = a.first_pos
    first = a.first
    if o.first.form ne 0 and (first.form eq 0 or o.first_pos lt first_pos)
        first_pos = o.first_pos
        first = o.first
    last_pos = a.last_pos
    last = a.last
    if o.last.form ne 0 and (last.form eq 0 or o.last_pos gt last_pos)
        last_pos = o.last_pos
        last = o.last
    return Partial[a.count + o.count, wrapadd[a.int_sum, o.int_sum], a.sum + o.sum, average, m2, least, most, first_pos, first, last_pos, last]

--- whether cell `i` is present, by the bitmap
fn _present[present, i]
    if len[present] eq 0
        return true
    return bitand[byte[present, shift[i, -3]], shift[1, bitand[i, 7]]] ne 0

--- a column's cells, each a Cell (form 0 where missing; a float that is
--- not a number stays a float, which a partial passes over)
fn _cells_of[col]
    n = len[col]
    present = present_of[col, 0, n]
    kind = cell_kind[col]
    out = []
    if kind eq 'int'
        nums = ints_of[col, 0, n]
        for i in range[n]
            if _present[present, i]
                out = push[out, Cell[1, nums[i], 0.0, '', 0, bytes[0]]]
            else
                out = push[out, _none_cell[]]
    if kind eq 'moment'
        ms = millis_of[col, 0, n]
        zs = zones_of[col, 0, n]
        for i in range[n]
            if _present[present, i]
                out = push[out, Cell[6, ms[i], 0.0, '', zs[i], bytes[0]]]
            else
                out = push[out, _none_cell[]]
    if kind eq 'float'
        reals = floats_of[col, 0, n]
        for i in range[n]
            if _present[present, i]
                out = push[out, Cell[2, 0, reals[i], '', 0, bytes[0]]]
            else
                out = push[out, _none_cell[]]
    if kind eq 'bool'
        flags = bools_of[col, 0, n]
        for i in range[n]
            v = 0
            if flags[i]
                v = 1
            if _present[present, i]
                out = push[out, Cell[3, v, 0.0, '', 0, bytes[0]]]
            else
                out = push[out, _none_cell[]]
    if kind eq 'text'
        cell_bytes = text_bytes_of[col, 0, n]
        cuts = text_ends_of[col, 0, n]
        start = 0
        for i in range[n]
            stop = cuts[i]
            if _present[present, i]
                out = push[out, Cell[4, 0, 0.0, text[slice[cell_bytes, start, stop], ''], 0, bytes[0]]]
            else
                out = push[out, _none_cell[]]
            start = stop
    if kind eq 'vector'
        flat = vectors_of[col, 0, n]
        w = vector_width[col]
        for i in range[n]
            if _present[present, i]
                row = []
                for j in range[w]
                    row = push[row, flat[i * w + j]]
                raw = float_bytes[row, 8, true]
                out = push[out, Cell[5, w, 0.0, hex[raw], 0, raw]]
            else
                out = push[out, _none_cell[]]
    return out

--- a cell as a predicate reads it: a moment as its milliseconds
fn _as_value[c]
    if c.form eq 6
        return Cell[1, c.whole, 0.0, '', 0, bytes[0]]
    return c

--- a value a program wrote as text, read as a column's kind (a moment as
--- its milliseconds)
fn _parse[cells, value]
    if cells eq 'int' or cells eq 'moment'
        why = '\'`value`\' is no int'
        if cells eq 'moment'
            why = '\'`value`\' is no moment\'s milliseconds'
        n = int[trim[value]]
        if not n.ok
            return error[why, 'magpie']
        if n gt 9223372036854775807 or n lt -9223372036854775808
            return error[why, 'magpie']
        return Cell[1, wrap[n], 0.0, '', 0, bytes[0]]
    if cells eq 'float'
        x = float[trim[value]]
        if not x.ok
            return error['\'`value`\' is no number', 'magpie']
        return Cell[2, 0, x, '', 0, bytes[0]]
    if cells eq 'bool'
        t = trim[value]
        if t eq 'true'
            return Cell[3, 1, 0.0, '', 0, bytes[0]]
        if t eq 'false'
            return Cell[3, 0, 0.0, '', 0, bytes[0]]
        return error['\'`value`\' is no bool', 'magpie']
    if cells eq 'text'
        return Cell[4, 0, 0.0, value, 0, bytes[0]]
    return error['a column of vectors is compared with nothing: \`nearest\` finds rows by a vector', 'magpie']

--- a file's bound as a cell
fn _bound_cell[b]
    return Cell[b.form, b.whole, b.real, b.word, 0, bytes[0]]

--- an operator's word, checked: eq, ne, lt, le (lte), gt, ge (gte)
fn _op[word]
    if word eq 'lte'
        return 'le'
    if word eq 'gte'
        return 'ge'
    if word in ['eq', 'ne', 'lt', 'le', 'gt', 'ge']
        return word
    return error['batch: no operator \'`word`\' — write eq, ne, lt, le, gt or ge', 'magpie']

--- whether a cell passes the predicate (-1, 0, 1 the comparison)
fn _passes[o, op]
    if op eq 'eq'
        return o eq 0
    if op eq 'ne'
        return o ne 0
    if op eq 'lt'
        return o eq -1
    if op eq 'le'
        return o ne 1
    if op eq 'gt'
        return o eq 1
    return o ne -1

--- whether a group's bounds can hold a cell the predicate admits
fn _group_may[ent, op, want]
    if ent.rows gt 0 and ent.absent eq ent.rows
        return false
    if op eq 'ne'
        return true
    lo_ok = ent.lo.form eq 0
    hi_ok = ent.hi.form eq 0
    if op eq 'eq'
        return (lo_ok or _cmp[_bound_cell[ent.lo], want] ne 1) and (hi_ok or _cmp[_bound_cell[ent.hi], want] ne -1)
    if op eq 'lt'
        return lo_ok or _cmp[_bound_cell[ent.lo], want] eq -1
    if op eq 'le'
        return lo_ok or _cmp[_bound_cell[ent.lo], want] ne 1
    if op eq 'gt'
        return hi_ok or _cmp[_bound_cell[ent.hi], want] eq 1
    return hi_ok or _cmp[_bound_cell[ent.hi], want] ne -1

--- a key's text: each key cell's form and value, so two keys are one
--- where their cells' bytes are (a float's -0 is its 0)
fn _key_text[cells]
    out = ''
    for c in cells
        if c.form eq 2
            x = c.real
            if x eq 0.0
                x = 0.0
            out = '`out`2:`unpack[ieee[x, 8, little = true], 0, 8, little = true]`|'
        if c.form eq 4
            out = '`out`4:`len[c.word]`:`c.word`|'
        if c.form eq 5
            --- (a vector's numbers by their bits, -0 as 0, as the kernel's
            --- key bytes)
            out = '`out`5:`c.whole`:'
            for x in float_values[c.raw, 0, c.whole, 8, true]
                y = x
                if y eq 0.0
                    y = 0.0
                out = '`out``unpack[ieee[y, 8, little = true], 0, 8, little = true]`,'
            out = '`out`|'
        if c.form eq 1 or c.form eq 3 or c.form eq 6
            out = '`out``c.form`:`c.whole`|'
    return out

--- the place of a column in a file, -1 for none
fn _column_at[r, name]
    for c in range[len[r.footer.columns]]
        if r.footer.columns[c].name eq name
            return c
    return -1

--- the bitmap of which cells are present (no bytes where every one is)
fn _bitmap_of[flags]
    every = true
    for f in flags
        if not f
            every = false
    if every
        return bytes[0]
    out = bytes[shift[len[flags] + 7, -3]]
    for i in range[len[flags]]
        if flags[i]
            out = set[out, shift[i, -3], bitor[byte[out, shift[i, -3]], shift[1, bitand[i, 7]]]]
    return out

--- a column of the kind from cells, a missing cell where a cell is none
fn _column_of[cells, kind]
    present = []
    for c in cells
        present = push[present, c.form ne 0]
    bitmap = _bitmap_of[present]
    if kind eq 'int'
        out = []
        for c in cells
            out = push[out, c.whole]
        return ints_column[out, bitmap]
    if kind eq 'float'
        out = []
        for c in cells
            x = 0.0
            if c.form eq 2
                x = c.real
            if c.form eq 1
                x = float[c.whole]
            out = push[out, x]
        return floats_column[out, bitmap]
    if kind eq 'bool'
        packed = bytes[shift[len[cells] + 7, -3]]
        for i in range[len[cells]]
            if cells[i].form eq 3 and cells[i].whole eq 1
                packed = set[packed, shift[i, -3], bitor[byte[packed, shift[i, -3]], shift[1, bitand[i, 7]]]]
        return bools_column[packed, len[cells], bitmap]
    if kind eq 'moment'
        ms = []
        zs = []
        for c in cells
            if c.form eq 6
                ms = push[ms, c.whole]
                zs = push[zs, c.zone]
            else
                ms = push[ms, 0]
                zs = push[zs, 0]
        return moments_column[ms, zs, bitmap]
    if kind eq 'text'
        out = bytes[0]
        cut_ends = []
        for c in cells
            if c.form eq 4
                out = concat[out, bytes[c.word]]
            cut_ends = push[cut_ends, len[out]]
        return text_column[out, cut_ends, bitmap]
    width = 0
    for c in cells
        if width eq 0 and c.form eq 5
            width = c.whole
    flat = []
    for c in cells
        if c.form eq 5 and c.whole eq width
            for x in float_values[c.raw, 0, width, 8, true]
                flat = push[flat, x]
        else
            for j in range[width]
                flat = push[flat, 0.0]
    return vectors_column[width, flat, bitmap]

--- a key's cells and its partials, one per aggregate
struct Keyed [cells, partials]

--- `summary_of[paths, by, of, how, on, ops, equal, lo, hi, upto]`: the
--- rows of the files at or before `upto` whose first key lies within
--- `lo` and `hi` and which every predicate admits (`on[i] ops[i]
--- equal[i]`; a column named twice is any of its values, columns all of
--- them), grouped by the `by` columns and reduced: `of[i]` by `how[i]`
--- into a column `of_how`. A row per key in the keys' order
fn summary_of[paths, by, of, how, on, ops, equal, lo, hi, upto]
    if len[of] ne len[how]
        return error['batch: a summary takes one aggregate per column: `len[of]` columns, `len[how]` aggregates', 'magpie']
    if len[on] ne len[ops] or len[on] ne len[equal]
        return error['batch: the predicates are three lists of one length: on, ops and equal', 'magpie']
    for h in how
        if h not in ['count', 'sum', 'min', 'max', 'mean', 'var', 'std', 'first', 'last']
            return error['batch: no aggregate \'`h`\' — write count, sum, min, max, mean, var, std, first or last', 'magpie']
    opw = slice[['x'], 0, 0]
    for o in ops
        w = _op[o]
        if not w.ok
            return error[w.reason, 'magpie']
        opw = push[opw, w]
    if len[paths] eq 0
        return frame.new[]
    --- every path opened first, as the kernel opens them: a file's reader,
    --- or the tail's pending rows read whole, one group of their own
    readers = []
    held = []
    is_held = slice[[true], 0, 0]
    slot = []
    for p in paths
        if _pending_path[p]
            df = pending_at[p]
            if not df.ok
                return error[df.reason, 'magpie']
            is_held = push[is_held, true]
            slot = push[slot, len[held]]
            held = push[held, df]
        else
            r = opened[p]
            if not r.ok
                return error[r.reason, 'magpie']
            is_held = push[is_held, false]
            slot = push[slot, len[readers]]
            readers = push[readers, r]
    --- the columns a predicate names, each once, in the order first named
    pcols = slice[['x'], 0, 0]
    for c in on
        if c not in pcols
            pcols = push[pcols, c]
    --- the first path's columns and kinds: the answer's kinds
    first_kinds = map[]
    if is_held[0]
        first = held[slot[0]]
        for c in first.columns
            first_kinds = set[first_kinds, c, cell_kind[first.`c`]]
    else
        for c in readers[slot[0]].footer.columns
            first_kinds = set[first_kinds, c.name, c.cells]
    keys_seen = map[]
    key_cells = []
    totals = []
    for a in range[len[of]]
        totals = push[totals, []]
    for at_path in range[len[paths]]
        units = []
        if is_held[at_path]
            unit = _pending_unit[held[slot[at_path]], paths[at_path], _log_key[paths[at_path]], by, of, on, opw, equal, pcols, lo, hi, upto]
            if not unit.ok
                return error[unit.reason, 'magpie']
            units = push[units, unit]
        else
            r = readers[slot[at_path]]
            keys0 = ''
            if len[r.footer.key_names] gt 0
                keys0 = r.footer.key_names[0]
            for g in range[len[r.footer.groups]]
                unit = _unit[r, g, keys0, by, of, on, opw, equal, pcols, lo, hi, upto]
                if not unit.ok
                    return error[unit.reason, 'magpie']
                units = push[units, unit]
        for unit in units
            for k in keys[unit]
                part = unit[k]
                if k in keys_seen
                    at = keys_seen[k]
                    for a in range[len[of]]
                        totals[a][at] = _merged[totals[a][at], part.partials[a]]
                else
                    keys_seen = set[keys_seen, k, len[key_cells]]
                    key_cells = push[key_cells, part.cells]
                    for a in range[len[of]]
                        totals[a] = push[totals[a], part.partials[a]]
    return _answer[first_kinds, paths[0], by, of, how, key_cells, totals]

--- whether a path names the tail's pending rows (`<dir>/.pending@first-last`)
fn _pending_path[p]
    return '/.pending' in p

--- the log's first key, for its pending rows (the manifest's keys, which
--- the pending rows' file carries); none where the log has no keys
fn _log_key[p]
    pieces = split[p, '/.pending']
    m = listed[pieces[0]]
    if not m.ok or len[m.keys] eq 0
        return ''
    return m.keys[0]

--- the names a group's rows are read with: the keys, the aggregated, the
--- predicates', the first key where a range asks it, the position
fn _unit_names[by, of, on, ranged, keys0]
    names = slice[['x'], 0, 0]
    for n in by
        if n not in names
            names = push[names, n]
    for n in of
        if n not in names
            names = push[names, n]
    for n in on
        if n not in names
            names = push[names, n]
    if ranged and keys0 not in names
        names = push[names, keys0]
    if '_pos' not in names
        names = push[names, '_pos']
    return names

--- the pending rows' partials, by key text: their checks as a file's
--- group meets them (the first key's range, each predicate's column and
--- values, the columns read), then their rows as a group's
fn _pending_unit[df, path, keys0, by, of, on, opw, equal, pcols, lo, hi, upto]
    ranged = (len[lo] gt 0 or len[hi] gt 0) and len[keys0] gt 0
    low = _none_cell[]
    high = _none_cell[]
    if ranged and keys0 in df.columns
        kind = cell_kind[df.`keys0`]
        if len[lo] gt 0
            got = _parse[kind, lo]
            if not got.ok
                return error['batch: column \'`keys0`\': `got.reason`', 'magpie']
            low = got
        if len[hi] gt 0
            got = _parse[kind, hi]
            if not got.ok
                return error['batch: column \'`keys0`\': `got.reason`', 'magpie']
            high = got
    for column in pcols
        if column not in df.columns
            return error['batch: \'`path`\' holds no column \'`column`\'', 'magpie']
        kind = cell_kind[df.`column`]
        for i in range[len[on]]
            if on[i] eq column
                want = _parse[kind, equal[i]]
                if not want.ok
                    return error['batch: column \'`column`\': `want.reason`', 'magpie']
    for n in _unit_names[by, of, on, ranged, keys0]
        if n not in df.columns
            return error['batch: \'`path`\' holds no column \'`n`\'', 'magpie']
    return _unit_rows[df, keys0, ranged, low, high, by, of, on, opw, equal, pcols, upto]

--- the bytes a value hashes to in a column's filter
fn _want_bytes[want]
    if want.form eq 1
        return pack[want.whole, 8, little = true]
    if want.form eq 2
        x = want.real
        if x eq 0.0
            x = 0.0
        return ieee[x, 8, little = true]
    if want.form eq 3
        return push[bytes[0], want.whole]
    return bytes[want.word]

--- one row group's partials, by key text — none where the group's
--- statistics show it holds no row the summary reads
fn _unit[r, g, keys0, by, of, on, opw, equal, pcols, lo, hi, upto]
    out = map[]
    f = r.footer
    if upto gte 0
        pc = _column_at[r, '_pos']
        if pc gte 0
            pe = entries[r, pc]
            if not pe.ok
                return error[pe.reason, 'magpie']
            if pe[g].lo.form eq 1 and pe[g].lo.whole gt upto
                return out
    ranged = (len[lo] gt 0 or len[hi] gt 0) and len[keys0] gt 0
    low = _none_cell[]
    high = _none_cell[]
    if ranged
        kc = _column_at[r, keys0]
        if kc gte 0
            ke = entries[r, kc]
            if not ke.ok
                return error[ke.reason, 'magpie']
            kind = f.columns[kc].cells
            if len[lo] gt 0
                got = _parse[kind, lo]
                if not got.ok
                    return error['batch: column \'`keys0`\': `got.reason`', 'magpie']
                low = got
                if not _group_may[ke[g], 'ge', low]
                    return out
            if len[hi] gt 0
                got = _parse[kind, hi]
                if not got.ok
                    return error['batch: column \'`keys0`\': `got.reason`', 'magpie']
                high = got
                if not _group_may[ke[g], 'le', high]
                    return out
    for column in pcols
        c = _column_at[r, column]
        if c lt 0
            return error['batch: \'`r.path`\' holds no column \'`column`\'', 'magpie']
        kind = f.columns[c].cells
        ce = entries[r, c]
        if not ce.ok
            return error[ce.reason, 'magpie']
        e = ce[g]
        admitted_any = false
        for i in range[len[on]]
            if not admitted_any and on[i] eq column
                want = _parse[kind, equal[i]]
                if not want.ok
                    return error['batch: column \'`column`\': `want.reason`', 'magpie']
                if _group_may[e, opw[i], want]
                    sieved = false
                    if opw[i] eq 'eq' and e.bloom_len gt 0
                        bf = value_filter[r, e]
                        if not bf.ok
                            return error[bf.reason, 'magpie']
                        sieved = not admits[bf, _want_bytes[want]]
                    if not sieved
                        admitted_any = true
        if not admitted_any
            return out
    cols = wanted[r, _unit_names[by, of, on, ranged, keys0]]
    if not cols.ok
        return error[cols.reason, 'magpie']
    df = group_of[r, g, cols]
    if not df.ok
        return error[df.reason, 'magpie']
    return _unit_rows[df, keys0, ranged, low, high, by, of, on, opw, equal, pcols, upto]

--- a group's rows (or the pending rows) as partials by key text: masked
--- by the positions, the first key's range and the predicates, grouped
--- by the keys' cells
fn _unit_rows[df, keys0, ranged, low, high, by, of, on, opw, equal, pcols, upto]
    out = map[]
    n = len[df]
    pos = ints_of[df._pos, 0, n]
    keep = slice[[true], 0, 0]
    for i in range[n]
        keep = push[keep, upto lt 0 or pos[i] lte upto]
    if ranged
        kcells = _cells_of[df.`keys0`]
        for i in range[n]
            c = _as_value[kcells[i]]
            inside = c.form ne 0 and (low.form eq 0 or _cmp[c, low] ne -1) and (high.form eq 0 or _cmp[c, high] ne 1)
            keep[i] = keep[i] and inside
    for column in pcols
        ccells = _cells_of[df.`column`]
        kind = cell_kind[df.`column`]
        for i in range[n]
            if keep[i]
                c = _as_value[ccells[i]]
                ok = false
                if c.form ne 0
                    for j in range[len[on]]
                        if not ok and on[j] eq column
                            want = _parse[kind, equal[j]]
                            if want.ok and _passes[_cmp[c, want], opw[j]]
                                ok = true
                keep[i] = ok
    --- (each row's group found once, as its place among the groups, and
    --- each column's partials kept per group and made records once the
    --- rows are read: a group's record read out of the map and written
    --- back for every row had been most of a summary — 109 ms over
    --- 200,000 rows where the kernel took 2)
    grouped = _grouped[df, by, keep]
    gidx = grouped.places
    group_keys = grouped.keys
    group_cells = grouped.cells
    ng = len[group_keys]
    columns = []
    for o in of
        columns = push[columns, _column_partials[df, o, gidx, ng, pos]]
    for g in range[ng]
        partials = []
        for a in range[len[of]]
            partials = push[partials, columns[a][g]]
        out = set[out, group_keys[g], Keyed[group_cells[g], partials]]
    return out

--- the rows grouped by the key columns: by one int column through a map
--- of ints, the key's text and cells made once per group; by any other
--- keys a row's cells and their text at a time
fn _grouped[df, by, keep]
    if len[by] eq 1
        b0 = by[0]
        if cell_kind[df.`b0`] eq 'int'
            return _grouped_by_int[df, b0, keep]
    return _grouped_by_cells[df, by, keep]

--- the rows grouped by one int column: a group per value, in the order
--- the values first come, a missing key leaving its row out — as
--- `_grouped_by_cells` groups them, with no text made for a row
fn _grouped_by_int[df, b, keep]
    n = len[df]
    vals = ints_of[df.`b`, 0, n]
    present = present_of[df.`b`, 0, n]
    places = map[]
    labels = slice[['x'], 0, 0]
    cells = []
    gidx = []
    for i in range[n]
        g = -1
        if keep[i] and _present[present, i]
            v = vals[i]
            if v in places
                g = places[v]
            else
                g = len[labels]
                places = set[places, v, g]
                kc = []
                kc = push[kc, Cell[1, v, 0.0, '', 0, bytes[0]]]
                labels = push[labels, _key_text[kc]]
                cells = push[cells, kc]
        gidx = push[gidx, g]
    return Grouped[gidx, labels, cells]

--- the rows grouped by their key cells' text
fn _grouped_by_cells[df, by, keep]
    n = len[df]
    by_cells = []
    for b in by
        by_cells = push[by_cells, _cells_of[df.`b`]]
    index = map[]
    group_keys = slice[['x'], 0, 0]
    group_cells = []
    gidx = []
    for i in range[n]
        g = -1
        if keep[i]
            kc = []
            whole = true
            for k in range[len[by]]
                c = by_cells[k][i]
                if c.form eq 0
                    whole = false
                kc = push[kc, c]
            if whole
                key = _key_text[kc]
                if key in index
                    g = index[key]
                else
                    g = len[group_keys]
                    index = set[index, key, g]
                    group_keys = push[group_keys, key]
                    group_cells = push[group_cells, kc]
        gidx = push[gidx, g]
    return Grouped[gidx, group_keys, group_cells]

--- a column's partials, one per group, the rows given as their groups'
--- places (-1 for a row left out): a column of numbers read as its
--- numbers, any other a cell at a time
fn _column_partials[df, name, gidx, ng, pos]
    kind = cell_kind[df.`name`]
    n = len[df]
    if kind eq 'float'
        return _float_partials[floats_of[df.`name`, 0, n], present_of[df.`name`, 0, n], gidx, ng, pos]
    if kind eq 'int'
        return _int_partials[ints_of[df.`name`, 0, n], present_of[df.`name`, 0, n], gidx, ng, pos]
    cells = _cells_of[df.`name`]
    parts = []
    for g in range[ng]
        parts = push[parts, _empty_partial[]]
    for i in range[len[gidx]]
        g = gidx[i]
        if g gte 0
            c = cells[i]
            if c.form ne 0
                parts[g] = _added[parts[g], c, pos[i]]
    return parts

--- the partials of a column of floats, as `_added` makes them a cell at
--- a time — a float that is not a number passed over, Welford's mean and
--- squared deviations in row order, the least and the most, the first
--- and the last by position — kept as numbers per group
fn _float_partials[xs, present, gidx, ng, pos]
    ns = []
    sums = []
    avgs = []
    m2s = []
    los = []
    his = []
    fps = []
    fvs = []
    lps = []
    lvs = []
    for g in range[ng]
        ns = push[ns, 0]
        sums = push[sums, 0.0]
        avgs = push[avgs, 0.0]
        m2s = push[m2s, 0.0]
        los = push[los, 0.0]
        his = push[his, 0.0]
        fps = push[fps, -1]
        fvs = push[fvs, 0.0]
        lps = push[lps, -1]
        lvs = push[lvs, 0.0]
    for i in range[len[gidx]]
        g = gidx[i]
        if g gte 0 and _present[present, i]
            x = xs[i]
            if x eq x
                k = ns[g] + 1
                ns[g] = k
                sums[g] = sums[g] + x
                delta = x - avgs[g]
                avg = avgs[g] + delta / float[k]
                avgs[g] = avg
                m2s[g] = m2s[g] + delta * (x - avg)
                if k eq 1 or x lt los[g]
                    los[g] = x
                if k eq 1 or x gt his[g]
                    his[g] = x
                at = pos[i]
                if k eq 1 or at lt fps[g]
                    fps[g] = at
                    fvs[g] = x
                if k eq 1 or at gt lps[g]
                    lps[g] = at
                    lvs[g] = x
    parts = []
    for g in range[ng]
        if ns[g] eq 0
            parts = push[parts, _empty_partial[]]
        else
            parts = push[parts, Partial[ns[g], 0, sums[g], avgs[g], m2s[g], Cell[2, 0, los[g], '', 0, bytes[0]], Cell[2, 0, his[g], '', 0, bytes[0]], fps[g], Cell[2, 0, fvs[g], '', 0, bytes[0]], lps[g], Cell[2, 0, lvs[g], '', 0, bytes[0]]]]
    return parts

--- the partials of a column of ints, as `_added` makes them a cell at a
--- time — the wrapping sum beside the float one — kept as numbers per
--- group
fn _int_partials[vs, present, gidx, ng, pos]
    ns = []
    isums = []
    sums = []
    avgs = []
    m2s = []
    los = []
    his = []
    fps = []
    fvs = []
    lps = []
    lvs = []
    for g in range[ng]
        ns = push[ns, 0]
        isums = push[isums, 0]
        sums = push[sums, 0.0]
        avgs = push[avgs, 0.0]
        m2s = push[m2s, 0.0]
        los = push[los, 0]
        his = push[his, 0]
        fps = push[fps, -1]
        fvs = push[fvs, 0]
        lps = push[lps, -1]
        lvs = push[lvs, 0]
    for i in range[len[gidx]]
        g = gidx[i]
        if g gte 0 and _present[present, i]
            v = vs[i]
            k = ns[g] + 1
            ns[g] = k
            isums[g] = wrapadd[isums[g], v]
            x = float[v]
            sums[g] = sums[g] + x
            delta = x - avgs[g]
            avg = avgs[g] + delta / float[k]
            avgs[g] = avg
            m2s[g] = m2s[g] + delta * (x - avg)
            if k eq 1 or v lt los[g]
                los[g] = v
            if k eq 1 or v gt his[g]
                his[g] = v
            at = pos[i]
            if k eq 1 or at lt fps[g]
                fps[g] = at
                fvs[g] = v
            if k eq 1 or at gt lps[g]
                lps[g] = at
                lvs[g] = v
    parts = []
    for g in range[ng]
        if ns[g] eq 0
            parts = push[parts, _empty_partial[]]
        else
            parts = push[parts, Partial[ns[g], isums[g], sums[g], avgs[g], m2s[g], Cell[1, los[g], 0.0, '', 0, bytes[0]], Cell[1, his[g], 0.0, '', 0, bytes[0]], fps[g], Cell[1, fvs[g], 0.0, '', 0, bytes[0]], lps[g], Cell[1, lvs[g], 0.0, '', 0, bytes[0]]]]
    return parts

--- a column's kind as the first file's footer names it
fn _kind_in[kinds, path, name]
    if name not in kinds
        return error['batch: \'`path`\' holds no column \'`name`\'', 'magpie']
    return kinds[name]

--- the answer: a row per key in the keys' order, the key columns as they
--- were, then each aggregate `of_how` in the kind it has
fn _answer[kinds, path, by, of, how, key_cells, totals]
    n = len[key_cells]
    keyed = frame.new[]
    for k in range[len[by]]
        kind = _kind_in[kinds, path, by[k]]
        if not kind.ok
            return error[kind.reason, 'magpie']
        cells = []
        for row in key_cells
            cells = push[cells, row[k]]
        name = by[k]
        keyed.`name` = _column_of[cells, kind]
    order = range[n]
    if n gt 1 and len[by] gt 0
        idx = []
        for i in range[n]
            idx = push[idx, i]
        keyed._summary_order_ = ints_column[idx, bytes[0]]
        sorted = sort[keyed, by]
        order = ints_of[sorted._summary_order_, 0, n]
        keyed = select[sorted, by]
    out = keyed
    if len[by] eq 0
        out = frame.new[]
    for a in range[len[of]]
        name = of[a]
        h = how[a]
        kind = _kind_in[kinds, path, name]
        if not kind.ok
            return error[kind.reason, 'magpie']
        parts = []
        for i in order
            parts = push[parts, totals[a][i]]
        label = '`name`_`h`'
        if h eq 'count'
            counts = []
            for p in parts
                counts = push[counts, p.count]
            out.`label` = ints_column[counts, bytes[0]]
        if h eq 'sum'
            if kind eq 'int' or kind eq 'bool'
                sums = []
                for p in parts
                    sums = push[sums, p.int_sum]
                out.`label` = ints_column[sums, bytes[0]]
            else
                if kind eq 'float'
                    sums = []
                    for p in parts
                        sums = push[sums, p.sum]
                    out.`label` = floats_column[sums, bytes[0]]
                else
                    return error['batch: sum of column \'`name`\', which holds `kind`', 'magpie']
        if h eq 'mean' or h eq 'var' or h eq 'std'
            if kind ne 'int' and kind ne 'float' and kind ne 'bool'
                return error['batch: `h` of column \'`name`\', which holds `kind`', 'magpie']
            figures = []
            held = []
            for p in parts
                x = 0.0 / 0.0
                if p.count gt 0
                    if h eq 'mean'
                        x = p.sum / float[p.count]
                    if h eq 'var'
                        x = p.m2 / float[p.count]
                    if h eq 'std'
                        x = sqrt[p.m2 / float[p.count]]
                figures = push[figures, x]
                held = push[held, p.count gt 0]
            out.`label` = floats_column[figures, _bitmap_of[held]]
        if h eq 'min' or h eq 'max' or h eq 'first' or h eq 'last'
            cells = []
            for p in parts
                if h eq 'min'
                    cells = push[cells, p.least]
                if h eq 'max'
                    cells = push[cells, p.most]
                if h eq 'first'
                    cells = push[cells, p.first]
                if h eq 'last'
                    cells = push[cells, p.last]
            out.`label` = _column_of[cells, kind]
    return out

--- a float's whole part as the kernel's cast takes it: toward zero, NaN
--- as 0, past either end as that end
fn _whole_of[x]
    if x ne x
        return 0
    if x gte 9223372036854775807.0
        return 9223372036854775807
    if x lte -9223372036854775807.0 - 1.0
        return -9223372036854775807 - 1
    return int[x]

--- a time cell as the join reads it: an int as it is, a moment as its
--- milliseconds, a float's whole part; none (form 0) for a missing cell
--- or another kind
fn _moment_of[c]
    if c.form eq 1 or c.form eq 6
        return Cell[1, c.whole, 0.0, '', 0, bytes[0]]
    if c.form eq 2
        return Cell[1, _whole_of[c.real], 0.0, '', 0, bytes[0]]
    return _none_cell[]

--- a candidate of the join: its moment, its position, the file it came
--- from, and the cells of the columns brought
struct Cand [at, pos, file, cells]

--- the labels with a column of missing cells per name: the join where
--- nothing can precede a label
fn _joined_none[labels, asked]
    out = labels
    n = len[labels]
    for w in asked
        cells = []
        for i in range[n]
            cells = push[cells, _none_cell[]]
        out.`w` = _column_of[cells, 'float']
    return out

--- the candidates with one group's rows more: each row with every key
--- and a moment, at or before `upto` and the latest moment its key is
--- asked at, with the cells of the columns brought
fn _cands_of[df, keyed, time, bring, latest, upto, fi, cands]
    n = len[df]
    kcells = []
    for k in keyed
        kcells = push[kcells, _cells_of[df.`k`]]
    tcells = _cells_of[df.`time`]
    pos = ints_of[df._pos, 0, n]
    bcells = []
    for b in bring
        bcells = push[bcells, _cells_of[df.`b`]]
    for i in range[n]
        kc = []
        whole = tcells[i].form ne 0
        for c in kcells
            if c[i].form eq 0
                whole = false
            kc = push[kc, c[i]]
        if whole and (upto lt 0 or pos[i] lte upto)
            kt = _key_text[kc]
            m = _moment_of[tcells[i]]
            if kt in latest and m.form ne 0 and m.whole lte latest[kt]
                brought = []
                for c in bcells
                    brought = push[brought, c[i]]
                one = Cand[m.whole, pos[i], fi, brought]
                if kt in cands
                    cands[kt] = push[cands[kt], one]
                else
                    first_cand = []
                    first_cand = push[first_cand, one]
                    cands = set[cands, kt, first_cand]
    return cands

--- `asof_rows[paths, labels, keyed, time, asked, upto]`: for each row of
--- `labels` — the log's keys (`keyed`) and a moment in its `time` column — the
--- newest row of the files with the same keys at or before the moment
--- (by time, then by position), its `asked` columns (every column of
--- the log not among the labels' when none is named) beside the label's;
--- missing cells where none precedes. The labels' columns come first. A
--- row past the position `upto` (-1 for no bound) is no candidate
fn asof_rows[paths, labels, keyed, time, asked, upto]
    if len[keyed] eq 0
        return error['batch: an as-of join needs the log\'s keys', 'magpie']
    if len[time] eq 0
        return error['batch: an as-of join needs the log\'s time column — declare it at the first batch (time = \'ts\')', 'magpie']
    for k in keyed
        if k not in labels.columns
            return error['batch: the labels lack the key column \'`k`\'', 'magpie']
    if time not in labels.columns
        return error['batch: the labels lack the time column \'`time`\'', 'magpie']
    nl = len[labels]
    lkeys = []
    for k in keyed
        lkeys = push[lkeys, _cells_of[labels.`k`]]
    ltimes = _cells_of[labels.`time`]
    --- each label's key text (empty where it has none) and moment, and the
    --- latest moment asked of each key
    label_key = slice[['x'], 0, 0]
    label_at = []
    latest = map[]
    for i in range[nl]
        m = _moment_of[ltimes[i]]
        kc = []
        whole = true
        for c in lkeys
            if c[i].form eq 0
                whole = false
            kc = push[kc, c[i]]
        if whole and m.form ne 0
            kt = _key_text[kc]
            label_key = push[label_key, kt]
            label_at = push[label_at, m.whole]
            if kt in latest
                if m.whole gt latest[kt]
                    latest[kt] = m.whole
            else
                latest = set[latest, kt, m.whole]
        else
            label_key = push[label_key, '']
            label_at = push[label_at, 0]
    if len[paths] eq 0 or len[latest] eq 0
        return _joined_none[labels, asked]
    --- the log's columns to bring, from the first path (the tail's pending
    --- rows are read whole)
    first_columns = slice[['x'], 0, 0]
    if _pending_path[paths[0]]
        df0 = pending_at[paths[0]]
        if not df0.ok
            return error[df0.reason, 'magpie']
        first_columns = df0.columns
    else
        first = opened[paths[0]]
        if not first.ok
            return error[first.reason, 'magpie']
        for c in first.footer.columns
            first_columns = push[first_columns, c.name]
    bring = asked
    if len[asked] eq 0
        bring = slice[['x'], 0, 0]
        for name in first_columns
            if name not in labels.columns and name ne '_pos'
                bring = push[bring, name]
    needed = slice[['x'], 0, 0]
    for k in keyed
        needed = push[needed, k]
    needed = push[needed, time]
    needed = push[needed, '_pos']
    for b in bring
        if b not in needed
            needed = push[needed, b]
    --- every group read, its rows for the labels' keys kept as candidates
    cands = map[]
    file_kinds = []
    for fi in range[len[paths]]
        p = paths[fi]
        if _pending_path[p]
            df = pending_at[p]
            if not df.ok
                return error[df.reason, 'magpie']
            for name in needed
                if name not in df.columns
                    return error['batch: \'`p`\' holds no column \'`name`\'', 'magpie']
            kinds = slice[['x'], 0, 0]
            for b in bring
                kinds = push[kinds, cell_kind[df.`b`]]
            file_kinds = push[file_kinds, kinds]
            cands = _cands_of[df, keyed, time, bring, latest, upto, fi, cands]
        else
            r = opened[p]
            if not r.ok
                return error[r.reason, 'magpie']
            cols = wanted[r, needed]
            if not cols.ok
                return error[cols.reason, 'magpie']
            kinds = slice[['x'], 0, 0]
            for b in bring
                kinds = push[kinds, r.footer.columns[_column_at[r, b]].cells]
            file_kinds = push[file_kinds, kinds]
            for g in range[len[r.footer.groups]]
                df = group_of[r, g, cols]
                if not df.ok
                    return error[df.reason, 'magpie']
                cands = _cands_of[df, keyed, time, bring, latest, upto, fi, cands]
    --- each label's pick: the newest candidate at or before its moment
    picks = []
    for i in range[nl]
        best = -1
        kt = label_key[i]
        if len[kt] gt 0 and kt in cands
            cs = cands[kt]
            for j in range[len[cs]]
                c = cs[j]
                if c.at lte label_at[i]
                    if best lt 0
                        best = j
                    else
                        b = cs[best]
                        if c.at gt b.at or (c.at eq b.at and c.pos gt b.pos)
                            best = j
        picks = push[picks, best]
    out = labels
    for bi in range[len[bring]]
        name = bring[bi]
        cells = []
        kind = 'float'
        for i in range[nl]
            if picks[i] lt 0
                cells = push[cells, _none_cell[]]
            else
                c = cands[label_key[i]][picks[i]]
                kind = file_kinds[c.file][bi]
                cells = push[cells, c.cells[bi]]
        out.`name` = _column_of[cells, kind]
    return out

fn _fresh[dir]
    if exists[dir]
        gone = rm[dir]
    made = mkdir[dir]
    return dir

--- a frame's image, digested — each column's name and its chunk (its
--- kind, its missing cells, its cells, as magpie.encode writes them):
--- what a recorded answer is held to
fn _image[f]
    n = len[f]
    out = bytes['`n`']
    for name in f.columns
        out = concat[out, bytes[name]]
        out = concat[out, chunk[f.`name`, 0, n, false]]
    return slice[hash[out, 'sha256'], 0, 16]

--- the kernel's answers of a summary over two files
test summary_is_the_kernels[]
    nothing = slice[['x'], 0, 0]
    dir = _fresh['target/crow_exec_summary']
    k = declare[dir, ['day', 'sym'], nothing, nothing]
    days = []
    syms = []
    pxs = []
    vols = []
    for i in range[900]
        days = push[days, i % 4]
        syms = push[syms, 's`i % 7`']
        pxs = push[pxs, float[(i * 37) % 101] / 8.0]
        vols = push[vols, (i * 13) % 50]
    df = frame.new[day = days, sym = syms, px = pxs, vol = vols]
    a = write_batch[dir, 0, 0, df, ['day', 'sym'], nothing]
    b = write_batch[dir, 1, 900, df, ['day', 'sym'], nothing]
    paths = ['`dir`/000000000000.batch', '`dir`/000000000001.batch']
    hows = ['count', 'sum', 'min', 'max', 'mean', 'var', 'std', 'first', 'last']
    seen = []
    for h in hows
        mine = summary_of[paths, ['sym'], ['px', 'vol'], [h, h], nothing, nothing, nothing, '', '', -1]
        seen = push[seen, _image[mine]]
    one = summary_of[paths, ['day', 'sym'], ['vol'], ['sum'], ['day', 'vol'], ['eq', 'gt'], ['2', '20'], '1', '3', 1200]
    seen = push[seen, _image[one]]
    whole = summary_of[paths, nothing, ['vol'], ['sum'], nothing, nothing, nothing, '', '', -1]
    seen = push[seen, _image[whole]]
    --- (recorded from the Rust kernel before it was deleted, 2026-10-28)
    assert[seen eq ['eb5ce0e1bcb614d0', '3e90ec839b34ec24', 'ad38d01cb377bd9b', 'f0476d88d5d42899', '7ca95930f2d5ec4a', 'a7d61e5c187fca0a', '93835fdaa518ad2d', '1e0fd1e14b0d04db', 'cdf775563e8bea83', '45ce121ce645972c', 'e88e7f5fb1b0e37a']]
    none = summary_of[paths, ['sym'], ['vol'], ['sum'], ['day'], ['gt'], ['9'], '', '', -1]
    assert[len[none] eq 0]
    median = summary_of[paths, ['sym'], ['px'], ['median'], nothing, nothing, nothing, '', '', -1]
    assert[median.reason eq 'batch: no aggregate \'median\' — write count, sum, min, max, mean, var, std, first or last']
    texts = summary_of[paths, ['sym'], ['sym'], ['sum'], nothing, nothing, nothing, '', '', -1]
    assert[texts.reason eq 'batch: sum of column \'sym\', which holds text']

--- the same as-of join as the kernel's: labels between the log's rows,
--- before the first, past `upto`, with a missing key or moment
--- a summary by one int column — grouped through a map of ints, the
--- columns' partials kept per group — answers as the cell-at-a-time
--- summary did, to the digit
test summary_by_an_int_column_is_the_cells_summary[]
    nothing = slice[['x'], 0, 0]
    dir = _fresh['target/crow_exec_summary_int']
    k = declare[dir, ['day', 'sym'], nothing, nothing]
    days = []
    syms = []
    pxs = []
    vols = []
    for i in range[900]
        days = push[days, i % 4]
        syms = push[syms, 's`i % 7`']
        pxs = push[pxs, float[(i * 37) % 101] / 8.0]
        vols = push[vols, (i * 13) % 50]
    df = frame.new[day = days, sym = syms, px = pxs, vol = vols]
    a = write_batch[dir, 0, 0, df, ['day', 'sym'], nothing]
    b = write_batch[dir, 1, 900, df, ['day', 'sym'], nothing]
    paths = ['`dir`/000000000000.batch', '`dir`/000000000001.batch']
    hows = ['count', 'sum', 'min', 'max', 'mean', 'var', 'std', 'first', 'last']
    seen = []
    for h in hows
        mine = summary_of[paths, ['day'], ['px', 'vol'], [h, h], nothing, nothing, nothing, '', '', -1]
        seen = push[seen, _image[mine]]
    ranged = summary_of[paths, ['day'], ['vol'], ['sum'], ['vol'], ['gt'], ['20'], '1', '2', 1200]
    seen = push[seen, _image[ranged]]
    --- (recorded from the summary that read a cell at a time, 2026-10-28)
    assert[seen eq ['2cfbf24bd7febf7b', 'a1412209d8925ba9', '8cde72ef6389338e', 'd111e189aff42cbf', 'e1aaf7f4346cdf3b', 'd6f3678887169574', '244dd458cd0586ee', '73d39a991becd50b', '47538d693bb95200', 'e005b0bb8a61ac6a']]

test asof_is_the_kernels[]
    nothing = slice[['x'], 0, 0]
    dir = _fresh['target/crow_exec_asof']
    k = declare[dir, ['sym'], ['time'], ['ts']]
    syms = []
    tss = []
    pxs = []
    for i in range[300]
        syms = push[syms, 's`i % 5`']
        tss = push[tss, i * 10]
        pxs = push[pxs, float[(i * 37) % 101] / 8.0]
    df = frame.new[sym = syms, ts = tss, px = pxs]
    a = write_batch[dir, 0, 0, frame.head[df, 150], ['sym'], nothing]
    b = write_batch[dir, 1, 150, frame.tail[df, 150], ['sym'], nothing]
    paths = ['`dir`/000000000000.batch', '`dir`/000000000001.batch']
    labels = frame.new[sym = ['s1', 's2', 's3', 's9', 's1'], ts = [5, 1495, 2990, 100, -3], label = [1, 0, 1, 1, 0]]
    seen = []
    for upto in [-1, 160, 2000]
        mine = asof_rows[paths, labels, ['sym'], 'ts', nothing, upto]
        seen = push[seen, _image[mine]]
    picked = asof_rows[paths, labels, ['sym'], 'ts', ['px'], -1]
    seen = push[seen, _image[picked]]
    none = asof_rows[nothing, labels, ['sym'], 'ts', ['px'], -1]
    seen = push[seen, _image[none]]
    --- (recorded from the Rust kernel before it was deleted, 2026-10-28)
    assert[seen eq ['420e26491d0b2df6', '142b5cddfc644ce3', '420e26491d0b2df6', '420e26491d0b2df6', '8513857fa1437365']]
    unkeyed = asof_rows[paths, labels, nothing, 'ts', nothing, -1]
    assert[unkeyed.reason eq 'batch: an as-of join needs the log\'s keys']
    other = asof_rows[paths, labels, ['day'], 'ts', nothing, -1]
    assert[other.reason eq 'batch: the labels lack the key column \'day\'']
