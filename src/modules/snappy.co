--- `use magpie.snappy`: Snappy's raw block format decoded, in
--- Crow, so the Kafka door reads a producer's snappy-compressed message
--- set: a varint of the uncompressed length, then elements — a literal
--- run, or a copy of what was written from an offset back, in three
--- widths. Only decoding, as the door needs; `snappy_literal` writes a
--- valid block of literals alone, for the tests. The kernel's answer
--- byte for byte (docs/magpie-in-crow.md)
use sys
use bits

--- `unsnapped[block]`: the bytes of a snappy block; refused where it is
--- cut short, reaches back past its start or decodes to another length
--- than it promised, in the kernel's words
fn unsnapped[block]
    total = len[block]
    size = 0
    width = 0
    i = 0
    reading = true
    while reading
        if i gte total
            return error['the snappy block is cut short', 'magpie']
        b = byte[block, i]
        i = i + 1
        if width gte 32
            return error['the snappy block\'s length is longer than 32 bits', 'magpie']
        size = bitor[size, shift[bitand[b, 127], width]]
        if bitand[b, 128] eq 0
            reading = false
        else
            width = width + 7
    out = bytes[0]
    while i lt total
        tag = byte[block, i]
        i = i + 1
        kind = bitand[tag, 3]
        if kind eq 0
            n = shift[tag, -2]
            if n gte 60
                extra = n - 59
                if i + extra gt total
                    return error['the snappy block is cut short', 'magpie']
                n = 0
                for k in range[extra]
                    n = bitor[n, shift[byte[block, i + k], 8 * k]]
                i = i + extra
            n = n + 1
            if i + n gt total
                return error['the snappy block is cut short', 'magpie']
            out = concat[out, slice[block, i, i + n]]
            i = i + n
        else
            length = 0
            offset = 0
            if kind eq 1
                if i gte total
                    return error['the snappy block is cut short', 'magpie']
                length = 4 + bitand[shift[tag, -2], 7]
                offset = bitor[shift[shift[tag, -5], 8], byte[block, i]]
                i = i + 1
            if kind eq 2
                if i + 2 gt total
                    return error['the snappy block is cut short', 'magpie']
                length = shift[tag, -2] + 1
                offset = unpack[block, i, 2, little = true, signed = false]
                i = i + 2
            if kind eq 3
                if i + 4 gt total
                    return error['the snappy block is cut short', 'magpie']
                length = shift[tag, -2] + 1
                offset = unpack[block, i, 4, little = true, signed = false]
                i = i + 4
            if offset eq 0 or offset gt len[out]
                return error['a snappy copy reaches `offset` bytes back where `len[out]` were written', 'magpie']
            start = len[out] - offset
            for k in range[length]
                out = push[out, byte[out, start + k]]
        if len[out] gt size
            return error['the snappy block decodes past the `size` bytes promised', 'magpie']
    if len[out] ne size
        return error['the snappy block decodes to `len[out]` bytes, and `size` were promised', 'magpie']
    return out

--- `snappy_literal[data]`: the bytes as a snappy block of literals alone
--- — a valid block, no compression: what a test writes to drive the
--- reader
fn snappy_literal[data]
    out = bytes[0]
    n = len[data]
    going = true
    while going
        b = bitand[n, 127]
        n = shift[n, -7]
        if n eq 0
            out = push[out, b]
            going = false
        else
            out = push[out, bitor[b, 128]]
    from = 0
    total = len[data]
    while from lt total
        stop = from + 65536
        if stop gt total
            stop = total
        m = stop - from - 1
        if m lt 60
            out = push[out, shift[m, 2]]
        else
            out = push[out, 244]
            out = concat[out, pack[m, 2, little = true]]
        out = concat[out, slice[data, from, stop]]
        from = stop
    return out

--- bytes from a list of numbers
fn _bytes_of[nums]
    out = bytes[0]
    for x in nums
        out = push[out, int[x]]
    return out

--- the kernel's own vectors: literals, copies of each width, an
--- overlapping copy, and blocks refused
test snappy_reads_the_kernels_blocks[]
    assert[same[unsnapped[snappy_literal[bytes[0]]], bytes[0]]]
    word = bytes['snappy snappy snappy']
    many = word
    for i in range[12]
        many = concat[many, many]
    assert[same[unsnapped[snappy_literal[many]], many]]
    assert[text[unsnapped[_bytes_of[[8, 12, 97, 98, 99, 100, 1, 4]]]] eq 'abcdabcd']
    assert[text[unsnapped[_bytes_of[[8, 4, 97, 98, 22, 2, 0]]]] eq 'abababab']
    assert[text[unsnapped[_bytes_of[[6, 4, 120, 121, 15, 2, 0, 0, 0]]]] eq 'xyxyxy']
    assert[not unsnapped[_bytes_of[[8, 12, 97, 98, 99, 100, 1, 9]]].ok]
    assert[not unsnapped[_bytes_of[[9, 12, 97, 98, 99, 100, 1, 4]]].ok]
    assert[not unsnapped[_bytes_of[[8, 12, 97, 98]]].ok]
