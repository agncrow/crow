--- `use web.auth`: `sign` and `verify`, written in Crow on the sys layer
--- (design rule 20) — a JSON Web Token signed with HS256: its header and
--- its claims as base64url, the signature an HMAC-SHA256 of the two
--- (RFC 7519). Each one's row in the builtin table (src/table.rs) is its
--- contract; the claims reach `sign` as the JSON text the value encodes
--- to. The tests are the module's own: `crow test src/modules/auth.co`.
use sys

--- `sign[claims, secret]`: a token carrying the claims, issued now (`iat`)
--- and expiring in an hour (`exp`) unless they say when; a secret under 32
--- characters signs nothing, and claims that are no map are refused
fn sign[claims, secret]
    given = len[secret]
    if given lt 32
        return error['a token\'s secret is 32 characters or more (got `given`)', 'auth']
    j = json[claims]
    if not j.ok
        return error['a token\'s claims are a map or a record of them', 'auth']
    if type[j] ne 'map'
        return error['a token\'s claims are a map or a record of them', 'auth']
    issued = int[time[]]
    added = ''
    if not has[j, 'iat']
        added = '"iat":`issued`'
    if not has[j, 'exp']
        expires = issued + 3600
        if len[added] gt 0
            added = '`added`,'
        added = '`added`"exp":`expires`'
    payload = claims
    if len[added] gt 0
        inner = trim[slice[claims, 1, len[claims] - 1]]
        if len[inner] gt 0
            payload = '{`inner`,`added`}'
        else
            payload = '{`added`}'
    head = base64url[bytes['{"alg":"HS256","typ":"JWT"}']]
    body = base64url[bytes[payload]]
    signature = base64url[hmac[bytes[secret], bytes['`head`.`body`'], 'sha256']]
    return '`head`.`body`.`signature`'

--- a token's part as the JSON value it carries, or nothing a token has
fn part_of[piece]
    raw = unbase64[piece]
    if not raw.ok
        return error['not a token', 'auth']
    spelled = text[raw]
    if not spelled.ok
        return error['not a token', 'auth']
    value = json[spelled]
    if not value.ok
        return error['not a token', 'auth']
    if type[value] ne 'map'
        return error['not a token', 'auth']
    return value

--- `verify[token, secret]`: the claims a token carries, when it was signed
--- with this secret and has not expired; otherwise why not — not a token,
--- not signed with HS256, a signature that does not match, expired
fn verify[token, secret]
    parts = split[token, '.']
    if len[parts] ne 3
        return error['not a token', 'auth']
    header = part_of[parts[0]]
    if not header.ok
        return error[header.reason, 'auth']
    if not has[header, 'alg']
        return error['not a token', 'auth']
    if str[header.alg] ne 'HS256'
        return error['the token is not signed with HS256', 'auth']
    expected = hmac[bytes[secret], bytes['`parts[0]`.`parts[1]`'], 'sha256']
    given = unbase64[parts[2]]
    if not given.ok
        return error['not a token', 'auth']
    if not same[expected, given]
        return error['the token\'s signature does not match', 'auth']
    claims = part_of[parts[1]]
    if not claims.ok
        return error[claims.reason, 'auth']
    if has[claims, 'exp']
        if float[claims.exp] lt time[]
            return error['the token has expired', 'auth']
    return claims

--- a token carries its claims and is refused with its reason; a token
--- another library signed is read (jwt.io's example, secret and all)
test a_token_is_signed_and_read[]
    secret = 'a-secret-of-at-least-thirty-two-chars'
    token = sign['{"user":"alice","role":"admin"}', secret]
    assert[len[split[token, '.']] eq 3]
    claims = verify[token, secret]
    assert[str[claims.user] eq 'alice']
    assert[int[claims.exp] - int[claims.iat] eq 3600]
    assert[verify[token, 'another-secret-of-thirty-two-chars!!'].reason eq 'the token\'s signature does not match']
    assert[verify['not.a.token', secret].reason eq 'not a token']
    assert[verify['nothing', secret].reason eq 'not a token']
    old = sign['{"user":"bob","exp":1000}', secret]
    assert[verify[old, secret].reason eq 'the token has expired']
    assert[sign['{"x":1}', 'short'].reason eq 'a token\'s secret is 32 characters or more (got 5)']
    assert[sign['[1, 2]', secret].reason eq 'a token\'s claims are a map or a record of them']
    bare = sign['{}', secret]
    assert[has[verify[bare, secret], 'iat']]
    known = 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiIxMjM0NTY3ODkwIiwibmFtZSI6IkpvaG4gRG9lIiwiaWF0IjoxNTE2MjM5MDIyfQ.SflKxwRJSMeKKF2QT4fwpMeJf36POk6yJV_adQssw5c'
    got = verify[known, 'your-256-bit-secret']
    assert[str[got.name] eq 'John Doe']
    none = 'eyJhbGciOiJub25lIn0.eyJzdWIiOiJ4In0.'
    assert[verify[none, secret].reason eq 'the token is not signed with HS256']
