--- `use lake`: the log as a directory of batch files (spec, lake). Each
--- commit is one file, written once by the kernel (sys.batch_write): a
--- frame given a position per row, sorted by its keys, with the statistics
--- a reader prunes by in its head. Everything else is here, in Crow: the
--- next number and position (`batch`), the sequencer (`commit`: a write
--- set and the keys its reads saw, refused where a key was written since
--- the snapshot), reading from a position (`read`), the rows up to a
--- snapshot (`scan`), the latest version of each key (`latest`), the rows
--- holding a value (`lookup`, the files pruned by their filters), and the
--- catalog's state (`batches`). One process writes a log; two writers on
--- one machine claim numbers through the kernel, which links a file into
--- place only where no file of the number exists, so a slip is a retry.
--- The tests are the module's own: `crow test src/modules/lake.co`.
use sys
use frame
use math

--- the log's files in a directory, in order: batch files
--- (`000000000017.batch`) and segments, each named by the batch numbers
--- it covers (`000000000003-000000000017.segment`)
fn _names[dir]
    entries = ls[dir]
    if not entries.ok
        return error['no log at \'`dir`\': `entries.reason`', 'lake']
    names = []
    for n in entries
        if (ends[n, '.batch'] and len[n] eq 18) or (ends[n, '.segment'] and len[n] eq 33)
            names = push[names, n]
    return names

--- the batch numbers a file's name covers, as [low, high]
fn _covers[name]
    if ends[name, '.batch']
        n = int[slice[name, 0, 12]]
        return [n, n]
    return [int[slice[name, 0, 12]], int[slice[name, 13, 25]]]

--- whether a batch's number lies inside one of the segments' ranges: a
--- segment holds its rows, so the batch is stale (left by a merge that
--- did not get to remove it)
fn _inside[c, segments]
    for s in segments
        if c[0] gte s[0] and c[0] lte s[1]
            return true
    return false

--- `batches[dir]`: the catalog's state — a frame of the log's files, a
--- row each: `number` and `high` (the batch numbers it covers), `form`
--- (`batch`, `segment`, or `stale` for a batch a segment already holds),
--- `path`, `rows`, `first` and `last` (positions); an empty log is one
--- row with an empty path and `last` -1
fn batches[dir]
    names = _names[dir]
    if not names.ok
        return names
    segments = []
    for n in names
        if ends[n, '.segment']
            segments = push[segments, _covers[n]]
    numbers = []
    highs = []
    forms = []
    paths = []
    counts = []
    firsts = []
    lasts = []
    for n in names
        c = _covers[n]
        p = '`dir`/`n`'
        head = batch_stats[p]
        if not head.ok
            return error[head.reason, 'lake']
        s = json[head]
        form = 'segment'
        if ends[n, '.batch']
            form = 'batch'
            if _inside[c, segments]
                form = 'stale'
        numbers = push[numbers, c[0]]
        highs = push[highs, c[1]]
        forms = push[forms, form]
        paths = push[paths, p]
        --- each figure read as an int and held plain: a value that can
        --- fail in the list had made the column's cells ones that can fail
        rows = int[s.rows]
        first = int[s.first]
        last = int[s.last]
        if not rows.ok or not first.ok or not last.ok
            return error['`p` has no row count or positions in its head', 'lake']
        counts = push[counts, rows + 0]
        firsts = push[firsts, first + 0]
        lasts = push[lasts, last + 0]
    if len[names] eq 0
        return frame.new[number = [0], high = [-1], form = ['none'], path = [''], rows = [0], first = [0], last = [-1]]
    return frame.new[number = numbers, high = highs, form = forms, path = paths, rows = counts, first = firsts, last = lasts]

--- the files a reader reads: the batches no segment holds, and the segments
fn _live[b]
    return b[b.form eq 'batch' or b.form eq 'segment']

--- `head[dir]`: the log's last position, -1 for an empty log
fn head[dir]
    b = batches[dir]
    if not b.ok
        return b
    --- a reduction over an int column answers a float: the position is an int
    return int[max[b.last]]

--- the next batch's number and first position, as [number, first]: past
--- every number any file covers, and every position any file holds
fn _next[b]
    return [int[max[b.high]] + 1, int[max[b.last]] + 1]

--- one batch file written: the kernel's row called from its own function,
--- outside any loop, so the kinds it takes reach every caller before the
--- program runs (a row called inside a loop had typed nothing of its
--- caller's parameters, and a frame handed an int did not build compiled),
--- the lists copied for it (a row takes its list of text as a value, and a
--- parameter the body only reads is lent: `(*by)` had not built)
fn _written[dir, number, first, f, by, texts]
    cols = by
    words = texts
    return batch_write[dir, number, first, f, cols, words]

--- a frame about to be written, its key and text columns checked to
--- exist: refused here, before the kernel is reached, and in both modes
--- before the program runs where the kinds are known (the frame's, the
--- lists') — a parameter typed only inside the loop below had reached no
--- caller, and a frame handed an int ran interpreted and did not build
fn _checked[f, by, texts]
    --- a frame, and nothing else: a parsed value handed here had read
    --- `columns` as its field and built nothing compiled
    probe = frame.head[f, 1]
    names = f.columns
    if len[names] eq 0
        return error['a batch holds a frame with columns', 'lake']
    --- the lists' kinds pinned here, outside the loops (`select` had done
    --- it, and a `use ui` program reads `select` as its control)
    keyed = push[by, '']
    worded = push[texts, '']
    if '' in by or '' in texts
        return error['a column name is empty', 'lake']
    for c in by
        if c not in names
            return error['no column \'`c`\' to sort by', 'lake']
    for c in texts
        if c not in names
            return error['no column \'`c`\' to index the words of', 'lake']
    return len[by] + len[texts]

--- a log's directory, made where it is not yet (a writer opens a log;
--- a reader of one that does not exist is told so)
fn _opened[dir]
    if exists[dir]
        return dir
    made = mkdir[dir]
    if not made.ok
        return error['cannot open a log at \'`dir`\': `made.reason`', 'lake']
    return dir

--- `batch[dir, f, by = [], texts = []]`: the frame written as the log's
--- next batch, sorted by the `by` columns, the words of `texts` indexed;
--- answers the first position its rows got. Two writers that claim one
--- number: the second's write is refused by the kernel and claims the next
fn batch[dir, f, by = [], texts = []]
    checked = _checked[f, by, texts]
    if not checked.ok
        return checked
    opened = _opened[dir]
    if not opened.ok
        return opened
    tries = 0
    while tries lt 100
        b = batches[dir]
        if not b.ok
            return b
        at = _next[b]
        made = _written[dir, at[0], at[1], f, by, texts]
        if made.ok
            return at[1]
        if not ('was written already' in made.reason)
            return error[made.reason, 'lake']
        tries = tries + 1
    return error['the log at \'`dir`\' is contended: 100 tries could not claim a batch number', 'lake']

--- the batch files whose positions reach past `after`, stacked, the rows
--- past it kept
fn _rows_after[b, after]
    out = frame.new[]
    for i in range[len[b]]
        if b.last[i] gt after and (b.form[i] eq 'batch' or b.form[i] eq 'segment')
            part = batch_read[b.path[i]]
            if not part.ok
                return error[part.reason, 'lake']
            kept = part[part._pos gt after]
            if len[out] eq 0
                out = kept
            else
                out = frame.stack[out, kept]
    return out

--- `since[dir, from]`: every row at position `from` or later, in position
--- order (a consumer's read: its offset is the last position it saw)
fn since[dir, from]
    b = batches[dir]
    if not b.ok
        return b
    if max[b.last] lt 0
        return frame.new[]
    rows = _rows_after[b, from - 1]
    if not rows.ok
        return rows
    if len[rows] eq 0
        return rows
    return sort[rows, '_pos']

--- `tail[dir, after, seconds]`: the rows past position `after`, waiting up
--- to the seconds for some to arrive (a view that follows the log: each
--- call a batch of new rows, its state a frame the caller keeps); an
--- empty frame when none came in time
fn tail[dir, after, seconds]
    --- the wait is counted in rounds of 20 ms, not read off the clock: a
    --- replay's clock stands still, and a loop on it never ended
    rounds = int[seconds * 50.0]
    rows = since[dir, after + 1]
    waited = 0
    while rows.ok and len[rows] eq 0 and waited lt rounds
        sleep[20]
        waited = waited + 1
        rows = since[dir, after + 1]
    return rows

--- `scan[dir, upto = -1]`: every row of the log up to position `upto`
--- (every row with -1), in position order: each version of each key
fn scan[dir, upto = -1]
    rows = since[dir, 0]
    if not rows.ok
        return rows
    --- the snapshot is one position, an int (said of `upto` itself, so a
    --- list handed as one is refused before the program runs); -1 is every row
    snapshot = pack[upto, 8]
    if upto eq -1 or len[rows] eq 0
        return rows
    return rows[rows._pos lte upto]

--- `latest[dir, by, upto = -1]`: the newest version of each key (the `by`
--- columns) up to
--- the snapshot — the table the log holds, one row per key
fn latest[dir, by, upto = -1]
    rows = scan[dir, upto]
    if not rows.ok
        return rows
    if len[rows] eq 0
        return rows
    --- `by` pinned as a list of text: a text had reached `unique` as a
    --- column's name and handed a column to the sort below
    keyed = push[by, '']
    if len[by] eq 0
        return rows
    newest = sort[rows, '_pos', desc = true]
    return sort[unique[newest, by], '_pos']

--- the rows of one file holding a value: the kernel's row in its own
--- function, as `_written` is, so `column` and `value` are text to the caller
fn _found[path, column, value]
    return batch_find[path, column, value]

--- `lookup[dir, column, value]`: the rows whose `column` holds the value,
--- written as text (`'3'`, `'2.5'`, `'true'`), in position order — each
--- file asked through its filter and, a segment, its row groups'
--- statistics, so a key the segment is sorted by reads one group
fn lookup[dir, column, value]
    --- the column's name and the value are text (typed here, outside the
    --- loop below, so a caller handing another kind is refused before the
    --- program runs); a value may be empty text, a name may not
    if len[bytes[column]] eq 0
        return error['lookup needs a column name', 'lake']
    asked = bytes[value]
    b = batches[dir]
    if not b.ok
        return b
    out = frame.new[]
    for i in range[len[b]]
        if b.form[i] eq 'batch' or b.form[i] eq 'segment'
            hit = _found[b.path[i], column, value]
            if not hit.ok
                return error[hit.reason, 'lake']
            if len[out] eq 0
                out = hit
            else
                out = frame.stack[out, hit]
    if len[out] eq 0
        return out
    return sort[out, '_pos']

--- the kernel's row in its own function, as `_found` is: the lists copied
--- where the row takes them
fn _searched[paths, column, words, k]
    named = paths
    asked = words
    return batch_search[named, column, asked, k]

--- `search[dir, column, words, k = 10]`: the k rows whose indexed `column`
--- (a `texts` column of `batch`) best match the words, each read as its
--- tokens, lowercased — BM25 as Lucene scores it, over the whole log as
--- one corpus, the files whose filters admit no word unread — with the
--- files' columns and a `score`, the best first and an earlier position
--- first between equals
fn search[dir, column, words, k = 10]
    --- the kinds pinned here, outside the helper: a list of text, an int
    if len[bytes[column]] eq 0
        return error['search needs a column name', 'lake']
    --- the words pinned as a list of text (an empty word is no token, and
    --- the kernel reads each word as its tokens), k as an int
    pinned = push[words, '']
    wanted = pack[k, 8]
    if k lt 0
        return error['a search answers at most k rows, and k is `k`', 'lake']
    b = batches[dir]
    if not b.ok
        return b
    live = _live[b]
    paths = []
    for i in range[len[live]]
        paths = push[paths, live.path[i]]
    return _searched[paths, column, words, k]

--- `commit[dir, f, by = [], texts = [], seen = -1, columns = [], equal = []]`:
--- the sequencer. A transaction read at snapshot `seen` the keys
--- `columns[i] = equal[i]` (each value as text); the write set `f` is
--- appended where none of those keys was written after `seen`, and
--- refused, naming the key and the position, where one was. Validation
--- covers every file before the number the write claims; a number another
--- writer took first means the files are read again
fn commit[dir, f, by = [], texts = [], seen = -1, columns = [], equal = []]
    checked = _checked[f, by, texts]
    if not checked.ok
        return checked
    --- the reads are pairs: a column each, a value each, as text
    pairs = concat[columns, equal]
    if len[pairs] ne 2 * len[columns]
        return error['commit takes its reads as two lists of one length: columns and equal', 'lake']
    opened = _opened[dir]
    if not opened.ok
        return opened
    tries = 0
    while tries lt 100
        b = batches[dir]
        if not b.ok
            return b
        for i in range[len[b]]
            if b.last[i] gt seen and (b.form[i] eq 'batch' or b.form[i] eq 'segment')
                for j in range[len[columns]]
                    held = _found[b.path[i], columns[j], equal[j]]
                    if not held.ok
                        return error[held.reason, 'lake']
                    hit = held[held._pos gt seen]
                    if len[hit] gt 0
                        return error['conflict: `columns[j]` = `equal[j]` was written at position `hit._pos[0]`, after snapshot `seen`', 'lake']
        at = _next[b]
        made = _written[dir, at[0], at[1], f, by, texts]
        if made.ok
            return at[1]
        if not ('was written already' in made.reason)
            return error[made.reason, 'lake']
        tries = tries + 1
    return error['the log at \'`dir`\' is contended: 100 tries could not claim a batch number', 'lake']

--- `merge[dir, by = [], every = false]`: every batch file and segment of
--- the log folded into one segment (sys.batch_merge): the rows sorted by
--- the `by` columns, the latest version of each key kept — or every row,
--- with `every`, for an append-only table whose keys are its sort order
--- and no identity — the statistics and the word filters as a batch's.
--- The inputs are removed once the segment is in place, and a stale
--- batch a crash left behind with them. Answers the segment's path, or ''
--- where the log holds fewer than two files
fn merge[dir, by = [], every = false]
    b = batches[dir]
    if not b.ok
        return b
    live = _live[b]
    --- `every` keeps every row where the keys would fold them: without
    --- keys every row is kept already, so saying so is a slip (and
    --- `every` is a truth, compared with one here, so another kind handed
    --- as it is refused before the program runs)
    if every eq true and len[by] eq 0
        return error['every keeps every row where keys would fold them: give merge its by columns', 'lake']
    if len[live] lt 2
        return ''
    inputs = []
    for p in live.path
        inputs = push[inputs, p]
    --- the key columns are a list of names, none empty: asked of `by`
    --- itself (a list a name is pushed onto, which holds no empty one), so
    --- a caller handing another kind is refused before the program runs —
    --- the copy below says nothing of it; the paths copied for the row
    --- (it takes its lists as values, and `inputs` is read again below:
    --- compiled, the row had moved it)
    keyed = push[by, '']
    if '' in by
        return error['a key column has a name', 'lake']
    named = inputs
    cols = by
    made = batch_merge[dir, named, cols, every]
    if not made.ok
        return error[made.reason, 'lake']
    stale = b[b.form eq 'stale']
    for p in inputs
        gone = rm[p]
    for p in stale.path
        gone = rm[p]
    return made

--- `metrics[dir]`: the log's figures as a frame of one row — `files` (the
--- live ones: batches no segment holds, and segments), `batches` (not
--- merged yet), `segments`, `stale` (batches a segment holds, not removed
--- yet), `rows` (live), `bytes` (the live files on disk) and `head` (the
--- last position, -1 for none); a table of its own a program writes to a
--- log of its own to keep
fn metrics[dir]
    b = batches[dir]
    if not b.ok
        return b
    live = _live[b]
    --- a frame picked by a mask is a value that can fail: held here, so
    --- the figures are plain ints
    if not live.ok
        return live
    if len[live] eq 0
        return frame.new[files = [0], batches = [0], segments = [0], stale = [0], rows = [0], bytes = [0], head = [-1]]
    total = 0
    for i in range[len[live]]
        total = total + _size_of[live.path[i]]
    return frame.new[files = [len[live] + 0], batches = [_counted[b, 'batch']], segments = [_counted[b, 'segment']], stale = [_counted[b, 'stale']], rows = [int[sum[live.rows]]], bytes = [total], head = [int[max[live.last]]]]

--- how many of the catalog's files are of a form
fn _counted[b, which]
    picked = b[b.form eq which]
    if not picked.ok
        return 0
    return len[picked] + 0

--- a file's bytes on disk, 0 where it cannot be sized (removed by a
--- merge between the listing and the asking)
fn _size_of[path]
    n = filesize[path]
    if not n.ok
        return 0
    return n + 0

--- the last piece of a path
fn _base[path]
    pieces = split[path, '/']
    return pieces[len[pieces] - 1]

--- a place a backup goes: a directory, or an s3:// prefix
fn _place[to]
    if starts[to, 'http://'] or starts[to, 'https://']
        return error['a backup is a directory or an s3:// prefix, not \'`to`\'', 'lake']
    if starts[to, 's3://']
        return ''
    made = mkdir[to]
    if not made.ok
        return error[made.reason, 'lake']
    return ''

--- bytes kept under a place: an S3 object, or a file
fn _kept[path, data]
    if starts[path, 's3://']
        sent = put[path, data]
        if not sent.ok
            return error[sent.reason, 'lake']
        return ''
    kept = store[path, data]
    if not kept.ok
        return error[kept.reason, 'lake']
    return ''

--- bytes read from a place: an S3 object, or a file
fn _fetched[path]
    if starts[path, 's3://']
        got = fetch[path, map[], map[], 0.0]
        if not got.ok
            return error[got.reason, 'lake']
        return got.body
    data = file[path]
    if not data.ok
        return error[data.reason, 'lake']
    return data

--- `backup[dir, to]`: the log's live files copied under `to` — a directory,
--- or an s3:// prefix — and a `manifest` written last naming them, one
--- per line, so a backup is whole only when its manifest is: a version of
--- the log, restored by `restore`. Answers how many files were copied
fn backup[dir, to]
    b = batches[dir]
    if not b.ok
        return b
    placed = _place[to]
    if not placed.ok
        return placed
    live = _live[b]
    nl = '\n'
    listing = ''
    copied = 0
    for i in range[len[live]]
        data = file[live.path[i]]
        if not data.ok
            return error[data.reason, 'lake']
        name = _base[live.path[i]]
        kept = _kept['`to`/`name`', data]
        if not kept.ok
            return kept
        listing = '`listing``name``nl`'
        copied = copied + 1
    written = write['`to`/manifest', listing]
    if not written.ok
        return error[written.reason, 'lake']
    return copied

--- `restore[saved, dir]`: the files a backup's manifest names copied into
--- `dir` (made where it is not yet; an empty directory, or one whose files
--- the backup's replace), each written whole. Answers how many files were
--- restored. A log is read by position, so a restore followed by the
--- batches written since is the log as it was
fn restore[saved, dir]
    if starts[saved, 'http://'] or starts[saved, 'https://']
        return error['a backup is a directory or an s3:// prefix, not \'`saved`\'', 'lake']
    listing = read['`saved`/manifest']
    if not listing.ok
        return error['no backup at \'`saved`\': `listing.reason`', 'lake']
    opened = _opened[dir]
    if not opened.ok
        return opened
    restored = 0
    for name in split[listing, '\n']
        if len[name] gt 0
            data = _fetched['`saved`/`name`']
            if not data.ok
                return data
            kept = store['`dir`/`name`', data]
            if not kept.ok
                return error[kept.reason, 'lake']
            restored = restored + 1
    return restored

--- a line of a follower's request, read without waiting: empty text
--- where none has arrived whole yet, the bytes past it kept for the next
fn _line_of[c]
    have = leftover[c]
    nl = bytes['\n']
    at = find[have, nl]
    while at lt 0
        got = recv[stream_of[c], 4096, 0.005]
        if not got.ok
            unread[c, have]
            if starts[got.reason, 'no data']
                return ''
            return error[got.reason, 'lake']
        if len[got] eq 0
            return error['closed', 'lake']
        have = concat[have, got]
        at = find[have, nl]
    unread[c, slice[have, at + 1, len[have]]]
    return text[slice[have, 0, at], '?']

--- a request's answer: `list` is the live files, a count then a name and
--- its bytes per line; `get <name>` is the file's size on a line and its
--- bytes after it
fn _shared[dir, line]
    nl = '\n'
    if line eq 'list'
        b = batches[dir]
        if not b.ok
            return error[b.reason, 'lake']
        live = _live[b]
        if not live.ok
            return error[live.reason, 'lake']
        out = '`len[live]``nl`'
        for i in range[len[live]]
            name = _base[live.path[i]]
            n = _size_of[live.path[i]]
            out = '`out``name` `n``nl`'
        return bytes[out]
    if starts[line, 'get ']
        name = slice[line, 4, len[line]]
        if '/' in name or not (ends[name, '.batch'] or ends[name, '.segment'])
            return error['\'`name`\' is no file of a log', 'lake']
        data = file['`dir`/`name`']
        if not data.ok
            return error[data.reason, 'lake']
        return concat[bytes['`len[data]``nl`'], data]
    return error['\'`line`\' is no request of a log', 'lake']

--- `share[dir, port, host = '127.0.0.1', rounds = 0]`: the log served to
--- its followers — replication by log shipping. A follower connects and
--- asks for the live files' names (`list`) and for each file it lacks
--- (`get <name>`), answered as the file's bytes; a file is written once
--- and never changed, so a follower that holds a file holds it whole. One
--- loop serves every connection, each polled in turn, as the Kafka door
--- does, until `rounds` loops have run (forever with 0). Answers how
--- many requests it answered
fn share[dir, port, host = '127.0.0.1', rounds = 0]
    l = listen[host, port]
    if not l.ok
        return error[l.reason, 'lake']
    conns = []
    answered = 0
    round = 0
    while rounds eq 0 or round lt rounds
        round = round + 1
        arrived = accept[l, 0.005]
        if arrived.ok
            conns = push[conns, socket_of[arrived, address[arrived], bytes['']]]
        kept = []
        for c in conns
            line = _line_of[c]
            if not line.ok
                sys.close[stream_of[c]]
            else
                if len[line] gt 0
                    reply = _shared[dir, line]
                    if not reply.ok
                        sys.close[stream_of[c]]
                    else
                        sent = send[stream_of[c], reply]
                        answered = answered + 1
                        kept = push[kept, c]
                else
                    kept = push[kept, c]
        conns = kept
    sys.close[l]
    return answered

--- a line of the server's answer, waited for (the connection's own wait)
fn _line_waited[c]
    have = leftover[c]
    nl = bytes['\n']
    at = find[have, nl]
    while at lt 0
        got = recv[stream_of[c], 65536, 0.0]
        if not got.ok
            return error[got.reason, 'lake']
        if len[got] eq 0
            return error['the log\'s server closed', 'lake']
        have = concat[have, got]
        at = find[have, nl]
    unread[c, slice[have, at + 1, len[have]]]
    return text[slice[have, 0, at], '?']

--- exactly n bytes of the server's answer, waited for
fn _exact[c, n]
    have = leftover[c]
    while len[have] lt n
        got = recv[stream_of[c], n - len[have], 0.0]
        if not got.ok
            return error[got.reason, 'lake']
        if len[got] eq 0
            return error['the log\'s server closed', 'lake']
        have = concat[have, got]
    unread[c, slice[have, n, len[have]]]
    return slice[have, 0, n]

--- `follow[dir, host, port, seconds = 5.0]`: the files a shared log holds
--- that `dir` lacks, fetched into it (made where it is not yet), each
--- written whole; the batches a fetched segment covers let go, as the
--- leader's merge let them go. One pass: a follower that keeps up calls
--- it again, and reads the log by position between calls, as any log is
--- read. Answers how many files came. An error value of kind `'lake'`
--- where the server cannot be reached within the seconds, or answers
--- other than a log's server does
fn follow[dir, host, port, seconds = 5.0]
    opened = _opened[dir]
    if not opened.ok
        return error[opened.reason, 'lake']
    s = open[host, port, false, seconds]
    if not s.ok
        return error[s.reason, 'lake']
    c = socket_of[s, '`host`:`port`', bytes['']]
    nl = '\n'
    asked = send[s, bytes['list`nl`']]
    if not asked.ok
        return error[asked.reason, 'lake']
    count_line = _line_waited[c]
    if not count_line.ok
        return error[count_line.reason, 'lake']
    n = int[count_line]
    if not n.ok
        return error['\'`host`:`port`\' answered no listing of a log', 'lake']
    listed = n + 0
    have = ls[dir]
    if not have.ok
        return error[have.reason, 'lake']
    --- every entry of the listing is read before a file is asked for:
    --- the entries still queued had been read as a file's size
    names = []
    for i in range[listed]
        entry = _line_waited[c]
        if not entry.ok
            return error[entry.reason, 'lake']
        names = push[names, split[entry, ' '][0]]
    fetched = 0
    for name in names
        if name not in have
            wanted = send[s, bytes['get `name``nl`']]
            if not wanted.ok
                return error[wanted.reason, 'lake']
            size_line = _line_waited[c]
            if not size_line.ok
                return error[size_line.reason, 'lake']
            m = int[size_line]
            if not m.ok
                return error['\'`host`:`port`\' answered no file for \'`name`\'', 'lake']
            data = _exact[c, m + 0]
            if not data.ok
                return error[data.reason, 'lake']
            kept = store['`dir`/`name`', data]
            if not kept.ok
                return error[kept.reason, 'lake']
            fetched = fetched + 1
    sys.close[s]
    b = batches[dir]
    if b.ok
        for i in range[len[b]]
            if b.form[i] eq 'stale'
                gone = rm[b.path[i]]
    return fetched

--- a scratch log for the tests, emptied first
fn _scratch[name]
    gone = rm[name]
    made = mkdir[name]
    return name

--- an empty log has no positions; each append claims the next; a read
--- from a position answers the rows at and past it in order
test a_log_grows_by_batches[]
    dir = _scratch['lake-test-grows']
    assert[head[dir] eq -1]
    assert[len[since[dir, 0]] eq 0]
    assert[len[scan[dir]] eq 0]
    first = batch[dir, frame.new[id = [3, 1, 2], name = ['Apple pie', 'banana split', 'cherry tart']], by = ['id'], texts = ['name']]
    assert[first eq 0]
    assert[head[dir] eq 2]
    second = batch[dir, frame.new[id = [1, 4], name = ['apple crumble', 'durian']], by = ['id']]
    assert[second eq 3]
    assert[head[dir] eq 4]
    b = batches[dir]
    assert[len[b] eq 2 and b.number eq [0, 1] and b.high eq [0, 1] and b.form eq ['batch', 'batch'] and b.first eq [0, 3] and b.last eq [2, 4] and b.rows eq [3, 2]]
    every = scan[dir]
    assert[len[every] eq 5 and every._pos eq [0, 1, 2, 3, 4] and every.id eq [3, 1, 2, 1, 4]]
    tail = since[dir, 2]
    assert[tail._pos eq [2, 3, 4] and tail.name eq ['cherry tart', 'apple crumble', 'durian']]
    upto = scan[dir, 3]
    assert[upto._pos eq [0, 1, 2, 3]]
    assert[not batch[dir, frame.new[], by = []].ok]
    opened = batch['lake-test-grows/made/here', frame.new[id = [1]]]
    assert[opened eq 0 and exists['lake-test-grows/made/here']]
    assert[batch['/dev/null/no-log-here', frame.new[id = [1]]].kind eq 'lake']
    gone = rm[dir]

--- the latest version of each key is the table; a lookup reads only the
--- files whose filters admit the value, and answers every version
test the_table_is_the_latest_version_of_each_key[]
    dir = _scratch['lake-test-latest']
    a = batch[dir, frame.new[id = [1, 2], qty = [10, 20]], by = ['id']]
    b = batch[dir, frame.new[id = [2, 3], qty = [25, 30]], by = ['id']]
    c = batch[dir, frame.new[id = [1], qty = [15]], by = ['id']]
    t = latest[dir, ['id']]
    assert[t.id eq [2, 3, 1] and t.qty eq [25, 30, 15] and t._pos eq [2, 3, 4]]
    earlier = latest[dir, ['id'], upto = 2]
    assert[earlier.id eq [1, 2] and earlier.qty eq [10, 25]]
    two = lookup[dir, 'id', '2']
    assert[two.qty eq [20, 25] and two._pos eq [1, 2]]
    none = lookup[dir, 'id', '9']
    assert[len[none] eq 0]
    assert[lookup[dir, 'nosuch', '1'].kind eq 'lake']
    assert[lookup[dir, 'id', 'x'].kind eq 'lake']
    gone = rm[dir]

--- a commit's reads are validated against what was written after its
--- snapshot: a key written since refuses the write, naming the position;
--- a commit that read nothing, or whose keys are untouched, appends
test the_sequencer_refuses_a_stale_read[]
    dir = _scratch['lake-test-commit']
    a = batch[dir, frame.new[id = [1, 2], qty = [10, 20]], by = ['id']]
    snapshot = head[dir]
    assert[snapshot eq 1]
    other = commit[dir, frame.new[id = [2], qty = [21]], by = ['id'], seen = snapshot, columns = ['id'], equal = ['2']]
    assert[other eq 2]
    stale = commit[dir, frame.new[id = [2], qty = [22]], by = ['id'], seen = snapshot, columns = ['id'], equal = ['2']]
    assert[stale.kind eq 'lake']
    assert[stale.reason eq 'conflict: id = 2 was written at position 2, after snapshot 1']
    fine = commit[dir, frame.new[id = [1], qty = [11]], by = ['id'], seen = snapshot, columns = ['id'], equal = ['1']]
    assert[fine eq 3]
    blind = commit[dir, frame.new[id = [5], qty = [50]], by = ['id']]
    assert[blind eq 4]
    t = latest[dir, ['id']]
    assert[t.id eq [2, 1, 5] and t.qty eq [21, 11, 50]]
    gone = rm[dir]

--- a merge folds every file into one segment holding the latest version
--- of each key; the readers answer the same table through the segment,
--- the next batch takes the next number and position, and a second merge
--- folds the segment with the new batches
test a_merge_folds_the_files_into_a_segment[]
    dir = _scratch['lake-test-merge']
    a = batch[dir, frame.new[id = [1, 2], qty = [10, 20], name = ['one', 'two']], by = ['id'], texts = ['name']]
    b = batch[dir, frame.new[id = [2, 3], qty = [25, 30], name = ['two again', 'three']], by = ['id'], texts = ['name']]
    before = latest[dir, ['id']]
    assert[merge[dir, by = ['id']] eq '`dir`/000000000000-000000000001.segment']
    files = batches[dir]
    assert[len[files] eq 1 and files.form eq ['segment'] and files.number eq [0] and files.high eq [1] and files.rows eq [3] and files.first eq [0] and files.last eq [3]]
    assert[head[dir] eq 3]
    after = latest[dir, ['id']]
    assert[after.id eq before.id and after.qty eq before.qty and after._pos eq before._pos]
    assert[scan[dir].qty eq [10, 25, 30]]
    assert[lookup[dir, 'id', '2'].qty eq [25]]
    assert[lookup[dir, 'name', 'two again'].id eq [2]]
    assert[merge[dir] eq '']
    c = batch[dir, frame.new[id = [1, 4], qty = [11, 40], name = ['one again', 'four']], by = ['id'], texts = ['name']]
    assert[c eq 4]
    assert[since[dir, 4].qty eq [11, 40]]
    stale = commit[dir, frame.new[id = [1], qty = [12], name = ['one more']], by = ['id'], seen = 3, columns = ['id'], equal = ['1']]
    assert[stale.reason eq 'conflict: id = 1 was written at position 4, after snapshot 3']
    assert[merge[dir, by = ['id']] eq '`dir`/000000000000-000000000002.segment']
    files = batches[dir]
    assert[len[files] eq 1 and files.high eq [2] and files.rows eq [4]]
    e = batch[dir, frame.new[id = [1], qty = [13], name = ['one yet again']], by = ['id']]
    assert[merge[dir, by = ['id'], every = true] eq '`dir`/000000000000-000000000003.segment']
    assert[batches[dir].rows eq [5] and sort[scan[dir], 'id'].id eq [1, 1, 2, 3, 4]]
    assert[latest[dir, ['id']].qty eq [25, 30, 40, 13]]
    assert[merge['`dir`', every = true].kind eq 'lake']
    d = batch[dir, frame.new[id = [5], qty = [50], name = ['five']], by = ['id']]
    assert[d eq 7 and batches[dir].number eq [0, 4]]
    gone = rm[dir]

--- a view follows the log: `tail` answers the rows past a position as
--- they come, and an empty frame when none come in time
test a_view_follows_the_log[]
    dir = _scratch['lake-test-tail']
    a = batch[dir, frame.new[id = [1, 2], qty = [10, 20]]]
    got = tail[dir, -1, 0.2]
    assert[got.qty eq [10, 20]]
    none = tail[dir, 1, 0.05]
    assert[len[none] eq 0]
    b = batch[dir, frame.new[id = [3], qty = [30]]]
    more = tail[dir, 1, 0.2]
    assert[more.qty eq [30] and more._pos eq [2]]
    gone = rm[dir]

--- a search ranks the rows of every file by BM25 over the words asked
test a_search_ranks_the_log[]
    dir = _scratch['lake-test-search']
    a = batch[dir, frame.new[id = [1, 2, 3], text = ['the quick brown fox', 'a lazy dog', 'the fox and the dog']], texts = ['text']]
    b = batch[dir, frame.new[id = [4], text = ['brown bread']], texts = ['text']]
    hits = search[dir, 'text', ['fox'], 10]
    assert[hits.id eq [1, 3]]
    assert[hits.score[0] gt hits.score[1]]
    two = search[dir, 'text', ['brown', 'dog'], 2]
    assert[len[two] eq 2]
    none = search[dir, 'text', ['zebra']]
    assert[len[none] eq 0 and 'score' in none.columns]
    m = merge[dir]
    again = search[dir, 'text', ['fox'], 10]
    assert[again.id eq [1, 3]]
    gone = rm[dir]

--- the figures, a backup and its restore: the restored log answers as the
--- log did
test a_backup_is_restored[]
    dir = _scratch['lake-test-backup']
    a = batch[dir, frame.new[id = [1, 2], qty = [10, 20]], by = ['id']]
    b = batch[dir, frame.new[id = [2, 3], qty = [25, 30]], by = ['id']]
    m = metrics[dir]
    assert[m.files eq [2] and m.batches eq [2] and m.rows eq [4] and m.head eq [3]]
    assert[m.bytes[0] gt 0]
    copied = backup[dir, 'lake-test-backup-copy']
    assert[copied eq 2]
    gone = rm[dir]
    back = restore['lake-test-backup-copy', dir]
    assert[back eq 2]
    assert[latest[dir, ['id']].qty eq [10, 25, 30]]
    assert[head[dir] eq 3]
    fourth = batch[dir, frame.new[id = [4], qty = [40]], by = ['id']]
    assert[fourth eq 4]
    assert[not restore['lake-test-nowhere', dir].ok]
    assert[not backup[dir, 'http://127.0.0.1:1/x'].ok]
    gone = rm['lake-test-backup-copy']
    gone = rm[dir]

--- the server's answers to a follower's requests, at known values
test a_shared_log_answers_its_followers[]
    dir = _scratch['lake-test-share']
    a = batch[dir, frame.new[id = [1, 2], qty = [10, 20]], by = ['id']]
    listing = text[_shared[dir, 'list'], '?']
    lines = split[listing, '\n']
    assert[lines[0] eq '1']
    assert[starts[lines[1], '000000000000.batch ']]
    got = _shared[dir, 'get 000000000000.batch']
    assert[got.ok and len[got] gt 10]
    assert[not _shared[dir, 'get ../secret'].ok]
    assert[not _shared[dir, 'steal'].ok]
    assert[not follow['lake-test-share-copy', '127.0.0.1', 1, 0.2].ok]
    gone = rm['lake-test-share-copy']
    gone = rm[dir]
