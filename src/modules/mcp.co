--- `use mcp`: tools from other programs, and a Crow program as one — the
--- Model Context Protocol, revision 2026-07-28 (stateless: every request
--- carries its protocol version and the client's capabilities in `_meta`,
--- over Streamable HTTP, one POST per message), written in Crow on
--- `request` and the sys layer (design rule 20). A client: `server[url]`
--- names an MCP endpoint, `discover[s]` asks its versions and
--- capabilities, `catalog[s]` lists its tools (each its `name`,
--- `description` and `inputSchema`), `tool[s, name, args]` calls one and
--- answers its text. A server: `answer[req, tools = [f, g]]` in a POST
--- route answers `server/discover`, `tools/list` and `tools/call` over
--- the functions themselves (`describe` and `apply`, sys), as `use llm`'s
--- loop calls them. The tests are the module's own (`crow test
--- src/modules/mcp.co`), and tests/mcp.rs drives a Crow client against a
--- stand-in server and a stand-in client against a Crow server, in both
--- modes. The design is docs/agents-design.md.
use sys, web

--- the protocol revision spoken, and this implementation's name
fn _version[]
    return '2026-07-28'

fn _implementation[]
    return '{"name": "crow", "version": "0.7.0"}'

--- the `_meta` every request carries: the version, who asks, what it can
fn _meta[]
    return '{"io.modelcontextprotocol/protocolVersion": "`_version[]`", "io.modelcontextprotocol/clientInfo": `_implementation[]`, "io.modelcontextprotocol/clientCapabilities": {}}'

--- the `_meta` a result carries: who answers
fn _answered_by[name]
    return '{"io.modelcontextprotocol/serverInfo": {"name": `encode[name]`, "version": "0.7.0"}}'

--- a request's params as JSON text with the `_meta` added
fn _with_meta[params]
    if len[trim[params]] lte 2
        return '{"_meta": `_meta[]`}'
    rest = slice[trim[params], 1, len[trim[params]]]
    return '{"_meta": `_meta[]`, `rest`'

--- text cut short for a message
fn _cut[words]
    shown = trim[words]
    if len[shown] gt 200
        return '`slice[shown, 0, 200]`…'
    return shown

--- ── the client ──────────────────────────────────────────────────────

--- `server[url, token = '']`: an MCP server as a connection — the URL of
--- its MCP endpoint, and the bearer token its requests carry, if any — a
--- parsed value: `s.url`, `s.token`
fn server[url, token = '']
    if not (starts[url, 'http://'] or starts[url, 'https://'])
        return error['an MCP server is reached at its endpoint\'s URL: `url` is none — http://localhost:8000/mcp', 'mcp']
    return json['{"url": `encode[url]`, "token": `encode[token]`}']

--- a server's description as a program hands it — what `server` answered
fn _server_of[s]
    if type[s] ne 'map' or not s.url.ok
        return error['an MCP server is what server[…] answers', 'mcp']
    return s

--- the JSON-RPC message a response carries — its status, its content
--- type and its body: the body's JSON, or, in a stream of events, the
--- last event holding a result or an error (the notifications before it
--- are the request's own)
fn _message_of[status, kind, body]
    if starts[kind, 'text/event-stream']
        last = json['{}']
        for event in split[replace[body, '\r\n', '\n'], '\n\n']
            data = []
            for line in split[event, '\n']
                if starts[line, 'data:']
                    data = push[data, trim[slice[line, 5, len[line]]]]
            if len[data] gt 0
                j = json[join[data, '\n']]
                if j.ok
                    if j.result.ok or j.error.ok
                        last = j
        if not last.result.ok and not last.error.ok
            return error['the MCP server\'s stream ended with no response', 'mcp']
        return last
    j = json[body]
    if not j.ok
        if status lt 200 or status gte 300
            return error['the MCP server answered `status`: `_cut[body]`', 'mcp']
        return error['the MCP server answered no JSON: `_cut[body]`', 'mcp']
    return j

--- a request sent — the method, its params as JSON text, and the name
--- the Mcp-Name header carries for a call — and the result read back; an
--- error of kind mcp where none came, or the server answered one
fn _sent[s, method, params, named]
    body = '{"jsonrpc": "2.0", "id": 1, "method": `encode[method]`, "params": `_with_meta[params]`}'
    h = map[]
    h = set[h, 'content-type', 'application/json']
    h = set[h, 'accept', 'application/json, text/event-stream']
    h = set[h, 'mcp-protocol-version', _version[]]
    h = set[h, 'mcp-method', method]
    if len[named] gt 0
        h = set[h, 'mcp-name', named]
    token = str[s.token]
    if len[token] gt 0
        h = set[h, 'authorization', 'Bearer `token`']
    r = request[str[s.url], 'POST', body, headers = h, timeout = 600]
    if not r.ok
        return error['cannot reach the MCP server: `r.reason`', 'mcp']
    kind = ''
    if 'content-type' in r.headers
        kind = lower[r.headers['content-type']]
    message = _message_of[r.status, kind, r.body]
    if not message.ok
        return error[message.reason, 'mcp']
    if message.error.ok
        return error['the MCP server answered an error `str[message.error.code]`: `str[message.error.message]`', 'mcp']
    if not message.result.ok
        return error['the MCP server answered no result', 'mcp']
    return message.result

--- `discover[s]`: what the server says of itself — `supportedVersions`,
--- `capabilities`, its `instructions` for a model, and who it is under
--- `_meta` — a parsed value
fn discover[s]
    checked = _server_of[s]
    if not checked.ok
        return error[checked.reason, 'mcp']
    return _sent[s, 'server/discover', '{}', '']

--- `catalog[s]`: the tools the server offers, a parsed value list — each
--- its `name`, `description` and `inputSchema`
fn catalog[s]
    checked = _server_of[s]
    if not checked.ok
        return error[checked.reason, 'mcp']
    result = _sent[s, 'tools/list', '{}', '']
    if not result.ok
        return error[result.reason, 'mcp']
    if not result.tools.ok
        return error['the MCP server listed no tools', 'mcp']
    return result.tools

--- the text a result's content blocks carry, joined
fn _content_text[result]
    words = []
    if result.content.ok
        for block in result.content
            if block.type.ok and str[block.type] eq 'text'
                words = push[words, str[block.text]]
    return join[words, '\n']

--- `tool[s, name, given]`: a tool of the server's called with its
--- arguments — a map, or a parsed value — answering the text its result
--- carries; a result the server marks an error is an error value of kind
--- mcp saying what it said, as is a tool the server does not have
fn tool[s, name, given]
    checked = _server_of[s]
    if not checked.ok
        return error[checked.reason, 'mcp']
    result = _sent[s, 'tools/call', '{"name": `encode[name]`, "arguments": `encode[given]`}', name]
    if not result.ok
        return error[result.reason, 'mcp']
    words = _content_text[result]
    if result.isError.ok
        if result.isError
            return error[words, 'mcp']
    return words

--- ── the server ──────────────────────────────────────────────────────

--- the JSON schema of a kind, by the word errors use for it (as `use
--- llm` writes a tool's schema for a model: a helper is a module's own)
fn _json_type[word]
    if word eq 'an int'
        return '{"type": "integer"}'
    if word eq 'a number' or word eq 'a decimal' or word eq 'a fraction'
        return '{"type": "number"}'
    if word eq 'text' or word eq 'a moment' or word eq 'markup' or word eq 'bytes'
        return '{"type": "string"}'
    if word eq 'a bool'
        return '{"type": "boolean"}'
    if word eq 'a JSON value' or word eq 'a map' or word eq 'a record' or word eq 'a value'
        return '{"type": "object"}'
    if word eq 'numbers' or word eq 'a list of numbers'
        return '{"type": "array", "items": {"type": "number"}}'
    if word eq 'a list of ints'
        return '{"type": "array", "items": {"type": "integer"}}'
    if word eq 'a list of text'
        return '{"type": "array", "items": {"type": "string"}}'
    if word eq 'a list of bools'
        return '{"type": "array", "items": {"type": "boolean"}}'
    if word eq 'a list' or word eq 'a list of records' or word eq 'a list of maps'
        return '{"type": "array", "items": {"type": "object"}}'
    return error['no schema for `word`', 'mcp']

--- a tool as `tools/list` says it, from the function's description: its
--- name, its comment, and its parameters as the input schema, every one
--- required
fn _tool_listed[d]
    properties = []
    required = []
    for p in d.params
        kind = _json_type[str[p.takes]]
        if not kind.ok
            return error['the parameter `str[p.name]` of `str[d.name]` takes `str[p.takes]`, which a client cannot hand it: a tool takes numbers, text, bools, lists, maps, records and parsed values', 'mcp']
        properties = push[properties, '`encode[str[p.name]]`: `kind`']
        required = push[required, encode[str[p.name]]]
    props = join[properties, ', ']
    req = join[required, ', ']
    return '{"name": `encode[str[d.name]]`, "description": `encode[str[d.doc]]`, "inputSchema": {"type": "object", "properties": {`props`}, "required": [`req`]}}'

--- a JSON-RPC error response as text, for the request's id (`null` where
--- it had none that could be read)
fn _error_text[id, code, message]
    return '{"jsonrpc": "2.0", "id": `id`, "error": {"code": `code`, "message": `encode[message]`}}'

--- a JSON-RPC result response as text
fn _result_text[id, result]
    return '{"jsonrpc": "2.0", "id": `id`, "result": `result`}'

--- a response of JSON, 200
fn _json_response[body]
    return binary[bytes[body], 'application/json']

--- the request's id as JSON text: a number or text, or null
fn _id_of[message]
    if not message.id.ok
        return 'null'
    return encode[message.id]

--- a tool's result as `tools/call` answers it: the text of the value, or
--- a failure said in words and marked an error, which a model can read
--- and try another way
fn _call_result[tools, name, given]
    for t in tools
        if str[describe[t].name] eq name
            out = apply[t, given]
            if not out.ok
                return '{"resultType": "complete", "content": [{"type": "text", "text": `encode[out.reason]`}], "isError": true}'
            parsed = json[out]
            words = out
            if parsed.ok
                if type[parsed] eq 'str'
                    words = str[parsed]
            return '{"resultType": "complete", "content": [{"type": "text", "text": `encode[words]`}], "isError": false}'
    return ''

--- `answer[req, tools = [f, g], name = 'crow', instructions = '']`: the
--- request a POST route was handed, answered as an MCP server over the
--- functions themselves — `server/discover` with the versions, the
--- capabilities and the instructions, `tools/list` with each tool's
--- schema from its description, `tools/call` with the tool applied by
--- name and its result's text (a failure marked an error); a notification
--- is accepted with 202, a body that is no JSON, a request missing its
--- `_meta` or its headers, or one of another protocol version refused
--- with 400 and the JSON-RPC error the protocol names, an unknown method
--- with 404
fn answer[req, tools = [], name = 'crow', instructions = '']
    message = json[req.body]
    if not message.ok
        return respond[400, _error_text['null', -32700, 'the body is no JSON']]
    id = _id_of[message]
    if not message.method.ok
        return respond[400, _error_text[id, -32600, 'the request names no method']]
    method = str[message.method]
    if not message.id.ok
        return respond[202, '']
    meta = message.params['_meta']
    if not meta.ok or not meta['io.modelcontextprotocol/protocolVersion'].ok or not meta['io.modelcontextprotocol/clientCapabilities'].ok
        return respond[400, _error_text[id, -32602, 'a request carries its protocol version and the client\'s capabilities in _meta']]
    asked_version = str[meta['io.modelcontextprotocol/protocolVersion']]
    if asked_version ne _version[]
        return respond[400, '{"jsonrpc": "2.0", "id": `id`, "error": {"code": -32022, "message": "Unsupported protocol version", "data": {"supported": ["`_version[]`"], "requested": `encode[asked_version]`}}}']
    header_version = ''
    if 'mcp-protocol-version' in req.headers
        header_version = req.headers['mcp-protocol-version']
    header_method = ''
    if 'mcp-method' in req.headers
        header_method = req.headers['mcp-method']
    if header_version ne asked_version or header_method ne method
        return respond[400, _error_text[id, -32020, 'Header mismatch: MCP-Protocol-Version and Mcp-Method must match the body']]
    served = _answered_by[name]
    if method eq 'server/discover'
        said = ', "instructions": `encode[instructions]`'
        if len[instructions] eq 0
            said = ''
        return _json_response[_result_text[id, '{"resultType": "complete", "supportedVersions": ["`_version[]`"], "capabilities": {"tools": {}}, "_meta": `served``said`, "ttlMs": 3600000, "cacheScope": "public"}']]
    if method eq 'tools/list'
        listed = []
        for t in tools
            one = _tool_listed[describe[t]]
            if not one.ok
                return respond[500, _error_text[id, -32603, one.reason]]
            listed = push[listed, one]
        glued = join[listed, ', ']
        return _json_response[_result_text[id, '{"resultType": "complete", "tools": [`glued`], "_meta": `served`, "ttlMs": 60000, "cacheScope": "public"}']]
    if method eq 'tools/call'
        if not message.params.name.ok
            return respond[400, _error_text[id, -32602, 'tools/call names the tool']]
        called = str[message.params.name]
        header_name = ''
        if 'mcp-name' in req.headers
            header_name = req.headers['mcp-name']
        if header_name ne called
            return respond[400, _error_text[id, -32020, 'Header mismatch: Mcp-Name must match the tool called']]
        given = json['{}']
        if message.params.arguments.ok
            given = message.params.arguments
        result = _call_result[tools, called, given]
        if len[result] eq 0
            return _json_response[_error_text[id, -32602, 'Unknown tool: `called`']]
        return _json_response[_result_text[id, '`slice[result, 0, len[result] - 1]`, "_meta": `served`}']]
    return respond[404, _error_text[id, -32601, 'Method not found: `method`']]

--- ── the module's own tests ────────────────────────────────────────────

--- a tool the module's own tests describe and call
fn _echo[words]
    return 'echo `trim[words]`'

--- a server's URL read, and one that is none refused; a request's params
--- gain the _meta every request carries
test a_server_is_its_endpoints_url[]
    s = server['http://127.0.0.1:8000/mcp']
    assert[str[s.url] eq 'http://127.0.0.1:8000/mcp']
    assert[str[s.token] eq '']
    t = server['https://example.com/mcp', token = 'abc']
    assert[str[t.token] eq 'abc']
    assert[not server['localhost:8000'].ok]
    assert[server['ftp://x'].kind eq 'mcp']
    bare = json[_with_meta['{}']]
    assert[str[bare['_meta']['io.modelcontextprotocol/protocolVersion']] eq '2026-07-28']
    full = json[_with_meta['{"name": "echo", "arguments": {"words": "hi"}}']]
    assert[str[full.name] eq 'echo']
    assert[str[full['_meta']['io.modelcontextprotocol/clientInfo'].name] eq 'crow']

--- a response is read as its JSON, or as the last event of a stream
--- that holds a response
test a_message_is_read_from_json_or_from_a_stream[]
    m = _message_of[200, 'application/json', '{"jsonrpc": "2.0", "id": 1, "result": {"resultType": "complete", "tools": []}}']
    assert[len[m.result.tools] eq 0]
    events = 'event: message\ndata: {"jsonrpc": "2.0", "method": "notifications/progress", "params": {}}\n\n: keep-alive\n\ndata: {"jsonrpc": "2.0", "id": 1, "result": {"resultType": "complete", "content": [{"type": "text", "text": "21"}]}}\n\n'
    m2 = _message_of[200, 'text/event-stream', events]
    assert[_content_text[m2.result] eq '21']
    assert[not _message_of[200, 'text/event-stream', ': keep-alive\n\n'].ok]
    assert[_message_of[502, 'text/plain', 'bad gateway'].reason eq 'the MCP server answered 502: bad gateway']
    assert[_message_of[200, 'text/html', '<p>hi</p>'].reason eq 'the MCP server answered no JSON: <p>hi</p>']

--- a tool is listed from its description, and called by name: its text,
--- a failure marked an error, a name no tool has none
test a_tool_is_listed_and_called[]
    listed = json[_tool_listed[describe[_echo]]]
    assert[str[listed.name] eq '_echo']
    assert[str[listed.description] eq 'a tool the module\'s own tests describe and call']
    assert[str[listed.inputSchema.properties.words.type] eq 'string']
    assert[str[listed.inputSchema.required[0]] eq 'words']
    called = json[_call_result[[_echo], '_echo', json['{"words": " hi "}']]]
    assert[str[called.content[0].text] eq 'echo hi']
    assert[str[called.isError] eq 'false']
    missing = json[_call_result[[_echo], '_echo', json['{}']]]
    assert[str[missing.isError] eq 'true']
    assert[_call_result[[_echo], 'nothing', json['{}']] eq '']
    assert[_error_text['1', -32601, 'Method not found: x'] eq '{"jsonrpc": "2.0", "id": 1, "error": {"code": -32601, "message": "Method not found: x"}}']
